---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import CursorTrail from '../components/CursorTrail.astro';
import Footer from '../components/Footer.astro';
/* `trail` is the cursor line. It is on everywhere except pages that own the
   cursor themselves — /playground puts a grab hand on its pannable field,
   and a line trailing off a hand you are dragging with reads as two
   cursors. Opt out there rather than fighting it. */
interface Props { title: string; description?: string; trail?: boolean; }
const {
  title,
  description = 'Anupama Mishra — Staff Product Designer. Ten years in fintech, enterprise software and developer tools.',
  trail = true,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Indexable. The Wix site was serving noindex — do not reintroduce it. -->
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- Light/dark is resolved before first paint so a returning visitor
         never sees the wrong palette flash: Light or Dark if they picked
         one with the nav's theme button, otherwise (System) their OS
         setting. data-mode-pref is the choice, data-mode what the tokens
         read. Runs inline on purpose; don't move it to a bundled script. -->
    <script is:inline>
      (() => {
        let stored = null;
        try { stored = localStorage.getItem('mode'); } catch (e) {}
        const pref = stored === 'dark' || stored === 'light' ? stored : 'system';
        const root = document.documentElement;
        root.dataset.modePref = pref;
        root.dataset.mode = pref === 'system'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : pref;
      })();
    </script>
    <!-- Page scale (see html in global.css). The layout is composed for a
         ~1440x800 laptop; a taller or wider screen scales every rem up by
         min(height / baseH, width / baseW), 1 to maxScale, so a big monitor
         shows the laptop composition larger. Worked out here, not in CSS
         from vw/svh, so browser zoom still works: zooming shrinks the CSS
         viewport, and a viewport-based scale shrank by the same amount,
         cancelling zoom out entirely up to ~150% on a big screen. Here the
         viewport is measured at 100% zoom (current size x zoom level), so
         the scale holds still and zoom multiplies on top of it. Zoom level:
         outerWidth / innerWidth (Chrome, Safari: outerWidth ignores zoom)
         or the change in devicePixelRatio since load (Firefox), snapped to
         a real zoom step so window chrome can't read as zoom. No JS: 1x. -->
    <script is:inline define:vars={{ baseH: 800, baseW: 1200, maxScale: 1.8 }}>
      (() => {
        const root = document.documentElement;
        const steps = [0.5, 0.67, 0.75, 0.8, 0.9, 1, 1.1, 1.25, 1.5, 1.75, 2, 2.5, 3, 4, 5];
        const dpr0 = devicePixelRatio;
        const zoom = () => {
          const z = Math.max(innerWidth ? outerWidth / innerWidth : 1, devicePixelRatio / dpr0);
          const near = steps.reduce((a, b) => (Math.abs(b - z) < Math.abs(a - z) ? b : a));
          return Math.abs(near - z) / near < 0.04 ? near : 1;
        };
        const set = () => {
          const z = zoom();
          const s = Math.min(maxScale, Math.max(1, Math.min((innerHeight * z) / baseH, (innerWidth * z) / baseW)));
          root.style.setProperty('--page-scale', s.toFixed(3));
        };
        set();
        addEventListener('resize', set);
      })();
    </script>
    <!-- The type system (tokens.css): Crimson Pro 300 roman + italic for
         headlines, Manrope 600 for everything else, Azeret Mono 400 for
         numbers. One weight per face on purpose — add a weight here only
         if tokens.css gains a role that needs it. Roboto Mono is Pixel's
         (AskBubble.astro) alone, kept until the chat is restyled. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400&family=Crimson+Pro:ital,wght@0,300;1,300&family=Manrope:wght@600&family=Roboto+Mono:wght@400&display=swap"
    />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer />
    {trail && <CursorTrail />}
    <style>
      .skip {
        position: absolute; left: -9999px;
        background: var(--fg); color: var(--bg);
        padding: 0.75rem 1rem; z-index: 100;
      }
      .skip:focus { left: var(--gutter); top: 1rem; }

      /* The page is a sheet lifted over the black footer (after
         rachelatwork.com): it stacks above it, paints its own ground, and
         its bottom corners round off onto the black. clip-path, not
         border-radius + overflow — clip-path also trims fixed layers
         inside the page (the playground's pinned heading), which would
         otherwise cover the footer. See Footer.astro for the other half. */
      main {
        position: relative;
        z-index: 1;
        background: var(--bg);
        clip-path: inset(0 round 0 0 var(--radius-page-end) var(--radius-page-end));
        transition: background var(--dur-hover) var(--ease-out);
      }
    </style>
  </body>
</html>
