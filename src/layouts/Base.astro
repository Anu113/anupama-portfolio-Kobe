---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import ThemeRail from '../components/ThemeRail.astro';
import CursorTrail from '../components/CursorTrail.astro';
import Footer from '../components/Footer.astro';
/* `trail` is the cursor line. It is on everywhere except pages that own the
   cursor themselves — /playground puts a grab hand on its pannable field,
   and a line trailing off a hand you are dragging with reads as two
   cursors. Opt out there rather than fighting it. */
interface Props { title: string; description?: string; trail?: boolean; }
const {
  title,
  description = 'Anupama Mishra — Staff Product Designer. Identity, access and the enterprise systems underneath them.',
  trail = true,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Day/night mode is resolved before first paint so a returning
         visitor never sees the wrong palette flash. Runs inline on
         purpose — do not move this to a bundled script. -->
    <script is:inline>
      (() => {
        let stored = null;
        try { stored = localStorage.getItem('mode'); } catch (e) {}
        document.documentElement.dataset.mode =
          stored ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'day');
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Indexable. The Wix site was serving noindex — do not reintroduce it. -->
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <!-- `@1` is Fontshare's VARIABLE cut of General Sans: one file covering
         the whole 200–700 weight axis instead of three static masters. The
         footer wordmark animates that axis under the cursor, which a static
         face cannot do. Weights 400/500/600 used everywhere else render the
         same. Don't swap this back to `@400,500,600`. -->
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=general-sans@1&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@1&display=swap"
    />
    <!-- Body copy. 400/500 covers regular paragraphs and the heavier .u-label
         weight; italic comes along for any <em> that lands in body text. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;1,400&display=swap"
    />
    <!-- The playground stream's print-label captions only. Weight 400 is
         the only cut used. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400&display=swap"
    />
    <script src="https://mcp.figma.com/mcp/html-to-design/capture.js" async></script>
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Nav />
    <ThemeRail />
    <main id="main"><slot /></main>
    <Footer />
    {trail && <CursorTrail />}
    <style>
      .skip {
        position: absolute; left: -9999px;
        background: var(--fg); color: var(--bg);
        padding: 0.75rem 1rem; z-index: 100;
      }
      .skip:focus { left: var(--gutter); top: 1rem; }
    </style>
  </body>
</html>
