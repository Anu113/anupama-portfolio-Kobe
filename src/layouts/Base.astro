---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import CursorTrail from '../components/CursorTrail.astro';
import CursorLamp from '../components/CursorLamp.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import SiteGate from '../components/SiteGate.astro';
import { site } from '../data/site';
import { UNLOCK_KEY } from '../scripts/unlock';
const siteLock = site.lock.site;
/* `trail` is the cursor line (and, in dark mode, the cursor lamp — see
   CursorLamp.astro). It is on everywhere except pages that own the
   cursor themselves — /playground puts a grab hand on its pannable field,
   and a line trailing off a hand you are dragging with reads as two
   cursors. Opt out there rather than fighting it. */
interface Props { title: string; description?: string; trail?: boolean; }
const {
  title,
  description = 'Anupama Mishra — Staff Product Designer. Ten years in fintech, enterprise software and developer tools.',
  trail = true,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Indexable. The Wix site was serving noindex — do not reintroduce it. -->
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- Every page names anupama.design (astro.config `site`) as its home,
         so search engines credit the domain, not a *.vercel.app preview. -->
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <!-- Light/dark is resolved before first paint so a returning visitor
         never sees the wrong palette flash: Light or Dark if they picked
         one with the nav's theme toggle, otherwise Light — the default,
         on request, whatever the OS is set to (data-mode-pref 'system'
         just means "not chosen yet"). data-mode-pref is the choice,
         data-mode what the tokens read. Runs inline on purpose; don't
         move it to a bundled script. -->
    <script is:inline>
      (() => {
        let stored = null;
        try { stored = localStorage.getItem('mode'); } catch (e) {}
        const pref = stored === 'dark' || stored === 'light' ? stored : 'system';
        const root = document.documentElement;
        root.dataset.modePref = pref;
        root.dataset.mode = pref === 'system' ? 'light' : pref;
      })();
    </script>
    <!-- The passcode (site.lock in data/site.ts, scripts/unlock.ts),
         decided before first paint: a visitor who typed it in the last
         few hours gets `data-unlocked` (no frost on locked cards, no
         gates); otherwise, while the whole-site lock is on,
         `data-site-lock` puts the frosted gate up (SiteGate.astro) before
         the page can flash unfrosted. -->
    <script is:inline define:vars={{ siteLock, unlockKey: UNLOCK_KEY }}>
      (() => {
        const root = document.documentElement;
        let until = 0;
        try { until = Number(localStorage.getItem(unlockKey)); } catch (e) {}
        if (until > Date.now()) root.dataset.unlocked = '';
        else if (siteLock) root.dataset.siteLock = '';
      })();
    </script>
    <!-- Page arrival, after andreas.vision (chosen 2026-11-17 from
         experiments/page-transitions/, "B · Rise"): arriving from another
         page of the site, the new page's opening parts ([data-rise]) rise
         10px into place one after another (PAGE ARRIVAL in tokens.css,
         `[data-rise]` in global.css). Back and forward rise too (on
         request, 2026-11-17), including a page the browser restores whole
         from memory (pageshow, persisted), where no load script runs. Not
         on a first visit or a refresh — the home page's preloader owns the
         first visit. Decided before first paint, so nothing shows and
         then hides. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const nav = performance.getEntriesByType('navigation')[0];
          const type = nav ? nav.type : 'navigate';
          const internal = !!document.referrer && new URL(document.referrer).origin === location.origin;
          if (type === 'back_forward' || (type === 'navigate' && internal)) root.dataset.arrive = '';
        } catch (e) {}
        addEventListener('pageshow', (e) => {
          if (!e.persisted) return;
          delete root.dataset.arrive;
          void root.offsetWidth; // let the old run go, so the rise plays again
          root.dataset.arrive = '';
        });
      })();
    </script>
    <!-- The type system (tokens.css): Crimson Pro 300 roman + italic for
         headlines, Manrope 600 for everything else, Azeret Mono 400 for
         numbers. One weight per face on purpose — add a weight here only
         if tokens.css gains a role that needs it. Roboto Mono is Pixel's
         (AskBubble.astro) alone, kept until the chat is restyled. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400&family=Crimson+Pro:ital,wght@0,300;1,300&family=Manrope:wght@600&family=Roboto+Mono:wght@400&display=swap"
    />
  </head>
  <body>
    <!-- First, so it decides before anything paints (Preloader.astro). -->
    <Preloader />
    <a href="#main" class="skip">Skip to content</a>
    <Nav />
    <main id="main"><slot />{trail && <CursorLamp />}</main>
    <Footer />
    {trail && <CursorTrail />}
    {siteLock && <SiteGate />}
    <!-- Wheel scrolls ease to a stop instead of halting (smooth-scroll.ts, Lenis). -->
    <script>import '../scripts/smooth-scroll';</script>
    <style>
      .skip {
        position: absolute; left: -9999px;
        background: var(--fg); color: var(--bg);
        padding: 0.75rem 1rem; z-index: 100;
      }
      .skip:focus { left: var(--gutter); top: 1rem; }

      /* The page is a sheet lifted over the black footer (after
         rachelatwork.com): it stacks above it, paints its own ground, and
         its bottom corners round off onto the black. clip-path, not
         border-radius + overflow — clip-path also trims fixed layers
         inside the page (the playground's pinned heading), which would
         otherwise cover the footer. See Footer.astro for the other half. */
      main {
        position: relative;
        z-index: 1;
        background: var(--bg);
        clip-path: inset(0 round 0 0 var(--radius-page-end) var(--radius-page-end));
        transition: background var(--dur-hover) var(--ease-out);
      }
    </style>
  </body>
</html>
