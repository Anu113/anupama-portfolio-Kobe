---
/* PrivacyCover.astro — the main image of the three PayPal privacy cases
   (Privacy settings, Data rights, Ads consent; `kind`): a composed,
   annotated mockup on the project hue, after rachelatwork.com's case
   covers (on request, in place of a strip of cropped screenshots). The
   redesigned Data and privacy page in a phone, three pieces of the
   redesign floating beside it, and a numbered note on each naming the
   decision it shows, in the same words as the craft section's claims.

   Static on purpose (her call): it's a cover, read in a glance. The
   phone is the coded screen (PrivacyScreen.astro), so it's sharp at any
   size; the pieces are drawn here from her screens' copy. Everything is
   laid out on one fixed canvas and scaled whole to the frame, so nothing
   is ever cropped. Where the frame is too small for the notes to read,
   only the phone shows.

   The frame behind it takes each case's own ground (`--cover-ground-*`,
   on request, 2026-11-19), so the three covers don't read as one; the
   cover itself is the same on all three.

   Decorative to assistive tech except for its one label (the case's
   hero alt). Values under PRIVACY COVER in tokens.css. */
import PrivacyScreen from './PrivacyScreen.astro';
import '../styles/pp-sans.css';

import Illo from './PrivacyIllo.astro';

// One cover per PayPal privacy case (on request, 2026-11-18, when the
// Privacy case was split): the same layout, a different phone, pieces and
// notes. Every piece is copy from that case's own screens.
type Kind = 'privacy' | 'data-rights' | 'ads-consent';
interface Props { alt: string; kind?: Kind }
const { alt, kind = 'privacy' } = Astro.props;
const phone: Record<Kind, string> = { privacy: 'it-hub', 'data-rights': 'it-clean', 'ads-consent': 'ck-1' };
const notes: Record<Kind, [string, string, string, string]> = {
  privacy: ['One page, three headings', 'A switch that says what it uses', 'Once a year, a check in the card', 'Learn more, at the end'],
  'data-rights': ['Delete part, keep the account', 'One tick per data type', 'A request says where it is', 'Clean up comes first'],
  'ads-consent': ['Once a year, one setting at a time', 'Asking first, with equal answers', 'The yearly card opens a checkup', 'Off until you turn it on'],
};
const n = notes[kind];
---
<div class={`cv cv--${kind}`} data-cv role="img" aria-label={alt}>
  <div class="cv__canvas" aria-hidden="true">
    <svg class="cv__wires" viewBox="0 0 1200 525">
      <path d="M487 150 C 460 150, 452 128, 426 128" />
      <path d="M487 360 C 468 360, 462 382, 440 382" />
      <path d="M713 300 C 740 300, 748 322, 772 322" />
      <path d="M713 118 C 734 118, 740 88, 760 88" />
      <circle cx="487" cy="150" r="3" /><circle cx="487" cy="360" r="3" /><circle cx="713" cy="300" r="3" /><circle cx="713" cy="118" r="3" />
    </svg>

    <div class="cv__phone">
      <div class="cv__screen" inert>
        <div class="cv__draw">
          <div class="sb"><span>9:41</span><span class="sb__icons"><i></i><i></i><i></i></span></div>
          <div class="cv__scr"><PrivacyScreen id={phone[kind]} /></div>
        </div>
      </div>
    </div>

    <p class="cv__note" style="left: 760px; top: 71px;"><b>01</b>{n[0]}</p>

    {kind === 'privacy' && (
      <>
        <div class="cv__piece" style="left: 106px; top: 66px; width: 320px;">
          <div class="pc-row"><span class="pc-t">Get personalized offers</span><span class="pc-switch pc-switch--on"><i></i></span></div>
          <p class="pc-d">On. You’ll see deals based on where you shop.</p>
          <p class="pc-k">What it uses</p>
          <p class="pc-d pc-d--ink">Where you’ve paid with PayPal, and stores you’ve visited in PayPal’s network</p>
        </div>
        <div class="cv__piece pc-anniv" style="left: 120px; top: 322px; width: 320px;">
          <span class="pc-anniv__art"><Illo name="anniv" size={64} /></span>
          <p class="pc-k">One year of your settings</p>
          <p class="pc-q">Personalized deals are on. Still want them?</p>
          <div class="pc-btns"><span class="pc-btn pc-btn--p">Keep on</span><span class="pc-btn">Turn off</span></div>
        </div>
        <div class="cv__piece pc-learn" style="left: 772px; top: 196px; width: 220px;">
          <img src="/images/paypal-privacy/learn-others.webp" alt="" width="220" height="149" />
          <p class="pc-learn__t">What others see when you use PayPal</p>
        </div>
      </>
    )}

    {kind === 'data-rights' && (
      <>
        <div class="cv__piece" style="left: 106px; top: 66px; width: 320px;">
          <div class="pc-row"><span class="pc-t">Personal info</span><span class="pc-check"></span></div>
          <p class="pc-d">This helps us keep your account safe, personalize your experience, and contact you when needed.</p>
          <p class="pc-link">What’s included ⌄</p>
        </div>
        <div class="cv__piece" style="left: 140px; top: 322px; width: 300px;">
          <ol class="pc-steps">
            <li class="is-done">Requested</li>
            <li class="is-done">We confirmed it’s you</li>
            <li class="is-now">Gathering your data<span>We’ll email you when it’s ready.</span></li>
          </ol>
        </div>
        <div class="cv__piece cv__piece--on" style="left: 772px; top: 262px; width: 320px;">
          <div class="pc-row pc-row--start"><span class="pc-t">Clean up your data</span><span class="pc-new">New</span></div>
          <p class="pc-d">Delete data you don’t need, like marketing or face scan data. Your account stays open.</p>
        </div>
      </>
    )}

    {kind === 'ads-consent' && (
      <>
        <div class="cv__piece" style="left: 76px; top: 66px; width: 350px;">
          <p class="pc-q">Want PayPal ads that match your interests?</p>
          <p class="pc-d">It stays off unless you turn it on. You can change it any time in Online ad preferences.</p>
          <div class="pc-btns"><span class="pc-btn">Allow</span><span class="pc-btn">Not now</span></div>
        </div>
        <div class="cv__piece pc-anniv" style="left: 120px; top: 322px; width: 320px;">
          <span class="pc-anniv__art"><Illo name="anniv" size={64} /></span>
          <p class="pc-k">One year of your settings</p>
          <p class="pc-q">Time for your privacy checkup</p>
          <div class="pc-btns"><span class="pc-btn pc-btn--p">Start checkup</span><span class="pc-btn">Not now</span></div>
        </div>
        <div class="cv__piece" style="left: 772px; top: 262px; width: 320px;">
          <div class="pc-row"><span class="pc-t">Online ad preferences</span><span class="pc-switch"><i></i></span></div>
          <p class="pc-d">Choose whether we share some of your info with our ad partners.</p>
        </div>
      </>
    )}

    <p class="cv__note" style="left: 106px; top: 22px;"><b>02</b>{n[1]}</p>
    <p class="cv__note" style={`left: ${kind === 'privacy' || kind === 'ads-consent' ? 120 : 140}px; top: 476px;`}><b>03</b>{n[2]}</p>
    <p class="cv__note" style={`left: 772px; top: ${kind === 'privacy' ? 420 : 392}px;`}><b>04</b>{n[3]}</p>
  </div>
</div>

<style>
  /* Each case's own ground, on the frame round the cover. */
  :global(.hero__frame.hero__frame:has(> .cv--privacy)) { background: var(--cover-ground-privacy); }
  :global(.hero__frame.hero__frame:has(> .cv--data-rights)) { background: var(--cover-ground-data-rights); }
  :global(.hero__frame.hero__frame:has(> .cv--ads-consent)) { background: var(--cover-ground-ads-consent); }
  /* The frame gives the size; the canvas is scaled to fit it whole. */
  .cv { position: relative; width: 100%; height: 100%; overflow: hidden; container-type: size; }
  .cv__canvas {
    position: absolute; left: 50%; top: 50%;
    width: 1200px; height: 525px;
    transform: translate(-50%, -50%) scale(var(--cv-k, 1));
  }

  .cv__wires { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .cv__wires path { fill: none; stroke: var(--cover-wire); stroke-width: 1.25; stroke-dasharray: 3 4; }
  .cv__wires circle { fill: var(--cover-wire); }

  /* The phone: the coded screen at its own size, scaled into a bezel. */
  .cv__phone {
    position: absolute; left: 487px; top: 22px; width: 226px; height: 481px;
    padding: var(--cover-bezel-w); border-radius: var(--radius-cover-device);
    background: var(--device-bezel); box-shadow: var(--device-shadow);
  }
  .cv__screen {
    position: relative; width: 100%; height: 100%; overflow: hidden;
    border-radius: var(--radius-cover-screen); background: var(--pp-surface);
  }
  .cv__draw {
    width: var(--pp-screen-w); height: var(--pp-screen-h); position: relative; overflow: hidden;
    display: flex; flex-direction: column;
    transform: scale(calc(218 / 288)); transform-origin: 0 0;
    color: var(--pp-ink); font-family: var(--pp-sans); font-size: var(--pp-text-md); font-weight: var(--pp-w-reg); line-height: 1.35;
  }
  .cv__scr { position: relative; flex: 1; overflow: hidden; }
  .sb { position: relative; z-index: 3; background: var(--pp-surface); display: flex; justify-content: space-between; align-items: center; padding: 14px 24px 4px; font-size: var(--pp-text-sm); font-weight: var(--pp-w-med); flex: none; }
  .sb__icons { display: flex; gap: 4px; align-items: flex-end; }
  .sb__icons i { display: block; width: 4px; height: 6px; background: var(--pp-ink); border-radius: 1px; }
  .sb__icons i:nth-child(2) { height: 8px; }
  .sb__icons i:nth-child(3) { width: 18px; height: 8px; border-radius: 2px; }

  /* The pieces: whole components from the redesign, in the app's type. */
  .cv__piece {
    position: absolute; padding: 16px 18px;
    background: var(--pp-surface); border-radius: var(--pp-radius-tile);
    box-shadow: var(--cover-piece-shadow);
    color: var(--pp-ink); font-family: var(--pp-sans); font-weight: var(--pp-w-reg); line-height: 1.4;
  }
  .cv__piece--on { box-shadow: 0 0 0 1.5px var(--pp-illo-deep), var(--cover-piece-shadow); }
  .cv__piece p { margin: 0; }
  .pc-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .pc-row--start { justify-content: flex-start; }
  .pc-t { font-size: var(--cover-type-title); font-weight: var(--pp-w-med); }
  .pc-d { margin-top: 6px !important; font-size: var(--cover-type-body); color: var(--pp-ink-dim); }
  .pc-link { margin-top: 10px !important; font-size: var(--cover-type-body); font-weight: var(--pp-w-med); color: var(--pp-blue); }
  .pc-switch { flex: none; position: relative; width: 44px; height: 24px; border-radius: var(--radius-pill); background: var(--pp-line); }
  .pc-switch i { position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; border-radius: 50%; background: var(--pp-surface); box-shadow: var(--pp-tile-shadow); }
  .pc-check { flex: none; position: relative; width: 20px; height: 20px; border-radius: 4px; background: var(--pp-illo-deep); }
  .pc-check::after { content: ''; position: absolute; left: 7px; top: 3px; width: 5px; height: 10px; border: solid var(--pp-surface); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .pc-switch--on { background: var(--pp-illo-deep); }
  .pc-switch--on i { left: 22px; }
  .pc-k { margin-top: 10px !important; font-size: var(--cover-type-badge); color: var(--pp-ink-dim); }
  .pc-anniv .pc-k { margin-top: 0 !important; }
  .pc-d--ink { color: var(--pp-ink); }
  .pc-q { margin-top: 4px !important; font-size: var(--cover-type-title); line-height: 1.3; padding-right: 70px; }
  .cv__piece:not(.pc-anniv) .pc-q { padding-right: 0; }
  .pc-anniv__art { position: absolute; top: 10px; right: 10px; }
  .pc-btns { display: flex; gap: 8px; margin-top: 14px; }
  .pc-btn { flex: 1; text-align: center; padding: 9px 8px; border-radius: var(--radius-pill); box-shadow: inset 0 0 0 1.5px var(--pp-illo-deep); color: var(--pp-illo-deep); font-size: var(--cover-type-body); font-weight: var(--pp-w-med); }
  .pc-btn--p { background: var(--pp-illo-deep); color: var(--pp-surface); }
  .pc-learn { padding: 0; overflow: hidden; }
  .pc-learn img { display: block; width: 100%; height: auto; }
  .pc-learn__t { padding: 12px 14px 14px; font-size: var(--cover-type-body); }
  .pc-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; font-size: var(--cover-type-body); }
  .pc-steps li { position: relative; padding-left: 26px; }
  .pc-steps li span { display: block; color: var(--pp-ink-dim); margin-top: 2px; }
  .pc-steps li::before { content: ''; position: absolute; left: 0; top: 3px; width: 14px; height: 14px; border-radius: 50%; box-shadow: inset 0 0 0 2px var(--pp-line); }
  .pc-steps li.is-done::before { background: var(--pp-blue); box-shadow: none; }
  .pc-steps li.is-now::before { box-shadow: inset 0 0 0 4px var(--pp-blue); }
  .pc-new { padding: 2px 8px; border-radius: 4px; background: var(--pp-new); color: var(--pp-surface); font-size: var(--cover-type-badge); font-weight: var(--pp-w-med); }

  /* The notes: numbered, in the site's mono, the decision each piece shows. */
  .cv__note {
    position: absolute; margin: 0; display: flex; gap: 10px; align-items: baseline;
    padding: 7px 12px; border-radius: var(--radius-pill);
    background: var(--cover-note-bg); color: var(--cover-note-ink);
    font-family: var(--font-mono); font-size: var(--cover-type-note); letter-spacing: 0.02em; white-space: nowrap;
  }
  .cv__note b { font-weight: inherit; color: var(--cover-note-num); }

  /* Too small to read the notes: the phone alone, centred. */
  @container (max-width: 560px) {
    .cv__wires, .cv__note, .cv__piece { display: none; }
  }
</style>

<script>
  // Scale the canvas to fit its frame whole, never cropped. Narrow, only
  // the phone shows, so fit that instead.
  document.querySelectorAll<HTMLElement>('[data-cv]').forEach((el) => {
    const canvas = el.querySelector<HTMLElement>('.cv__canvas')!;
    const fit = () => {
      const w = el.clientWidth, h = el.clientHeight;
      const narrow = w <= 560;
      const k = narrow ? h / 525 : Math.min(w / 1200, h / 525);
      canvas.style.setProperty('--cv-k', String(k));
    };
    new ResizeObserver(fit).observe(el);
    fit();
  });
</script>
