---
/* Dock — the site's primary navigation and its preferences, recreated from
   cali.so's dock by explicit request ("exact icons and exact menu style").
   Same shape, sizes, icons, hover tint, sliding active dot and tooltips;
   the one change is orientation:
     ≥1200px  vertical, fixed under the name in the top-left (the name box
              is the home link, so the dock starts at Work)
     <1200px  horizontal, fixed bottom-centre, the reference's own placement
   Items: Work, About, Playground, Contact, then Preferences, which opens a
   small panel with two switches:
     Theme  Light / System / Dark. System follows the OS setting (the site
            already did this until a visitor picked one); Light and Dark are
            remembered, the same `mode` key Base.astro reads before paint.
     Sound  On / Off, the site's UI sounds (src/scripts/sound.ts).
   The glass (a translucent page-coloured fill with a backdrop blur) is the
   reference's own, requested as an exact match; it sits on its own layer so
   the panel and tooltips aren't caught inside a blurred box.

   Colour follows whichever band is behind the dock (same probe-and-swap as
   Nav.astro), so it reads on the terracotta hero and the pale bands alike.
   Tooltips show on hover (fine pointers) and on keyboard focus; the panel
   closes on Escape or a click elsewhere and hands focus back to its button.
   Its switches are radio groups: arrow keys move the choice, as with native
   radios. Reduced motion drops every transition; nothing here moves on its
   own. */
interface Props { path: string; }
const { path } = Astro.props;
const items = [
  { label: 'Work', href: '/work', icon: 'work' },
  { label: 'About', href: '/about', icon: 'about' },
  { label: 'Playground', href: '/playground', icon: 'playground' },
  { label: 'Contact', href: '/contact', icon: 'contact' },
];
const activeIndex = items.findIndex((i) => path === i.href || path.startsWith(`${i.href}/`));
---
<nav class="dock" aria-label="Primary" data-dock data-theme="charcoal" data-active={activeIndex}>
  <span class="dock__glass" aria-hidden="true"></span>
  <span class="dock__dot" aria-hidden="true" data-dock-dot></span>

  {items.map((item, i) => (
    <a class="dock__item" href={item.href} aria-label={item.label} aria-current={i === activeIndex ? 'page' : undefined} data-dock-item>
      {item.icon === 'work' && (
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" stroke="currentColor"><path d="M10.487 14.584L12.255 12.816"/><path d="M8.46698 12.563L11.798 15.894C12.189 16.285 12.822 16.285 13.212 15.894L15.894 13.212C16.285 12.821 16.285 12.188 15.894 11.798L14.685 10.589"/><path fill-rule="evenodd" clip-rule="evenodd" d="M14.1711 6.85988L11.1411 3.8299L3.766 11.205C2.82897 12.142 2.263 15.6755 2.25119 15.7498C2.2504 15.7499 2.25 15.75 2.25 15.75L2.251 15.751C2.251 15.751 2.25106 15.7506 2.25119 15.7498C2.32546 15.738 5.85897 15.172 6.796 14.235L14.1711 6.85988Z" fill="currentColor" fill-opacity="0.3" stroke="none"/><path d="M9.53299 5.43699L6.20199 2.10599C5.81099 1.71499 5.17799 1.71499 4.78799 2.10599L2.10599 4.78799C1.71499 5.17899 1.71499 5.81199 2.10599 6.20199L5.43699 9.53299"/><path d="M3.41599 7.513L5.18398 5.745"/><path d="M2.25 15.75C2.25 15.75 5.849 15.182 6.796 14.235C7.743 13.288 15.373 5.65799 15.373 5.65799C16.21 4.82099 16.21 3.46399 15.373 2.62799C14.536 1.79099 13.179 1.79099 12.343 2.62799C12.343 2.62799 4.713 10.258 3.766 11.205C2.819 12.152 2.251 15.751 2.251 15.751L2.25 15.75Z"/><path d="M11.121 3.84802L14.152 6.87902"/></g></svg>
      )}
      {item.icon === 'about' && (
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" stroke="currentColor"><circle cx="5.5" cy="5.5" r="2.75" fill="currentColor" opacity=".3" stroke-width="0"/><line x1="15.25" y1="11.75" x2="2.75" y2="11.75"/><line x1="9.25" y1="15.25" x2="2.75" y2="15.25"/><circle cx="5.5" cy="5.5" r="2.75"/></g></svg>
      )}
      {item.icon === 'playground' && (
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" stroke="currentColor"><path fill-rule="evenodd" clip-rule="evenodd" d="M3.99214 14.75H3.75C2.64543 14.75 1.75 13.8546 1.75 12.75V5.25C1.75 4.14543 2.64543 3.25 3.75 3.25H14.25C15.3546 3.25 16.25 4.14543 16.25 5.25V12.4833L12.664 8.914C11.883 8.133 10.617 8.133 9.83599 8.914L3.99214 14.75Z" fill="currentColor" fill-opacity="0.3" stroke="none"/><path d="M4 14.75L9.836 8.914C10.617 8.133 11.883 8.133 12.664 8.914L16.25 12.5"/><path d="M3.75 14.75L14.25 14.75C15.3546 14.75 16.25 13.8546 16.25 12.75V5.25C16.25 4.14543 15.3546 3.25 14.25 3.25L3.75 3.25C2.64543 3.25 1.75 4.14543 1.75 5.25L1.75 12.75C1.75 13.8546 2.64543 14.75 3.75 14.75Z"/><path d="M5.75 8.5C6.44036 8.5 7 7.94036 7 7.25C7 6.55964 6.44036 6 5.75 6C5.05964 6 4.5 6.55964 4.5 7.25C4.5 7.94036 5.05964 8.5 5.75 8.5Z" fill="currentColor" stroke="none"/><path d="M9 1.5V3.25"/><path d="M5.25 1.5V3.25"/><path d="M12.75 1.5V3.25"/></g></svg>
      )}
      {item.icon === 'contact' && (
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" stroke="currentColor"><path d="M9 2.25c-3.728 0-6.75 2.798-6.75 6.25 0 1.603.652 3.064 1.723 4.17L3.25 15.75l3.397-1.13c.74.278 1.533.43 2.353.43 3.728 0 6.75-2.798 6.75-6.25S12.728 2.25 9 2.25Z" fill="currentColor" opacity=".3" stroke-width="0" stroke="none"/><path d="M9 2.25c-3.728 0-6.75 2.798-6.75 6.25 0 1.603.652 3.064 1.723 4.17L3.25 15.75l3.397-1.13c.74.278 1.533.43 2.353.43 3.728 0 6.75-2.798 6.75-6.25S12.728 2.25 9 2.25Z"/><path d="M9 5.75V8.5l1.875 1.375"/></g></svg>
      )}
      <span class="dock__tip" aria-hidden="true">{item.label}</span>
    </a>
  ))}

  <span class="dock__rule" aria-hidden="true"></span>

  <div class="dock__prefs">
    <button type="button" class="dock__item" aria-label="Preferences" aria-haspopup="dialog" aria-expanded="false" aria-controls="dock-prefs" data-prefs-btn>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" stroke="currentColor"><path d="M11 7.5C12.2426 7.5 13.25 6.49264 13.25 5.25C13.25 4.00736 12.2426 3 11 3C9.75736 3 8.75 4.00736 8.75 5.25C8.75 6.49264 9.75736 7.5 11 7.5Z" fill="currentColor" fill-opacity="0.3" stroke="none"/><path d="M7 15C8.24264 15 9.25 13.9926 9.25 12.75C9.25 11.5074 8.24264 10.5 7 10.5C5.75736 10.5 4.75 11.5074 4.75 12.75C4.75 13.9926 5.75736 15 7 15Z" fill="currentColor" fill-opacity="0.3" stroke="none"/><path d="M13.25 5.25H16.25"/><path d="M1.75 5.25H8.75"/><path d="M11 7.5C12.2426 7.5 13.25 6.49264 13.25 5.25C13.25 4.00736 12.2426 3 11 3C9.75736 3 8.75 4.00736 8.75 5.25C8.75 6.49264 9.75736 7.5 11 7.5Z"/><path d="M4.75 12.75H1.75"/><path d="M16.25 12.75H9.25"/><path d="M7 15C8.24264 15 9.25 13.9926 9.25 12.75C9.25 11.5074 8.24264 10.5 7 10.5C5.75736 10.5 4.75 11.5074 4.75 12.75C4.75 13.9926 5.75736 15 7 15Z"/></g></svg>
      <span class="dock__tip" aria-hidden="true">Preferences</span>
    </button>

    <div class="prefs" id="dock-prefs" role="dialog" aria-label="Preferences" hidden data-prefs>
      <div class="prefs__row">
        <span class="prefs__label" id="prefs-theme">Theme</span>
        <div class="seg" role="radiogroup" aria-labelledby="prefs-theme" data-seg="theme">
          <span class="seg__thumb" aria-hidden="true"></span>
          <button type="button" class="seg__opt" role="radio" aria-checked="false" aria-label="Light" data-value="light">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          </button>
          <button type="button" class="seg__opt" role="radio" aria-checked="false" aria-label="System" data-value="system">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
          </button>
          <button type="button" class="seg__opt" role="radio" aria-checked="false" aria-label="Dark" data-value="dark">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/></svg>
          </button>
        </div>
      </div>
      <div class="prefs__row">
        <span class="prefs__label" id="prefs-sound">Sound</span>
        <div class="seg" role="radiogroup" aria-labelledby="prefs-sound" data-seg="sound">
          <span class="seg__thumb" aria-hidden="true"></span>
          <button type="button" class="seg__opt" role="radio" aria-checked="false" aria-label="On" data-value="on">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"/><path d="M16 9a5 5 0 0 1 0 6"/><path d="M19.364 18.364a9 9 0 0 0 0-12.728"/></svg>
          </button>
          <button type="button" class="seg__opt" role="radio" aria-checked="false" aria-label="Off" data-value="off">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"/><line x1="22" x2="16" y1="9" y2="15"/><line x1="16" x2="22" y1="9" y2="15"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  .dock {
    position: fixed;
    z-index: 55;
    display: flex;
    align-items: center;
    gap: var(--dock-gap);
    padding: var(--dock-pad);
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--bg) 68%, transparent);
    box-shadow: 0 0 0 1px var(--dock-ring), var(--dock-shadow);
    color: var(--fg);
    /* Horizontal, bottom-centre: the reference's own placement. */
    left: 50%;
    bottom: max(var(--dock-edge), env(safe-area-inset-bottom, 0px));
    height: var(--dock-size);
    transform: translateX(-50%);
    --dock-ring: color-mix(in oklab, var(--fg) 12%, transparent);
    --dock-hover: color-mix(in oklab, var(--fg) 6%, transparent);
  }
  /* Vertical, under the name. Top is the name box's bottom edge plus the
     same breathing room the old menu had. */
  @media (min-width: 1200px) {
    .dock {
      flex-direction: column;
      left: var(--idmark-inset);
      top: calc(var(--idmark-inset) + var(--idmark-h) + var(--dock-offset));
      bottom: auto;
      width: var(--dock-size);
      height: auto;
      transform: none;
    }
  }
  @media (min-width: 2400px) {
    .dock { top: calc(var(--idmark-inset) + var(--idmark-h) * var(--idmark-scale-xl) + var(--dock-offset)); }
  }

  .dock__glass {
    position: absolute; inset: 0;
    border-radius: inherit;
    pointer-events: none;
    backdrop-filter: blur(12px) saturate(1.25);
    -webkit-backdrop-filter: blur(12px) saturate(1.25);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.2), inset 0 -1px 0 rgb(255 255 255 / 0.06);
  }

  .dock__item {
    position: relative;
    display: grid; place-items: center;
    width: var(--dock-item); height: var(--dock-item);
    padding: 0; border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--fg-dim);
    cursor: pointer;
    transition: color var(--dur-dock) var(--ease-swift), background-color var(--dur-dock) var(--ease-swift);
  }
  .dock__item svg { display: block; }
  @media (hover: hover) and (pointer: fine) {
    .dock__item:hover { color: var(--fg); background: var(--dock-hover); }
  }
  .dock__item:active { transform: scale(0.97); }
  .dock__item[aria-current='page'],
  .dock__item[aria-expanded='true'] { color: var(--fg); }

  .dock__rule {
    flex: none;
    width: 1px; height: var(--dock-rule);
    margin: 0 0.125rem;
    background: color-mix(in oklab, var(--fg) 16%, transparent);
  }
  @media (min-width: 1200px) {
    .dock__rule { width: var(--dock-rule); height: 1px; margin: 0.125rem 0; }
  }

  /* The "you are here" dot: under the icon on the horizontal dock, beside
     it on the vertical one. Placed by the script; slides when it moves. */
  .dock__dot {
    position: absolute;
    left: 0; bottom: 8px;
    width: var(--dock-dot); height: var(--dock-dot);
    border-radius: var(--radius-pill);
    background: var(--fg);
    opacity: 0;
    pointer-events: none;
    z-index: 1;
    transform: translate(calc(var(--dot-x, 0px) - 50%), 0);
    transition: transform var(--dur-dock-dot) var(--ease-swift), opacity var(--dur-dock) ease;
  }
  @media (min-width: 1200px) {
    .dock__dot {
      left: auto; right: 8px; top: 0; bottom: auto;
      transform: translate(0, calc(var(--dot-y, 0px) - 50%));
    }
  }
  .dock__dot[data-ready] { opacity: 1; }
  .dock__dot[data-instant] { transition: none; }

  /* Tooltips: above the horizontal dock, to the right of the vertical one. */
  .dock__tip {
    position: absolute;
    left: 50%; bottom: calc(100% + var(--dock-tip-offset));
    transform: translateX(-50%) scale(0.95);
    padding: 0.25rem 0.5rem;
    border-radius: calc(var(--radius-panel) * 0.45);
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 0 0 1px var(--dock-ring), var(--dock-tip-shadow);
    font-family: var(--font-display);
    font-size: var(--step-dock-tip);
    line-height: 1.3;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-dock) var(--ease-swift), transform var(--dur-dock) var(--ease-swift);
  }
  @media (min-width: 1200px) {
    .dock__tip {
      left: calc(100% + var(--dock-tip-offset)); bottom: auto; top: 50%;
      transform: translateY(-50%) scale(0.95);
      transform-origin: left center;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .dock__item:hover .dock__tip { opacity: 1; transform: translateX(-50%) scale(1); }
  }
  .dock__item:focus-visible .dock__tip { opacity: 1; transform: translateX(-50%) scale(1); }
  @media (min-width: 1200px) {
    .dock__item:focus-visible .dock__tip { transform: translateY(-50%) scale(1); }
  }
  @media (min-width: 1200px) and (hover: hover) and (pointer: fine) {
    .dock__item:hover .dock__tip { transform: translateY(-50%) scale(1); }
  }
  .dock__item[aria-expanded='true'] .dock__tip { opacity: 0; }

  /* --- Preferences panel ---------------------------------------------- */
  .dock__prefs { position: relative; }
  /* Above the horizontal dock, flush with its right end (the button is the
     last item, so centring on it would run off a phone screen). */
  .prefs {
    position: absolute;
    bottom: calc(100% + var(--dock-tip-offset) + var(--dock-pad));
    right: calc(var(--dock-pad) * -1);
    min-width: max-content;
    padding: 0.5rem;
    border-radius: var(--radius-panel);
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 0 0 1px var(--dock-ring), var(--panel-shadow);
    transform-origin: bottom right;
    transition: opacity var(--dur-dock) var(--ease-swift), transform var(--dur-dock) var(--ease-swift);
  }
  @media (min-width: 1200px) {
    .prefs {
      bottom: calc(var(--dock-pad) * -1);
      left: calc(100% + var(--dock-pad) + var(--dock-tip-offset));
      right: auto;
      transform-origin: left bottom;
    }
  }
  .prefs[hidden] { display: block; visibility: hidden; opacity: 0; transform: scale(0.95); pointer-events: none; }

  .prefs__row {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1.25rem;
    height: 2.5rem;
  }
  .prefs__row + .prefs__row { margin-top: 0.25rem; }
  .prefs__label {
    font-family: var(--font-display);
    font-size: var(--step-dock-tip);
    color: var(--fg-dim);
  }

  .seg {
    position: relative;
    display: inline-flex; align-items: center;
    gap: 0.125rem;
    padding: 0.25rem;
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--fg) 7%, var(--bg));
  }
  .seg__thumb {
    position: absolute;
    top: 0.25rem; left: 0;
    height: 2rem; width: 0;
    border-radius: var(--radius-pill);
    background: var(--bg);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--fg) 8%, transparent), 0 1px 1px -0.5px rgb(0 0 0 / 0.05), 0 3px 3px -1.5px rgb(0 0 0 / 0.05), 0 6px 6px -3px rgb(0 0 0 / 0.05);
    transform: translateX(var(--thumb-x, 0px));
    transition: transform var(--dur-dock-dot) var(--ease-swift), width var(--dur-dock-dot) var(--ease-swift);
  }
  .seg__thumb[data-instant] { transition: none; }
  .seg__opt {
    position: relative; z-index: 1;
    display: grid; place-items: center;
    min-width: 2.5rem; height: 2rem;
    padding: 0 0.5rem;
    border: 0; border-radius: var(--radius-pill);
    background: transparent;
    color: var(--fg-dim);
    cursor: pointer;
    transition: color var(--dur-dock) var(--ease-swift);
  }
  .seg__opt[aria-checked='true'] { color: var(--fg); }
  @media (hover: hover) and (pointer: fine) {
    .seg__opt:hover { color: var(--fg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock__item, .dock__dot, .dock__tip, .prefs, .seg__thumb, .seg__opt { transition: none; }
  }
</style>

<script>
  import { isSoundOn, setSoundOn, onSoundChange, playTick, playTap, playThemeTone } from '../scripts/sound';

  const dock = document.querySelector<HTMLElement>('[data-dock]');
  if (dock) {
    const items = [...dock.querySelectorAll<HTMLAnchorElement>('[data-dock-item]')];
    const dot = dock.querySelector<HTMLElement>('[data-dock-dot]')!;
    const vertical = matchMedia('(min-width: 1200px)');

    // --- Active dot -------------------------------------------------------
    // Sits on the current page's item; slides to an item as it's clicked,
    // so the move is visible for the moment before the next page paints.
    let active = Number(dock.dataset.active);
    const placeDot = (i: number, instant = false) => {
      const el = items[i];
      if (!el) { dot.removeAttribute('data-ready'); return; }
      if (instant) dot.setAttribute('data-instant', '');
      dot.style.setProperty('--dot-x', `${el.offsetLeft + el.offsetWidth / 2}px`);
      dot.style.setProperty('--dot-y', `${el.offsetTop + el.offsetHeight / 2}px`);
      dot.setAttribute('data-ready', '');
      if (instant) requestAnimationFrame(() => requestAnimationFrame(() => dot.removeAttribute('data-instant')));
    };
    placeDot(active, true);
    vertical.addEventListener('change', () => placeDot(active, true));
    addEventListener('pageshow', (e) => { if (e.persisted) placeDot(Number(dock.dataset.active), true); });

    items.forEach((el, i) => {
      el.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') playTick(); });
      el.addEventListener('click', () => { playTap(); active = i; placeDot(i); });
    });

    // --- Band follow ------------------------------------------------------
    // Same probe-and-swap as Nav.astro, keyed to the dock's own centre.
    const bands = [...document.querySelectorAll<HTMLElement>('[data-themeband]')];
    const pick = () => {
      if (!bands.length) return;
      const r = dock.getBoundingClientRect();
      const probe = r.top + r.height / 2;
      let current = bands[0];
      for (const b of bands) {
        const br = b.getBoundingClientRect();
        if (br.top <= probe && br.bottom > probe) current = b;
      }
      const t = current.getAttribute('data-theme');
      if (t && dock.getAttribute('data-theme') !== t) dock.setAttribute('data-theme', t);
      for (const v of ['--bg', '--fg', '--fg-dim']) {
        const val = current.style.getPropertyValue(v);
        if (val) dock.style.setProperty(v, val);
        else dock.style.removeProperty(v);
      }
    };
    pick();
    addEventListener('scroll', pick, { passive: true });
    addEventListener('resize', pick);
    addEventListener('theme:changed', pick);

    // --- Preferences panel ------------------------------------------------
    const btn = dock.querySelector<HTMLButtonElement>('[data-prefs-btn]')!;
    const panel = dock.querySelector<HTMLElement>('[data-prefs]')!;
    btn.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') playTick(); });

    const segs = new Map<string, { opts: HTMLButtonElement[]; thumb: HTMLElement }>();
    panel.querySelectorAll<HTMLElement>('[data-seg]').forEach((seg) => {
      segs.set(seg.dataset.seg!, {
        opts: [...seg.querySelectorAll<HTMLButtonElement>('[role="radio"]')],
        thumb: seg.querySelector<HTMLElement>('.seg__thumb')!,
      });
    });

    const paintSeg = (name: string, value: string, instant = false) => {
      const s = segs.get(name)!;
      s.opts.forEach((o) => {
        const on = o.dataset.value === value;
        o.setAttribute('aria-checked', String(on));
        o.tabIndex = on ? 0 : -1;
      });
      const sel = s.opts.find((o) => o.dataset.value === value)!;
      if (instant) s.thumb.setAttribute('data-instant', '');
      s.thumb.style.setProperty('--thumb-x', `${sel.offsetLeft}px`);
      s.thumb.style.width = `${sel.offsetWidth}px`;
      if (instant) requestAnimationFrame(() => requestAnimationFrame(() => s.thumb.removeAttribute('data-instant')));
    };

    // Theme. `mode` in localStorage is 'day' | 'night' when chosen, absent
    // for System; Base.astro resolves it before first paint either way.
    const root = document.documentElement;
    const osDark = matchMedia('(prefers-color-scheme: dark)');
    const storedMode = () => { try { return localStorage.getItem('mode'); } catch { return null; } };
    const themePref = () => { const m = storedMode(); return m === 'night' ? 'dark' : m === 'day' ? 'light' : 'system'; };
    const applyMode = (next: 'day' | 'night') => {
      if (root.dataset.mode === next) return;
      playThemeTone(next === 'night');
      root.dataset.mode = next;
      dispatchEvent(new Event('theme:changed'));
    };
    const setTheme = (pref: string) => {
      try {
        if (pref === 'system') localStorage.removeItem('mode');
        else localStorage.setItem('mode', pref === 'dark' ? 'night' : 'day');
      } catch {}
      applyMode(pref === 'dark' ? 'night' : pref === 'light' ? 'day' : osDark.matches ? 'night' : 'day');
      paintSeg('theme', pref);
    };
    osDark.addEventListener('change', () => { if (themePref() === 'system') applyMode(osDark.matches ? 'night' : 'day'); });

    const choose = (name: string, value: string) => {
      if (name === 'theme') setTheme(value);
      else setSoundOn(value === 'on');
    };
    onSoundChange((on) => paintSeg('sound', on ? 'on' : 'off'));

    segs.forEach((s, name) => {
      s.opts.forEach((o, i) => {
        o.addEventListener('click', () => choose(name, o.dataset.value!));
        o.addEventListener('keydown', (e) => {
          const step = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
          if (!step) return;
          e.preventDefault();
          const next = s.opts[(i + step + s.opts.length) % s.opts.length];
          choose(name, next.dataset.value!);
          next.focus();
        });
      });
    });

    const open = () => {
      panel.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
      paintSeg('theme', themePref(), true);
      paintSeg('sound', isSoundOn() ? 'on' : 'off', true);
      panel.querySelector<HTMLElement>('[role="radio"][tabindex="0"]')?.focus({ preventScroll: true });
    };
    const close = (restoreFocus: boolean) => {
      if (panel.hidden) return;
      panel.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
      if (restoreFocus) btn.focus();
    };
    btn.addEventListener('click', () => { playTap(); panel.hidden ? open() : close(false); });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) close(true); });
    addEventListener('pointerdown', (e) => {
      if (!panel.hidden && !panel.contains(e.target as Node) && !btn.contains(e.target as Node)) close(false);
    });
  }
</script>
