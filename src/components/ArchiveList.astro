---
/* ArchiveList.astro — the archive tier on /work. Earlier projects as text
   rows rather than tiles, each with a preview image that appears on hover.

   Based on the reference's archive list (allierho.com/projects-grid, the
   block under ARCHIVE), with one deliberate difference:

   1. The preview FLOATS OVER the list. It does not sit inside the row and it
      does not push the type sideways — the rows never move.
   2. It FOLLOWS THE CURSOR, easing toward the pointer rather than snapping,
      and hangs BELOW it, left edge on the pointer (flipping left or up near
      the window's edges).
      This is the departure: the reference pins its preview to the centre of
      the list. Anupama asked for cursor-following, so the position comes from
      the pointer, which is the one thing here that needs script.
   3. The link label is hidden until hover (as the reference does, at
      opacity 0), so the right-hand column stays quiet.
   4. On hover the project name lightens a little (--hover-fade), after
      danield.design's archive: it confirms which row the pointer is on.
      Only the name — fading the whole row would fade the preview too, and
      the grey meta would drop below AA.

   The follow is a hand-rolled rAF that parks the moment the chase settles —
   same shape as CursorTrail, and the reason no animation library is needed.
   Two details keep it honest:
   - The chase is SEEDED on entry (`seeded`), so the preview appears where the
     pointer already is. Without that, moving from the first row to the last
     makes it swoop down the page on every re-entry.
   - Under prefers-reduced-motion the easing drops to 1 — the preview still
     tracks the pointer, because that is the visitor's own hand, but nothing
     moves on its own. Same call the playground makes for drag.

   `pointer-events: none` is load-bearing: the preview sits under the cursor
   by definition, and without it the image would swallow the hover that
   summons it and the whole thing would flicker.

   Keyboard gets the reveal via :focus-visible; with no pointer to follow it
   parks over the focused row. Hover-capable pointers only
   (@media (hover: hover)), and only above 900px where there is room.

   The hairlines are harp strings (on request, 2026-11-18, "A · Catch" of
   experiments/archive-strings/). A line catches the pointer as it
   crosses, bends with it (up to --string-pull), then slips off and rings
   back to straight, a damped spring on the shared frame loop. Its reason:
   the rows already sound like a harp; the line you cross now answers
   your hand the way a string would. Fine hover pointers with motion
   allowed only — the script marks the list `data-strung`, hides the CSS
   borders and draws each line as an SVG path in the --rule colour. With
   no script, on touch or under reduced motion the borders stay as they
   were. Focus gives the row's top line a small ring.

   Sound (page sound on only, sound.ts): each line plays its harp note as
   it lets go, louder the further it was pulled, newest highest; focus
   plays the row's top line. Without strings (reduced motion) the row
   plucks as the pointer enters it, as before. */
interface ArchiveItem {
  name: string; tag: string; year: string;
  href?: string; image?: string;
}
interface Props { items: readonly ArchiveItem[] }
const { items } = Astro.props;
---
<ul class="arch" data-arch>
  {items.map((a) => {
    const Row = a.href ? 'a' : 'div';
    /* These point at /work/<slug> now. Only an off-site href gets a new tab
       (and the rel that makes one safe) — forcing one for our own pages
       would strand the visitor in a second window. */
    const external = !!a.href && /^https?:/.test(a.href);
    const linkAttrs = a.href
      ? { href: a.href, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
      : {};
    return (
      <li class="arch__item">
        <Row class="arch__row" {...linkAttrs}>
          {a.image && (
            /* aria-hidden: the row already says the project's name, so the
               preview is decoration and would only double the announcement. */
            <span class="arch__preview" aria-hidden="true">
              <img src={a.image} alt="" loading="lazy" decoding="async" width="760" height="460" />
            </span>
          )}
          <span class="arch__name u-accent">{a.name}</span>
          {/* One cell, not two: "Website design, 2021" reads as a single
              caption the way the reference sets it. */}
          <span class="arch__meta u-label">{a.tag}, {a.year}</span>
          {a.href && <span class="arch__cta u-label">View<span class="arch__sr"> {a.name}</span> &rarr;</span>}
        </Row>
      </li>
    );
  })}
</ul>

<style>
  .arch {
    /* Smaller than the reference's ~26% of the viewport (on request), at the
       previews' own 760×460. */
    --preview-w: clamp(12rem, 20vw, 17rem);
    /* Space between the pointer and the preview's top edge — clears the
       arrow cursor's own height. */
    --preview-gap: 1.25rem;
    position: relative;   /* the previews position against this, and only this */
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .arch__item { border-top: 1px solid var(--rule); }
  .arch__item:last-child { border-bottom: 1px solid var(--rule); }

  /* The strings (see the header). The borders stay in layout, only
     turned transparent, so nothing shifts when the SVGs take over. Each
     SVG sits centred on its boundary, tall enough for the bow, under the
     preview and never taking the pointer. The SVGs are made by the script,
     so they carry no scope hash: :global(). */
  .arch[data-strung] .arch__item { position: relative; border-color: transparent; }
  .arch :global(.arch__string) {
    position: absolute;
    left: 0;
    /* Half its height above the padding box, so the path's y=39.5 lands
       on the 1px top border (which sits just above the padding box). */
    top: -2.5rem;
    width: 100%;
    height: 5rem;
    overflow: visible;
    pointer-events: none;
  }
  .arch :global(.arch__string--end) { top: calc(100% - 2.5rem + 1px); }   /* on the bottom border */
  .arch :global(.arch__string path) { fill: none; stroke: var(--rule); stroke-width: 1; }

  .arch__row {
    display: flex;
    align-items: center;
    gap: var(--col-gap);
    padding-block: 1.15rem;
    color: var(--fg);
    text-decoration: none;
  }

  /* Hover-capable pointers only — see the header note. */
  .arch__preview { display: none; }
  @media (hover: hover) {
    .arch__preview {
      display: block;
      /* Absolute against the list, NOT fixed. `position: fixed` resolves
         against the nearest transformed ancestor, and this list sits inside
         a <Reveal> that holds a translate until it lands — so a fixed
         preview lands hundreds of pixels off for the 900ms the reveal is
         running. --px/--py are therefore list-local, converted from the
         pointer in the script below. */
      position: absolute;
      left: 0;
      top: 0;
      width: var(--preview-w);
      aspect-ratio: 760 / 460;
      overflow: hidden;
      /* Under the nav (50), so a preview chased up the page never covers it. */
      z-index: 20;
      /* The preview lives under the cursor — without this it would swallow
         the hover that summons it. */
      pointer-events: none;
      opacity: 0;
      /* Hangs below the pointer like a tooltip, its left edge on the
         pointer, so the cursor stays on the row it is previewing rather than
         behind the image. Near the window's right edge the script sets
         data-flip-x and the preview's right edge sits on the pointer instead;
         near the bottom, data-flip-y lifts it above the pointer. Positional
         only — nothing transitions here, or the entrance would fight the
         follow. */
      --ox: 0%;
      --oy: var(--preview-gap);
      transform: translate3d(
        calc(var(--px, 0px) + var(--ox)),
        calc(var(--py, 0px) + var(--oy)),
        0
      );
      transition: opacity var(--dur-hover) var(--ease-out);
    }
    .arch[data-flip-x] .arch__preview { --ox: -100%; }
    .arch[data-flip-y] .arch__preview { --oy: calc(-100% - var(--preview-gap) / 2); }
    .arch__row:hover .arch__preview,
    .arch__row:focus-visible .arch__preview { opacity: 1; }
  }
  /* max-width: none is load-bearing — Tailwind's preflight sets
     `img { max-width: 100% }`, which fights the fixed width above. */
  .arch__preview img {
    width: 100%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Family, italic and weight come from the global .u-accent role on the
     span — only the size and the flex behaviour belong to this component.
     Nudged up from --step-h3: Instrument Serif runs optically smaller than
     General Sans, so matching sizes would leave the names reading lighter
     than the row they title. */
  .arch__name {
    flex: 1 1 auto;
    min-width: 0;
    font-size: calc(var(--step-title) * 1.15);
    line-height: 1.1;
    transition: opacity var(--dur-hover-fade) var(--ease-fade);
  }
  .arch__row:hover .arch__name,
  .arch__row:focus-visible .arch__name { opacity: var(--hover-fade); }
  .arch__meta { flex: 0 0 16rem; color: var(--fg-dim); }
  .arch__cta { flex: 0 0 auto; color: var(--accent-text); }
  .arch__row:hover .arch__cta { text-decoration: underline; text-underline-offset: 4px; }

  /* The reference keeps the link column quiet until you are on the row. Only
     where there is a hover to reveal it — on touch it must stay visible, or
     it would never appear at all. */
  @media (hover: hover) {
    .arch__cta {
      opacity: 0;
      transition: opacity var(--dur-hover) var(--ease-out);
    }
    .arch__row:hover .arch__cta,
    .arch__row:focus-visible .arch__cta { opacity: 1; }
  }

  /* "View" alone repeats nine times in a screen-reader's link list; the
     project name rides along for it and stays off-screen visually. */
  .arch__sr {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    /* Needs a hover pointer AND room. A narrow desktop window has the first
       but not the second: the rows wrap there, and a preview wider than the
       row it floats over stops reading as a preview. */
    .arch__preview { display: none !important; }
    .arch__cta { opacity: 1; }
    .arch__row {
      flex-wrap: wrap;
      gap: 0.35rem 1rem;
      min-height: 0;
      padding-block: 1.15rem;
    }
    .arch__name { flex: 1 1 100%; }
    .arch__meta { flex: 0 0 auto; }
    .arch__cta { flex: 0 0 auto; margin-left: auto; }
  }
</style>

<script>
  import { playPluck } from '../scripts/sound';
  import { wake } from '../scripts/frame-loop';

  /* The hairlines as strings: one per boundary (the top of each row, then
     the last row's bottom), each an SVG path drawn as a quadratic whose
     control point sits under the pointer, so the bow peaks where it was
     pulled. Held, a line follows the pointer; let go, it rings as a
     damped spring (--string-hz, --string-damping), time-based so 60Hz
     and 120Hz ring alike. */
  function strings(list: HTMLElement, rows: HTMLElement[]) {
    const css = getComputedStyle(list);
    const num = (name: string, fallback: number) => parseFloat(css.getPropertyValue(name)) || fallback;
    const PULL = num('--string-pull', 14);           // px
    const W = 2 * Math.PI * num('--string-hz', 9);   // rad/s
    const ZETA = num('--string-damping', 0.07);
    const MID = 40;                                  // the path's resting y, in the SVG's own px
    const NS = 'http://www.w3.org/2000/svg';

    type Str = { item: HTMLElement; end: boolean; path: SVGPathElement;
      y: number; a: number; v: number; x: number; held: boolean; side: number };
    const all: Str[] = [];
    const add = (item: HTMLElement, end: boolean) => {
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('class', end ? 'arch__string arch__string--end' : 'arch__string');
      svg.setAttribute('aria-hidden', 'true');
      const path = document.createElementNS(NS, 'path');
      svg.append(path);
      item.append(svg);
      all.push({ item, end, path, y: 0, a: 0, v: 0, x: 0.5, held: false, side: 0 });
    };
    const items = rows.map((r) => r.closest<HTMLElement>('.arch__item')!);
    items.forEach((it, i) => { add(it, false); if (i === items.length - 1) add(it, true); });
    list.toggleAttribute('data-strung', true);

    let w = 0;
    // List-local, from offsets: the list is the items' offsetParent, and
    // offsets ignore the <Reveal> transform the list may sit in.
    const measure = () => {
      w = list.clientWidth;
      all.forEach((s) => { s.y = s.item.offsetTop + (s.end ? s.item.offsetHeight : 0); });
      all.forEach(draw);
    };
    const draw = (s: Str) => {
      // -0.5: the 1px stroke covers the border's own pixel row, crisp.
      const y = MID - 0.5;
      s.path.setAttribute('d', `M0 ${y} Q ${(s.x * w).toFixed(1)} ${(y + s.a * 2).toFixed(1)} ${w} ${y}`);
    };
    measure();
    addEventListener('resize', measure, { passive: true });

    const step = (dt: number) => {
      const t = dt / 1000, n = 4, h = t / n;
      let busy = false;
      for (const s of all) {
        if (s.held) { draw(s); busy = true; continue; }
        if (!s.a && !s.v) continue;
        for (let i = 0; i < n; i++) { s.v += (-W * W * s.a - 2 * ZETA * W * s.v) * h; s.a += s.v * h; }
        if (Math.abs(s.a) < 0.05 && Math.abs(s.v) < 0.5) { s.a = 0; s.v = 0; }
        draw(s);
        busy = true;
      }
      return busy;
    };
    const kick = () => wake(step);

    const release = (s: Str, i: number, quiet: boolean) => {
      if (!s.held) return;
      s.held = false;
      s.v = 0;
      if (!quiet) playPluck(i, all.length, Math.abs(s.a) / PULL);
      kick();
    };

    let py: number | null = null;
    list.addEventListener('pointerenter', measure);
    list.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const box = list.getBoundingClientRect();
      const x = Math.min(0.95, Math.max(0.05, (e.clientX - box.left) / (w || 1)));
      const y = e.clientY - box.top;
      if (py !== null) {
        all.forEach((s, i) => {
          const was = py! - s.y, is = y - s.y;
          if (s.held) {
            // Back over the line: it lets go without a sound.
            if (Math.sign(is) === -s.side) { s.a = 0; release(s, i, true); return; }
            s.x = x;
            if (Math.abs(is) > PULL) { s.a = PULL * s.side; release(s, i, false); }
            else { s.a = is; kick(); }
            return;
          }
          if ((was < 0 && is >= 0) || (was > 0 && is <= 0)) {
            s.held = true;
            s.side = Math.sign(y - py!) || 1;
            s.x = x;
            s.a = is;
            s.v = 0;
            kick();
          }
        });
      }
      py = y;
    }, { passive: true });
    list.addEventListener('pointerleave', () => {
      all.forEach((s, i) => release(s, i, false));
      py = null;
    });

    // Focus: a small ring on the row's top line, and its note.
    rows.forEach((row, i) => row.addEventListener('focus', () => {
      const s = all[i];
      playPluck(i, all.length, 0.4);
      s.x = 0.5;
      s.v += 0.2 * PULL * W;
      kick();
    }));
  }

  /* Eases the preview toward the pointer. See the header comment for why this
     is hand-rolled rather than a library, and why it seeds on entry. */
  document.querySelectorAll<HTMLElement>('[data-arch]').forEach((list) => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    // Chased in viewport coordinates — stable while the page scrolls — and
    // converted to list-local only at the moment of writing.
    let tx = 0, ty = 0, cx = 0, cy = 0;
    let raf = 0, seeded = false, inside = false;
    const preview = list.querySelector<HTMLElement>('.arch__preview');
    // --preview-gap is in rem; the flip test needs it in pixels.
    const gap = () => parseFloat(getComputedStyle(list).getPropertyValue('--preview-gap'))
      * parseFloat(getComputedStyle(document.documentElement).fontSize);

    const frame = () => {
      raf = 0;
      // 1 under reduced motion: the preview still tracks the pointer (that is
      // the visitor's own hand) but never travels on its own.
      const k = reduce.matches ? 1 : 0.18;
      cx += (tx - cx) * k;
      cy += (ty - cy) * k;
      const box = list.getBoundingClientRect();
      list.style.setProperty('--px', `${(cx - box.left).toFixed(1)}px`);
      list.style.setProperty('--py', `${(cy - box.top).toFixed(1)}px`);
      // Below and right of the pointer unless that would run past the
      // window's right or bottom edge.
      if (preview) {
        list.toggleAttribute('data-flip-x', cx + preview.offsetWidth > innerWidth);
        list.toggleAttribute('data-flip-y', cy + gap() + preview.offsetHeight > innerHeight);
      }
      // Park once the chase has caught up; the next move restarts it.
      if (Math.abs(tx - cx) > 0.5 || Math.abs(ty - cy) > 0.5) {
        raf = requestAnimationFrame(frame);
      }
    };

    const queue = () => { if (!raf) raf = requestAnimationFrame(frame); };

    list.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;   // touch and pen never hover
      inside = true;
      tx = e.clientX;
      ty = e.clientY;
      // First move after entering: start AT the pointer, so re-entering the
      // list lower down doesn't drag the preview across the page.
      if (!seeded) { cx = tx; cy = ty; seeded = true; }
      queue();
    }, { passive: true });

    list.addEventListener('pointerleave', () => { seeded = false; inside = false; });

    // The strings (header comment). Fine hover pointers with motion allowed
    // get SVG lines that catch the pointer; everyone else keeps the borders,
    // and the row plucks as the pointer enters it, as before.
    const rows = [...list.querySelectorAll<HTMLElement>('.arch__row')];
    const strung = matchMedia('(hover: hover) and (pointer: fine)').matches && !reduce.matches;
    if (!strung) {
      rows.forEach((row, i) => {
        row.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') playPluck(i, rows.length); });
        row.addEventListener('focus', () => playPluck(i, rows.length));
      });
    } else {
      strings(list, rows);
    }

    // Scrolling with the pointer parked moves the list under a stationary
    // cursor, so the local offset changes even though nothing was moved.
    addEventListener('scroll', () => { if (inside) queue(); }, { passive: true });

    // Keyboard has no pointer to chase, so focus parks the preview under the
    // row itself rather than wherever the mouse was last left.
    list.addEventListener('focusin', (e) => {
      const row = (e.target as HTMLElement).closest<HTMLElement>('.arch__row');
      if (!row) return;
      const r = row.getBoundingClientRect();
      tx = cx = r.left + r.width / 2;
      ty = cy = r.bottom - gap();   // preview opens just under the row
      seeded = true;
      queue();
    });
  });
</script>
