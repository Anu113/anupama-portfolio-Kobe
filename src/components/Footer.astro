---
/* The footer closing every page, in `Base.astro` below <main>.
   Four rows, top to bottom (restructured after emmiwu.com/figma's footer —
   a short personal sign-off leading, not a bio paragraph, with the contact
   and site links as two plain columns underneath it):
     1. the sign-off — one big line carrying the ask ("Let's talk"), reading
        `site.ask` so it never drifts from the wording every other band uses
     2. two columns, "Get in touch" and "Site" — how to reach her, where
        else to go
     3. a meta line — her city and a live clock in HER timezone (mono, the
        system's one use of it), the credit, the copyright
   Type and colour follow allierho.com's footer: the sign-off is the serif
   heading in the accent, everything under it 12px uppercase labels. (A
   full-bleed name wordmark with a variable-weight cursor effect used to
   close this; removed with the move to that system — its typeface is
   gone, and it was decoration the reference doesn't carry.) */
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer id="site-footer" data-theme="bone" data-themeband class="foot">
  <div class="foot__top u-shell">
    <p class="foot__signoff">
      Building something complicated? <em>Let's talk</em> — I'm looking for a {site.ask}.
    </p>
  </div>

  <div class="foot__cols u-shell">
    <div class="foot__contact">
      <p class="u-label foot__eyebrow">Get in touch</p>
      <ul class="foot__links">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.linkedin} rel="me">LinkedIn<span class="foot__mark-nudge" aria-hidden="true">↗</span></a></li>
      </ul>
    </div>

    <div class="foot__sitenav">
      <p class="u-label foot__eyebrow">Site</p>
      <ul class="foot__links">
        <li><a href="/work">Work</a></li>
        <li><a href="/about">About me</a></li>
        <li><a href="/playground">Playground</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
  </div>

  <div class="foot__meta u-shell">
    <p class="foot__where u-label">
      <span>{site.location}</span>
      <!-- Filled by the script below; the dashes are what a visitor with no
           JS sees, which is honest about a clock that can't tick. -->
      <span class="foot__clock" data-clock={site.timezone}>--:--:--</span>
    </p>

    <p class="foot__credit u-label">
      Designed + coded with <span class="foot__heart" aria-hidden="true">♡</span
      ><span class="foot__vh">love</span> by {site.name.split(' ')[0]}
    </p>

    <p class="foot__legal u-label">
      © {year}, {site.name}<br />All rights reserved
    </p>
  </div>

</footer>

<style>
  .foot {
    background: var(--bg);
    color: var(--fg);
    border-top: 1px solid var(--rule);
    /* The playground paints its heading on a fixed layer at z-index 0.
       A static footer would be painted under it — stay positioned. */
    position: relative;
    z-index: 1;
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  /* --- Row 1: the sign-off -------------------------------------------- */
  .foot__signoff {
    margin: 0;
    max-width: 34ch;
    font-family: var(--font-serif); font-weight: var(--weight-serif);
    font-size: var(--step-heading);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-serif);
    color: var(--accent-text);
  }
  .foot__signoff em { font-style: italic; }

  /* --- Row 2: get in touch | site -------------------------------------- */
  .foot__cols {
    display: flex;
    gap: clamp(3rem, 8vw, 6rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  .foot__eyebrow { margin: 0 0 1rem; }

  .foot__links { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .foot__links a {
    font-family: var(--font-sans);
    font-size: var(--step-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-weight: var(--weight-sans);
    color: var(--fg);
    text-decoration: none;
    /* Underline sits off the baseline rather than through the descenders,
       and it's the hover target as well — colour alone never carries it. */
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.2em;
    transition: color var(--dur-hover) var(--ease-out);
  }
  .foot__links a:hover { color: var(--accent-text); }
  /* Same micro-nudge as .link-ext (global.css) on the LinkedIn row's
     external-link glyph — kept local rather than swapped for .link-ext
     itself, since this row's own underline-as-hover-target treatment
     (above) already does the job .link-ext's dotted underline does
     elsewhere. */
  .foot__mark-nudge {
    display: inline-block;
    opacity: 0.6;
    margin-inline-start: 0.15em;
    transition: opacity var(--dur-micro) var(--ease-out),
                transform var(--dur-micro-move) var(--ease-out);
  }
  .foot__links a:hover .foot__mark-nudge {
    opacity: 0.95;
    transform: translate(1.5px, -1.5px);
  }
  @media (prefers-reduced-motion: reduce) {
    .foot__mark-nudge { transition: none; }
  }

  /* --- Row 3: city + clock, credit, copyright ------------------------ */
  .foot__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem clamp(2rem, 5vw, 4rem);
    padding-top: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .foot__where,
  .foot__credit,
  .foot__legal { margin: 0; }

  .foot__where {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    color: var(--fg);
  }
  /* Tabular figures so the seconds don't shuffle the line every tick. */
  .foot__clock { font-family: var(--font-mono); font-weight: var(--weight-mono); font-variant-numeric: tabular-nums; letter-spacing: 0; text-transform: none; }

  .foot__legal { text-align: right; }

  .foot__heart {
    display: inline-block;
    padding-inline: 0.15em;
    transform: translateY(0.05em);
    font-size: 1.1em;
  }

  .foot__vh {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .foot__signoff { max-width: none; }
    .foot__cols { flex-direction: column; gap: 2.5rem; }
    .foot__meta { flex-direction: column; align-items: flex-start; }
    .foot__legal { text-align: left; }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('.foot__clock');
  if (el?.dataset.clock) {
    try {
      const fmt = new Intl.DateTimeFormat('en-GB', {
        timeZone: el.dataset.clock,
        hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
      });
      const tick = () => { el.textContent = fmt.format(new Date()); };
      tick();
      setInterval(tick, 1000);
    } catch (e) { /* leave the placeholder in place */ }
  }
</script>
