---
/* PrivacyArt.astro — the `illos` block on the PayPal Privacy case: her
   illustrations and what they mean ("F" of experiments/privacy-process,
   on request, 2026-11-26; she drew them). First the research finding
   that set their direction (the door, and what people told us), then
   each illustration with what it means and where it's used, the colours
   taken off them, and her credit.

   The door picture is the symbol from testing, not one of hers (its
   source file is a stock image), so the credit names her four and not
   the door. Grounds and swatches are PayPal's colours from the art:
   they belong to the work (PRIVACY PROCESS in tokens.css). Static. */
interface Props {
  door: { src: string; alt: string; finding: string; heard: string; meant: string };
  items: { name: string; src: string; alt: string; means: string; where: string; blue?: boolean }[];
  palette: { name: string; token: string }[];
  credit: string;
}
const { door, items, palette, credit } = Astro.props;
---
<div class="art">
  <div class="art__door">
    <img src={door.src} alt={door.alt} width="570" height="630" loading="lazy" decoding="async" />
    <div>
      <p class="u-label-mono">Where it started</p>
      <p class="art__finding">{door.finding}</p>
      <dl class="art__pair">
        <div><dt class="u-label-mono">What we heard</dt><dd>{door.heard}</dd></div>
        <div><dt class="u-label-mono">What that meant for the art</dt><dd>{door.meant}</dd></div>
      </dl>
    </div>
  </div>

  <ul class="art__specs">
    {items.map((it) => (
      <li class="art__spec">
        <div class:list={['art__tile', it.blue && 'art__tile--blue']}>
          <img src={it.src} alt={it.alt} loading="lazy" decoding="async" />
        </div>
        <h3 class="art__name">{it.name}</h3>
        <dl class="art__dl">
          <dt class="u-label-mono">Means</dt><dd>{it.means}</dd>
          <dt class="u-label-mono">Where</dt><dd>{it.where}</dd>
        </dl>
      </li>
    ))}
  </ul>

  <div class="art__foot">
    <ul class="art__palette" aria-label="Colours from the art">
      {palette.map((p) => (
        <li><i style={`background: var(${p.token});`} aria-hidden="true"></i>{p.name}</li>
      ))}
    </ul>
    <p class="art__credit">{credit}</p>
  </div>
</div>

<style>
  .art { display: grid; row-gap: var(--case-block-gap); }

  .art__door {
    display: grid; grid-template-columns: var(--illo-door-w) minmax(0, 1fr);
    gap: var(--col-gap); align-items: center;
  }
  .art__door img { width: 100%; height: auto; display: block; }
  .art__finding {
    margin: 0.6rem 0 1.25rem; max-width: 30ch;
    font-family: var(--font-serif); font-weight: var(--weight-serif);
    font-size: var(--step-title); line-height: 1.35; letter-spacing: var(--tracking-serif);
    text-wrap: balance;
  }
  .art__pair { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--col-gap); }
  .art__pair dd { margin: 0.4rem 0 0; font-size: var(--step-small); line-height: 1.6; color: var(--fg-dim); }

  .art__specs {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--case-card-gap);
  }
  .art__tile {
    height: var(--illo-art-h); border-radius: var(--radius-case-card);
    background: var(--illo-ground); display: grid; place-items: center; overflow: hidden;
  }
  .art__tile img { max-width: 72%; max-height: 72%; display: block; mix-blend-mode: multiply; }
  .art__tile--blue { background: var(--illo-ground-blue); }
  .art__tile--blue img { mix-blend-mode: normal; max-width: 100%; max-height: 100%; }
  .art__name {
    margin: 1rem 0 0.5rem; font-family: var(--font-sans); font-weight: var(--weight-sans);
    font-size: var(--step-small); line-height: 1.4;
  }
  .art__dl { margin: 0; display: grid; gap: 0.3rem; }
  .art__dl dd { margin: 0 0 0.5rem; font-size: var(--step-copy); line-height: 1.6; color: var(--fg-dim); text-wrap: pretty; }

  .art__foot { display: grid; row-gap: 0.75rem; }
  .art__palette { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .art__palette li { display: flex; align-items: center; gap: 0.5rem; font: 400 0.625rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--fg-dim); }
  .art__palette i { width: var(--illo-swatch); height: var(--illo-swatch); border-radius: 0.375rem; display: block; }
  .art__credit { margin: 0; font-size: var(--step-small); color: var(--fg); }

  @media (max-width: 900px) {
    .art__specs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .art__door, .art__pair { grid-template-columns: 1fr; }
    .art__door img { max-width: var(--illo-door-w); }
  }
</style>
