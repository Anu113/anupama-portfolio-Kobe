---
/* Preloader — the first-paint loader, "Pixel blinds" (on request,
   2026-11-18, "F · Pixel blinds" of experiments/curtain-pixel/, after
   mariavasilyeva.com's cover; it replaced Moss pushing a curtain, which
   is parked in PreloaderMoss.astro). On the home page only, every time
   it's opened or refreshed (on request); not when arriving from another
   page of the site, and not on back/forward.

   What it shows: first the whole screen is flat ink (no shadow, a hard
   edge) over the hero. After a beat the ink is cut into horizontal slats
   that pull back to the left in whole-pixel steps, top first, each
   trailing one loose pixel, so the hero shows through from the top
   down. One pixel is the last to go, on the word "pixel" in the hero
   sentence; it holds a moment, then pops. Then the layer is gone and
   the hero is simply there.
   Its reason: the one screen with nothing else to show; it opens on her
   sentence and says its last word, "pixel", once, without a word.

   Pacing: it never runs faster than its own pace (--dur-preloader-blinds),
   and never further than the page has loaded — its real (non-lazy)
   images and the hero portrait's first frame (`hero-scrub:ready`; not the 4.6MB sheet, which loads after). While the
   page is still loading, the slats clear only in proportion, and the last
   pixel (or the last slats) waits until it's ready. After
   --dur-preloader-max it lets go regardless and the page shows as it is.

   It always lands on the hero (on request, 2026-11-17): the page is put
   at the top and held there under the curtain (no scroll restoration on
   a refresh, no scrolling until it ends).

   It never holds the page hostage: any deliberate key, click, tap or
   real scroll (after --dur-preloader-skip-grace, and never a shortcut
   like Cmd+R) ends it at once: the layer fades. A CSS failsafe hides it
   after --dur-preloader-failsafe even if the script never runs; when it
   ends it removes itself from the DOM. Decorative, so aria-hidden: screen
   readers get the page straight away. Under reduced motion there are no
   slats: the ink simply fades when the page is in.

   Values: PRELOADER in tokens.css. */
const pages = ['/'];
---
<script is:inline define:vars={{ pages }}>
  (() => {
    // Stands down while the whole site is behind the passcode
    // (SiteGate.astro): the frosted page is the first screen then.
    if ('siteLock' in document.documentElement.dataset) return;
    try {
      const p = location.pathname.replace(/index\.html$/, '').replace(/(.)\/$/, '$1');
      if (!pages.includes(p)) return;
      // Every time the home page is opened or refreshed, on request; not
      // when arriving from another page of the site (a click on her name
      // from a case study), and not on back/forward.
      const nav = performance.getEntriesByType('navigation')[0];
      const type = nav ? nav.type : 'navigate';
      let internal = false;
      try { internal = !!document.referrer && new URL(document.referrer).origin === location.origin; } catch (e) {}
      if (type === 'back_forward' || (type === 'navigate' && internal)) return;
    } catch (e) {
      return;
    }
    document.documentElement.dataset.preloader = '';
    window.__preloaderT0 = performance.now();
    // It always hands over to the hero (on request, 2026-11-17): a refresh
    // mid-page doesn't restore the old scroll under the curtain.
    // Held there (data-preloader-hold) until it ends, or the failsafe's
    // time is up even if the script below never runs.
    const html = document.documentElement;
    try { history.scrollRestoration = 'manual'; } catch (e) {}
    html.dataset.preloaderHold = '';
    const keep = () => { if ('preloaderHold' in html.dataset) { if (scrollY) scrollTo(0, 0); } else removeEventListener('scroll', keep); };
    addEventListener('scroll', keep, { passive: true });
    scrollTo(0, 0);
    setTimeout(() => { delete html.dataset.preloaderHold; }, 20000);
  })();
</script>
<div class="preloader" aria-hidden="true" data-preloader-root>
  <canvas class="preloader__canvas" data-preloader-canvas></canvas>
</div>

<script>
  import { cssMs } from '../scripts/css-time';

  declare global {
    interface Window { __preloaderT0?: number }
  }

  const html = document.documentElement;
  const num = (name: string, fallback: number) => {
    const v = parseFloat(getComputedStyle(html).getPropertyValue(name));
    return Number.isFinite(v) ? v : fallback;
  };
  const clamp = (t: number) => Math.min(1, Math.max(0, t));
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const hash = (n: number) => { const s = Math.sin(n * 127.1) * 43758.5453; return s - Math.floor(s); };

  // Where the word "pixel" sits in the hero sentence, on screen (its centre).
  function wordCentre(): [number, number] | null {
    const h1 = document.querySelector('.hero__line');
    if (!h1) return null;
    const walker = document.createTreeWalker(h1, NodeFilter.SHOW_TEXT);
    for (let n = walker.nextNode(); n; n = walker.nextNode()) {
      const at = (n.textContent ?? '').lastIndexOf('pixel');
      if (at < 0) continue;
      const range = document.createRange();
      range.setStart(n, at);
      range.setEnd(n, at + 5);
      const r = range.getBoundingClientRect();
      if (!r.width || r.bottom < 0 || r.top > innerHeight) return null;
      return [r.left + r.width / 2, r.top + r.height / 2];
    }
    return null;
  }

  function run(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-preloader-canvas]')!;
    const cx = canvas.getContext('2d');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const inputs = ['pointerdown', 'keydown', 'wheel', 'touchstart'] as const;
    const t0 = window.__preloaderT0 ?? performance.now();
    const maxDur = cssMs('--dur-preloader-max', 2500);
    let ended = false;
    let raf = 0;

    const finish = () => {
      cancelAnimationFrame(raf);
      inputs.forEach((e) => removeEventListener(e, skip, true));
      removeEventListener('resize', size);
      root.remove();
      delete html.dataset.preloader;
      delete html.dataset.preloaderHold;
      try { history.scrollRestoration = 'auto'; } catch (e) {}
      // Heavy work held back for the hand-over (the hero's 96 frames) may go now.
      dispatchEvent(new CustomEvent('preloader:done'));
    };

    // ---- progress: the images the page asks for straight away, and the hero sprite
    const imgs = [...document.images].filter((i) => i.loading !== 'lazy');
    let loaded = imgs.filter((i) => i.complete).length;
    imgs.forEach((i) => {
      if (i.complete) return;
      const done = () => { loaded++; };
      i.addEventListener('load', done, { once: true });
      i.addEventListener('error', done, { once: true });
    });
    const heroWaits = !!document.querySelector('.hero-scrub')
      && !matchMedia('(prefers-reduced-motion: reduce), (hover: none), (pointer: coarse)').matches;
    let heroIn = 'heroReady' in html.dataset;
    addEventListener('hero-scrub:ready', () => { heroIn = true; }, { once: true });
    const progress = () => {
      if (performance.now() - t0 >= maxDur) return 1;
      const parts = [imgs.length ? loaded / imgs.length : 1];
      if (heroWaits) parts.push(heroIn ? 1 : 0);
      return parts.reduce((a, b) => a + b, 0) / parts.length;
    };

    const end = (fast: boolean) => {
      if (ended) return;
      ended = true;
      cancelAnimationFrame(raf);
      inputs.forEach((e) => removeEventListener(e, skip, true));
      scrollTo(0, 0);   // whatever happened under the curtain, it lands on the hero
      delete html.dataset.preloaderHold;
      if (!fast) { finish(); return; }
      // skipped, reduced motion, or no canvas: the layer fades
      root.classList.add('is-fading');
      setTimeout(finish, (reduce ? cssMs('--dur-preloader-fade', 450) : cssMs('--dur-preloader-skip', 600)) + 50);
    };

    // Only a deliberate input skips it (see the header).
    const grace = cssMs('--dur-preloader-skip-grace', 1200);
    const skip = (e: Event) => {
      if (performance.now() - t0 < grace) return;
      if (e instanceof KeyboardEvent && (e.metaKey || e.ctrlKey || e.altKey || ['Meta', 'Control', 'Alt', 'Shift'].includes(e.key))) return;
      if (e instanceof WheelEvent && Math.abs(e.deltaX) + Math.abs(e.deltaY) < 4) return;
      end(true);
    };
    inputs.forEach((e) => addEventListener(e, skip, { capture: true, passive: true }));

    // ---- reduced motion (or no canvas): no slats; the ink fades once the page is in
    if (reduce || !cx) {
      const wait = () => { if (ended) return; if (progress() >= 1) end(true); else raf = requestAnimationFrame(wait); };
      raf = requestAnimationFrame(wait);
      return;
    }

    // ---- the pixel blinds
    const ink = getComputedStyle(root).backgroundColor;
    const across = num('--preloader-pixels', 28);
    const waitAt = num('--preloader-wait-at', 0.8);
    const holdMs = cssMs('--dur-preloader-black', 400);
    const durMs = cssMs('--dur-preloader-blinds', 1600);
    const GRID_END = 0.78;   // the slats are gone by here; the last pixel has the rest
    let W = 0, H = 0, S = 0, slats = 0, word: [number, number] | null = null;
    function size() {
      const d = Math.min(2, devicePixelRatio || 1);
      W = innerWidth; H = innerHeight;
      canvas.width = Math.round(W * d); canvas.height = Math.round(H * d);
      cx!.setTransform(d, 0, 0, d, 0, 0);
      S = Math.max(W, H * 1.4) / across;   // the pixel: not too fine on a tall phone
      slats = Math.max(4, Math.round(H / S / 2));
      word = wordCentre();
    }
    size();
    addEventListener('resize', size);

    const draw = (p: number) => {
      cx.clearRect(0, 0, W, H);
      cx.fillStyle = ink;
      const g = p / GRID_END, sh = H / slats;
      for (let i = 0; i < slats; i++) {
        const q = clamp((g - (i / slats) * 0.45) / 0.55);
        const len = Math.ceil((W * (1 - ease(q))) / S) * S;   // pulls back in whole pixels
        if (len > 0) cx.fillRect(0, i * sh, len, sh + 0.5);
        if (q > 0 && q < 1) cx.fillRect(len + S * 0.25, i * sh + (hash(i) > 0.5 ? 0 : sh - S * 0.5), S * 0.5, S * 0.5);
      }
      // the last pixel, on the word: holds, then a small pop and it's gone
      if (word) {
        const k = clamp((p - 0.88) / 0.12);
        const s = S * (1 - k * k) * (1 + 0.25 * Math.sin(k * Math.PI));
        if (s > 0) cx.fillRect(word[0] - s / 2, word[1] - s / 2, s, s);
      }
    };

    let p = 0, last = 0;
    const tick = (now: number) => {
      if (ended) return;
      const dt = last ? Math.min(100, now - last) : 0;
      last = now;
      const l = progress();
      // never further than the page has loaded; the last part waits for ready
      const target = l >= 1 ? 1 : Math.min(waitAt, l * waitAt);
      if (now - t0 >= holdMs) p = Math.min(target, p + dt / durMs);
      draw(p);
      root.classList.add('is-drawn');   // the canvas carries the ink from here
      if (p >= 1) { end(false); return; }
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
  }

  const root = document.querySelector<HTMLElement>('[data-preloader-root]');
  if (root && 'preloader' in html.dataset) run(root);
  else root?.remove(); // not this visit: nothing left in the DOM
</script>

<style>
  .preloader { display: none; }

  /* The page holds still at the hero under the curtain, so a skip by
     wheel or key never lands somewhere else. */
  :global(:root[data-preloader-hold]) { overflow: hidden; }

  /* Flat ink from the first paint, before the script runs; the canvas
     takes over once it has drawn (is-drawn). */
  :global(:root[data-preloader]) .preloader {
    display: block;
    position: fixed;
    inset: 0;
    z-index: var(--z-loader);
    overflow: hidden;
    background: var(--preloader-curtain);
    /* Failsafe: if the script never runs, get out of the way anyway. */
    animation: preloader-failsafe 0s var(--dur-preloader-failsafe) forwards;
  }
  :global(:root[data-preloader]) .preloader:global(.is-drawn) { background: transparent; }

  .preloader__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Skipped or reduced motion: the layer fades. */
  :global(:root[data-preloader]) .preloader:global(.is-fading) {
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-preloader-skip) var(--ease-fade);
  }
  @media (prefers-reduced-motion: reduce) {
    .preloader__canvas { display: none; }
    :global(:root[data-preloader]) .preloader:global(.is-fading) { transition-duration: var(--dur-preloader-fade); }
  }

  @keyframes preloader-failsafe {
    to { opacity: 0; visibility: hidden; }
  }
</style>
