---
/* PixelSky.astro — the hero's pixel sky, after andreas.vision. Chosen on
   request from a round of mocks (experiments/hero-pixels, option D3,
   "cloud edge"). UX reason: the sentence ends on "the last stubborn
   pixel", and the first thing the page does on scroll is fold its whole
   sky into one pixel-sized tile beside that word — the claim, acted out
   once, then out of the way of the work.

   At rest: terracotta pixel clouds along the top and bottom of the hero
   (and a little up the sides), drifting slowly, clearing around the
   words and the nav so text never sits on colour. The tones are the
   accent mixed into the ground in four steps (--sky-mix-1…4), with a
   checker dither between each step and the next, so it re-inks in dark
   mode by itself.

   On scroll: over the first --sky-fold of the viewport's height, the
   sky's region shrinks from the whole hero to the tile after "pixel"
   (the [data-pixel-sky-tile] span in the headline). The tile is
   full-stop sized and stands in for the sentence's full stop (T1 of the
   small-tile mocks, on request): it lands as a crisp 2x2 block
   (--sky-tile-cells). The real full stop stays in the DOM for screen
   readers ([data-pixel-sky-stop], visually hidden) and shows instead of
   the tile under reduced motion. There's no pin: the
   hero scrolls normally and the fold rides along. The region's edge is
   never a rectangle — it's ragged and drifting like the clouds, and
   tightens as the region gets smaller. While it passes over the
   headline it's held to the lighter tones; it reaches full strength
   only as it lands in the tile, where the edge relaxes away so the
   tile ends square, and keeps drifting.

   Cells change in steps, so it draws at ~15fps, and only while the hero
   is on screen. Under prefers-reduced-motion: one still frame of the
   sky at rest, no drift, no fold, the tile hidden and the full stop
   back. Decorative:
   aria-hidden, no pointer events.

   Usage: <PixelSky /> as the first child of the hero band (which must
   be position: relative), plus <span data-pixel-sky-tile aria-hidden="true"></span><span data-pixel-sky-stop>.</span>
   where the tile should land, and data-sky-clear on any hero element
   the sky should keep off. Values under PIXEL SKY in tokens.css. */
---

<canvas class="pixel-sky" aria-hidden="true" data-pixel-sky></canvas>

<style>
  .pixel-sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
  :global([data-pixel-sky-tile]) {
    display: inline-block;
    width: var(--sky-tile);
    height: var(--sky-tile);
    margin-inline-start: var(--sky-tile-gap);
    vertical-align: var(--sky-tile-drop);
  }
  /* The full stop the tile replaces: read out, not shown. */
  :global([data-pixel-sky-stop]) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    :global([data-pixel-sky-tile]) { display: none; }
    :global([data-pixel-sky-stop]) { position: static; width: auto; height: auto; overflow: visible; clip-path: none; }
  }
</style>

<script>
  const cv = document.querySelector<HTMLCanvasElement>('[data-pixel-sky]');
  const host = cv?.parentElement;
  const tile = document.querySelector<HTMLElement>('[data-pixel-sky-tile]');
  const ctx = cv?.getContext('2d');

  if (cv && host && ctx) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const FRAME_MS = 66;        // ~15fps: cells change in steps anyway
    const DRIFT_X = 0.05, DRIFT_Y = 0.018;   // noise units per second
    const CHUNK = 0.5;          // share of 2x2 groups drawn as one block

    // --- noise ------------------------------------------------------------
    const hash = (x: number, y: number) => {
      let h = Math.imul(x | 0, 374761393) + Math.imul(y | 0, 668265263);
      h = Math.imul(h ^ (h >>> 13), 1274126177);
      return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
    };
    const vnoise = (x: number, y: number) => {
      const xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi;
      const u = xf * xf * (3 - 2 * xf), v = yf * yf * (3 - 2 * yf);
      const a = hash(xi, yi), b = hash(xi + 1, yi), c = hash(xi, yi + 1), d = hash(xi + 1, yi + 1);
      return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
    };
    const fbm = (x: number, y: number) =>
      vnoise(x, y) * 0.55 + vnoise(x * 2.1 + 5.2, y * 2.1 + 1.3) * 0.3 + vnoise(x * 4.3 + 9.1, y * 4.3 + 3.7) * 0.15;
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const sstep = (a: number, b: number, x: number) => { const t = clamp((x - a) / (b - a)); return t * t * (3 - 2 * t); };
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    // --- tokens -------------------------------------------------------------
    // Lengths are resolved through a probe so clamp()/em values work.
    const probe = document.createElement('span');
    probe.style.cssText = 'position:absolute;visibility:hidden;pointer-events:none;';
    host.appendChild(probe);
    const len = (name: string) => { probe.style.width = `var(${name})`; return probe.offsetWidth; };
    const rgb = (c: string) => {
      c = c.trim();
      if (c.startsWith('#')) {
        const h = c.length === 4 ? c.slice(1).split('').map((x) => x + x).join('') : c.slice(1);
        return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16));
      }
      return (c.match(/[\d.]+/g) || ['0', '0', '0']).slice(0, 3).map(Number);
    };
    const mix = (a: number[], b: number[], t: number) => `rgb(${a.map((v, i) => Math.round(v * t + b[i] * (1 - t))).join(',')})`;

    let tones: string[] = [], cell = 20, scalePx = 360, fold = 0.4, tileCells = 2, ground: number[] = [];
    const pats = new Map<string, CanvasPattern>();
    const readTokens = () => {
      const s = getComputedStyle(host);
      const acc = rgb(s.getPropertyValue('--accent'));
      ground = rgb(s.getPropertyValue('--bg'));
      tones = [1, 2, 3, 4].map((i) => mix(acc, ground, parseFloat(s.getPropertyValue(`--sky-mix-${i}`)) || 0));
      cell = len('--sky-cell') || 20;
      scalePx = len('--sky-scale') || 360;
      fold = parseFloat(s.getPropertyValue('--sky-fold')) || 0.4;
      tileCells = parseFloat(s.getPropertyValue('--sky-tile-cells')) || 2;
      pats.clear();
    };

    // --- geometry -------------------------------------------------------------
    let W = 0, H = 0, dpr = 1, cvTop = 0;
    type Box = { x0: number; y0: number; x1: number; y1: number };
    let clears: Box[] = [];
    let tileBox = { x: 0, y: 0, w: 0, h: 0 };
    const measure = () => {
      const r = cv.getBoundingClientRect();
      dpr = Math.min(2, devicePixelRatio || 1);
      W = r.width; H = r.height;
      cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
      pats.clear();
      // Page-relative: the canvas scrolls with the page, the nav is fixed
      // (measured as it sits at the top of the page).
      const top = r.top + scrollY;
      cvTop = top;
      const box = (el: Element, fixed = false): Box => {
        const b = el.getBoundingClientRect(), off = fixed ? 0 : scrollY;
        return { x0: b.left - r.left, y0: b.top + off - top, x1: b.right - r.left, y1: b.bottom + off - top };
      };
      clears = [
        ...[...host.querySelectorAll('[data-sky-clear]')].map((el) => box(el)),
        ...[...document.querySelectorAll('.nav__mark, .nav__right')].map((el) => box(el, true)),
      ];
      if (tile) { const t = box(tile); tileBox = { x: t.x0, y: t.y0, w: t.x1 - t.x0, h: t.y1 - t.y0 }; }
    };
    const PAD = 18, SOFT = 70;
    const clearAt = (x: number, y: number) => {
      let c = 0;
      for (const b of clears) {
        const dx = Math.max(b.x0 - PAD - x, 0, x - b.x1 - PAD), dy = Math.max(b.y0 - PAD - y, 0, y - b.y1 - PAD);
        c = Math.max(c, 1 - sstep(0, SOFT, Math.hypot(dx, dy)));
      }
      return c;
    };
    // Signed distance to a rounded rectangle at (0,0,w,h); negative inside.
    const rrSDF = (x: number, y: number, w: number, h: number, r: number) => {
      r = Math.min(r, w / 2, h / 2);
      const qx = Math.abs(x - w / 2) - (w / 2 - r), qy = Math.abs(y - h / 2) - (h / 2 - r);
      return Math.hypot(Math.max(qx, 0), Math.max(qy, 0)) + Math.min(Math.max(qx, qy), 0) - r;
    };

    // --- drawing ----------------------------------------------------------------
    // Levels: 0 empty; then per tone a dithered step (checker of the tone
    // below and this one) and a solid step.
    const pat = (lo: string | null, hi: string) => {
      const k = `${lo}|${hi}`;
      const hit = pats.get(k); if (hit) return hit;
      const s = Math.max(1, Math.round(dpr * 1.5)), c = document.createElement('canvas');
      c.width = c.height = s * 2;
      const x = c.getContext('2d')!;
      if (lo) { x.fillStyle = lo; x.fillRect(0, 0, s * 2, s * 2); }
      x.fillStyle = hi; x.fillRect(0, 0, s, s); x.fillRect(s, s, s, s);
      const p = ctx.createPattern(c, 'repeat')!; pats.set(k, p); return p;
    };

    const draw = (t: number, prog: number) => {
      ctx.clearRect(0, 0, cv.width, cv.height);
      if (!W || !tones.length) return;
      const e = sstep(0.08, 0.92, prog);          // region interpolation
      const a = sstep(0, 0.2, prog);              // the cloud edge coming in
      const f = sstep(0, 0.45, prog);             // the sky filling the region
      const R = tile && prog > 0
        ? { x: lerp(0, tileBox.x, e), y: lerp(0, tileBox.y, e), w: lerp(W, tileBox.w, e), h: lerp(H, tileBox.h, e) }
        : { x: 0, y: 0, w: W, h: H };
      if (R.w < 2) return;
      // Cells shrink with the region but never below the tile's own, so
      // it lands as exactly tileCells x tileCells.
      const c = Math.max(tileBox.w / tileCells || 4, cell * (R.w / W));
      const cols = Math.ceil(R.w / c), rows = Math.ceil(R.h / c);
      const span = W / scalePx, L = 2 * tones.length;
      // The cloud edge relaxes away over the last fifth, so the tile ends square.
      const settle = 1 - sstep(0.8, 1, prog);
      const amp = a * lerp(170, 0, e) * settle;
      const radius = a * lerp(120, 0, e);

      for (let j = 0; j < rows; j++) for (let i = 0; i < cols; i++) {
        // Cloud edge, judged per cell so it steps in whole pixels.
        let edgeOff = 0;
        if (a > 0) {
          const lx = (i + 0.5) * c, ly = (j + 0.5) * c;
          const d = rrSDF(lx, ly, R.w, R.h, radius);
          const n = fbm(lx / R.w * 6 + t * 0.15, ly / R.w * 6 - t * 0.1);
          const ed = d + (n - 0.3) * amp * 1.4;
          if (ed > 0) continue;
          edgeOff = -sstep(-amp * 0.5 - 0.01, 0, ed) * 0.5;
        }
        // Single cells near the end, so the tile's four pixels differ.
        const big = prog < 0.7 && hash((i >> 1) + 31, (j >> 1) + 7) < CHUNK;
        const si = big ? (i & ~1) + 1 : i + 0.5, sj = big ? (j & ~1) + 1 : j + 0.5;
        const u = (si * c) / R.w, v = (sj * c) / R.h;
        const x = R.x + si * c, y = R.y + sj * c;
        // At rest: top and bottom bands, a little up the sides.
        const rest = Math.max(
          1 - sstep(0, 0.34, v),
          sstep(0.58, 0.98, v),
          Math.max(1 - sstep(0, 0.1, u), sstep(0.9, 1, u)) * 0.7,
        ) * 1.05;
        const open = rest - clearAt(x, y) * (1 - f);
        // Light while it passes over the words, full strength as the tile.
        const m = open + (0.62 - open) * f + sstep(0.75, 1, prog) * 0.9 + edgeOff;
        if (m <= 0) continue;
        const n = fbm(u * span + t * DRIFT_X, (sj * c / R.w) * span + t * DRIFT_Y);
        const lv = Math.min(L, Math.floor(((n - 0.5) * 3.4 + m - 0.42) * (L + 1)));
        if (lv <= 0) continue;
        if (lv % 2 === 0) ctx.fillStyle = tones[lv / 2 - 1];
        else { const h = (lv - 1) / 2; ctx.fillStyle = pat(h ? tones[h - 1] : null, tones[h]); }
        const x0 = Math.round((R.x + i * c) * dpr), y0 = Math.round((R.y + j * c) * dpr);
        const x1 = Math.round((R.x + Math.min(R.w, (i + 1) * c)) * dpr), y1 = Math.round((R.y + Math.min(R.h, (j + 1) * c)) * dpr);
        ctx.fillRect(x0, y0, x1 - x0, y1 - y0);
      }
    };

    // --- loop ---------------------------------------------------------------------
    // Done by --sky-fold of the viewport, or sooner if the tile would
    // otherwise be under the top tenth of the screen when it lands.
    const progress = () => {
      if (reduce.matches) return 0;
      const dist = Math.max(80, Math.min(innerHeight * fold, tileBox.y + cvTop - innerHeight * 0.1));
      return clamp(scrollY / dist);
    };
    let visible = true, last = 0, raf = 0;
    const t0 = performance.now();
    const frame = (now: number) => {
      raf = requestAnimationFrame(frame);
      if (now - last < FRAME_MS) return;
      last = now;
      draw((now - t0) / 1000, progress());
    };
    const start = () => { if (!raf && visible && !reduce.matches) raf = requestAnimationFrame(frame); };
    const stop = () => { cancelAnimationFrame(raf); raf = 0; };
    const still = () => draw(0, progress());

    const relayout = () => { readTokens(); measure(); still(); };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? start() : stop(); }).observe(cv);
    reduce.addEventListener('change', () => { stop(); relayout(); start(); });
    addEventListener('resize', relayout);
    document.fonts?.ready.then(relayout);
    // The theme button re-inks the tokens: read them again.
    new MutationObserver(() => { readTokens(); still(); }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-mode'] });

    relayout();
    start();
  }
</script>
