---
/* Horizontal drag/scroll rail with a grab cursor — the interaction
   from the reference. Works with mouse drag, trackpad, touch swipe
   and arrow keys. Falls back to native scroll-snap. */
interface Props { class?: string; label?: string; }
const { class: cls = '', label = 'Selected work' } = Astro.props;
---
<div class={`rail ${cls}`} data-rail tabindex="0" role="region" aria-label={label}>
  <div class="rail__track" data-rail-track><slot /></div>
</div>

<style>
  .rail {
    overflow-x: auto; overflow-y: hidden;
    cursor: grab;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }
  .rail::-webkit-scrollbar { display: none; }
  .rail[data-dragging='true'] { cursor: grabbing; scroll-snap-type: none; }
  .rail[data-dragging='true'] * { pointer-events: none; user-select: none; }
  .rail__track {
    display: flex; align-items: flex-end;
    gap: clamp(1rem, 4vw, 4.5rem);
    padding-inline: var(--gutter);
    width: max-content;
  }
  .rail__track > * { scroll-snap-align: center; flex: 0 0 auto; }
</style>

<script>
  document.querySelectorAll('[data-rail]').forEach((rail) => {
    let down = false, startX = 0, startScroll = 0, moved = 0;
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') return;      // let touch scroll natively
      down = true; moved = 0;
      startX = e.clientX; startScroll = rail.scrollLeft;
      rail.setPointerCapture(e.pointerId);
    });
    rail.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) rail.dataset.dragging = 'true';
      moved = Math.abs(dx);
      rail.scrollLeft = startScroll - dx;
    });
    const end = (e) => {
      if (!down) return;
      down = false; delete rail.dataset.dragging;
      try { rail.releasePointerCapture(e.pointerId); } catch {}
      if (moved > 6) {   // swallow the click that ends a drag
        const kill = (ev) => { ev.preventDefault(); ev.stopPropagation(); };
        rail.addEventListener('click', kill, { capture: true, once: true });
      }
    };
    rail.addEventListener('pointerup', end);
    rail.addEventListener('pointercancel', end);
    rail.addEventListener('keydown', (e) => {
      const step = rail.clientWidth * 0.7;
      if (e.key === 'ArrowRight') { rail.scrollBy({ left: step, behavior: 'smooth' }); e.preventDefault(); }
      if (e.key === 'ArrowLeft')  { rail.scrollBy({ left: -step, behavior: 'smooth' }); e.preventDefault(); }
    });
  });
</script>
