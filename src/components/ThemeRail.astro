---
/* ThemeRail.astro — the sitewide day/night control. Mounted once in
   Base.astro, so it's the same fixed element on every page.

   This used to carry a second "shuffle" control that repainted the
   hero (and, tinted, every other themed band) toward a random palette
   chosen fresh on every page load — by explicit instruction, the site
   is fixed to a single terracotta now (baked into tokens.css's
   [data-theme='charcoal'] block) and that whole system is gone. See
   this file's git history if a palette-shuffle ever comes back; the
   hex-to-HSL hue-lending logic it used is worth reusing rather than
   reinventing.

   The day/night tap sound is a ~100ms sine tone, pitch falling toward
   Night and rising toward Day.

   Pill fill, icon stroke and the rail's own colour all recolour to
   match whichever band is currently behind the rail's own fixed centre
   — the identical `data-theme` swap Nav.astro does for itself (same
   probe-and-swap script, just keyed to this rail's vertical centre
   instead of the nav's). */
---
<div class="theme-rail" id="theme-rail" data-theme="charcoal">
  <button type="button" class="theme-rail__btn" id="theme-rail-toggle" aria-label="Switch to night mode">
    <svg id="theme-rail-toggle-icon" viewBox="0 0 24 24" stroke-width="1.9" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="4.4" />
      <path d="M12,4.2 v-1.4 M12,21.2 v-1.4 M4.2,12 h-1.4 M21.2,12 h-1.4 M6.5,6.5 L5.5,5.5 M18.5,18.5 L17.5,17.5 M17.5,6.5 L18.5,5.5 M5.5,18.5 L6.5,17.5" />
    </svg>
  </button>
</div>

<style>
  .theme-rail {
    position: fixed;
    top: 50%;
    right: clamp(1.25rem, 4vw, 3rem);
    transform: translateY(-50%);
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.9rem 0.4rem;
    border-radius: 999px;
    color: var(--fg, #17120f);
    /* "Liquid glass": a diagonal sheen instead of a flat tint — brighter
       near the top-left, like light catching the top of a curved glass
       pill, plus a bright inner top edge for a little depth. No outer
       drop shadow — the sheen and inset edge do the depth work. */
    background: linear-gradient(155deg,
      color-mix(in srgb, currentColor 20%, transparent) 0%,
      color-mix(in srgb, currentColor 6%, transparent) 35%,
      color-mix(in srgb, currentColor 10%, transparent) 100%);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.5),
                inset 0 0 0 1px color-mix(in srgb, currentColor 14%, transparent);
    transition: color var(--dur-hover) var(--ease-out),
                box-shadow var(--dur-hover) var(--ease-out),
                background var(--dur-hover) var(--ease-out),
                transform var(--dur-hover) var(--ease-out);
  }
  /* The whole pill lifts slightly on hover — reads as "this whole
     control is interactive" before a visitor has even found a specific
     icon. */
  .theme-rail:hover {
    transform: translateY(-50%) scale(1.04);
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-rail:hover { transform: translateY(-50%); }
  }

  .theme-rail__btn {
    all: unset;
    cursor: pointer;
    position: relative;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
  }
  .theme-rail__btn:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .theme-rail__btn svg {
    width: 21px;
    height: 21px;
    stroke: currentColor;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
    transition: transform var(--dur-hover) var(--ease-out),
                opacity var(--dur-hover) var(--ease-out);
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-rail__btn svg { transition: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-rail__btn { transition: none; }
  }

  /* Vertically centred works while the hero's copy sits in the band's
     upper half (every page except the home hero). On the home hero at
     mobile widths the copy stack is tall enough (portrait + headline +
     two bio paragraphs + links) that a vertically centred rail — or
     even a bottom-anchored one at a fixed offset — lands on top of
     whichever line of copy happens to fall at that height, and that
     height shifts as the copy's own content or length changes (tried
     bottom-anchored first; it cleared the CTA row at one content
     length and then sat on top of the "find me at" line at another).
     Top-right, below the nav, is the one position on this page that's
     never going to have hero copy under it — the copy only grows
     downward from below the nav gap, it never reaches back up. */
  @media (max-width: 860px) {
    .theme-rail {
      top: 4.5rem;
      bottom: auto;
      transform: none;
    }
    /* :hover is a touch-device no-op in practice, so no reduced-motion
       variant needed here the way the base (desktop) rule above has one. */
    .theme-rail:hover { transform: scale(1.04); }
  }
</style>

<script>
  // The day/night tick: a ~100ms sine tone, pitch falling toward Night
  // and rising toward Day, silenced under prefers-reduced-motion.
  let audioCtx: AudioContext | null = null;
  const tick = (toDarker: boolean) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const Ctx = window.AudioContext || (window as any).webkitAudioContext;
    if (!Ctx) return;
    try {
      audioCtx = audioCtx || new Ctx();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const t = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(toDarker ? 1046 : 659, t);
      osc.frequency.exponentialRampToValueAtTime(toDarker ? 523 : 1318, t + 0.07);
      gain.gain.setValueAtTime(0.0001, t);
      gain.gain.exponentialRampToValueAtTime(0.05, t + 0.006);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.09);
      osc.connect(gain).connect(audioCtx.destination);
      osc.start(t);
      osc.stop(t + 0.1);
    } catch (e) { /* audio is a nicety — never let it break the control */ }
  };

  const toggleBtn = document.getElementById('theme-rail-toggle') as HTMLButtonElement | null;
  const toggleIcon = document.getElementById('theme-rail-toggle-icon') as unknown as SVGElement | null;
  const root = document.documentElement;

  // The two glyphs the single toggle button swaps between.
  const SUN_ICON = '<circle cx="12" cy="12" r="4.4" /><path d="M12,4.2 v-1.4 M12,21.2 v-1.4 M4.2,12 h-1.4 M21.2,12 h-1.4 M6.5,6.5 L5.5,5.5 M18.5,18.5 L17.5,17.5 M17.5,6.5 L18.5,5.5 M5.5,18.5 L6.5,17.5" />';
  const MOON_ICON = '<mask id="theme-rail-crescent"><rect width="24" height="24" fill="#fff" /><circle cx="14.6" cy="9" r="5" fill="#000" /></mask><circle cx="11.4" cy="12" r="5.6" fill="currentColor" stroke="none" mask="url(#theme-rail-crescent)" />';

  if (toggleBtn && toggleIcon) {
    let mode: 'day' | 'night' = root.dataset.mode === 'night' ? 'night' : 'day';

    const syncActive = () => {
      toggleIcon.innerHTML = mode === 'night' ? MOON_ICON : SUN_ICON;
      toggleBtn.setAttribute('aria-label', mode === 'night' ? 'Switch to day mode' : 'Switch to night mode');
    };

    // Nav.astro's own band-follow script, and the rail's own copy of it
    // just below, only re-run on scroll/resize — neither one is told
    // when a click (not a scroll) is what just changed a band's colour.
    // This event is that missing signal: both listen for it below.
    const announceThemeChange = () => window.dispatchEvent(new Event('theme:changed'));

    const setMode = (next: 'day' | 'night') => {
      if (next === mode) return;
      tick(next === 'night');
      mode = next;
      root.dataset.mode = mode;
      try { localStorage.setItem('mode', mode); } catch {}
      syncActive();
      announceThemeChange();
    };

    toggleBtn.addEventListener('click', () => setMode(mode === 'day' ? 'night' : 'day'));

    syncActive();
  }

  // Recolour with whichever band is behind the rail's own centre —
  // identical mechanism to Nav.astro's own band-follow script, just
  // probing this element's vertical centre instead of the nav's.
  const rail = document.getElementById('theme-rail');
  const bands = [...document.querySelectorAll('[data-themeband]')];
  if (rail && bands.length) {
    const pick = () => {
      const probe = rail.getBoundingClientRect().top + rail.offsetHeight / 2;
      let current = bands[0];
      for (const b of bands) {
        const r = b.getBoundingClientRect();
        if (r.top <= probe && r.bottom > probe) current = b;
      }
      const t = current.getAttribute('data-theme');
      if (t && rail.getAttribute('data-theme') !== t) rail.setAttribute('data-theme', t);
      for (const v of ['--bg', '--fg', '--fg-dim']) {
        const val = (current as HTMLElement).style.getPropertyValue(v);
        if (val) rail.style.setProperty(v, val);
        else rail.style.removeProperty(v);
      }
    };
    pick();
    addEventListener('scroll', pick, { passive: true });
    addEventListener('theme:changed', pick);
    addEventListener('resize', pick);
  }
</script>
