---
/* CasePreview.astro — one project as a full-bleed band on the home page.
   The home page is a trailer, not the case study: the visual leads, the copy
   is a single line, and everything that isn't essential to "should I click"
   (role, platforms, timelines) stays on the case-study page and on /work's
   CaseCard instead. Each band carries its own palette via the `theme` prop
   (same [data-theme] mechanism as Section.astro), so each project owns a hue
   as you scroll — coral, lilac, sage — the way the reference gives each
   chapter its own ground. `data-themeband` puts the band in the set the nav
   watches, so the nav recolours over it too; without it the nav keeps the
   previous band's colours and can drop below AA.
   `flip` puts content left, mockup right. `device` picks the frame.
   Still by default — the band carries no scroll motion of its own beyond the
   media-then-copy stagger below.

   Media and copy are two separate <Reveal>s, not one wrapping the whole
   band: the image settles in first, the text follows a beat later, so the
   visual gets a moment alone before anyone starts reading — the whole point
   of leading with imagery instead of a wall of text.

   `mediaRatio` now also shapes the desktop frame, not just the phone: each
   project can hold its own crop instead of every band repeating the same
   16/10 window, which is where the between-bands rhythm mostly comes from
   now that every band shares one column split. Omit it and the desktop
   frame keeps 16/10.

   `video` is the one exception: a phone can hold a screen recording of the
   real prototype instead of a still. It came from a GIF; it is served as
   mp4/webm because the source GIF was 4.9MB and a GIF cannot be paused.
   Three things keep that honest, and none of them are optional:
     · a visible pause control — it loops for 17s, and WCAG 2.2.2 wants
       anything auto-playing past 5s to be stoppable;
     · no autoplay under prefers-reduced-motion, where it holds the poster
       until the visitor asks for it;
     · playback only while the band is on screen.
   `mediaRatio` on a phone lets the frame take the recording's own aspect
   instead of the default 9/19.5 — the alternative is cropping 9% off each
   side of a real screen recording, which eats the UI. A recording also
   brings its own status bar, so the frame drops the notch. */
import Reveal from './Reveal.astro';

interface Props {
  company: string; title: string; tagline: string;
  impact: string; href: string; image?: string; alt?: string;
  theme?: 'ink' | 'bone' | 'sand' | 'clay' | 'sage' | 'lilac' | 'coral';
  flip?: boolean; device?: 'desktop' | 'phone';
  /* `alt` here describes the recording, not the still — they are different
     media and the still's alt is written for a landscape crop. */
  video?: { mp4: string; webm?: string; poster: string; alt?: string };
  mediaRatio?: string;
}
const { company, title, tagline, impact, href, image, alt = '',
        theme = 'ink', flip = false, device = 'desktop',
        video, mediaRatio } = Astro.props;
---
<article class:list={['band', flip && 'band--flip']} data-theme={theme} data-themeband>
  <Reveal class="band__media" y={20}>
    {device === 'phone' ? (
      <div class:list={['phone', mediaRatio && 'phone--auto']}
           style={mediaRatio ? `--screen-ratio: ${mediaRatio};` : undefined}>
        <div class="phone__screen">
          {!video && <div class="phone__notch"></div>}
          {video ? (
            <video class="phone__video" poster={video.poster} aria-label={video.alt ?? alt}
                   muted loop playsinline preload="none">
              {video.webm && <source src={video.webm} type="video/webm" />}
              <source src={video.mp4} type="video/mp4" />
            </video>
          ) : (
            image && <img src={image} alt={alt} loading="lazy" decoding="async" />
          )}
        </div>
        {video && (
          <button class="phone__toggle" type="button" data-play aria-pressed="false">
            <span data-play-label>Play</span> prototype
          </button>
        )}
      </div>
    ) : (
      <div class="desktop" style={mediaRatio ? `--screen-ratio: ${mediaRatio};` : undefined}>
        <div class="desktop__bar"><i></i><i></i><i></i></div>
        <div class="desktop__screen">
          {image && <img src={image} alt={alt} loading="lazy" decoding="async" />}
        </div>
      </div>
    )}
  </Reveal>
  <Reveal class="band__body" delay={160} y={16}>
    <p class="u-label eyebrow">{company}</p>
    <h3 class="title">{title}</h3>
    <p class="tagline">{tagline}</p>
    <p class="impact">{impact}</p>
    <a class="cta" href={href}>View case study &rarr;</a>
  </Reveal>
</article>

<style>
  .band { background: var(--bg); color: var(--fg); padding: clamp(6rem, 11vw, 10rem) var(--gutter); min-height: 92svh; display: grid; grid-template-columns: repeat(12, 1fr); column-gap: var(--gutter); align-items: center; }

  /* Media dominates: seven of twelve tracks, sitting flush against the
     band's own left edge. The body takes three, with a full track of air
     on the far side — an asymmetric split reads as an editorial spread,
     not a card with a caption. */
  /* :global — the class is passed as a prop into <Reveal>, so it lands on
     a div owned by Reveal.astro's own scope, not this file's (same gotcha
     CLAUDE.md documents for a class forwarded through <Section>). Without
     :global() these never match and the media/body stop being grid items. */
  :global(.band__media) { grid-column: 1 / 8; display: flex; justify-content: center; }
  :global(.band__body) { grid-column: 9 / 12; }
  :global(.band--flip .band__media) { grid-column: 6 / 13; grid-row: 1; }
  :global(.band--flip .band__body) { grid-column: 2 / 5; grid-row: 1; }

  /* A little vertical rhythm across an otherwise-identical column split —
     every third band sits high instead of centred, so the row of bands
     doesn't read as one template repeated six times. */
  .band:nth-of-type(3n) { align-items: start; padding-block-start: clamp(8rem, 14vw, 13rem); }

  .eyebrow { color: var(--fg-dim); margin: 0 0 1.25rem; }
  .title { font-family: var(--font-display); font-size: var(--step-h2); font-weight: 600; letter-spacing: var(--tracking-tight); line-height: 1.05; margin: 0 0 1.25rem; max-width: 16ch; text-wrap: balance; }
  .tagline { font-family: var(--font-accent); font-style: italic; font-size: var(--step-h3); color: var(--fg-dim); line-height: 1.35; margin: 0 0 2.75rem; max-width: 28ch; text-wrap: pretty; }
  .impact { font-family: var(--font-display); font-size: var(--step-body); font-weight: 600; letter-spacing: -0.01em; line-height: 1.4; margin: 0 0 2.75rem; max-width: 26ch; border-top: 1px solid var(--rule); padding-top: 1.25rem; text-wrap: pretty; }
  /* Same bordered-pill control as the hero's resume link — a control
     reads as the same control everywhere it appears on the site. */
  .cta {
    display: inline-block;
    color: var(--fg);
    text-decoration: none;
    border: 1px solid var(--fg-dim);
    border-radius: 999px;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-display); font-size: var(--step-label); letter-spacing: var(--tracking-label);
    text-transform: uppercase; font-weight: 600;
    transition: background var(--dur-hover) var(--ease-out), border-color var(--dur-hover) var(--ease-out);
  }
  .cta:hover { background: var(--screen); border-color: var(--fg-dim); }

  /* Device frames. --shell / --screen come from tokens.css (see note below).
     Sized up from a thumbnail to something that carries the band on its
     own — the visual is the hero here, not a supporting illustration. */
  .phone { width: min(360px, 90%); aspect-ratio: 9 / 19.5; background: var(--shell); border-radius: 38px; padding: 10px; box-shadow: 0 40px 80px -40px rgba(0,0,0,0.55); }
  .phone__screen { position: relative; width: 100%; height: 100%; border-radius: 29px; overflow: hidden; background: var(--screen); }

  /* The frame stops dictating its own height and takes the recording's,
     so nothing gets cropped. --screen-ratio comes from `mediaRatio`. */
  .phone--auto { aspect-ratio: auto; }
  .phone--auto .phone__screen { height: auto; aspect-ratio: var(--screen-ratio); }
  .phone__video { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Sits under the phone, in the band's own palette — a control, not chrome
     stuck on the mockup. */
  .phone__toggle {
    display: block; margin: 1rem auto 0;
    font-family: var(--font-display); font-size: var(--step-label);
    letter-spacing: var(--tracking-label); text-transform: uppercase;
    font-weight: 600; color: var(--fg-dim);
    background: none; border: 0; padding: 0.5rem;
    cursor: pointer;
  }
  .phone__toggle:hover { color: var(--fg); }
  .phone__notch { position: absolute; top: 10px; left: 50%; transform: translateX(-50%); width: 34%; height: 22px; background: var(--shell); border-radius: 12px; z-index: 1; }
  .desktop { width: 100%; background: var(--shell); border-radius: 10px; padding: 8px; box-shadow: 0 40px 80px -40px rgba(0,0,0,0.55); }
  .desktop__bar { height: 14px; display: flex; gap: 5px; align-items: center; padding-inline: 6px; }
  .desktop__bar i { width: 7px; height: 7px; border-radius: 50%; background: var(--rule); display: block; }
  .desktop__screen { aspect-ratio: var(--screen-ratio, 16 / 10); border-radius: 5px; overflow: hidden; background: var(--screen); }
  .band__media img { width: 100%; height: 100%; object-fit: cover; display: block; }

  @media (max-width: 1024px) {
    :global(.band__media) { grid-column: 1 / 8; }
    :global(.band__body) { grid-column: 9 / 13; }
    :global(.band--flip .band__media) { grid-column: 6 / 13; }
    :global(.band--flip .band__body) { grid-column: 1 / 5; }
    .band:nth-of-type(3n) { padding-block-start: clamp(6rem, 11vw, 9rem); }
  }
  @media (max-width: 760px) {
    .band { grid-template-columns: 1fr; row-gap: 2.5rem; min-height: 0; padding-block: clamp(4.5rem, 13vw, 7rem); }
    .band:nth-of-type(3n) { padding-block-start: clamp(4.5rem, 13vw, 7rem); }
    :global(.band__media), :global(.band__body),
    :global(.band--flip .band__media), :global(.band--flip .band__body) { grid-column: 1 / -1; grid-row: auto; }
    :global(.band--flip .band__media) { order: -1; }
    .title, .tagline, .impact { max-width: none; }
    .phone { width: min(280px, 78%); }
  }
</style>

<script>
  /* Prototype playback. Plays only while the band is on screen, never
     autoplays under prefers-reduced-motion, and the button is the WCAG
     2.2.2 stop control for a 17-second loop. The button is the only path
     to playback when motion is reduced, so it always reflects real state
     rather than intent — `ended` can't fire on a loop, but a failed
     play() promise can, and a toggle that lies is worse than no toggle. */
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('.phone--auto').forEach((phone) => {
    const video = phone.querySelector<HTMLVideoElement>('.phone__video');
    const button = phone.querySelector<HTMLButtonElement>('[data-play]');
    const label = phone.querySelector<HTMLElement>('[data-play-label]');
    if (!video || !button || !label) return;

    let wanted = !reduced.matches;   // whether the visitor wants it running
    let onScreen = false;

    const sync = () => {
      const playing = !video.paused;
      label.textContent = playing ? 'Pause' : 'Play';
      button.setAttribute('aria-pressed', String(playing));
    };

    const play = () => video.play().then(sync, sync);
    const pause = () => { video.pause(); sync(); };

    /* A click plays straight away. The observer is an optimisation — it must
       never be the reason a button the visitor just pressed does nothing. */
    button.addEventListener('click', () => {
      wanted = !wanted;
      wanted ? play() : pause();
    });
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);

    // Reduced motion can be switched on mid-visit; stop when it is.
    reduced.addEventListener('change', (e) => {
      if (e.matches) { wanted = false; pause(); }
    });

    new IntersectionObserver((entries) => {
      onScreen = entries[0].isIntersecting;
      if (wanted) onScreen ? play() : pause();
    }, { threshold: 0.25 }).observe(phone);

    sync();
  });
</script>
