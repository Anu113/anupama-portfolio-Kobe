---
/* Fixed nav, top-right, matching the reference. It watches which
   themed section is behind it and adopts that palette.
   The day/night toggle used to live here (a sun/moon button on the
   right) — it's moved out to ThemeRail.astro, a persistent control
   fixed to the viewport on every page, not just parked in the nav.
   This component now only owns the wordmark and the primary links. */
const links = [
  { label: 'Work', href: '/work' },
  { label: 'About me', href: '/about' },
  { label: 'Playground', href: '/playground' },
  { label: 'Contact', href: '/contact' },
];
---
<header class="nav" data-theme="ink" id="site-nav">
  <a class="nav__mark" href="/">Anupama Mishra</a>
  <div class="nav__right">
    <nav aria-label="Primary">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed; inset-inline: 0; top: 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.5rem var(--gutter);
    color: var(--fg);
    /* Solid, not translucent — the site is deliberately hard-edged (see
       tokens.css, --radius) and a glass/blur nav would be the one soft
       surface on the page. Without a background here at all, tall content
       (the home hero's display type especially) scrolls straight through
       the nav's own band and collides with the wordmark and links. */
    background: var(--bg);
    mix-blend-mode: normal;
    transition: color var(--dur-hover) var(--ease-out),
                background var(--dur-hover) var(--ease-out);
    pointer-events: none;
  }
  .nav a,
  .nav button { pointer-events: auto; }
  .nav__right {
    display: flex; align-items: center;
    gap: clamp(1.25rem, 3vw, 2.75rem);
  }
  /* The full name, set to match the link row rather than shout over it —
     same size and tracking as the links, heavier weight to hold the corner. */
  .nav__mark {
    font-family: var(--font-display);
    font-size: var(--step-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-weight: 600;
    text-decoration: none; color: inherit;
    white-space: nowrap;
  }
  .nav ul {
    display: flex; gap: clamp(1.25rem, 3vw, 2.75rem);
    list-style: none; margin: 0; padding: 0;
  }
  .nav a[href^='/'] { color: inherit; text-decoration: none; }
  /* Each link's box is locked to its own natural (unhovered) width by
     the script below, so the wider tracking on hover overflows visually
     rather than growing the flex item — the point being that hovering
     "Work" never nudges "About me" sideways. display: inline-block is
     required for the JS width lock to actually constrain the text. */
  .nav nav li { position: relative; }
  .nav nav a {
    display: inline-block;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: var(--step-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-weight: 500;
    transition: letter-spacing var(--dur-hover) var(--ease-out);
  }
  /* 0.14em resting → 0.26em on hover — dialed in over a few passes: an
     underline was the original affordance here, tried a full repel-
     from-cursor effect too, but this reads as the site's own restrained
     hover language best. */
  .nav nav a:hover { letter-spacing: 0.26em; }
  @media (prefers-reduced-motion: reduce) {
    .nav nav a { transition: none; }
  }
</style>

<script>
  // Lock each nav link's box to its own resting width, measured once,
  // so the wider hover tracking (see the CSS above) overflows visually
  // instead of growing the flex item and nudging its neighbours.
  const lockNavLinkWidths = () => {
    document.querySelectorAll<HTMLAnchorElement>('.nav nav a').forEach((a) => {
      a.style.width = 'auto';
      a.style.width = `${a.getBoundingClientRect().width}px`;
    });
  };
  lockNavLinkWidths();
  // Re-measure once the real webfont swaps in — its metrics differ
  // slightly from the fallback, which would otherwise leave the lock
  // fixed at the wrong (fallback-font) width.
  document.fonts?.ready.then(lockNavLinkWidths);

  // Nav adopts the theme of the section currently under it.
  const nav = document.getElementById('site-nav');
  const bands = [...document.querySelectorAll('[data-themeband]')];
  if (nav && bands.length) {
    const pick = () => {
      const probe = nav.offsetHeight / 2;
      let current = bands[0];
      for (const b of bands) {
        const r = b.getBoundingClientRect();
        if (r.top <= probe && r.bottom > probe) current = b;
      }
      const t = current.getAttribute('data-theme');
      if (t && nav.getAttribute('data-theme') !== t) nav.setAttribute('data-theme', t);
      // Mirror the band's own --bg/--fg/--fg-dim inline overrides (set by
      // ThemeRail's shuffle) exactly, rather than just copying the theme
      // name — a shuffled band's colour is an inline override the plain
      // data-theme cascade above doesn't know about, so without this the
      // nav would keep showing that theme's un-shuffled colour while
      // scrolled over a shuffled band.
      for (const v of ['--bg', '--fg', '--fg-dim']) {
        const val = (current as HTMLElement).style.getPropertyValue(v);
        if (val) nav.style.setProperty(v, val);
        else nav.style.removeProperty(v);
      }
    };
    pick();
    addEventListener('scroll', pick, { passive: true });
    addEventListener('resize', pick);
  }
</script>
