---
/* Fixed nav, top-right, matching the reference. It watches which
   themed section is behind it and adopts that palette.
   The day/night toggle used to live here (a sun/moon button on the
   right) — it's moved out to ThemeRail.astro, a persistent control
   fixed to the viewport on every page, not just parked in the nav.
   This component now only owns the wordmark and the primary links. */
const links = [
  { label: 'Work', href: '/work' },
  { label: 'About me', href: '/about' },
  { label: 'Playground', href: '/playground' },
  { label: 'Contact', href: '/contact' },
];
---
<header class="nav" data-theme="ink" id="site-nav">
  <a class="nav__mark" href="/">Anupama Mishra</a>
  <div class="nav__right">
    <nav aria-label="Primary">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed; inset-inline: 0; top: 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.5rem var(--gutter);
    color: var(--fg);
    /* Solid, not translucent — the site is deliberately hard-edged (see
       tokens.css, --radius) and a glass/blur nav would be the one soft
       surface on the page. Without a background here at all, tall content
       (the home hero's display type especially) scrolls straight through
       the nav's own band and collides with the wordmark and links. */
    background: var(--bg);
    mix-blend-mode: normal;
    transition: color var(--dur-hover) var(--ease-out),
                background var(--dur-hover) var(--ease-out);
    pointer-events: none;
  }
  .nav a,
  .nav button { pointer-events: auto; }
  .nav__right {
    display: flex; align-items: center;
    gap: clamp(1.25rem, 3vw, 2.75rem);
  }
  /* The full name, set to match the link row rather than shout over it —
     same size and tracking as the links, heavier weight to hold the corner. */
  .nav__mark {
    font-family: var(--font-display);
    font-size: var(--step-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-weight: 600;
    text-decoration: none; color: inherit;
    white-space: nowrap;
  }
  .nav ul {
    display: flex; gap: clamp(1.25rem, 3vw, 2.75rem);
    list-style: none; margin: 0; padding: 0;
  }
  .nav a[href^='/'] { color: inherit; text-decoration: none; }
  .nav nav a {
    font-family: var(--font-display);
    font-size: var(--step-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-weight: 500;
    position: relative;
  }
  .nav nav a::after {
    content: ''; position: absolute; left: 0; bottom: -4px;
    width: 100%; height: 1px; background: currentColor;
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--dur-hover) var(--ease-out);
  }
  .nav nav a:hover::after { transform: scaleX(1); }
</style>

<script>
  // Nav adopts the theme of the section currently under it.
  const nav = document.getElementById('site-nav');
  const bands = [...document.querySelectorAll('[data-themeband]')];
  if (nav && bands.length) {
    const pick = () => {
      const probe = nav.offsetHeight / 2;
      let current = bands[0];
      for (const b of bands) {
        const r = b.getBoundingClientRect();
        if (r.top <= probe && r.bottom > probe) current = b;
      }
      const t = current.getAttribute('data-theme');
      if (t && nav.getAttribute('data-theme') !== t) nav.setAttribute('data-theme', t);
    };
    pick();
    addEventListener('scroll', pick, { passive: true });
    addEventListener('resize', pick);
  }
</script>
