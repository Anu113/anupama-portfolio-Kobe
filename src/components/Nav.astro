---
/* Site chrome: the name top-left, a thin top row at ≥1200px, and the
   Dock (primary navigation + preferences, see Dock.astro).
     Name       "Anupama Mishra" as plain text, at every width. It's the
                home link, which is why the dock has no Index item.
     Top row    ≥1200px only. "Working remotely · city, local time" and
                the enquiries email, together at the right margin.
     Dock       Horizontal, fixed bottom-centre, at every width (see
                Dock.astro) — the always-available navigation.
   Name and top row sit on the page's own --gutter, so they share one
   left and one right edge with every band's content.

   Hides on scroll-down, returns on scroll-up. It used to stay fixed with
   no background, so the name and the clock/email drew straight over case
   cards, headlines and the footer as the page scrolled past (and picked
   up band colours that failed contrast over them). Now: transparent at
   the very top, where it reads as part of the hero; slides away as soon
   as the visitor scrolls down into content; comes back on any scroll up
   (the "I want to go somewhere" gesture) on a solid strip of the band
   behind it, so it never sits on content without a ground. Keyboard focus
   inside it always brings it back. Reduced motion: same states, no slide.
   The name and top row recolour to match whichever band is behind them
   (script below); the dock does the same for itself. */
import Dock from './Dock.astro';
import { site } from '../data/site';
const path = Astro.url.pathname;
---
<header class="nav" data-theme="ink" id="site-nav">
  <a class="nav__mark" href="/" aria-label="Anupama Mishra — home">{site.name}</a>

  <div class="bar__status">
    <p class="bar__meta bar__clock">
      <span>Working remotely</span>
      <span class="bar__dim">{site.location}, <time data-bar-clock={site.timezone}>--:--</time></span>
    </p>

    <p class="bar__meta bar__mail">
      <span class="bar__dim">For inquiries</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </div>
</header>

<Dock path={path} />

<style>
  .nav {
    position: fixed; inset-inline: 0; top: 0; z-index: 50;
    display: flex; align-items: center;
    padding: 1.5rem var(--gutter);
    color: var(--fg);
    background: transparent;
    pointer-events: none;
    transition: transform var(--dur-hover) var(--ease-out);
  }
  .nav.is-solid { background: var(--bg); }
  .nav.is-hidden:not(:focus-within) { transform: translateY(-100%); }
  @media (prefers-reduced-motion: reduce) {
    .nav { transition: none; }
  }
  .nav a { pointer-events: auto; }
  /* The full name at --step-name (16→24px, matched to hansonwu.com),
     heavier weight to hold the corner. line-height is pinned to
     --idmark-h so the dock can sit a fixed distance under it. */
  .nav__mark {
    font-family: var(--font-display);
    font-size: var(--step-name);
    line-height: var(--idmark-h);
    font-weight: 600;
    text-decoration: none; color: inherit;
    white-space: nowrap;
  }

  /* --- The top row (≥1200px) ---------------------------------- */
  .bar__status { display: none; }

  @media (min-width: 1200px) {
    .nav {
      /* baseline, not center — the name and the top row set very
         different font sizes; sharing a baseline is what makes them read
         as one line. */
      align-items: baseline;
      justify-content: space-between;
      padding-block: calc(var(--idmark-inset) + 0.75rem) var(--idmark-inset);
    }
    .nav__mark { display: block; }

    /* Both status items sit together at the right margin — as one status
       row rather than two unrelated lines. */
    .bar__status {
      display: flex; align-items: baseline; justify-content: flex-end;
      gap: clamp(1.5rem, 3vw, 3rem);
    }
    .bar__meta { display: flex; gap: var(--bar-meta-gap); margin: 0; white-space: nowrap; }
  }

  .bar__meta {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-bar-meta);
    line-height: 1.3;
    letter-spacing: 0.01em;
  }
  .bar__dim { color: var(--fg-dim); }
  .bar__clock time { font-variant-numeric: tabular-nums; }

  .bar__mail a {
    position: relative;
    color: var(--fg);
    text-decoration: none;
  }
  .bar__mail a::after {
    content: '';
    position: absolute; left: 0; right: 0; bottom: -2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-hover) var(--ease-out);
  }
  .bar__mail a:hover::after,
  .bar__mail a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (prefers-reduced-motion: reduce) {
    .bar__mail a::after { transition: none; }
  }
</style>

<script>
  // The name and top row adopt the theme of the section currently behind
  // them. The dock runs the same check for its own position.
  const nav = document.getElementById('site-nav');
  const bands = [...document.querySelectorAll('[data-themeband]')];
  if (nav && bands.length) {
    const pick = () => {
      const probe = nav.offsetHeight / 2;
      let current = bands[0];
      for (const b of bands) {
        const r = b.getBoundingClientRect();
        if (r.top <= probe && r.bottom > probe) current = b;
      }
      const t = current.getAttribute('data-theme');
      if (t && nav.getAttribute('data-theme') !== t) nav.setAttribute('data-theme', t);
      for (const v of ['--bg', '--fg', '--fg-dim']) {
        const val = (current as HTMLElement).style.getPropertyValue(v);
        if (val) nav.style.setProperty(v, val);
        else nav.style.removeProperty(v);
      }
    };
    pick();
    addEventListener('scroll', pick, { passive: true });

    // Hide on scroll-down, show on scroll-up (see the header comment).
    // A few px of hysteresis so trackpad jitter doesn't flicker it.
    let lastY = scrollY;
    const follow = () => {
      const y = scrollY;
      const dy = y - lastY;
      nav.classList.toggle('is-solid', y > 0);
      if (y <= nav.offsetHeight) nav.classList.remove('is-hidden');
      else if (dy > 4) nav.classList.add('is-hidden');
      else if (dy < -4) nav.classList.remove('is-hidden');
      if (Math.abs(dy) > 4 || y <= nav.offsetHeight) lastY = y;
    };
    follow();
    addEventListener('scroll', follow, { passive: true });
    addEventListener('resize', pick);
    addEventListener('theme:changed', pick);
  }

  // Top-row clock: her time, not the visitor's.
  const clock = document.querySelector<HTMLElement>('[data-bar-clock]');
  if (clock?.dataset.barClock) {
    const fmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: clock.dataset.barClock,
      hour: '2-digit',
      minute: '2-digit',
    });
    const paint = () => { clock.textContent = fmt.format(new Date()); };
    paint();
    setInterval(paint, 15000);
  }
</script>
