---
/* Fixed site chrome: the name top-left, a thin top row at ≥1200px, and the
   Dock (primary navigation + preferences, see Dock.astro).
     Name       At ≥1200px it's IdentityPrism, a small 3D box that turns
                with the mouse wheel (see its header comment), 20px off the
                corner. Below that it's the plain text wordmark, which
                expands to the full name on hover. Either way it's the home
                link, which is why the dock has no Index item.
     Top row    ≥1200px only. Starts on the page's content edge (column 4 of
                a 16-column grid, --gutter-start in tokens.css) and spreads
                "Working remotely · city, local time" and the enquiries email
                out to the right margin, each on one line.
     Dock       Vertical under the name at ≥1200px, horizontal at the bottom
                below that. Page content starts at --gutter-start, clear of
                it (see CHROME RAIL in tokens.css).
   The name and top row recolour to match whichever band is behind them
   (script below); the dock does the same for itself. */
import IdentityPrism from './IdentityPrism.astro';
import Dock from './Dock.astro';
import { site } from '../data/site';
const path = Astro.url.pathname;
---
<header class="nav" data-theme="ink" id="site-nav">
  <a class="nav__mark" href="/" aria-label="Anupama Mishra — home">
    <span class="nav__mark-visual" aria-hidden="true"
      ><span class="nav__mark-fixed">A</span><span class="nav__mark-suffix">.M</span><span class="nav__mark-rest">nupama Mishra</span></span
    >
    <IdentityPrism />
  </a>

  <div class="bar__status">
    <p class="bar__meta bar__clock">
      <span>Working remotely</span>
      <span class="bar__dim">{site.location}, <time data-bar-clock={site.timezone}>--:--</time></span>
    </p>

    <p class="bar__meta bar__mail">
      <span class="bar__dim">For inquiries</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </div>
</header>

<Dock path={path} />

<style>
  .nav {
    position: fixed; inset-inline: 0; top: 0; z-index: 50;
    display: flex; align-items: center;
    padding: 1.5rem var(--gutter);
    color: var(--fg);
    background: transparent;
    pointer-events: none;
  }
  .nav a { pointer-events: auto; }
  /* The full name, set to match the link row rather than shout over it —
     same size and tracking as the links, heavier weight to hold the corner. */
  .nav__mark {
    font-family: var(--font-display);
    font-size: var(--step-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-weight: 600;
    text-decoration: none; color: inherit;
    white-space: nowrap;
  }
  .nav__mark-visual { display: inline-flex; align-items: baseline; }
  .nav__mark-rest {
    display: inline-block;
    overflow: hidden;
    max-width: 0;
    white-space: nowrap;
    transition: max-width var(--dur-hover) var(--ease-out);
  }
  .nav__mark:hover .nav__mark-rest,
  .nav__mark:focus-visible .nav__mark-rest {
    max-width: 18ch;
  }
  .nav__mark-suffix {
    display: inline-block;
    overflow: hidden;
    max-width: 3ch;
    opacity: 0.45;
    white-space: nowrap;
    transition: max-width var(--dur-hover) var(--ease-out), opacity var(--dur-hover) var(--ease-out);
  }
  .nav__mark:hover .nav__mark-suffix,
  .nav__mark:focus-visible .nav__mark-suffix {
    max-width: 0;
    opacity: 0;
  }

  /* --- The top row (≥1200px) ---------------------------------- */
  .bar__status { display: none; }

  @media (min-width: 1200px) {
    .nav {
      display: grid;
      grid-template-columns: repeat(var(--bar-cols), minmax(0, 1fr));
      column-gap: var(--bar-gap);
      align-items: start;
      padding: var(--idmark-inset);
    }
    .nav__mark { display: block; grid-column: 1 / span 2; }
    .nav__mark-visual { display: none; }

    /* Starts on the page's content edge, the same line as the hero
       headline, and spreads its two items out to the right margin. */
    .bar__status {
      display: flex; align-items: baseline; justify-content: space-between;
      grid-column: calc(var(--chrome-cols) + 1) / -1;
      grid-row: 1;
    }
    .bar__meta { display: flex; gap: var(--bar-meta-gap); margin: 0; white-space: nowrap; }
  }

  .bar__meta {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-bar-meta);
    line-height: 1.3;
    letter-spacing: 0.01em;
  }
  .bar__dim { color: var(--fg-dim); }
  .bar__clock time { font-variant-numeric: tabular-nums; }

  .bar__mail a {
    position: relative;
    color: var(--fg);
    text-decoration: none;
  }
  .bar__mail a::after {
    content: '';
    position: absolute; left: 0; right: 0; bottom: -2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-hover) var(--ease-out);
  }
  .bar__mail a:hover::after,
  .bar__mail a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (prefers-reduced-motion: reduce) {
    .bar__mail a::after,
    .nav__mark-rest,
    .nav__mark-suffix { transition: none; }
  }
</style>

<script>
  // The name and top row adopt the theme of the section currently behind
  // them. The dock runs the same check for its own position.
  const nav = document.getElementById('site-nav');
  const bands = [...document.querySelectorAll('[data-themeband]')];
  if (nav && bands.length) {
    const pick = () => {
      const probe = nav.offsetHeight / 2;
      let current = bands[0];
      for (const b of bands) {
        const r = b.getBoundingClientRect();
        if (r.top <= probe && r.bottom > probe) current = b;
      }
      const t = current.getAttribute('data-theme');
      if (t && nav.getAttribute('data-theme') !== t) nav.setAttribute('data-theme', t);
      for (const v of ['--bg', '--fg', '--fg-dim']) {
        const val = (current as HTMLElement).style.getPropertyValue(v);
        if (val) nav.style.setProperty(v, val);
        else nav.style.removeProperty(v);
      }
    };
    pick();
    addEventListener('scroll', pick, { passive: true });
    addEventListener('resize', pick);
    addEventListener('theme:changed', pick);
  }

  // Top-row clock: her time, not the visitor's.
  const clock = document.querySelector<HTMLElement>('[data-bar-clock]');
  if (clock?.dataset.barClock) {
    const fmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: clock.dataset.barClock,
      hour: '2-digit',
      minute: '2-digit',
    });
    const paint = () => { clock.textContent = fmt.format(new Date()); };
    paint();
    setInterval(paint, 15000);
  }
</script>
