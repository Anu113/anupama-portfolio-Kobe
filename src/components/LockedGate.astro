---
/* LockedGate.astro — the full-page state a FULLY locked case study shows
   instead of the case itself. Distinct from CaseGate.astro, which is the
   compact inline panel a PARTIALLY gated case shows part-way down its own
   page (see the `locked` field's comment in cases.ts for which is which).

   Layout "D" of five mocks (experiments/locked-gate), chosen on request:
   it shows what's behind the lock instead of only saying so. Everything
   sits in one centred column (on request, experiments/locked-gate/
   centered.html), top to bottom: the case named in a mono line, the
   headline, one paragraph, the public version — Role, Scope, Outcome in
   one row of three (no Team, on request) — the passcode form and a way
   to ask for it, then the case's own sections as a numbered contents
   list: the first one readable (its heading), the rest as flat ink
   redaction bars. A hiring manager sees a real, structured case is
   there; a recruiter gets level and scope without the passcode.
   The passcode field is a single underline (option 1 of six in
   experiments/locked-gate/inputs.html, on request), with the show/hide
   eye at its end and the Unlock pill on its own line under it.
   The paragraph and the facts are 13px (--step-small), not body size:
   in Manrope 600 at 15px the paragraph competed with the headline;
   ozgur.design and allierho.com both keep their gate copy quieter.
   The bars are decoration (aria-hidden); each redacted row tells screen
   readers "redacted" in words instead. No motion beyond the shared hover.
   Copy chosen on request from the mock's copy bank.

   Same security model as CaseGate — static site, no server, so this is a
   soft deterrent, not confidentiality. See cases.ts. */
import { site } from '../data/site';
import LockIcon from './LockIcon.astro';

interface Props {
  slug: string;
  caseTitle: string;
  company: string;
  role: string;
  scope?: string;
  outcome?: string;
  sections: { nav: string; heading: string }[];
  password: string;
  backHref?: string;
  targetId: string;
}
const {
  slug, caseTitle, company, role, scope, outcome, sections,
  password, backHref = '/work', targetId,
} = Astro.props;
const mailSubject = encodeURIComponent(`Passcode for "${caseTitle}"`);
const facts = [
  { term: 'Role', detail: role },
  { term: 'Scope', detail: scope },
  { term: 'Outcome', detail: outcome },
].filter((f) => f.detail);
const num = (i: number) => String(i + 1).padStart(2, '0');
/* Redaction bar lengths, in %, cycled so the column reads like text with
   a ragged edge rather than a stack of equal blocks. One or two lines. */
const bars = [[92, 64], [78, 40], [86], [70, 88], [55], [66], [80, 48]];
---
<div class="locked" data-gate data-slug={slug} data-password={password} data-target={targetId}>
  <div class="locked__col">
    <p class="u-label-mono locked__eyebrow">
      <LockIcon size="1.1em" />
      <span>{company} · Under NDA</span>
    </p>
    <p class="locked__case">{caseTitle}</p>
    <h1 class="locked__head">The interesting parts are <em>confidential</em>.</h1>
    <p class="locked__body">
      The detailed process is protected, but here is the public version.
      Have the passcode? Step in for the full case study.
    </p>
    {facts.length > 0 && (
      <dl class="locked__facts">
        {facts.map((f) => (
          <div>
            <dt class="u-label-mono">{f.term}</dt>
            <dd>{f.detail}</dd>
          </div>
        ))}
      </dl>
    )}

    <form class="locked__form" data-gate-form autocomplete="off">
      <label class="u-label-mono locked__label" for={`locked-pw-${slug}`}>Passcode</label>
      <div class="locked__field">
        <div class="locked__input-wrap">
          <input
            class="locked__input"
            id={`locked-pw-${slug}`}
            name="password"
            type="password"
            autocomplete="off"
            aria-describedby={`locked-err-${slug}`}
          />
          <button class="locked__peek" type="button" data-gate-peek aria-label="Show passcode" aria-pressed="false">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path data-eye-open d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" />
              <circle data-eye-open cx="12" cy="12" r="3" />
              <path data-eye-closed d="M3 3l18 18M10.6 10.6a3 3 0 0 0 4.24 4.24M9.88 4.24A10.9 10.9 0 0 1 12 4c7 0 11 8 11 8a17.6 17.6 0 0 1-3.06 4.06M6.1 6.1A17.4 17.4 0 0 0 1 12s4 8 11 8a10.6 10.6 0 0 0 4.9-1.2" style="display:none" />
            </svg>
          </button>
        </div>
      </div>
      <p class="locked__err" id={`locked-err-${slug}`} role="alert" data-gate-err hidden>
        That's not it. Try again.
      </p>
      <button class="locked__submit btn btn--primary" type="submit">Unlock</button>
    </form>
    <p class="locked__reach">
      No passcode? <a href={`mailto:${site.email}?subject=${mailSubject}`}>Email me</a> and I'll walk you through it.
    </p>

    <ol class="locked__toc" aria-label="Case contents">
      {sections.map((s, i) => (
        <li>
          <span class="u-label-mono locked__num" aria-hidden="true">{num(i)}</span>
          <span class="u-label-mono locked__sec">{s.nav}</span>
          {i === 0 ? (
            <span class="locked__open">{s.heading}</span>
          ) : (
            <span class="locked__bars">
              <span class="u-sr-only">redacted</span>
              {bars[(i - 1) % bars.length].map((w) => (
                <span class="locked__bar" style={`width: ${w}%`} aria-hidden="true" />
              ))}
            </span>
          )}
        </li>
      ))}
    </ol>

    <a class="locked__back u-label-mono" href={backHref}>
      <span aria-hidden="true">&larr;</span> All work
    </a>
  </div>
</div>

<style>
  .locked {
    background: var(--bg);
    color: var(--fg);
    padding: calc(var(--nav-h) + var(--space-band)) var(--gutter) var(--space-band);
  }
  /* One centred column. The text centres; the facts row and the contents
     list are left-aligned tables inside the same centred width. */
  .locked__col {
    max-width: 48rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .locked__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
  }
  .locked__case { margin: 0 0 0.4rem; font-size: var(--step-small); color: var(--fg-dim); }
  .locked__head {
    font-family: var(--font-serif);
    font-weight: var(--weight-serif);
    font-size: var(--step-case-title);
    line-height: 1.1;
    letter-spacing: var(--tracking-serif);
    margin: 0 0 0.9rem;
    text-wrap: balance;
  }
  .locked__head em { font-style: italic; }
  .locked__body {
    margin: 0 0 2.25rem;
    max-width: 34rem;
    font-size: var(--step-small);
    line-height: 1.7;
    color: var(--fg-dim);
    text-wrap: balance;
  }

  /* ---- the public version: one row of three ---- */
  .locked__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    margin: 0 0 2.25rem;
    text-align: left;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .locked__facts > div { padding: 1rem 1.25rem 1.1rem; }
  .locked__facts > div + div { border-left: 1px solid var(--rule); }
  .locked__facts dt { margin-bottom: 0.4rem; }
  .locked__facts dd { margin: 0; font-size: var(--step-small); line-height: 1.55; }
  @media (max-width: 700px) {
    .locked__facts { grid-template-columns: 1fr; }
    .locked__facts > div { padding-inline: 0; }
    .locked__facts > div + div { border-left: 0; border-top: 1px solid var(--rule); }
  }

  /* ---- the form ---- */
  .locked__form {
    width: 100%;
    max-width: 22rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .locked__label { display: block; margin: 0 0 0.25rem; }
  .locked__field { width: 100%; }
  /* One underline, no box. --fg at rest (a control's boundary needs 3:1),
     the accent while focused or wrong. */
  .locked__input-wrap {
    position: relative;
    border-bottom: 1px solid var(--fg);
    transition: border-color var(--dur-hover) var(--ease-out);
  }
  /* Focus thickens the line to 2px as well as turning it the accent, so
     the focus state doesn't rest on colour alone. */
  .locked__input-wrap:focus-within { border-bottom-color: var(--accent); box-shadow: 0 1px 0 var(--accent); }
  .locked__input-wrap:has([aria-invalid='true']) { border-bottom-color: var(--accent-text); }
  .locked__input {
    width: 100%;
    font: inherit;
    font-size: var(--step-body);
    color: var(--fg);
    background: none;
    border: 0;
    border-radius: 0;
    padding: 0.6rem 2.5rem;
    text-align: center;
  }
  /* The underline itself turns the accent on focus, so the field needs no
     second ring. */
  .locked__input:focus-visible { outline: none; }
  .locked__peek {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--fg-dim);
    cursor: pointer;
    transition: color var(--dur-hover) var(--ease-out);
  }
  .locked__peek:hover { color: var(--fg); }
  .locked__peek:focus-visible { outline: 2px solid var(--accent); outline-offset: 0; }
  .locked__submit { margin-top: 1.5rem; }

  .locked__err { margin: 0.6rem 0 0; font-size: var(--step-small); color: var(--accent-text); }
  .locked__reach { margin: 1rem 0 0; font-size: var(--step-small); color: var(--fg-dim); }
  .locked__reach a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
    transition: color var(--dur-hover) var(--ease-out), text-decoration-color var(--dur-hover) var(--ease-out);
  }
  .locked__reach a:hover { color: var(--accent-text); text-decoration-color: currentColor; }

  /* ---- the contents, redacted ---- */
  .locked__toc {
    list-style: none;
    margin: clamp(3.5rem, 7vw, 5rem) 0 0;
    padding: 0;
    width: 100%;
    text-align: left;
  }
  .locked__toc li {
    display: grid;
    grid-template-columns: 2rem 11rem minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 0;
    border-top: 1px solid var(--rule);
  }
  .locked__toc li:last-child { border-bottom: 1px solid var(--rule); }
  @media (max-width: 600px) {
    .locked__toc li { grid-template-columns: 2rem minmax(0, 1fr); row-gap: 0.5rem; }
    .locked__open, .locked__bars { grid-column: 2; }
  }
  .locked__sec { color: var(--fg); }
  .locked__open { font-size: var(--step-small); line-height: 1.5; }
  .locked__bars { display: flex; flex-direction: column; gap: 0.4rem; }
  .locked__bar { display: block; height: 0.55rem; background: var(--fg); opacity: 0.85; }

  .locked__back {
    margin-top: 2.5rem;
    color: var(--fg-dim);
    text-decoration: none;
    transition: color var(--dur-hover) var(--ease-out);
  }
  .locked__back:hover { color: var(--fg); }
</style>

<script>
  // Identical logic to CaseGate.astro's script, duplicated rather than
  // shared — every other component here owns its own inline script, and a
  // ~30-line compare/reveal routine isn't worth a shared module for two
  // call sites. Reveals the whole page (the caller wraps it in one hidden
  // container) rather than one trailing section.
  document.querySelectorAll<HTMLElement>('.locked[data-gate]').forEach((gate) => {
    const slug = gate.dataset.slug!;
    const password = gate.dataset.password ?? '';
    const target = document.getElementById(gate.dataset.target!);
    const form = gate.querySelector<HTMLFormElement>('[data-gate-form]');
    const input = gate.querySelector<HTMLInputElement>('.locked__input');
    const err = gate.querySelector<HTMLElement>('[data-gate-err]');
    const peek = gate.querySelector<HTMLButtonElement>('[data-gate-peek]');
    if (!target || !form || !input) return;

    const storeKey = `case-unlocked:${slug}`;

    const reveal = () => {
      target.hidden = false;
      gate.hidden = true;
      gate.setAttribute('aria-hidden', 'true');
    };

    try {
      if (sessionStorage.getItem(storeKey) === '1') reveal();
    } catch {
      /* Storage can be unavailable — the form still works, it just won't
         remember across a reload. */
    }

    peek?.addEventListener('click', () => {
      const showing = peek.getAttribute('aria-pressed') === 'true';
      input.type = showing ? 'password' : 'text';
      peek.setAttribute('aria-pressed', String(!showing));
      peek.setAttribute('aria-label', showing ? 'Show passcode' : 'Hide passcode');
      peek.querySelectorAll<SVGElement>('[data-eye-open]').forEach((p) => {
        p.style.display = showing ? '' : 'none';
      });
      peek.querySelectorAll<SVGElement>('[data-eye-closed]').forEach((p) => {
        p.style.display = showing ? 'none' : '';
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const ok = input.value.trim().toLowerCase() === password.trim().toLowerCase();
      if (!ok) {
        err?.removeAttribute('hidden');
        input.setAttribute('aria-invalid', 'true');
        return;
      }
      err?.setAttribute('hidden', '');
      input.removeAttribute('aria-invalid');
      try { sessionStorage.setItem(storeKey, '1'); } catch { /* see above */ }
      reveal();
    });
  });
</script>
