---
/* LockedGate.astro — the full-page state a FULLY locked case study shows
   instead of the case itself. Distinct from CaseGate.astro, which is the
   compact inline panel a PARTIALLY gated case shows part-way down its own
   page (see the `locked` field's comment in cases.ts for which is which).

   Layout "D" of five mocks (experiments/locked-gate), chosen on request:
   it shows what's behind the lock instead of only saying so. Everything
   sits in one centred column (on request, experiments/locked-gate/
   centered.html), top to bottom: the case named in a mono line, the
   headline, one paragraph, the public version — Role, Scope, Outcome as
   three soft cards (no Team, on request) — then the passcode form and a
   way to ask for it. A recruiter gets level and scope without the
   passcode.
   The cards are the About page's (option A, grey, of the mocks in
   experiments/locked-gate/soft-cards.html, on request, 2026-11-14): a
   3% ink fill, no border, 28px corners, under LOCKED GATE in
   tokens.css — an exception to the square --radius rule, this page
   only. They replaced a hairline row; the numbered contents list with
   ink redaction bars under the form was removed with them.
   The passcode field is a single underline (option 1 of six in
   experiments/locked-gate/inputs.html, on request), with the show/hide
   eye at its end. Beside it, the pill pair's round ink arrow sends it
   (on request, 2026-11-26, "H · Arrow beside the field" of
   experiments/unlock-feedback/; the Unlock pill is gone). It's a real
   submit button named "Unlock". Empty, it asks for the passcode; wrong,
   the field nudges and the text is selected to retype; right, the
   circle turns green with a tick that holds until the case's cover has
   loaded (at most --unlock-wait-max, "Opening the case…" if it's slow),
   then the gate fades and the case rises at the top. Values under
   LOCKED GATE · UNLOCK in tokens.css. Its reason: a visitor knows the
   passcode worked before a slow page arrives.
   The paragraph and the facts are 13px (--step-small), not body size:
   in Manrope 600 at 15px the paragraph competed with the headline;
   ozgur.design and allierho.com both keep their gate copy quieter.
   No other motion. Under reduced motion the states simply switch.
   Copy chosen on request from the mock's copy bank.

   Same security model as CaseGate — static site, no server, so this is a
   soft deterrent, not confidentiality. See cases.ts.

   It takes the site's one passcode (site.lock in data/site.ts, checked
   and remembered by scripts/unlock.ts, on request 2026-11-18): the right
   one here unlocks the whole site and every locked case, and a visitor
   who already typed it anywhere never sees this page. A locked card
   frosts on hover before the click (LockFrost.astro); this is where the
   click lands. */
import { gmailCompose } from '../data/site';
import LockIcon from './LockIcon.astro';

interface Props {
  slug: string;
  caseTitle: string;
  company: string;
  role: string;
  scope?: string;
  outcome?: string;
  backHref?: string;
  targetId: string;
}
const {
  slug, caseTitle, company, role, scope, outcome,
  backHref = '/work', targetId,
} = Astro.props;
const mailHref = gmailCompose(`Passcode for "${caseTitle}"`);
const facts = [
  { term: 'Role', detail: role },
  { term: 'Scope', detail: scope },
  { term: 'Outcome', detail: outcome },
].filter((f) => f.detail);
---
<div class="locked" data-locked-gate data-slug={slug} data-target={targetId}>
  <div class="locked__col">
    <p class="u-label-mono locked__eyebrow">
      <LockIcon size="1.1em" />
      <span>{company} · Under NDA</span>
    </p>
    <p class="locked__case">{caseTitle}</p>
    <h1 class="locked__head">The interesting parts are <em>confidential</em>.</h1>
    <p class="locked__body">
      The detailed process is protected, but here is the public version.
      Have the passcode? Step in for the full case study.
    </p>
    {facts.length > 0 && (
      <dl class="locked__facts">
        {facts.map((f) => (
          <div>
            <dt class="u-label-mono">{f.term}</dt>
            <dd>{f.detail}</dd>
          </div>
        ))}
      </dl>
    )}

    <form class="locked__form" data-gate-form autocomplete="off">
      <label class="u-label-mono locked__label" for={`locked-pw-${slug}`}>Passcode</label>
      <div class="locked__row">
        <div class="locked__input-wrap" data-gate-wrap>
          <input
            class="locked__input"
            id={`locked-pw-${slug}`}
            name="password"
            type="password"
            autocomplete="off"
            aria-describedby={`locked-err-${slug}`}
          />
          <button class="locked__peek" type="button" data-gate-peek aria-label="Show passcode" aria-pressed="false">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path data-eye-open d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" />
              <circle data-eye-open cx="12" cy="12" r="3" />
              <path data-eye-closed d="M3 3l18 18M10.6 10.6a3 3 0 0 0 4.24 4.24M9.88 4.24A10.9 10.9 0 0 1 12 4c7 0 11 8 11 8a17.6 17.6 0 0 1-3.06 4.06M6.1 6.1A17.4 17.4 0 0 0 1 12s4 8 11 8a10.6 10.6 0 0 0 4.9-1.2" style="display:none" />
            </svg>
          </button>
        </div>
        <button class="locked__go" type="submit" aria-label="Unlock" data-gate-go>
          <svg class="locked__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          <svg class="locked__arrow locked__arrow--next" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          <svg class="locked__tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path pathLength="1" d="M5 12.5l4.5 4.5L19 7.5" /></svg>
        </button>
      </div>
      <p class="locked__err" id={`locked-err-${slug}`} role="alert" data-gate-err></p>
      <p class="u-label-mono locked__wait" data-gate-wait aria-hidden="true">Opening the case<span>.</span><span>.</span><span>.</span></p>
      <p class="u-sr-only" role="status" data-gate-live></p>
    </form>
    <p class="locked__reach">
      No passcode? <a href={mailHref} target="_blank" rel="noopener">Email me<span class="u-sr-only"> (opens Gmail in a new tab)</span></a> and I'll walk you through it.
    </p>

    <a class="locked__back u-label-mono" href={backHref}>
      <span aria-hidden="true">◂</span> All work
    </a>
  </div>
</div>

<style>
  .locked {
    background: var(--bg);
    color: var(--fg);
    padding: calc(var(--nav-h) + var(--space-band)) var(--gutter) var(--space-band);
  }
  /* One centred column. The text centres; the facts row and the contents
     list are left-aligned tables inside the same centred width. */
  .locked__col {
    max-width: 48rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .locked__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
  }
  .locked__case { margin: 0 0 0.4rem; font-size: var(--step-small); color: var(--fg-dim); }
  .locked__head {
    font-family: var(--font-serif);
    font-weight: var(--weight-serif);
    font-size: var(--step-case-title);
    line-height: 1.1;
    letter-spacing: var(--tracking-serif);
    margin: 0 0 0.9rem;
    text-wrap: balance;
  }
  .locked__head em { font-style: italic; }
  .locked__body {
    margin: 0 0 2.25rem;
    max-width: 34rem;
    font-size: var(--step-small);
    line-height: 1.7;
    color: var(--fg-dim);
    text-wrap: balance;
  }

  /* ---- the public version: three soft cards ---- */
  .locked__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--locked-card-gap);
    width: 100%;
    margin: 0 0 2.5rem;
    text-align: left;
  }
  .locked__facts > div {
    background: var(--locked-card);
    border-radius: var(--radius-locked-card);
    padding: var(--locked-card-pad);
  }
  .locked__facts dt { margin-bottom: 0.45rem; }
  .locked__facts dd { margin: 0; font-size: var(--step-small); line-height: 1.55; }
  @media (max-width: 700px) {
    .locked__facts { grid-template-columns: 1fr; }
  }

  /* ---- the form ---- */
  .locked__form {
    width: 100%;
    max-width: 22rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .locked__label { display: block; margin: 0 0 0.25rem; }
  .locked__row { display: flex; align-items: center; gap: var(--unlock-gap); width: 100%; }
  /* One underline, no box. --fg at rest (a control's boundary needs 3:1),
     thicker while focused (ink, never the accent). */
  .locked__input-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
    border-bottom: 1px solid var(--fg);
    transition: border-color var(--dur-hover) var(--ease-out);
  }
  /* Focus thickens the line to 2px, so the focus state is a change of
     weight, not of colour. */
  .locked__input-wrap:focus-within { border-bottom-color: var(--focus); box-shadow: 0 1px 0 var(--focus); }
  .locked__input-wrap:has([aria-invalid='true']) { border-bottom-color: var(--accent-text); }
  .locked__input {
    width: 100%;
    font: inherit;
    font-size: var(--step-body);
    color: var(--fg);
    background: none;
    border: 0;
    border-radius: 0;
    padding: 0.6rem 2.5rem;
    text-align: center;
  }
  /* The underline itself thickens on focus, so the field needs no
     second ring. */
  .locked__input:focus-visible { outline: none; }
  .locked__peek {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--fg-dim);
    cursor: pointer;
    transition: color var(--dur-hover) var(--ease-out);
  }
  .locked__peek:hover { color: var(--fg); }
  .locked__peek:focus-visible { outline: 2px solid var(--focus); outline-offset: 0; }
  /* A wrong passcode: one short nudge, beside the words that say so. */
  .locked__input-wrap.is-wrong { animation: locked-nudge var(--dur-unlock-nudge) var(--ease-pair-swap); }
  @keyframes locked-nudge {
    20% { translate: calc(var(--unlock-nudge) * -1) 0; }
    40% { translate: calc(var(--unlock-nudge) * 0.8) 0; }
    60% { translate: calc(var(--unlock-nudge) * -0.5) 0; }
    80% { translate: calc(var(--unlock-nudge) * 0.3) 0; }
  }

  /* The pill pair's round arrow (PILL PAIR in tokens.css): on hover the
     arrow slides out as a fresh one slides in. Right passcode: green,
     and the arrow gives way to a tick that draws in. */
  .locked__go {
    position: relative;
    flex: none;
    overflow: hidden;
    width: var(--unlock-go);
    height: var(--unlock-go);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--pair-bg);
    color: var(--pair-fg);
    cursor: pointer;
    transition: background-color var(--dur-hover) var(--ease-out), transform 0.1s ease-out;
  }
  .locked__go:active { transform: scale(0.94); }
  .locked__go:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .locked__go svg {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 16px;
    height: 16px;
  }
  .locked__arrow { transition: transform var(--pair-swap) var(--ease-pair-swap), opacity var(--dur-hover) var(--ease-out); }
  .locked__arrow--next { transform: translateX(-200%); }
  .locked__go:is(:hover, :focus-visible):not(.is-yes) .locked__arrow:first-child { transform: translateX(200%); }
  .locked__go:is(:hover, :focus-visible):not(.is-yes) .locked__arrow--next { transform: none; }
  .locked__tick {
    opacity: 0;
    transform: scale(0.4);
    transition: opacity var(--dur-hover) var(--ease-out), transform var(--dur-hover) var(--ease-out);
  }
  .locked__tick path { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset var(--dur-hover) var(--ease-out) 0.14s; }
  .locked__go.is-yes { background: var(--unlock-ok); color: var(--unlock-tick); cursor: default; }
  .locked__go.is-yes .locked__arrow { opacity: 0; }
  .locked__go.is-yes .locked__tick { opacity: 1; transform: none; }
  .locked__go.is-yes .locked__tick path { stroke-dashoffset: 0; }

  .locked__err { margin: 0.6rem 0 0; min-height: 1.2em; font-size: var(--step-small); color: var(--accent-text); }
  .locked__err:empty { min-height: 0; }
  .locked__wait { margin: 0.6rem 0 0; opacity: 0; transition: opacity var(--dur-hover) var(--ease-out); }
  .locked__wait.is-on { opacity: 1; }
  .locked__wait span { animation: locked-dot 1.2s infinite; }
  .locked__wait span:nth-child(2) { animation-delay: 0.2s; }
  .locked__wait span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes locked-dot { 0%, 100% { opacity: 0.2; } 40% { opacity: 1; } }
  .locked.is-leaving { opacity: 0; transition: opacity var(--unlock-leave) var(--ease-out); }

  @media (prefers-reduced-motion: reduce) {
    .locked__input-wrap.is-wrong, .locked__wait span { animation: none; }
    .locked__go, .locked__go *, .locked.is-leaving { transition: none; }
  }
  .locked__reach { margin: 1.5rem 0 0; font-size: var(--step-small); color: var(--fg-dim); }
  /* Its link is the site's plain link (LINKS in tokens.css, `a` in
     global.css): no rule of its own here. */

  .locked__back {
    margin-top: 2.5rem;
    color: var(--fg-dim);
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-out);
  }
  .locked__back:hover,
  .locked__back:focus-visible { color: var(--fg); }
</style>

<script>
  import { passcodeMatches, unlock, onUnlocked, isUnlocked } from '../scripts/unlock';
  import { cssMs } from '../scripts/css-time';

  // The same compare/remember as every gate (scripts/unlock.ts). Reveals
  // the whole page (the caller wraps it in one hidden container).
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, reduce() ? 0 : ms));

  /* The case's cover sits in the hidden page, where a lazy image never
     loads, so fetch and decode its file on the side. */
  const coverReady = (target: HTMLElement) => {
    const img = target.querySelector<HTMLImageElement>('img');
    const src = img?.currentSrc || img?.src;
    if (!src) return Promise.resolve();
    const pre = new Image();
    if (img?.srcset) { pre.srcset = img.srcset; pre.sizes = img.sizes; }
    pre.src = src;
    return pre.decode().catch(() => {});
  };

  document.querySelectorAll<HTMLElement>('[data-locked-gate]').forEach((gate) => {
    const target = document.getElementById(gate.dataset.target!);
    const form = gate.querySelector<HTMLFormElement>('[data-gate-form]');
    const input = gate.querySelector<HTMLInputElement>('.locked__input');
    const wrap = gate.querySelector<HTMLElement>('[data-gate-wrap]');
    const go = gate.querySelector<HTMLButtonElement>('[data-gate-go]');
    const err = gate.querySelector<HTMLElement>('[data-gate-err]');
    const wait = gate.querySelector<HTMLElement>('[data-gate-wait]');
    const live = gate.querySelector<HTMLElement>('[data-gate-live]');
    const peek = gate.querySelector<HTMLButtonElement>('[data-gate-peek]');
    if (!target || !form || !input || !wrap || !go) return;

    const reveal = () => {
      target.hidden = false;
      gate.hidden = true;
      gate.setAttribute('aria-hidden', 'true');
    };
    // Unlocked before this page (another tab, an earlier visit): no gate.
    if (isUnlocked()) { reveal(); return; }
    let busy = false;
    // Unlocked by another gate on this page: follow it.
    onUnlocked(() => { if (!busy) reveal(); });

    peek?.addEventListener('click', () => {
      const showing = peek.getAttribute('aria-pressed') === 'true';
      input.type = showing ? 'password' : 'text';
      peek.setAttribute('aria-pressed', String(!showing));
      peek.setAttribute('aria-label', showing ? 'Show passcode' : 'Hide passcode');
      peek.querySelectorAll<SVGElement>('[data-eye-open]').forEach((p) => {
        p.style.display = showing ? '' : 'none';
      });
      peek.querySelectorAll<SVGElement>('[data-eye-closed]').forEach((p) => {
        p.style.display = showing ? 'none' : '';
      });
    });

    const say = (msg: string) => {
      if (err) err.textContent = msg;
      input.setAttribute('aria-invalid', 'true');
    };
    input.addEventListener('input', () => {
      if (err) err.textContent = '';
      input.removeAttribute('aria-invalid');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (busy) return;
      if (!input.value.trim()) { say('Enter the passcode.'); input.focus(); return; }
      if (!passcodeMatches(input.value)) {
        say("That's not it. Try again.");
        wrap.classList.remove('is-wrong');
        void wrap.offsetWidth;
        wrap.classList.add('is-wrong');
        input.focus();
        input.select();
        return;
      }

      busy = true;
      if (err) err.textContent = '';
      input.removeAttribute('aria-invalid');
      input.readOnly = true;
      go.classList.add('is-yes');
      go.setAttribute('aria-label', 'Unlocked');
      if (live) live.textContent = 'Unlocked. Opening the case study.';
      unlock();

      // Hold the tick at least --unlock-hold, and until the cover has
      // loaded, but never longer than --unlock-wait-max.
      const slow = setTimeout(() => wait?.classList.add('is-on'), cssMs('--unlock-slow', 1200));
      await Promise.all([
        sleep(cssMs('--unlock-hold', 900)),
        Promise.race([coverReady(target), new Promise((r) => setTimeout(r, cssMs('--unlock-wait-max', 2500)))]),
      ]);
      clearTimeout(slow);

      gate.classList.add('is-leaving');
      await sleep(cssMs('--unlock-leave', 280));
      reveal();
      window.scrollTo({ top: 0, behavior: 'instant' });
      // The case's opening parts rise, as on arriving from another page.
      const root = document.documentElement;
      delete root.dataset.arrive;
      void root.offsetWidth;
      root.dataset.arrive = '';
      target.setAttribute('tabindex', '-1');
      target.focus({ preventScroll: true });
    });
  });
</script>
