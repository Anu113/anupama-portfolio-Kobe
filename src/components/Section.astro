---
/* Wraps a band of the page. Usage: <Section theme="bone">...</Section>
   `theme` still stamps data-theme on the band, but since the move to
   allierho.com's single palette every theme name resolves to the same
   colours (tokens.css, ROLE COLOURS) — it's inert, kept so the markup
   didn't need touching everywhere. */
interface Props {
  theme?: 'ink' | 'sand' | 'bone' | 'clay' | 'sage' | 'lilac' | 'coral' | 'ember' | 'charcoal';
  full?: boolean; id?: string; class?: string;
}
const { theme = 'bone', full = false, id, class: cls = '' } = Astro.props;
---
<section
  data-theme={theme}
  data-themeband
  id={id}
  class={`u-section ${full ? '' : 'u-shell'} ${cls}`}
  style="background: var(--bg); color: var(--fg);"
>
  <slot />
</section>

