---
/* Wraps a band of the page in a palette. The nav recolours to match.
   Usage: <Section theme="sand">...</Section>
   Themes available (defined in tokens.css):
     ink | sand | bone | clay      — the editorial four
     sage | lilac | coral          — the saturated chapter-card grounds
   Each also has a night variant; the nav toggle switches between them. */
interface Props {
  theme?: 'ink' | 'sand' | 'bone' | 'clay' | 'sage' | 'lilac' | 'coral';
  full?: boolean; id?: string; class?: string;
}
const { theme = 'ink', full = false, id, class: cls = '' } = Astro.props;
---
<section
  data-theme={theme}
  data-themeband
  id={id}
  class={`u-section ${full ? '' : 'u-shell'} ${cls}`}
  style="background: var(--bg); color: var(--fg);"
>
  <slot />
</section>
