---
/* ProjectCard.astro — the home page's "Selected work" panel: one project,
   one full-width row, one unified card. Built after studying
   tobias-ecsedy.com's project cards — the presentation and interaction
   only, not its type, colour or branding (explicitly not the brief): a
   single outer padding wraps both the hero canvas and the text underneath
   it, so the artwork sits inset from the card's own edge instead of a
   separate image tile with a caption below. The whole card is one <a>,
   not an image with a button next to it.

   `theme` is the card's own background — one colour from tokens.css's
   palette, the same data-theme mechanism as every other themed band on the
   site — so each project reads as its own coloured panel against the
   page's (usually ink) ground. That contrast between panel and page draws
   the "clearly defined boundary" instead of a literal border, and it's
   also what makes this a genuinely reusable card: swap the theme and nine
   more design decisions (--fg, --fg-dim, --screen, --shell, the night
   variant) come along for free, already tuned for contrast.

   The hero is a canvas, not an image container — a gallery wall she pins
   assets to, not a picture frame that gets replaced by one. Its own
   background is a muted step off the card's `--bg` (`color-mix`, same hue
   family — a genuinely different colour, the way `--screen` is, reads as
   the wrong project's palette leaking into this one), and it stays visible
   behind whatever sits on it: `object-fit: contain` inside a padded flex
   box, not `cover` filling the box edge-to-edge, because most of what gets
   pinned here — a browser window, a phone mockup, a floating UI piece —
   will be a transparent PNG that's meant to float on the wall, not a photo
   that's meant to fill it. Hero content is a named slot for exactly that
   reason: pass slot="hero" for anything richer than one asset (a layered
   composition, a video, several mockups at once) and the card doesn't need
   a new prop per media type. `image`/`alt`/`ratio` stay as the one-asset
   shorthand, since that covers most projects today.

   The hover label is the same HoverLabel.astro every card uses — a pill
   that tracks the cursor across the *whole* card, not just the hero canvas,
   which is why it renders as a sibling of `.pc__hero` and `.pc__body`
   rather than nested inside the hero: nested, the pill couldn't reach the
   cursor once it left the canvas for the title/tagline underneath. `theme`
   is set on `.pc` itself already, so the pill's colour needs no extra
   wiring here (contrast HoverLabel's note on CaseCard, whose card root
   isn't themed). An earlier pass here put the label in the text stack
   instead (a line under the tagline) with a lift-and-shadow on the card
   itself; both are gone in favour of the one shared hover affordance every
   card now has. */
import type { HoverState } from '../data/hoverState';
import HoverLabel from './HoverLabel.astro';
import LockIcon from './LockIcon.astro';

interface Props {
  company: string; title: string; tagline: string; href: string;
  image?: string; alt?: string; ratio?: string;
  theme?: 'ink' | 'bone' | 'sand' | 'clay' | 'sage' | 'lilac' | 'coral' | 'ember';
  hoverState?: HoverState;
  locked?: boolean;
}
const {
  company, title, tagline, href,
  image, alt = '', ratio = '2 / 1',
  theme = 'ink',
  hoverState = 'case-study',
  locked = false,
} = Astro.props;
const hasHeroSlot = Astro.slots.has('hero');
---
<a class="pc" href={href} data-theme={theme} data-hover-trigger>
  <div class="pc__hero" style={`--ratio: ${ratio};`}>
    {hasHeroSlot ? <slot name="hero" /> : (image && <img src={image} alt={alt} loading="lazy" decoding="async" />)}
  </div>
  <HoverLabel state={hoverState} />
  <div class="pc__body">
    <p class="pc__co u-label">{company}</p>
    <h2 class="pc__title">
      {title}
      {locked && <LockIcon class="pc__lock" size="0.6em" />}
    </h2>
    <p class="pc__tagline">{tagline}</p>
  </div>
</a>

<style>
  .pc {
    display: block;
    position: relative;   /* HoverLabel now tracks the whole card, not just the hero */
    /* HoverLabel's pill is the cursor here — no second, native hand icon. */
    cursor: none;
    text-decoration: none;
    color: var(--fg);
    background: var(--bg);
    border-radius: var(--radius);
    padding: clamp(1.75rem, 3.5vw, 3rem);
  }
  /* No shadow, no lift on hover — the card itself stays still. The hover
     affordance is HoverLabel tracking the cursor over the canvas below. */

  /* The canvas — a wall, not a picture. Its background is a muted step off
     the card's own --bg (same hue family, ~5% toward black) rather than
     --screen, which is tuned as a *contrasting* device-frame tone on
     purpose elsewhere and reads as a different project's colour leaking in
     here. object-fit: contain + this padding is what keeps it a wall a PNG
     gets pinned to: an asset is centred and shown whole, and the canvas
     colour stays visible around it instead of the asset cropping to cover
     every corner. */
  .pc__hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--bg) 95%, black 5%);
    aspect-ratio: var(--ratio);
    border-radius: var(--radius);
    overflow: hidden;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }
  /* :global — hero content is as likely to arrive via the slot (a phone
     frame, a video, several pinned assets) as via the `image` prop. */
  .pc__hero img,
  .pc__hero :global(img),
  .pc__hero :global(video) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .pc__body { max-width: 44ch; }
  .pc__co { color: var(--fg-dim); margin: 0 0 0.6rem; }
  .pc__title {
    font-family: var(--font-display);
    font-size: var(--step-h2);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    font-weight: 500;
    margin: 0 0 0.6rem;
    text-wrap: balance;
  }
  .pc__lock { margin-left: 0.4em; color: var(--fg-dim); vertical-align: middle; }
  /* Small and quiet on purpose — a caption, not a second headline. The
     first pass sized this at --step-h3 and it competed with the title for
     the same moment, which is also what was making the card run tall. */
  .pc__tagline {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: var(--step-body);
    color: var(--fg-dim);
    line-height: 1.4;
    margin: 0;
    max-width: 42ch;
    text-wrap: pretty;
  }

  @media (max-width: 640px) {
    .pc__body { max-width: none; }
  }
</style>
