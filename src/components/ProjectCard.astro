---
/* ProjectCard.astro — the home page's "Selected work" row: one project,
   one full-width card, text on the left and its media on the right.
   Redesigned from an earlier stacked (hero-on-top) layout after review
   against a reference row-card pattern: same two-column shape, numbered
   index, pill role tags and an explicit "View case study" line, kept on
   this site's own palette and typography rather than the reference's
   colours.

   Colour: the card itself is the page's white; only the media half is
   coloured, with the company's project hue (hueFor() in data/work.ts,
   PROJECT HUES in tokens.css) — so every card reads the same and only
   the picture changes. `theme` is still accepted but inert.

   Hard-edged (`border-radius: 0`), unlike every other card/image/button
   on the site, which share --radius (20px) — see .pc's own inline
   comment. Once these cards started stacking on scroll (see the sticky
   rows in index.astro), a rounded corner peeking out from under the
   next square-ish edge looked like a rendering glitch rather than an
   intentional shingle; the flat edge reads as a deliberate stack.

   The hero is a canvas, not a picture frame: its own background is a
   muted step off the card's `--bg`, and whatever's pinned to it sits
   inset via `object-fit: contain`, not `cover` — most of what lands
   here (a browser window, a phone mockup, a floating UI piece) is a
   transparent PNG meant to float on the wall, not a photo meant to
   fill it. `image`/`alt` are the one-asset shorthand; pass
   `slot="hero"` for anything richer (a layered composition, a video,
   several mockups at once). No `ratio` prop — this card's row height
   is fixed (see .pc's own height comment), unlike CaseCard.astro's
   /work grid tiles, which do vary their media ratio per tile.

   The hover label is the same HoverLabel.astro every card uses,
   rendered as a sibling of `.pc__hero`/`.pc__body` so its cursor-follow
   pill can reach the whole card, not just the media half. `index` and
   `tags` are new: the number is decorative (aria-hidden, the link
   itself already names the project), the tags are real text — quiet
   metadata about what she actually did on it, not another loud visual
   element. They sit in one row with the company above the title —
   `OKTA · ENTERPRISE · PRODUCT STRATEGY` — after carlthomasiv.com's
   case-study list; the page passes labelsFor(w) (data/work.ts). */
import type { HoverState } from '../data/hoverState';
import HoverLabel from './HoverLabel.astro';
import LockIcon from './LockIcon.astro';
import { hueFor } from '../data/work';

interface Props {
  index: number;
  company: string; title: string; tagline: string; href: string;
  tags?: string[];
  image?: string; alt?: string;
  theme?: 'ink' | 'bone' | 'sand' | 'clay' | 'sage' | 'lilac' | 'coral' | 'ember';
  hoverState?: HoverState;
  locked?: boolean;
}
const {
  index,
  company, title, tagline, href,
  tags = [],
  image, alt = '',
  theme = 'ink',
  hoverState = 'case-study',
  locked = false,
} = Astro.props;
const num = String(index).padStart(2, '0');
---
<a class={`pc ${hoverState === 'case-study' ? 'pc--no-pill' : ''}`} href={href} data-theme={theme} data-hover-trigger>
  <div class="pc__body">
    <p class="pc__num" aria-hidden="true">{num}</p>
    {/* COMPANY · [domain] [discipline]… — after carlthomasiv.com; the
        chips come from labelsFor() in data/work.ts. */}
    <div class="pc__meta">
      <p class="pc__co u-label">{company}</p>
      {tags.length > 0 && (
        <>
          <span class="pc__dot u-label" aria-hidden="true">·</span>
          <ul class="pc__tags" aria-label="Domain and discipline">
            {tags.map((t) => <li>{t}</li>)}
          </ul>
        </>
      )}
    </div>
    <h2 class="pc__title">
      {title}
      {locked && <LockIcon class="pc__lock" size="0.6em" />}
    </h2>
    <p class="pc__tagline">{tagline}</p>
    <span class="pc__cta">View case study <span class="pc__arrow" aria-hidden="true">→</span></span>
  </div>

  <div class="pc__hero" data-hue={hueFor(company) ?? ''}>
    {/* Both, not either/or: index.astro passes the hero slot inside a
        `{'video' in w && …}` condition, and Astro counts that slot as
        present even when the condition renders nothing — which left every
        image card's media empty. The page passes `image` only when there's
        no video, so at most one of these renders. */}
    <slot name="hero" />
    {image && <img src={image} alt={alt} loading="lazy" decoding="async" />}
  </div>

  {hoverState !== 'case-study' && <HoverLabel state={hoverState} />}
</a>

<style>
  .pc {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    /* minmax(0, 1fr), not the implicit auto row this used to have —
       an auto row won't shrink below its content's own min-content
       size even when the container has a definite height (a two-line
       title makes the whole grid taller than a one-line title's,
       overriding `height` below). minmax(0, ...) gives the row an
       explicit floor of 0, so `height` actually wins and the taller
       content clips via `overflow: hidden` instead. */
    grid-template-rows: minmax(0, 1fr);
    align-items: stretch;
    gap: var(--card-gap);
    /* Fixed, not content-driven — every row in the list is this same
       height regardless of title length or tag count, so the grid
       reads as evenly composed instead of jumping card to card. Text
       that doesn't fit clamps (below) rather than growing the row.
       672px = 420px + 60%. A +20% (806px) pass was tried and reverted —
       back to the original height; the sharp corners below stayed. */
    height: 672px;
    position: relative;   /* HoverLabel tracks the whole card */
    cursor: none;         /* HoverLabel's pill is the cursor here */
    text-decoration: none;
    color: var(--fg);
    background: var(--bg);
    /* Hard-edged on purpose, unlike every other card/image/button on the
       site (which share --radius, 20px) — the stacked "Selected work"
       rows read better with a sharp edge where one card's top slides
       under the next, so this is a deliberate, scoped exception rather
       than a change to the sitewide --radius token. */
    border-radius: 0;
    padding: var(--card-pad);   /* the footer insets by this too */
    overflow: hidden;
    transition: transform var(--dur-hover) var(--ease-out);
  }
  /* case-study cards already show a static "View case study" line in
     .pc__body (below) — HoverLabel's cursor-follow pill would just
     repeat it, so it's left unrendered for this state (see the .astro
     file's template) and the native pointer cursor comes back instead
     of the `cursor: none` above, which otherwise assumes the pill is
     standing in for the cursor. */
  .pc.pc--no-pill {
    cursor: pointer;
  }

  .pc__body { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .pc__num {
    font-family: var(--font-sans); font-weight: var(--weight-sans);
    font-size: var(--step-body);
    color: var(--fg-dim);
    margin: 0 0 clamp(1rem, 2vw, 1.5rem);
  }
  .pc__meta {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.9rem;
  }
  .pc__dot { color: var(--fg-dim); }
  .pc__co {
    color: var(--fg-dim);
    margin: 0;
    transition: color var(--dur-micro) var(--ease-out);
  }
  .pc:hover .pc__co { color: var(--fg); }
  .pc__title {
    font-family: var(--font-serif);
    font-size: var(--step-heading);
    line-height: 1.15;
    letter-spacing: var(--tracking-serif);
    font-weight: var(--weight-serif);
    margin: 0 0 0.6rem;
    text-wrap: balance;
    /* Clamped, not left to grow — a longer title stays the same card
       height as a short one; see .pc's own comment on why. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc__lock { margin-left: 0.4em; color: var(--fg-dim); vertical-align: middle; }
  .pc__tagline {
    font-family: var(--font-serif); font-weight: var(--weight-serif); letter-spacing: var(--tracking-serif);
    font-style: italic;
    font-size: var(--step-body);
    color: var(--fg-dim);
    line-height: 1.4;
    margin: 0 0 1.1rem;
    max-width: 40ch;
    text-wrap: pretty;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Label chips — quiet metadata, not another loud element: a hairline
     box, no fill, small tracked caps, square like the rest of the
     site's cards (the reference's chips are square-cornered too). */
  .pc__tags {
    display: contents;
    list-style: none; margin: 0; padding: 0;
  }
  .pc__tags li {
    font-family: var(--font-sans);
    font-size: var(--step-label);
    font-weight: var(--weight-sans);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-dim);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 0.25rem 0.55rem;
  }

  .pc__cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-sans);
    font-size: var(--step-label);
    font-weight: var(--weight-sans);
    color: var(--fg);
    text-decoration: underline dotted 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in oklab, currentColor 38%, transparent);
    transition: text-decoration-color var(--dur-micro) var(--ease-out);
  }
  .pc:hover .pc__cta { text-decoration-color: currentColor; }
  .pc__arrow {
    opacity: 0.7;
    transition: opacity var(--dur-micro) var(--ease-out),
                transform var(--dur-micro-move) var(--ease-out);
  }
  .pc:hover .pc__arrow { opacity: 1; transform: translate(2px, -2px); }

  /* The canvas — a wall, not a picture. The company's project hue
     (tokens.css, PROJECT HUES; the only colour on the card), object-fit:
     contain so a pinned asset centres and shows whole instead of
     cropping to cover every edge. */
  .pc__hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--hue);
    border-radius: 0; /* matches .pc's own hard edge — see its comment */
    overflow: hidden;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    /* Fills whatever height .pc's own fixed height leaves it via grid
       stretch — `aspect-ratio` dropped since a fixed-height row can't
       also honour an aspect ratio without one of the two losing. */
    height: 100%;
    min-height: 0;
  }
  .pc__hero img,
  .pc__hero :global(img),
  .pc__hero :global(video) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    transition: transform var(--dur-hover) var(--ease-out);
  }
  /* A one-pixel lift on the pinned asset itself, same idea as the CTA
     arrow's nudge — a small, immediate sign the row is "live" under the
     cursor, not a parallax effect. */
  .pc:hover .pc__hero img,
  .pc:hover .pc__hero :global(img),
  .pc:hover .pc__hero :global(video) {
    transform: translateY(-4px);
  }

  @media (max-width: 860px) {
    .pc { grid-template-columns: 1fr; height: auto; }
    .pc__hero { order: -1; height: 320px; }
    .pc__tagline { max-width: none; }
  }
</style>
