---
/* ProjectCard.astro — one row in the home page's "Selected work": a
   full-width card that stacks over the one before it as you scroll
   (the sticky rows and settle effect live in index.astro). Text on the
   left — number, company and label chips, title (12px caps, after
   allierho.com), one 12px line, "View case study" — and on the right a stage on the company's project hue
   holding the work itself:

   - a phone that runs the flow on its own (after daneden.me): a screen
     recording, her screens in sequence (each sliding over the last, like
     an app pushing a new screen), or a coded PayPal prototype on
     autopilot;
   - for Okta's desktop work, the screenshot on its own (a placeholder,
     drawn as a browser window, until the NDA check).

   Its UX reason: a recruiter skimming the stack sees the product
   working, not a thumbnail of it.

   Motion: a phone moves only while its card is on screen, the tab is
   visible and motion is allowed (no pause control, on request). Under
   reduced motion each phone
   shows its first screen and the recording its poster. The flows run on
   phone-loop.ts, told when to go by this file's script. Hover (fine
   pointers): the phone or screenshot rises by --phone-lift and the CTA's
   arrow nudges.

   The whole card is one link, made by stretching the title's link over
   it, not by wrapping the card in <a>: the coded prototypes are real
   buttons and inputs (inert here), which can't sit inside a link.

   Hard-edged, like the rest of the site's cards; a sharp top edge also
   reads as a deliberate shingle where one card slides over the next.
   Only the phone is round (it's the device's, PHONE CARDS in
   tokens.css). Fixed height, so every row in the stack is the same
   size whatever the copy; on narrow screens it stacks, stage first. */
import EnrollPrototype from './EnrollPrototype.astro';
import OffersPrototype from './OffersPrototype.astro';
import { hueFor, type HomeMedia } from '../data/work';

interface Props {
  index: number;
  company: string; title: string; tagline: string; href: string;
  tags?: string[];
  media: HomeMedia;
  video?: { mp4: string; webm: string; poster: string };
}
const { index, company, title, tagline, href, tags = [], media, video } = Astro.props;
const num = String(index).padStart(2, '0');
---
<article class="pc">
  <div class="pc__body">
    <p class="pc__num" aria-hidden="true">{num}</p>
    {/* COMPANY · [domain] [discipline]… — after carlthomasiv.com; the
        chips come from labelsFor() in data/work.ts. */}
    <div class="pc__meta">
      <p class="pc__co u-label">{company}</p>
      {tags.length > 0 && (
        <>
          <span class="pc__dot u-label" aria-hidden="true">·</span>
          <ul class="pc__tags" aria-label="Domain and discipline">
            {tags.map((t) => <li>{t}</li>)}
          </ul>
        </>
      )}
    </div>
    <h3 class="pc__title"><a class="pc__link" href={href}>{title}</a></h3>
    <p class="pc__tagline">{tagline}</p>
    <span class="pc__cta" aria-hidden="true">View case study <span class="pc__arrow">→</span></span>
  </div>

  <div class="pc__stage" data-hue={hueFor(company) ?? ''} data-phone role="img" aria-label={media.alt}>

    {media.type === 'desktop' ? (
      <img class="pc__desktop" src={media.image} alt="" loading="lazy" decoding="async" />
    ) : (
      <div class="pc__device" aria-hidden="true">
        <div class="pc__device-inner">
          {media.type === 'prototype' && media.name === 'paypal-enroll' && <EnrollPrototype autoplay />}
          {media.type === 'prototype' && media.name === 'paypal-offers' && <OffersPrototype autoplay />}
          {media.type !== 'prototype' && (
            <div class="pc__phone">
              <div class="pc__screen">
                {media.type === 'video' && video && (
                  <video poster={video.poster} muted loop playsinline preload="metadata" data-phone-video>
                    <source src={video.webm} type="video/webm" />
                    <source src={video.mp4} type="video/mp4" />
                  </video>
                )}
                {media.type === 'screens' && media.screens.map((src, i) => (
                  <img class:list={['pc__shot', i === 0 && 'is-on']} src={src} alt="" loading="lazy" decoding="async" data-phone-shot />
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    )}
  </div>
</article>

<style>
  .pc {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    /* minmax(0, 1fr) so the fixed height below wins over a long title;
       text that doesn't fit clamps instead of growing the row. */
    grid-template-rows: minmax(0, 1fr);
    gap: var(--card-gap);
    height: var(--card-h);
    padding: var(--card-pad);   /* the footer insets by this too */
    background: var(--bg);
    color: var(--fg);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .pc__body { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .pc__num {
    font-size: var(--step-copy);
    line-height: var(--leading-copy);
    color: var(--fg-dim);
    margin: 0 0 clamp(1rem, 2vw, 1.5rem);
  }
  .pc__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: 0 0 0.9rem; }
  .pc__dot { color: var(--fg-dim); }
  .pc__co { color: var(--fg-dim); margin: 0; transition: color var(--dur-micro) var(--ease-out); }
  .pc:hover .pc__co { color: var(--fg); }
  /* Label chips: a hairline box, no fill, square. */
  .pc__tags { display: contents; list-style: none; margin: 0; padding: 0; }
  .pc__tags li {
    font-family: var(--font-sans);
    font-size: var(--step-label);
    font-weight: var(--weight-sans);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-dim);
    border-radius: var(--radius);
    padding: 0.25rem 0.55rem;
  }
  /* Title as a 12px caps caption, the reference's project titles
     (allierho.com): the big serif is kept for the page's own heads. */
  .pc__title {
    font-family: var(--font-sans);
    font-size: var(--step-label);
    line-height: var(--leading-label);
    letter-spacing: var(--tracking-label);
    font-weight: var(--weight-sans);
    text-transform: uppercase;
    margin: 0 0 0.6rem;
    text-wrap: balance;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pc__link { color: var(--fg); text-decoration: none; }
  /* The title's link covers the whole card — see the header comment. */
  .pc__link::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  .pc__link:focus-visible { outline: none; }
  .pc:has(.pc__link:focus-visible) { outline: 2px solid var(--accent); outline-offset: -2px; }
  .pc__tagline {
    font-size: var(--step-copy);
    line-height: var(--leading-copy);
    letter-spacing: var(--tracking-copy);
    color: var(--fg-dim);
    margin: 0 0 1.1rem;
    max-width: 40ch;
    text-wrap: pretty;
  }
  .pc__cta {
    margin-top: auto;
    display: inline-flex; align-items: center; gap: 0.4em;
    font-family: var(--font-sans);
    font-size: var(--step-label);
    font-weight: var(--weight-sans);
    color: var(--fg);
    text-decoration: underline dotted 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in oklab, currentColor 38%, transparent);
    transition: text-decoration-color var(--dur-micro) var(--ease-out);
  }
  .pc:hover .pc__cta { text-decoration-color: currentColor; }
  .pc__arrow {
    opacity: 0.7;
    transition: opacity var(--dur-micro) var(--ease-out), transform var(--dur-micro-move) var(--ease-out);
  }
  .pc:hover .pc__arrow { opacity: 1; transform: translate(2px, -2px); }

  /* The stage: the project hue, the work standing on it. */
  .pc__stage {
    position: relative;
    background: var(--hue);
    min-height: 0;
    display: flex; justify-content: center; align-items: center;
    overflow: hidden;
  }

  /* --- the phone ---------------------------------------------------
     Drawn at full size (the PayPal prototypes' own size) and scaled
     down as a whole, so the coded prototypes and the screen phones are
     the same object at the same size. */
  .pc__device {
    flex: none;
    width: calc(var(--phone-w) * var(--phone-scale));
    height: calc(var(--phone-h) * var(--phone-scale));
    border-radius: calc(var(--radius-phone) * var(--phone-scale));
    box-shadow: var(--phone-shadow);
    transition: transform var(--dur-hover) var(--ease-out);
  }
  .pc__device-inner {
    width: var(--phone-w); height: var(--phone-h);
    transform: scale(var(--phone-scale));
    transform-origin: 0 0;
  }
  .pc__phone {
    width: 100%; height: 100%;
    padding: var(--phone-bezel-w);
    background: var(--phone-bezel);
    border-radius: var(--radius-phone);
  }
  .pc__screen {
    position: relative; width: 100%; height: 100%;
    overflow: hidden;
    border-radius: var(--radius-phone-screen);
    background: var(--phone-screen);
  }
  /* The recording is wider than the screen; shown whole from the top,
     its own white app ground carries on below it. */
  .pc__screen video {
    display: block; width: 100%; height: 100%;
    object-fit: contain; object-position: top;
  }
  /* Screens in sequence: the incoming one slides in over the last, which
     drifts a little the other way — an app pushing a new screen. Only
     the two screens in motion transition; the rest jump back offstage
     out of sight. */
  .pc__shot {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: top;
    transform: translateX(100%);
  }
  .pc__shot.is-on {
    z-index: 1;
    transform: none;
    transition: transform var(--dur-phone-step) var(--ease-out);
  }
  .pc__shot.is-prev {
    transform: translateX(var(--phone-parallax));
    transition: transform var(--dur-phone-step) var(--ease-out);
  }

  /* --- desktop work ----------------------------------------------
     The screenshot as given: the Okta placeholders draw their own window
     on a transparent ground, so the hue shows round it. */
  .pc__desktop {
    max-width: calc(100% - 2 * var(--phone-stage-pad)); max-height: calc(100% - 2 * var(--phone-stage-pad));
    object-fit: contain;
    display: block;
    transition: transform var(--dur-hover) var(--ease-out);
  }

  @media (hover: hover) {
    .pc:hover .pc__device,
    .pc:hover .pc__desktop { transform: translateY(var(--phone-lift)); }
  }

  /* Narrow: one column, stage first, sized to the phone. */
  @media (max-width: 860px) {
    .pc { grid-template-columns: 1fr; grid-template-rows: auto auto; height: auto; --phone-scale: var(--phone-scale-narrow); }
    .pc__stage { order: -1; padding: var(--phone-stage-pad); }
    .pc__tagline { max-width: none; }
  }
</style>

<script>
  import { phoneLoop } from '../scripts/phone-loop';

  // Which phones may move: on screen, tab visible, no reduced motion. Each stage hears phone:play / phone:pause.
  const stages = [...document.querySelectorAll<HTMLElement>('[data-phone]')];
  if (stages.length) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const inView = new Set<Element>();

    const sync = () => {
      for (const s of stages) {
        const on = !reduced.matches && !document.hidden && inView.has(s);
        if (s.dataset.playing === String(on)) continue;
        s.dataset.playing = String(on);
        s.dispatchEvent(new CustomEvent(on ? 'phone:play' : 'phone:pause'));
      }
    };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? inView.add(e.target) : inView.delete(e.target);
      sync();
    }, { threshold: 0.35 });
    stages.forEach((s) => io.observe(s));
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);

    for (const s of stages) {
      const v = s.querySelector<HTMLVideoElement>('[data-phone-video]');
      if (v) {
        s.addEventListener('phone:play', () => { v.play().catch(() => {}); });
        s.addEventListener('phone:pause', () => v.pause());
      }
      const shots = [...s.querySelectorAll<HTMLElement>('[data-phone-shot]')];
      if (shots.length > 1) {
        let i = 0;
        const next = () => {
          shots.forEach((el) => el.classList.remove('is-prev'));
          shots[i].classList.replace('is-on', 'is-prev');
          i = (i + 1) % shots.length;
          shots[i].classList.add('is-on');
        };
        phoneLoop(s, shots.map(() => [2400, next]));
      }
    }
  }
</script>
