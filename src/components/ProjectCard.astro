---
/* ProjectCard.astro — one card in the home page's "Selected work":
   one wide card, then two pairs (the grid lives in index.astro). On
   request, 2026-11-24, from experiments/home-explore/inspired.html,
   after andreas.vision's cards: a paper card, 28px corners, its work on
   the project's own hue (`ground`: okta, paypal, walmart, or the GROUND
   HUES mint and apricot where two PayPal cards would share lilac). The
   words sit left under the work; on the wide card (`wide`) they sit
   beside it, on the left (on the right with `flip`), with the title in
   the serif heading. The
   words: the company and tags (mono labels, `labelsFor()`), the title,
   one 12px line and "View case study" as the pill pair
   (PillPair.astro). The work is:

   - a phone that runs the flow on its own (after daneden.me): a screen
     recording, her screens in sequence (each sliding over the last, like
     an app pushing a new screen), a /work flow playing on its own (the
     same screens, touch marks and iOS arrivals as its /work tile, from
     data/workPlay.ts and scripts/work-play.ts), or a coded PayPal
     prototype on autopilot;
   - for Okta's desktop work, the screenshot on its own (it draws its
     own laptop and phone);
   - two phones side by side (`pair`, Scan & Go, on request 2026-11-25):
     the first plays only its flow's first screen on a loop (the scan:
     the line sweeps, the barcode catches green, the item card rises),
     the second holds a still screen (the cart). A little smaller than a
     single phone (--phone-scale-pair) so the card's colour shows above
     and below them.

   Its UX reason: a recruiter skimming the grid sees the product working,
   not a thumbnail of it.

   Hover or keyboard focus (the reused hover system): a faint oxblood
   line comes in (none at rest), the card rises a little on a soft
   layered shadow, the work inside grows a touch, and "View case study"
   fades up with its arrow swapping (it shows at rest on touch, where
   there is no hover). Values under HOME CARDS in tokens.css.

   Motion: a phone moves only while its card is on screen, the tab is
   visible and motion is allowed (no pause control, on request). Under
   reduced motion each phone shows its first screen and the recording
   its poster, and nothing rises or grows. The flows run on phone-loop.ts, told
   when to go by this file's script.

   The whole card is one link, made by stretching the title's link over
   it, not by wrapping the card in <a>: the coded prototypes are real
   buttons and inputs (inert here), which can't sit inside a link.

   A locked case (`locked`, from lockFor() in cases.ts) frosts its stage
   on hover or focus with a small lock and "Password protected"
   (LockFrost.astro, on request 2026-11-18), and still clicks through to
   its gate; screen readers hear "password protected" after the title. */
import EnrollPrototype from './EnrollPrototype.astro';
import OffersPrototype from './OffersPrototype.astro';
import type { HomeMedia } from '../data/work';
import { workPlay, isPlay } from '../data/workPlay';
import { layerHtml, HOME_SIZES } from '../scripts/work-play-layer';
import { existsSync } from 'node:fs';
import '../styles/work-play.css';
import LockFrost from './LockFrost.astro';
import LockIcon from './LockIcon.astro';
import PillPair from './PillPair.astro';

interface Props {
  company: string; title: string; tagline: string; href: string;
  tags?: string[];
  media: HomeMedia;
  video?: { mp4: string; webm: string; poster: string };
  locked?: boolean;
  ground?: 'okta' | 'paypal' | 'walmart' | 'mint' | 'apricot' | 'sage';
  wide?: boolean;
  flip?: boolean;
}
const { company, title, tagline, href, tags = [], media, video, locked = false, ground, wide = false, flip = false } = Astro.props;
const groundVar = ground === 'mint' || ground === 'apricot' || ground === 'sage' ? `var(--ground-${ground})` : ground ? `var(--hue-${ground})` : 'var(--screen)';
// The home-size screen renders (-454 / -227, see work-play-layer.ts) exist only for some flows;
// ask for them only when the first screen has one, or the browser gets a missing file and the
// phone shows black glass.
const hasHomeRenders = (src?: string) => !!src && existsSync(`public${src.replace(/\.webp$/, '-454.webp')}`);
// A 'play' card runs its /work tile's flow (data/workPlay.ts).
const flow = media.type === 'play' && isPlay(workPlay[media.play]) ? workPlay[media.play] : null;
// A 'pair' card's first phone loops only the flow's first screen (Scan & Go's scan).
const pairFull = media.type === 'pair' ? workPlay[media.play] : undefined;
const pairFlow = pairFull && isPlay(pairFull) ? { ...pairFull, steps: [pairFull.steps[0]] } : null;
---
<article class:list={['pc', wide && 'pc--wide', wide && flip && 'pc--flip']} data-locked={locked || undefined} style={`--stage-ground: ${groundVar}`}>
  <div class="pc__stage" data-phone role="img" aria-label={media.alt}>
    {media.type === 'desktop' ? (
      <img class="pc__desktop" src={media.image} alt="" loading="lazy" decoding="async" />
    ) : media.type === 'pair' ? (
      <div class="pc__pair" aria-hidden="true">
        {[pairFlow, null].map((f) => (
          <div class="pc__device">
            <i class="pc__btn"></i><i class="pc__btn"></i><i class="pc__btn"></i><i class="pc__btn"></i><i class="pc__btn"></i>
            <div class="pc__device-inner">
              <span class="pc__island"></span>
              <div class="pc__phone">
                <div class="pc__screen">
                  {f ? (
                    <div class="pc__play" data-work-play={JSON.stringify(f)} set:html={layerHtml(f.steps[0], false)} />
                  ) : (
                    <img class="pc__shot is-on" src={media.still} alt="" loading="lazy" decoding="async" />
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="pc__device" aria-hidden="true">
        <i class="pc__btn"></i><i class="pc__btn"></i><i class="pc__btn"></i><i class="pc__btn"></i><i class="pc__btn"></i>
        <div class="pc__device-inner">
          <span class="pc__island"></span>
          {media.type === 'prototype' && media.name === 'paypal-enroll' && <EnrollPrototype autoplay />}
          {media.type === 'prototype' && media.name === 'paypal-offers' && <OffersPrototype autoplay />}
          {media.type !== 'prototype' && (
            <div class="pc__phone">
              <div class="pc__screen">
                {media.type === 'video' && video && (
                  <video poster={video.poster} muted loop playsinline preload="metadata" data-phone-video>
                    <source src={video.webm} type="video/webm" />
                    <source src={video.mp4} type="video/mp4" />
                  </video>
                )}
                {media.type === 'screens' && media.screens.map((src, i) => (
                  <img class:list={['pc__shot', i === 0 && 'is-on']} src={src} alt="" loading="lazy" decoding="async" data-phone-shot />
                ))}
                {flow && isPlay(flow) && (
                  <div class="pc__play" data-work-play={JSON.stringify(flow)} data-wp-sizes={hasHomeRenders(flow.steps[0].src) ? HOME_SIZES : undefined} set:html={layerHtml(flow.steps[0], false, hasHomeRenders(flow.steps[0].src) ? HOME_SIZES : undefined)} />
                )}
              </div>
            </div>
          )}
        </div>
      </div>
    )}
    {locked && <LockFrost />}
  </div>

  <div class="pc__body">
    {/* COMPANY · [domain] [discipline]… — after carlthomasiv.com; the
        chips come from labelsFor() in data/work.ts. */}
    <div class="pc__meta">
      <p class="pc__co u-label-mono">{locked && <LockIcon class="pc__lock" size="1em" />}{company}</p>
      {tags.length > 0 && (
        <>
          <span class="pc__dot u-label-mono" aria-hidden="true">·</span>
          <ul class="pc__tags" aria-label="Domain and discipline">
            {tags.map((t) => <li>{t}</li>)}
          </ul>
        </>
      )}
    </div>
    <h3 class="pc__title"><a class="pc__link" href={href}>{title}{locked && <span class="u-sr-only">, password protected</span>}</a></h3>
    <p class="pc__tagline">{tagline}</p>
    <PillPair label="View case study" size="sm" class="pc__cta" />
  </div>
</article>

<style>
  /* The card: paper, no line at rest. On hover or focus the faint line
     (::after, so it never shifts the layout) comes in and the card rises
     on its shadow. */
  .pc {
    position: relative;
    isolation: isolate;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: var(--home-card-pad);
    color: var(--fg);
    background: var(--home-card-fill);
    border-radius: var(--radius-home-card);
    transition:
      transform var(--home-card-dur) var(--ease-out),
      box-shadow var(--home-card-dur) var(--ease-out);
  }
  .pc::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid transparent;
    pointer-events: none;
    transition: border-color var(--home-card-dur) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .pc:hover { transform: translateY(var(--home-card-rise)); box-shadow: var(--home-card-shadow); }
    .pc:hover::after { border-color: var(--home-card-line); }
  }
  .pc:has(.pc__link:focus-visible) { transform: translateY(var(--home-card-rise)); box-shadow: var(--home-card-shadow); }
  .pc:has(.pc__link:focus-visible)::after { border-color: var(--home-card-line); }

  /* The words, left under the work, as on the reference. */
  .pc__body {
    display: flex; flex-direction: column; align-items: flex-start;
    text-align: left;
    padding-top: var(--home-card-text-gap);
    flex: 1;
  }
  .pc__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem 1rem; margin: 0 0 0.5rem; }
  .pc__dot { color: var(--fg-dim); }
  .pc__co { color: var(--fg-dim); margin: 0; transition: color var(--dur-micro) var(--ease-out); }
  .pc:hover .pc__co { color: var(--fg); }
  .pc__co :global(.pc__lock) { display: inline-block; margin-right: 0.4em; vertical-align: -0.1em; }
  /* Locked: the frost is the hover, so the work holds still under it. */
  @media (hover: hover) {
    .pc[data-locked]:hover .pc__device,
    .pc[data-locked]:hover .pc__desktop { transform: none; }
  }
  .pc__tags { display: contents; list-style: none; margin: 0; padding: 0; }
  .pc__tags li {
    font-family: var(--font-mono);
    font-size: var(--step-fine);
    font-weight: var(--weight-mono);
    line-height: 1.5;
    letter-spacing: var(--tracking-mono-label);
    text-transform: uppercase;
    color: var(--fg-dim);
    white-space: nowrap;   /* a tag never breaks across lines */
  }
  .pc__title {
    font-family: var(--font-sans);
    font-size: var(--step-item);
    line-height: var(--leading-item);
    letter-spacing: var(--tracking-item);
    font-weight: var(--weight-sans);
    margin: 0 0 0.375rem;
    text-wrap: balance;
  }
  .pc__link { color: var(--fg); text-decoration: none; }
  /* The title's link covers the whole card — see the header comment. */
  .pc__link::after { content: ''; position: absolute; inset: 0; z-index: 2; border-radius: var(--radius-home-card); }
  .pc__link:focus-visible { outline: none; }
  .pc:has(.pc__link:focus-visible) { outline: 2px solid var(--focus); outline-offset: 6px; }
  .pc__tagline {
    font-size: var(--step-copy);
    line-height: var(--leading-copy);
    letter-spacing: var(--tracking-copy);
    color: var(--fg-dim);
    margin: 0;
    max-width: var(--home-tagline-max);
    text-wrap: pretty;
  }
  /* "View case study": the pill pair, a label here (the card is the
     link), so the card's hover drives it. Withheld at rest where there's
     a pointer to reveal it. */
  .pc :global(.pc__cta) {
    margin-top: 1rem;
    transition:
      opacity var(--home-card-dur) var(--ease-out),
      translate var(--home-card-dur) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .pc :global(.pc__cta) { opacity: 0; translate: 0 6px; }
  }
  .pc:is(:hover, :has(.pc__link:focus-visible)) :global(.pc__cta) { opacity: 1; translate: 0 0; }
  .pc:is(:hover, :has(.pc__link:focus-visible)) :global(.btn--pair__pill) { transform: scale(var(--pair-grow)); }
  .pc:is(:hover, :has(.pc__link:focus-visible)) :global(.btn--pair__arrow svg:first-child) { transform: translateX(200%); }
  .pc:is(:hover, :has(.pc__link:focus-visible)) :global(.btn--pair__arrow svg + svg) { transform: none; }

  /* The wide card: the words on the left, the work on the right, the
     title in the serif heading. */
  @media (min-width: 861px) {
    .pc--wide { display: grid; grid-template-columns: var(--home-wide-cols); align-items: center; gap: 2rem; }
    .pc--wide .pc__body { order: -1; padding: 0 0 0 1rem; flex: none; }
    .pc--wide .pc__title {
      font-family: var(--font-serif); font-weight: var(--weight-serif);
      font-size: var(--step-heading); line-height: var(--leading-heading); letter-spacing: normal;
      margin-bottom: 0.75rem;
    }
    /* The second wide card: the work first, the words on the right. */
    .pc--flip { grid-template-columns: var(--home-wide-cols-flip); }
    .pc--flip .pc__body { order: 0; padding: 0 1rem 0 0; }
  }

  /* The stage: the work on its project's hue. */
  .pc__stage {
    position: relative;
    height: var(--home-stage-h);
    display: flex; justify-content: center; align-items: center;
    overflow: hidden;
    border-radius: var(--radius-home-stage);
    background: var(--stage-ground);
  }

  /* --- the phone ---------------------------------------------------
     An iPhone 17 Pro in silver, after daneden.me (option C of
     experiments/device-daneden: his phone, whole and centred). The
     black glass and screen are drawn at full size (the PayPal
     prototypes' own size) and scaled down as a whole, so the coded
     prototypes and the screen phones are the same object at the same
     size; the aluminium band, its buttons and the Dynamic Island are
     drawn round them here, at the same scale. */
  .pc__device {
    --s: var(--phone-scale);
    position: relative;
    flex: none;
    width: calc((var(--phone-w) + 2 * var(--phone-band-w)) * var(--s));
    height: calc((var(--phone-h) + 2 * var(--phone-band-w)) * var(--s));
    padding: calc(var(--phone-band-w) * var(--s));
    border-radius: calc((var(--radius-phone) + var(--phone-band-w)) * var(--s));
    /* the band: lit edge, brushed face, a darker lip */
    background: linear-gradient(100deg, var(--phone-metal-1) 0%, var(--phone-metal-2) 18%, var(--phone-metal-3) 52%, var(--phone-metal-2) 82%, var(--phone-metal-1) 100%);
    box-shadow:
      inset 0 0 0 calc(0.75px * var(--s)) var(--phone-metal-4),
      inset calc(1.5px * var(--s)) calc(1.5px * var(--s)) calc(2px * var(--s)) var(--phone-metal-hi),
      var(--phone-shadow);
    transition: transform var(--home-card-dur) var(--ease-out);
  }
  /* Buttons: Action and volume on the left, the side button and Camera
     Control on the right. */
  .pc__btn {
    position: absolute;
    width: calc(var(--phone-btn-w) * var(--s));
    border-radius: calc(var(--phone-btn-w) * var(--s));
    left: calc(var(--phone-btn-w) * -0.7 * var(--s));
    background: linear-gradient(90deg, var(--phone-metal-4), var(--phone-metal-3));
  }
  .pc__btn:nth-child(1) { top: 18.5%; height: 5.2%; }
  .pc__btn:nth-child(2) { top: 27%; height: 8.6%; }
  .pc__btn:nth-child(3) { top: 37.5%; height: 8.6%; }
  .pc__btn:nth-child(n + 4) { left: auto; right: calc(var(--phone-btn-w) * -0.7 * var(--s)); background: linear-gradient(270deg, var(--phone-metal-4), var(--phone-metal-3)); }
  .pc__btn:nth-child(4) { top: 30%; height: 13%; }
  .pc__btn:nth-child(5) { top: 56%; height: 7.5%; }
  .pc__device-inner {
    position: relative;
    width: var(--phone-w); height: var(--phone-h);
    transform: scale(var(--s));
    transform-origin: 0 0;
  }
  .pc__island {
    position: absolute; z-index: 5; left: 50%; translate: -50% 0;
    top: calc(var(--phone-bezel-w) + var(--phone-island-top));
    width: var(--phone-island-w); height: var(--phone-island-h);
    border-radius: 999px;
    background: var(--phone-island);
    pointer-events: none;
  }
  .pc__phone {
    width: 100%; height: 100%;
    padding: var(--phone-bezel-w);
    background: var(--phone-bezel);
    border-radius: var(--radius-phone);
  }
  .pc__screen {
    position: relative; width: 100%; height: 100%;
    overflow: hidden;
    border-radius: var(--radius-phone-screen);
    background: var(--phone-screen);
  }
  /* The recording is wider than the screen; shown whole from the top,
     its own white app ground carries on below it. */
  .pc__screen video {
    display: block; width: 100%; height: 100%;
    object-fit: contain; object-position: top;
  }
  /* Screens in sequence: the incoming one slides in over the last, which
     drifts a little the other way — an app pushing a new screen. Only
     the two screens in motion transition; the rest jump back offstage
     out of sight. */
  .pc__shot {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: top;
    transform: translateX(100%);
  }
  .pc__shot.is-on {
    z-index: 1;
    transform: none;
    transition: transform var(--dur-phone-step) var(--ease-out);
  }
  .pc__shot.is-prev {
    transform: translateX(var(--phone-parallax));
    transition: transform var(--dur-phone-step) var(--ease-out);
  }

  /* Two phones on one card, a little smaller than one alone. */
  .pc__pair { --phone-scale: var(--phone-scale-pair); display: flex; gap: var(--home-pair-gap); }

  /* A /work flow: its layers fill the screen (styles/work-play.css). */
  /* container-type: the scan's marks are sized in cqw of the screen, as on /work. */
  .pc__play { position: absolute; inset: 0; overflow: hidden; container-type: inline-size; }

  /* --- desktop work ----------------------------------------------
     The screenshot as given: the Okta placeholder draws its own laptop
     and phone, so it stands on the soft card with no frame of ours. */
  .pc__desktop {
    max-width: calc(100% - 2 * var(--phone-stage-pad)); max-height: calc(100% - 2 * var(--phone-stage-pad));
    object-fit: contain;
    display: block;
    transition: transform var(--home-card-dur) var(--ease-out);
  }

  /* The work grows a touch inside its stage. */
  @media (hover: hover) and (pointer: fine) {
    .pc:hover .pc__device,
    .pc:hover .pc__desktop { transform: scale(var(--home-card-grow)); }
  }
  .pc:has(.pc__link:focus-visible) :is(.pc__device, .pc__desktop) { transform: scale(var(--home-card-grow)); }

  /* Narrow: a smaller phone on a shorter stage. */
  @media (max-width: 860px) {
    .pc { --phone-scale: var(--phone-scale-narrow); }
    .pc__pair { --phone-scale: var(--phone-scale-pair-narrow); gap: 0.75rem; }
    .pc__stage { height: var(--home-stage-h-narrow); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc, .pc::after, .pc :global(.pc__cta), .pc__device, .pc__desktop { transition: none; }
    .pc:hover, .pc:has(.pc__link:focus-visible) { transform: none; }
    .pc:hover :is(.pc__device, .pc__desktop),
    .pc:has(.pc__link:focus-visible) :is(.pc__device, .pc__desktop) { transform: none; }
  }
</style>

<script>
  import { phoneLoop } from '../scripts/phone-loop';
  import { autoPlay } from '../scripts/work-play';

  // Which phones may move: on screen, tab visible, no reduced motion. Each stage hears phone:play / phone:pause.
  const stages = [...document.querySelectorAll<HTMLElement>('[data-phone]')];
  if (stages.length) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const inView = new Set<Element>();

    const sync = () => {
      for (const s of stages) {
        const on = !reduced.matches && !document.hidden && inView.has(s);
        if (s.dataset.playing === String(on)) continue;
        s.dataset.playing = String(on);
        s.dispatchEvent(new CustomEvent(on ? 'phone:play' : 'phone:pause'));
      }
    };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? inView.add(e.target) : inView.delete(e.target);
      sync();
    }, { threshold: 0.35 });
    stages.forEach((s) => io.observe(s));
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);

    for (const s of stages) {
      const v = s.querySelector<HTMLVideoElement>('[data-phone-video]');
      if (v) {
        s.addEventListener('phone:play', () => { v.play().catch(() => {}); });
        s.addEventListener('phone:pause', () => v.pause());
      }
      const shots = [...s.querySelectorAll<HTMLElement>('[data-phone-shot]')];
      if (shots.length > 1) {
        let i = 0;
        const next = () => {
          shots.forEach((el) => el.classList.remove('is-prev'));
          shots[i].classList.replace('is-on', 'is-prev');
          i = (i + 1) % shots.length;
          shots[i].classList.add('is-on');
        };
        phoneLoop(s, shots.map(() => [2400, next]));
      }
      const play = s.querySelector<HTMLElement>('[data-work-play]');
      if (play) autoPlay(play, JSON.parse(play.dataset.workPlay!), s);
    }
  }
</script>
