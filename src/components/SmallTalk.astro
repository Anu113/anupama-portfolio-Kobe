---
/* SmallTalk.astro — "Small talk", the home page's short questions, just
   before the footer. On request, after andreas.vision's section of the
   same name, matched rule for rule off his stylesheet and his AskPanel
   (SMALL TALK in tokens.css): head on the left, cards on the right
   (stacked under 1200px), one card open at a time, and under them a
   field: "Ask Moss anything else".

   UX reason: the questions a recruiter asks on a first call (what she
   does, where she is, what she wants next, how to reach her) answered
   in one line each, without leaving the page; anything else goes to Moss.

   Cards: the ground grows 3% under the pointer (fine pointers only), the
   + turns to ×, and the answer's height opens and closes on one curve
   (WAAPI, --ease-talk-card; no overshoot, so the cards under it glide
   instead of bouncing) while its words fade and rise in, or fade out.
   Opening one card closes the other in step. Closed answers are height 0 and
   inert, so their links aren't tabbable; aria-expanded says the state.
   12px corners: his, kept on request — the one rounded list on the site.

   The field, "Ask Moss anything else", is AskMoss.astro (shared with
   the About page); its behaviour and rules are in that file's header.
   Moss scrubs through his clip as the pointer crosses this band.
   Under reduced motion: no spring or grow.

   Questions and answers: src/data/talk.ts. [X] means hers to write. */
import { talk } from '../data/talk';
import AskMoss from './AskMoss.astro';

const sign = '<svg class="talk__sign" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1.75v10.5M1.75 7h10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>';
---
<section class="u-section u-shell talk" aria-labelledby="talk-h" data-talk data-ask-scope>
  <div class="talk__grid">
    <div class="talk__head">
      <h2 class="u-heading" id="talk-h">Small <em>talk</em></h2>
      <p class="talk__dek">The short ones are here. For anything else, ask Moss.</p>
    </div>

    <div class="talk__body">
      <ul class="talk__list">
        {talk.map((t, i) => (
          <li class="talk__card" data-talk-card>
            <button class="talk__row" type="button" id={`talk-q${i}`} aria-expanded="false" aria-controls={`talk-a${i}`}>
              <span class="talk__q">{t.q}</span>
              <Fragment set:html={sign} />
            </button>
            <div class="talk__panel" id={`talk-a${i}`} role="region" aria-labelledby={`talk-q${i}`} inert>
              <div class="talk__answer">
                {t.a.map((p) => <p set:html={p} />)}
              </div>
            </div>
          </li>
        ))}
      </ul>

      <div class="talk__ask"><AskMoss /></div>
    </div>
  </div>
</section>

<style>
  /* the playground line above already ends on --space-band */
  .talk { padding-block: 0 var(--space-band); }
  .talk__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); align-items: start; }
  .talk__head { grid-column: 1 / -1; display: flex; flex-direction: column; gap: var(--talk-pad); margin-bottom: var(--space-label); }
  .talk__body { grid-column: 1 / -1; }
  .talk__dek {
    margin: 0; max-width: var(--talk-head-max); color: var(--talk-soft);
    font-size: var(--step-talk); line-height: 1.42; letter-spacing: 0;
  }
  @media (min-width: 75rem) {
    .talk__head { grid-column: 1 / 7; position: sticky; top: var(--space-band-tight); margin-bottom: 0; }
    .talk__body { grid-column: 8 / 13; }
  }

  .talk__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--talk-gap); }
  .talk__card { position: relative; isolation: isolate; border-radius: var(--radius-talk); }
  .talk__card::before {
    content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit;
    background: var(--talk-card);
    transition: scale var(--dur-talk-grow) var(--ease-talk-grow);
  }
  @media (hover: hover) and (pointer: fine) {
    .talk__card:hover::before { scale: 1.03; }
  }

  .talk__row {
    width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    margin: 0; padding: var(--talk-pad) var(--talk-pad-end) var(--talk-pad) var(--talk-pad);
    border: 0; border-radius: var(--radius-talk); background: none; color: var(--fg);
    font: inherit; font-size: var(--step-talk); line-height: 1.4; letter-spacing: 0;
    text-align: left; text-wrap: pretty; cursor: pointer;
  }
  .talk__row:focus-visible { outline: 2px solid var(--focus); outline-offset: 0; }
  .talk__q { flex: 1; }
  .talk__row :global(.talk__sign) {
    flex: none; width: 1.25rem; height: 1.25rem; color: var(--talk-sign);
    transition: transform var(--dur-talk-sign) ease-out;
  }
  .talk__row[aria-expanded='true'] :global(.talk__sign) { transform: rotate(45deg); }

  .talk__panel { height: 0; overflow: clip; }
  .talk__list { overflow-anchor: none; }
  :global(.talk__card.is-open) .talk__panel { height: auto; }
  .talk__answer {
    display: flow-root; max-width: var(--talk-answer-max); padding: 0 var(--talk-pad) var(--talk-pad);
    color: var(--talk-soft); font-size: var(--step-talk); line-height: 1.5; letter-spacing: 0; text-wrap: pretty;
  }
  .talk__answer :global(p) { margin: 0; }
  .talk__answer :global(p + p) { margin-top: 0.75rem; }
  .talk__answer :global(a) { color: var(--fg); text-decoration: underline var(--link-thick) var(--link-line); text-underline-offset: var(--link-offset); }
  .talk__answer :global(a:hover) { text-decoration-color: var(--link-line-hover); text-decoration-thickness: var(--link-thick-hover); }

  .talk__ask { margin-top: var(--talk-gap); }

  @media (prefers-reduced-motion: reduce) {
    .talk__card::before, .talk__row :global(.talk__sign) { transition: none; }
  }
</style>
<script>
  const band = document.querySelector<HTMLElement>('[data-talk]');
  const root = document.documentElement;
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const css = getComputedStyle(root);
  const ease = css.getPropertyValue('--ease-talk-card').trim() || 'ease-out';
  const dur = parseFloat(css.getPropertyValue('--dur-talk-card')) || 520;
  const fade = parseFloat(css.getPropertyValue('--dur-talk-card-fade')) || 260;
  const rise = css.getPropertyValue('--talk-card-rise').trim() || '6px';

  // Animate the panel's height from what it was to what it is now, and
  // fade the words in (rising) or out. Starts from wherever an
  // interrupted animation had got to, so quick clicks never jump.
  function grow(panel: HTMLElement, answer: HTMLElement, from: number, on: boolean) {
    // a shut panel's words start from nothing, whatever they rest at
    const fromOpacity = from < 1 ? '0' : getComputedStyle(answer).opacity;
    panel.getAnimations().forEach((a) => a.cancel());
    answer.getAnimations().forEach((a) => a.cancel());
    const to = panel.getBoundingClientRect().height;
    if (still.matches || Math.abs(to - from) < 1) return;
    panel.animate([{ height: `${from}px` }, { height: `${to}px` }], { duration: dur, easing: ease });
    answer.animate(
      on
        ? [{ opacity: fromOpacity, transform: `translateY(${rise})` }, { opacity: 1, transform: 'none' }]
        : [{ opacity: fromOpacity }, { opacity: 0 }],
      { duration: on ? dur : fade, easing: ease, delay: on ? fade / 4 : 0, fill: 'both' },
    );
  }

  if (band) {
    // ---- the cards: one open at a time ----
    const cards = [...band.querySelectorAll<HTMLElement>('[data-talk-card]')];
    function setOpen(card: HTMLElement, on: boolean) {
      const btn = card.querySelector<HTMLButtonElement>('.talk__row')!;
      const panel = card.querySelector<HTMLElement>('.talk__panel')!;
      const answer = card.querySelector<HTMLElement>('.talk__answer')!;
      btn.setAttribute('aria-expanded', String(on));
      panel.inert = !on;
      if (card.classList.contains('is-open') === on) return;
      const from = panel.getBoundingClientRect().height;
      card.classList.toggle('is-open', on);
      grow(panel, answer, from, on);
    }
    cards.forEach((card) => card.querySelector('.talk__row')!.addEventListener('click', () => {
      const on = !card.classList.contains('is-open');
      cards.forEach((c) => c !== card && setOpen(c, false));
      setOpen(card, on);
    }));
  }
</script>
