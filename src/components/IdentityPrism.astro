---
/* Identity prism: the name in the top-left corner, as a small 3D box.
   A direct recreation of the identity mark on huyml.co, requested as a
   close match, with the name and the illustration swapped for hers.

   The box is 56 × 123 and 56 deep, with four faces around its vertical
   axis:
     front / back: ANUPAMA set vertically, reading upward, with two small
                   lines beside it (year, city)
     left / right: her illustrated card, the image used exactly as supplied
   The top and bottom stay open, as in the reference.

   Behaviour, using the reference's own numbers:
     - Mouse wheel spins it around Y. Every wheel event adds deltaY × 0.25°
       to a target angle, anywhere on the page, while the page scrolls as
       normal. On each frame the drawn angle moves 12% of the way to the
       target, which gives the lag and follow-through.
     - 140ms after the wheel stops, the target snaps to the nearest quarter
       turn (1s, power3.out), so the box always settles square on a face:
       the name or the portrait, never an edge.
     - Hover or keyboard focus on the link fades the wordmark to the accent
       colour (450ms). The illustration faces are left untouched.
     - With sound on (top bar's Audio toggle), hovering ticks and clicking
       taps, as the reference's does.
   The reference has no pointer-driven tilt; the pointer only hovers.

   Why it's here: the name is the first thing a visitor looks for, and
   giving it the one physical response on the page (it turns as you
   scroll) makes the corner feel built rather than typed.

   Only drawn at ≥1200px, the same cut-off the reference uses. Below that,
   Nav.astro shows the plain text wordmark. Under prefers-reduced-motion
   the wheel listener is never attached, so it stays on the name face. The
   whole prism is aria-hidden; the link around it carries the label. */
import { site } from '../data/site';
const year = new Date().getFullYear();
const city = site.location.toLowerCase();
---
<span class="idp" aria-hidden="true">
  <span class="idp__box" data-idp-box>
    <span class="idp__face idp__face--word" style="--face: translateZ(calc(var(--idmark-w) / 2))">
      <span class="idp__word-inner">
        <span class="idp__name">Anupama</span>
        <span class="idp__meta idp__meta--end">portfolio &copy; {year}</span>
        <span class="idp__meta idp__meta--split"><span>+91</span><span>{city}, in</span></span>
      </span>
    </span>
    <span class="idp__face" style="--face: rotateY(90deg) translateZ(calc(var(--idmark-w) / 2))">
      <img src="/images/anupama-idcard.webp" alt="" draggable="false" decoding="async" />
    </span>
    <span class="idp__face idp__face--word" style="--face: rotateY(180deg) translateZ(calc(var(--idmark-w) / 2))">
      <span class="idp__word-inner">
        <span class="idp__name">Anupama</span>
        <span class="idp__meta idp__meta--end">portfolio &copy; {year}</span>
        <span class="idp__meta idp__meta--split"><span>+91</span><span>{city}, in</span></span>
      </span>
    </span>
    <span class="idp__face" style="--face: rotateY(-90deg) translateZ(calc(var(--idmark-w) / 2))">
      <img src="/images/anupama-idcard.webp" alt="" draggable="false" decoding="async" />
    </span>
  </span>
</span>

<style>
  .idp {
    display: none;
  }
  @media (min-width: 1200px) {
    .idp {
      display: flex;
      align-items: center;
      justify-content: center;
      width: var(--idmark-w);
      height: var(--idmark-h);
      perspective: 1200px;
      perspective-origin: center center;
      /* The nav link sets uppercase label tracking; the faces set their own. */
      text-transform: none;
      letter-spacing: normal;
    }
  }
  @media (min-width: 2400px) {
    .idp {
      transform: scale(var(--idmark-scale-xl));
      transform-origin: top left;
    }
  }

  .idp__box {
    position: relative;
    width: var(--idmark-w);
    height: var(--idmark-h);
    transform-style: preserve-3d;
    transform-origin: center center;
  }

  .idp__face {
    position: absolute;
    left: 0; top: 0;
    width: var(--idmark-w);
    height: var(--idmark-h);
    overflow: hidden;
    isolation: isolate;
    backface-visibility: hidden;
    transform-style: preserve-3d;
    transform: var(--face);
  }
  .idp__face img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    object-position: center;
    pointer-events: none;
    user-select: none;
    backface-visibility: hidden;
    transform: translateZ(0.1px);
  }

  /* The wordmark face is opaque, like the reference's, so the box reads
     as a solid block rather than a wireframe as it turns. */
  .idp__face--word {
    background: var(--bg);
    color: var(--fg);
    transition: color var(--dur-idmark-swap) var(--ease-out);
  }
  :global(.nav__mark:hover) .idp__face--word,
  :global(.nav__mark:focus-visible) .idp__face--word {
    color: var(--accent);
  }

  /* Laid out as a landscape strip (the face's height becomes its width),
     then turned a quarter-turn anticlockwise into the upright face, so the
     name reads bottom to top, the same way the reference's does. */
  .idp__word-inner {
    position: absolute;
    left: 0; top: 0;
    width: var(--idmark-h);
    height: var(--idmark-w);
    padding: 0.15rem 0.2rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transform-origin: top left;
    transform: translateY(var(--idmark-h)) rotate(-90deg) translateZ(0.1px);
  }
  .idp__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--idmark-word);
    line-height: 0.8;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .idp__meta {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--idmark-meta);
    line-height: 1.1;
    white-space: nowrap;
  }
  .idp__meta--end { text-align: end; }
  .idp__meta--split { display: flex; justify-content: space-between; }

  @media (prefers-reduced-motion: reduce) {
    .idp__face--word { transition: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { playTick, playTap } from '../scripts/sound';

  // Sound, when the visitor has turned it on in the top bar: a tick as the
  // pointer arrives on the name, a tap when it is clicked (reference: its
  // hover and tick sounds). Silent otherwise; see src/scripts/sound.ts.
  const link = document.querySelector<HTMLElement>('[data-idp-box]')?.closest('a');
  link?.addEventListener('pointerenter', playTick);
  link?.addEventListener('click', playTap);

  const box = document.querySelector<HTMLElement>('[data-idp-box]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (box && !still) {
    // Values lifted from the reference: degrees per wheel pixel, the
    // per-frame follow factor, the pause that counts as "stopped", and
    // the settle tween onto the nearest face.
    const DEG_PER_PX = 0.25;
    const FOLLOW = 0.12;
    const SNAP_AFTER = 140;

    const state = { current: 0, target: 0 };
    let snapTimer: number | undefined;
    let snap: gsap.core.Tween | undefined;
    let ticking = false;

    gsap.set(box, { rotationX: 0, rotationY: 0, force3D: true });

    const tick = () => {
      state.current += (state.target - state.current) * FOLLOW;
      // Once the box has caught up and nothing is still pulling on it,
      // land exactly on the angle and stop drawing frames.
      if (Math.abs(state.target - state.current) < 0.01 && !snap?.isActive()) {
        state.current = state.target;
        gsap.ticker.remove(tick);
        ticking = false;
      }
      gsap.set(box, { rotationX: 0, rotationY: state.current, force3D: true });
    };

    const wake = () => {
      if (ticking) return;
      ticking = true;
      gsap.ticker.add(tick);
    };

    const onWheel = (e: WheelEvent) => {
      snap?.kill();
      state.target += e.deltaY * DEG_PER_PX;
      clearTimeout(snapTimer);
      snapTimer = window.setTimeout(() => {
        snap = gsap.to(state, {
          target: Math.round(state.target / 90) * 90,
          duration: 1,
          ease: 'power3.out',
          overwrite: true,
        });
        wake();
      }, SNAP_AFTER);
      wake();
    };

    addEventListener('wheel', onWheel, { capture: true, passive: true });
  }
</script>
