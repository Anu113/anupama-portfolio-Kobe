---
/* CaseBlocks.astro — renders the body of one case-study section.
   Takes the `blocks` array from a section in data/cases.ts and lays each
   kind out. Six kinds, deliberately: prose, points, rows, figure, quote,
   metrics — plus `prototype`, a working flow rebuilt from her screens, and
   `screens`, a row of phone screens redrawn in code. That set covers the reference layout
   (rachelchen.tech/projects/openai), which alternates statement copy with
   small titled grids and captioned figures.

   Adding a seventh kind means adding it to CaseBlock in data/cases.ts
   first — the union is what keeps these pages from drifting into whatever
   HTML a given case study felt like.

   Every block stays inside the body column. The sticky rail owns the
   column to its left for the whole band, so nothing here may use a
   negative inline margin to reach into it — it collides with the rail.
   `figure` with `wide: true` gets a more panoramic frame, not more width.

   Type follows the case page's (see [slug].astro): labels, row terms,
   captions and citations are small mono caps (.u-label-mono); `points`
   is a numbered list at --step-small, not a grid of serif titles; the
   quote is roman serif at --step-title on a 1px ink rule — no italic,
   no accent (both dropped on request). */
import type { CaseBlock } from '../data/cases';
import Reveal from './Reveal.astro';
import EnrollPrototype from './EnrollPrototype.astro';
import OffersPrototype from './OffersPrototype.astro';
import AdsConsentPrototype from './AdsConsentPrototype.astro';
import PrivacyScreens from './PrivacyScreens.astro';

interface Props { blocks: CaseBlock[] }
const { blocks } = Astro.props;
---
{blocks.map((block, i) => (
  <Reveal delay={Math.min(i, 3) * 80}>
    {block.kind === 'prose' && (
      <div class="prose">
        {block.text.map((p) => <p>{p}</p>)}
      </div>
    )}

    {block.kind === 'points' && (
      <div class="group">
        {block.label && <p class="u-label-mono group__label">{block.label}</p>}
        <ol class="points">
          {block.items.map((it, n) => (
            <li class="point">
              <span class="point__num u-label-mono" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
              <h3 class="point__title">{it.title}</h3>
              <p class="point__body">{it.body}</p>
            </li>
          ))}
        </ol>
      </div>
    )}

    {block.kind === 'rows' && (
      <div class="group">
        {block.label && <p class="u-label-mono group__label">{block.label}</p>}
        <dl class="rows">
          {block.items.map((it) => (
            <div class="row">
              <dt class="row__term u-label-mono">{it.term}</dt>
              <dd class="row__detail">{it.detail}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    {block.kind === 'figure' && (
      <figure class:list={['fig', block.wide && 'fig--wide']}>
        <div class="fig__frame" style={block.ratio ? `--fig-ratio: ${block.ratio};` : undefined}>
          <img src={block.src} alt={block.alt} loading="lazy" decoding="async" />
        </div>
        {block.caption && <figcaption class="fig__cap u-label-mono">{block.caption}</figcaption>}
      </figure>
    )}

    {block.kind === 'quote' && (
      <blockquote class="quote">
        <p>{block.text}</p>
        {block.cite && <cite class="u-label-mono">{block.cite}</cite>}
      </blockquote>
    )}

    {block.kind === 'prototype' && block.name === 'paypal-enroll' && (
      <EnrollPrototype caption={block.caption} />
    )}
    {block.kind === 'prototype' && block.name === 'paypal-offers' && (
      <OffersPrototype caption={block.caption} />
    )}
    {block.kind === 'prototype' && block.name === 'paypal-ads-consent' && (
      <AdsConsentPrototype caption={block.caption} />
    )}
    {block.kind === 'screens' && (
      <PrivacyScreens set={block.set} caption={block.caption} />
    )}

    {block.kind === 'metrics' && (
      <div class="group">
        {block.label && <p class="u-label-mono group__label">{block.label}</p>}
        <dl class="metrics" style={`--cols: ${Math.min(block.items.length, 3)};`}>
          {block.items.map((it) => (
            <div class="metric">
              <dt class="metric__value">{it.value}</dt>
              <dd class="metric__label">{it.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}
  </Reveal>
))}

<style>
  /* Every block sits in the same rhythm; the section owns the gap between
     them via `gap` on its own container, so nothing here sets a top margin. */
  .prose p {
    max-width: var(--measure);
    margin: 0 0 1.15em;
    color: var(--fg-dim);
    text-wrap: pretty;
  }
  .prose p:last-child { margin-bottom: 0; }

  .group__label { margin: 0 0 1.25rem; }

  /* --- points: a numbered list, one hairline per item ------------------ */
  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }
  .point {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    column-gap: 0.75rem;
    row-gap: 0.25rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--rule);
  }
  .point:last-child { border-bottom: 1px solid var(--rule); }
  .point__num { grid-row: span 2; line-height: 1.25rem; letter-spacing: 0.04em; }
  .point__title {
    font-family: var(--font-sans);
    font-size: var(--step-small);
    font-weight: var(--weight-sans);
    line-height: 1.25rem;
    margin: 0;
  }
  .point__body {
    margin: 0;
    font-size: var(--step-small);
    line-height: 1.6;
    color: var(--fg-dim);
    text-wrap: pretty;
  }

  /* --- rows: the scope table ------------------------------------------
     Read as a table on purpose. This is the block a recruiter stops on. */
  .rows { margin: 0; }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
    gap: 0.5rem var(--col-gap);
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
  }
  .row:last-child { border-bottom: 1px solid var(--rule); }
  .row__term { padding-top: 0.3em; }
  .row__detail { margin: 0; color: var(--fg-dim); text-wrap: pretty; }

  /* --- figure ---------------------------------------------------------- */
  .fig { margin: 0; }
  /* --fig-ratio, when a block supplies one, is the image's own aspect, so
     `cover` has nothing to crop. Without it the frame forces 16/10 and eats
     the top and bottom of every portrait screen and long page mockup. */
  .fig__frame {
    background: var(--screen);
    aspect-ratio: var(--fig-ratio, 16 / 10);
    overflow: hidden;
  }
  .fig__frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* `wide` is a shape, not a breakout. An earlier version pulled these
     figures back across the rail column with a negative inline margin —
     which collides with the rail, because the rail is sticky and sits in
     that column for the whole band. Nothing in the body may enter the rail
     track. Every figure stays inside the body column; `wide` just gets a
     more panoramic frame so a section's lead image still reads as one. */
  /* Same fallback pattern as above — a supplied ratio has to beat `wide`,
     which is the more specific selector and would otherwise re-crop. */
  .fig--wide .fig__frame { aspect-ratio: var(--fig-ratio, 16 / 7.5); }
  .fig__cap {
    margin-top: 0.75rem;
    max-width: var(--measure);
    line-height: 1.6;
    letter-spacing: 0.03em;
    text-transform: none;
  }

  /* --- quote ------------------------------------------------------------ */
  .quote {
    margin: 0;
    border-inline-start: 1px solid var(--fg);
    padding-inline-start: 1.25rem;
  }
  .quote p {
    font-family: var(--font-serif); font-weight: var(--weight-serif);
    font-size: var(--step-title);
    line-height: 1.35;
    letter-spacing: var(--tracking-serif);
    margin: 0;
    max-width: 36ch;
    color: var(--fg);
    text-wrap: balance;
  }
  .quote cite { display: block; margin-top: 0.75rem; font-style: normal; }

  /* --- metrics ---------------------------------------------------------- */
  .metrics {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    gap: 2rem var(--col-gap);
  }
  .metric { border-top: 1px solid var(--rule); padding-top: 1rem; }
  .metric__value {
    font-family: var(--font-serif);
    font-size: var(--step-heading);
    font-weight: var(--weight-serif);
    letter-spacing: var(--tracking-serif);
    line-height: 1;
  }
  .metric__label {
    margin: 0.75rem 0 0;
    color: var(--fg-dim);
    font-size: var(--step-small);
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media (max-width: 820px) {
    .metrics { grid-template-columns: 1fr; }
    .row { grid-template-columns: 1fr; }
    .quote p { max-width: none; }
  }
</style>
