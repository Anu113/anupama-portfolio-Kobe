---
/* CaseBlocks.astro — renders the body of one case-study section.
   Takes the `blocks` array from a section in data/cases.ts and lays each
   kind out. Six kinds, deliberately: prose, points, rows, figure, quote,
   metrics — plus `prototype`, a working flow rebuilt from her screens, and
   `screens`, a row of phone screens redrawn in code, and `chase`, the
   Chase Pay case's phones and recording (ChaseScreens.astro). That set covers the reference layout
   (rachelchen.tech/projects/openai), which alternates statement copy with
   small titled grids and captioned figures.

   Adding a seventh kind means adding it to CaseBlock in data/cases.ts
   first — the union is what keeps these pages from drifting into whatever
   HTML a given case study felt like.

   Every block stays inside the body column. The sticky rail owns the
   column to its left for the whole band, so nothing here may use a
   negative inline margin to reach into it — it collides with the rail.
   `figure` with `wide: true` gets a more panoramic frame, not more width.

   Type follows the case page's (see [slug].astro): labels, row terms,
   captions and citations are small mono caps (.u-label-mono); `points`
   is a numbered list at --step-small, not a grid of serif titles; the
   quote is roman serif at --step-title on a 1px ink rule — no italic,
   no accent (both dropped on request).

   Two pieces of story structure, after rachelatwork.com and
   carlthomasiv.com: `bet` is the case's one "How might we…?" line, a mono
   label over a serif sentence; and a `claim` on a figure or screens row
   makes it a numbered craft decision — "01" and the claim ("X replaced
   Y") set above the work, the caption under it giving the reason. Claims
   are numbered in the order they appear in the section. A `compare` (the
   before/after phone, PrivacyCompare.astro) takes a claim the same way.

   Five story blocks, after andreas.vision/work/schneider (on request,
   2026-11-14; mocks in experiments/case-storytelling), so the process
   reads as evidence rather than paragraphs: `sides` (the two readers a
   case answers to, set once in the situation), `funnel` (4 → 3 → 1),
   `bars` (scores against the bar to clear, numbers always printed),
   `fixes` (each finding beside what changed) and `aside` (a gap named
   where it happened). Ink only, no hairlines; values under CASE STORY in
   tokens.css.

   Four blocks for the Privacy case's process, art and Learn more cards
   ("F" of experiments/privacy-process, on request, 2026-11-26), each in
   its own component: `sketches` (SketchCollage), `illos` (PrivacyArt),
   `sketchrows` (SketchRows) and `cardparts` (LearnCardParts).

   `okta`: the Okta AI agents case's screens, drawn as Okta's Admin
   Console (OktaAgent.astro), on request, 2026-11-26. */
import type { CaseBlock } from '../data/cases';
import Reveal from './Reveal.astro';
import EnrollPrototype from './EnrollPrototype.astro';
import OffersPrototype from './OffersPrototype.astro';
import AdsConsentPrototype from './AdsConsentPrototype.astro';
import PrivacyScreens from './PrivacyScreens.astro';
import PrivacyCompare from './PrivacyCompare.astro';
import ContextualPrivacy from './ContextualPrivacy.astro';
import ChaseScreens from './ChaseScreens.astro';
import ChaseDiagram from './ChaseDiagram.astro';
import SketchCollage from './SketchCollage.astro';
import PrivacyArt from './PrivacyArt.astro';
import SketchRows from './SketchRows.astro';
import LearnCardParts from './LearnCardParts.astro';
import OktaAgent from './OktaAgent.astro';
import OktaIam from './OktaIam.astro';

interface Props { blocks: CaseBlock[] }
const { blocks } = Astro.props;
let claimCount = 0;
const claimNum = blocks.map((b) =>
  (b.kind === 'figure' || b.kind === 'screens' || b.kind === 'compare' || b.kind === 'chase') && b.claim
    ? String(++claimCount).padStart(2, '0')
    : null,
);
---
{blocks.map((block, i) => (
  <Reveal still delay={Math.min(i, 3) * 80}>
    {claimNum[i] && (
      <p class="claim">
        <span class="claim__num u-label-mono" aria-hidden="true">{claimNum[i]}</span>
        <span class="claim__text">{(block as { claim: string }).claim}</span>
      </p>
    )}

    {block.kind === 'bet' && (
      <div class="bet">
        <p class="u-label-mono bet__label">The bet</p>
        <p class="bet__text">{block.text}</p>
      </div>
    )}

    {block.kind === 'prose' && (
      <div class="prose">
        {block.text.map((p) => <p>{p}</p>)}
      </div>
    )}

    {block.kind === 'points' && (
      <div class="group">
        {block.label && <p class="u-label-mono group__label">{block.label}</p>}
        <ol class="points">
          {block.items.map((it, n) => (
            <li class="point">
              <span class="point__num u-label-mono" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
              <h3 class="point__title">{it.title}</h3>
              <p class="point__body">{it.body}</p>
            </li>
          ))}
        </ol>
      </div>
    )}

    {block.kind === 'rows' && (
      <div class="group">
        {block.label && <p class="u-label-mono group__label">{block.label}</p>}
        <dl class="rows">
          {block.items.map((it) => (
            <div class="row">
              <dt class="row__term u-label-mono">{it.term}</dt>
              <dd class="row__detail">{it.detail}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    {block.kind === 'figure' && (
      <figure class:list={['fig', block.wide && 'fig--wide']}>
        <div class="fig__frame" style={block.ratio ? `--fig-ratio: ${block.ratio};` : undefined}>
          <img src={block.src} alt={block.alt} loading="lazy" decoding="async" />
        </div>
        {block.caption && <figcaption class="fig__cap u-label-mono">{block.caption}</figcaption>}
      </figure>
    )}

    {block.kind === 'quote' && (
      <blockquote class="quote">
        <p>{block.text}</p>
        {block.cite && <cite class="u-label-mono">{block.cite}</cite>}
      </blockquote>
    )}

    {block.kind === 'prototype' && block.name === 'paypal-enroll' && (
      <EnrollPrototype caption={block.caption} />
    )}
    {block.kind === 'prototype' && block.name === 'paypal-offers' && (
      <OffersPrototype caption={block.caption} />
    )}
    {block.kind === 'prototype' && block.name === 'paypal-ads-consent' && (
      <AdsConsentPrototype caption={block.caption} />
    )}
    {block.kind === 'screens' && (
      <PrivacyScreens set={block.set} caption={block.caption} />
    )}
    {block.kind === 'diagram' && block.name === 'contextual-privacy' && (
      <ContextualPrivacy caption={block.caption} />
    )}
    {block.kind === 'diagram' && (block.name === 'chase-study' || block.name === 'chase-flow') && (
      <ChaseDiagram name={block.name} caption={block.caption} />
    )}
    {block.kind === 'chase' && (
      <ChaseScreens set={block.set} caption={block.caption} />
    )}
    {block.kind === 'compare' && (
      <PrivacyCompare set={block.set} notes={block.notes} claim={block.claim} />
    )}

    {block.kind === 'sides' && (
      <div class="sides">
        {block.items.map((it) => (
          <section class="side" aria-label={it.who}>
            <p class="u-label-mono side__who">{it.who}</p>
            <p class="side__span">{it.span}</p>
            <p class="side__q">{it.question}</p>
            <ul class="side__needs">
              {it.needs.map((n) => <li>{n}</li>)}
            </ul>
          </section>
        ))}
      </div>
    )}

    {block.kind === 'funnel' && (() => {
      const max = Math.max(...block.stages.map((s) => s.count ?? 0));
      return (
        <div class="group">
          {block.label && <p class="u-label-mono group__label">{block.label}</p>}
          <ol class="funnel">
            {block.stages.map((st) => (
              <li class="stage">
                <span class="stage__value">{st.value}</span>
                {st.count !== undefined && (
                  <span class="stage__marks" aria-hidden="true">
                    {Array.from({ length: max }, (_, k) => (
                      <i class:list={[k < st.count! ? 'on' : k < max && 'ghost']} />
                    ))}
                  </span>
                )}
                <span class="u-label-mono stage__label">{st.label}</span>
              </li>
            ))}
          </ol>
        </div>
      );
    })()}

    {block.kind === 'bars' && (() => {
      const top = Math.max(...block.items.map((it) => it.value));
      return (
        <div class="group">
          {block.label && <p class="u-label-mono group__label">{block.label}</p>}
          <div class="bars" style={`--bar-at: ${block.threshold / 100};`}>
            <span class="u-label-mono bars__line" aria-hidden="true">{block.thresholdLabel}</span>
            <dl class="bars__list">
              {block.items.map((it) => (
                <div class="bars__row">
                  <dt class="u-label-mono">{it.label}</dt>
                  <dd class="bars__track" aria-hidden="true">
                    <span class:list={['bars__bar', it.value === top && 'bars__bar--top']} style={`--v: ${it.value / 100};`}></span>
                  </dd>
                  <dd class="bars__value">{it.value}%</dd>
                </div>
              ))}
            </dl>
          </div>
          {block.note && <p class="u-label-mono bars__note">{block.note}</p>}
        </div>
      );
    })()}

    {block.kind === 'fixes' && (
      <div class="group">
        {block.label && <p class="u-label-mono group__label">{block.label}</p>}
        <table class="fixes">
          <thead>
            <tr>
              <th scope="col" class="u-label-mono"><span class="u-sr-only">Severity</span></th>
              <th scope="col" class="u-label-mono">Found</th>
              <th scope="col" class="u-label-mono">Changed</th>
            </tr>
          </thead>
          <tbody>
            {block.items.map((it) => (
              <tr>
                <td class="u-label-mono fixes__tag">{it.tag}</td>
                <td>{it.found}</td>
                <td class="fixes__changed">{it.changed}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {block.kind === 'aside' && (
      <aside class="aside" aria-label={block.label}>
        <p class="u-label-mono aside__label">{block.label}</p>
        <p class="aside__text">{block.text}</p>
      </aside>
    )}

    {block.kind === 'see' && (
      <p class="see">{block.text} <a href={block.href}>{block.label}</a></p>
    )}

    {block.kind === 'sketches' && <SketchCollage label={block.label} items={block.items} />}
    {block.kind === 'illos' && <PrivacyArt door={block.door} items={block.items} palette={block.palette} credit={block.credit} />}
    {block.kind === 'sketchrows' && <SketchRows label={block.label} src={block.src} alt={block.alt} caption={block.caption} items={block.items} />}
    {block.kind === 'okta' && <OktaAgent screen={block.screen} caption={block.caption} />}
    {block.kind === 'iam' && <OktaIam view={block.view} caption={block.caption} />}
    {block.kind === 'cardparts' && <LearnCardParts notes={block.notes} cards={block.cards} />}

    {block.kind === 'metrics' && (
      <div class="group">
        {block.label && <p class="u-label-mono group__label">{block.label}</p>}
        <dl class="metrics" style={`--cols: ${Math.min(block.items.length, 3)};`}>
          {block.items.map((it) => (
            <div class="metric">
              <dt class="metric__value">{it.value}</dt>
              <dd class="metric__label">{it.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}
  </Reveal>
))}

<style>
  /* Every block sits in the same rhythm; the section owns the gap between
     them via `gap` on its own container, so nothing here sets a top margin. */
  .prose p {
    max-width: var(--measure);
    margin: 0 0 1.15em;
    color: var(--fg-dim);
    text-wrap: pretty;
  }
  .prose p:last-child { margin-bottom: 0; }

  .group__label { margin: 0 0 1.25rem; }

  /* --- points: a numbered list, items parted by space ------------------ */
  .points {
    list-style: none;
    display: grid;
    row-gap: var(--case-list-gap);
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }
  .point {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    column-gap: 0.75rem;
    row-gap: 0.25rem;
  }
  .point__num { grid-row: span 2; line-height: 1.25rem; letter-spacing: 0.04em; }
  .point__title {
    font-family: var(--font-sans);
    font-size: var(--step-small);
    font-weight: var(--weight-sans);
    line-height: 1.25rem;
    margin: 0;
  }
  .point__body {
    margin: 0;
    font-size: var(--step-small);
    line-height: 1.6;
    color: var(--fg-dim);
    text-wrap: pretty;
  }

  /* --- rows: the scope table ------------------------------------------
     Read as a table on purpose. This is the block a recruiter stops on. */
  .rows { margin: 0; display: grid; row-gap: var(--case-list-gap); }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
    gap: 0.5rem var(--col-gap);
  }
  .row__term { padding-top: 0.3em; }
  .row__detail { margin: 0; color: var(--fg-dim); text-wrap: pretty; }

  /* --- figure ---------------------------------------------------------- */
  .fig { margin: 0; }
  /* --fig-ratio, when a block supplies one, is the image's own aspect, so
     `cover` has nothing to crop. Without it the frame forces 16/10 and eats
     the top and bottom of every portrait screen and long page mockup. */
  .fig__frame {
    background: var(--screen);
    aspect-ratio: var(--fig-ratio, 16 / 10);
    overflow: hidden;
  }
  .fig__frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* `wide` is a shape, not a breakout. An earlier version pulled these
     figures back across the rail column with a negative inline margin —
     which collides with the rail, because the rail is sticky and sits in
     that column for the whole band. Nothing in the body may enter the rail
     track. Every figure stays inside the body column; `wide` just gets a
     more panoramic frame so a section's lead image still reads as one. */
  /* Same fallback pattern as above — a supplied ratio has to beat `wide`,
     which is the more specific selector and would otherwise re-crop. */
  .fig--wide .fig__frame { aspect-ratio: var(--fig-ratio, 16 / 7.5); }
  .fig__cap {
    margin-top: 0.75rem;
    max-width: var(--measure);
    line-height: 1.6;
    letter-spacing: 0.03em;
    text-transform: none;
  }

  /* --- quote ------------------------------------------------------------ */
  /* No rule beside it (on request): the serif at title size sets it apart. */
  .quote { margin: 0; }
  .quote p {
    font-family: var(--font-serif); font-weight: var(--weight-serif);
    font-size: var(--step-title);
    line-height: 1.35;
    letter-spacing: var(--tracking-serif);
    margin: 0;
    max-width: 36ch;
    color: var(--fg);
    text-wrap: balance;
  }
  .quote cite { display: block; margin-top: 0.75rem; font-style: normal; }

  /* --- bet: the case's one question, set like a quote without the rule --- */
  .bet__label { margin: 0 0 0.75rem; }
  .bet__text {
    font-family: var(--font-serif); font-weight: var(--weight-serif);
    font-size: var(--step-title);
    line-height: 1.35;
    letter-spacing: var(--tracking-serif);
    margin: 0;
    max-width: 36ch;
    color: var(--fg);
    text-wrap: balance;
  }

  /* --- claim: a numbered craft decision, above its screens -------------- */
  .claim {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    column-gap: 0.75rem;
    align-items: baseline;
    margin: 0 0 1.25rem;
    max-width: var(--measure);
  }
  .claim__num { color: var(--fg); letter-spacing: 0.04em; }
  .claim__text {
    font-size: var(--step-body);
    line-height: 1.45;
    color: var(--fg);
    text-wrap: balance;
  }

  /* --- metrics ---------------------------------------------------------- */
  .metrics {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    gap: var(--case-card-gap);
  }
  /* Soft cards, as the headline numbers (CASE CARDS in tokens.css). */
  .metric {
    background: var(--case-card);
    border-radius: var(--radius-case-card);
    padding: var(--case-card-pad);
  }
  .metric__value {
    font-family: var(--font-serif);
    font-size: var(--step-heading);
    font-weight: var(--weight-serif);
    letter-spacing: var(--tracking-serif);
    line-height: 1;
  }
  .metric__label {
    margin: 0.75rem 0 0;
    color: var(--fg-dim);
    font-size: var(--step-small);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* --- sides: the two readers, side by side ----------------------------- */
  .sides {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--col-gap);
  }
  .side__who { margin: 0; }
  .side__span {
    font-family: var(--font-serif); font-weight: var(--weight-serif);
    font-size: var(--step-heading); letter-spacing: var(--tracking-serif);
    line-height: 1; margin: 0.75rem 0;
  }
  .side__q {
    font-family: var(--font-serif); font-weight: var(--weight-serif);
    font-style: italic; font-size: var(--step-title); line-height: 1.3;
    letter-spacing: var(--tracking-serif); margin: 0 0 1rem; text-wrap: balance;
  }
  .side__needs { list-style: none; margin: 0; padding: 0; display: grid; row-gap: var(--case-list-gap-tight); font-size: var(--step-small); color: var(--fg-dim); }

  /* --- funnel: the process as narrowing numbers -------------------------- */
  .funnel {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    column-gap: var(--case-list-gap);
  }
  .stage {
    display: flex; flex-direction: column;
  }
  .stage__value {
    font-family: var(--font-serif); font-weight: var(--weight-serif);
    font-size: var(--step-heading); letter-spacing: var(--tracking-serif); line-height: 1;
  }
  .stage__marks { display: flex; gap: 4px; height: var(--story-square-h); margin-top: 0.9rem; }
  .stage__marks i { flex: 0 0 var(--story-square); background: var(--story-mark-ghost); }
  .stage__marks i.on { background: var(--story-mark); }
  .stage__label { margin-top: 0.75rem; line-height: 1.5; text-transform: none; letter-spacing: 0.03em; }
  /* A stage with no marks lines its label up with the others'. */
  .stage__value + .stage__label { margin-top: calc(0.9rem + var(--story-square-h) + 0.75rem); }

  /* --- bars: scores against a bar to clear ------------------------------ */
  .bars { position: relative; padding-top: 1.5rem; }
  .bars__list { margin: 0; }
  .bars__row {
    display: grid;
    grid-template-columns: var(--story-bar-label) minmax(0, 1fr) var(--story-bar-value);
    gap: 0.75rem;
    align-items: center;
    min-height: 2.5rem;
  }
  .bars__row dd { margin: 0; }
  .bars__track { position: relative; height: var(--story-bar-h); }
  .bars__bar { position: absolute; inset: 0 auto 0 0; width: calc(var(--v) * 100%); background: var(--story-mark-pale); }
  .bars__bar--top { background: var(--story-mark); }
  .bars__value {
    text-align: right;
    font-family: var(--font-serif); font-weight: var(--weight-serif);
    font-size: var(--step-title); letter-spacing: var(--tracking-serif);
  }
  /* The bar to clear: a dashed line across every row, labelled on top. */
  .bars__line {
    position: absolute; top: 0; bottom: 0;
    left: calc(var(--story-bar-label) + 0.75rem + (100% - var(--story-bar-label) - var(--story-bar-value) - 1.5rem) * var(--bar-at));
    border-left: 1px dashed var(--fg);
    padding-left: 0.4rem;
    color: var(--fg);
    white-space: nowrap;
    line-height: 1;
  }
  .bars__note { margin: 1rem 0 0; text-transform: none; letter-spacing: 0.03em; line-height: 1.6; max-width: var(--measure); }

  /* --- fixes: found → changed ------------------------------------------- */
  .fixes { width: 100%; border-collapse: separate; border-spacing: 0 var(--case-list-gap); margin-block: calc(-1 * var(--case-list-gap)); font-size: var(--step-small); line-height: 1.55; }
  .fixes th { text-align: left; font-weight: inherit; padding: 0 1rem 0 0; }
  .fixes td { padding: 0 1rem 0 0; vertical-align: top; color: var(--fg-dim); }
  .fixes__tag { width: 6.5rem; line-height: 1.9; }
  .fixes td.fixes__changed { color: var(--fg); }

  /* --- aside: the gap, named mid-story ---------------------------------- */
  .aside { max-width: var(--measure); }
  /* One line pointing elsewhere: the site's link style, nothing more. */
  .see { max-width: var(--measure); margin: 0; font-size: var(--step-copy); color: var(--fg-dim); }
  .see a { color: var(--fg); }
  .aside__label { margin: 0 0 0.6rem; }
  .aside__text {
    margin: 0;
    font-family: var(--font-serif); font-weight: var(--weight-serif);
    font-size: var(--step-title); line-height: 1.35; letter-spacing: var(--tracking-serif);
    text-wrap: pretty;
  }

  @media (max-width: 820px) {
    .sides { grid-template-columns: 1fr; }
    .funnel { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.5rem; }
    .fixes, .fixes tbody, .fixes tr, .fixes td { display: block; width: auto; }
    .fixes thead { display: none; }
    .fixes { margin-block: 0; }
    .fixes tbody { display: grid; row-gap: var(--case-list-gap); }
    .fixes td { padding: 0.15rem 0; }
    .fixes td.fixes__changed::before { content: '→ '; color: var(--fg-dim); }
    .metrics { grid-template-columns: 1fr; }
    .row { grid-template-columns: 1fr; }
    .quote p { max-width: none; }
  }
</style>
