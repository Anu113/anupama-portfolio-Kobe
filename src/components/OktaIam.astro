---
/* OktaIam.astro — the Okta IAM case's product pictures, drawn in code in
   the Okta Admin Console's style (on request, 2026-11-26; built from
   experiments/okta-case, which follows the order of
   marygans.com/case-studies/ai-dashboard, with every picture redrawn for
   Okta: none of her files are used).

   She has no screens of her own for this case, so these are redrawn.
   The org (Acme), people and counts are made-up UI content; the access
   model's five steps and the plan's order of areas are still hers to
   confirm (see the okta-iam entry in cases.ts).

   `view` picks what to draw, each on the Okta hue:
     cover      the dashboard on a laptop with a phone version beside it
                (the case's cover; the laptop hides on narrow screens)
     dashboard  the Admin Console dashboard on its own
     scale      one person at a time vs a whole group, as dots
     plan       migration day vs in place, on one grid of areas × quarters,
                switched by two buttons
     model      the five steps of one access change, a diagram with a
                list; pointing at or focusing a step lights it
     flow       person, group and app pages leading into one Change access
                step and the audit trail
     scroll     the Salesforce entitlements page, grouped by department,
                scrolling slowly
     cards      the group-change card and the trend line after it
     role       a role card; one permission switches on and its review
                bar appears
     review     the review dialog: checks tick in, the admin confirms, a
                notice says it was applied and logged, with Undo

   Motion plays only while a picture is on screen (the dashboard, cards
   and line replay every --iam-replay while you stay). Its reason: the
   work is shown happening, the way the console behaves, not described.
   Everything is still and finished under reduced motion. Each picture is
   one image for screen readers (role img + a label); the buttons drawn
   inside it are drawings, not controls. The plan's switch and the
   model's steps are real buttons. Colours are the OKTA AI SCREENS tokens
   (they belong to the work); timing under OKTA IAM in tokens.css. */
type View = 'cover' | 'dashboard' | 'scale' | 'plan' | 'model' | 'flow' | 'scroll' | 'cards' | 'role' | 'review';
interface Props { view: View; caption?: string }
const { view, caption } = Astro.props;

const nav = ['Dashboard', 'Directory', 'Applications', 'Security', 'Identity Governance', 'Reports', 'Settings'];
const bars = [42, 55, 38, 70, 92, 30, 24];

const labels: Record<View, string> = {
  cover: 'The Okta Admin Console dashboard on a laptop and on a phone: counts of people, apps and access changes this week, a Needs attention list and a chart of access changes.',
  dashboard: 'The Okta Admin Console dashboard: 41,280 people, 312 applications, 1,904 access changes this week; a Needs attention list led by 61 people in Finance who haven’t used Salesforce in 90 days; a chart of access changes over seven days.',
  scale: '',
  plan: '',
  model: '',
  flow: 'Diagram: a person’s page, a group’s page and an app’s page all lead into one Change access step, which writes to the audit trail.',
  scroll: 'The Salesforce entitlements page, grouped by department: Finance 240, Sales 118, Support 64, each with a Change access link, scrolling slowly.',
  cards: 'Two cards. Salesforce Standard user in Finance: 179 of 240 signed in within 90 days, 61 not, with a button to remove the 61. Beside it, people with Salesforce in Finance over twelve weeks, dropping by 61 after one bulk change.',
  role: 'A role card: Help desk admin, 12 admins, four permissions. Manage app assignments switches on and a bar appears: 1 change, reaches 12 admins, Review.',
  review: 'A Review 240 changes dialog: remove Salesforce Standard user from people in Finance; 240 people match, no admins in the group, can be undone for 30 days; a confirm box, then a notice that 240 changes were applied and logged, with Undo.',
};

const people = Array.from({ length: 120 }, (_, i) => (i * 37) % 7 < 2);
const firstOn = people.indexOf(true);

const areas = ['Entitlements', 'Role management', 'People & groups', 'OIN publishing', 'Dev onboarding'];
const quarters = ['Q1', 'Q2', 'Q3', 'Q4', 'Q5', 'Q6'];
const plans = {
  place: (r: number, c: number) => (c > r ? 'new' : c === r ? 'dual' : ''),
  cut: (r: number, c: number) => (c < 4 ? (c >= 1 ? 'dual' : '') : 'new'),
};

const steps = [
  ['Who, by what they share', 'Filters, not names. The question admins actually ask.'],
  ['What changes', 'An app, a role or an entitlement, in one sentence.'],
  ['How many, before you commit', 'The count updates as the filter changes.'],
  ['Who exactly', 'A few names, to check the filter caught the right people.'],
  ['Review, then record', 'The button says what it will do. Every change is logged.'],
];

const names = ['Priya N.', 'Marcus O.', 'Tomás R.', 'Aiko S.', 'Daniel F.', 'Ruth B.', 'Omar H.', 'Ines V.', 'Kwame A.', 'Sara L.', 'Jonas P.', 'Meera K.', 'Leo C.', 'Hana M.'];
const groups: [string, number, string[], number][] = [
  ['Finance', 240, names.slice(0, 8), 0],
  ['Sales', 118, names.slice(6), 2],
  ['Support', 64, names.slice(2, 7), 3],
];
const initials = (n: string) => n.split(' ').map((w) => w[0]).join('').replace('.', '');

const animated = ['cover', 'dashboard', 'flow', 'scroll', 'cards', 'role', 'review'].includes(view);
const replay = ['cover', 'dashboard', 'cards'].includes(view);
---

<figure class:list={['iam', `iam--${view}`, animated && 'iam-anim']} data-replay={replay ? '' : undefined}>
  {(view === 'cover' || view === 'dashboard') && (
    <div class:list={['stage', view === 'cover' && 'stage--cover']} role="img" aria-label={labels[view]}>
      <div class="desk">
        <div class="win" aria-hidden="true">
          <div class="win__top"><i></i><i></i><i></i><span class="win__url">acme-admin.okta.com/admin/dashboard</span></div>
          <div class="win__app">
            <div class="win__nav"><b class="logo">okta</b>{nav.map((n, k) => <span class:list={[k === 0 && 'on']}>{n}</span>)}</div>
            <div class="win__main">
              <div class="h">Dashboard</div>
              <div class="stats">
                <div class="blk" style="--d:.15s"><div class="sk"></div><div class="c"><span class="k">People</span><b class="v">41,280</b></div></div>
                <div class="blk" style="--d:.3s"><div class="sk"></div><div class="c"><span class="k">Applications</span><b class="v">312</b></div></div>
                <div class="blk" style="--d:.45s"><div class="sk"></div><div class="c"><span class="k">Access changes this week</span><b class="v">1,904</b></div></div>
              </div>
              <div class="row2">
                <div class="blk" style="--d:.65s"><div class="sk"></div><div class="c">
                  <div class="pn">Needs attention</div>
                  <div class="att"><span class="dot dot--amber"></span><span>61 people in Finance haven’t used Salesforce in 90 days</span><span class="lnk">Review</span></div>
                  <div class="att"><span class="dot dot--blue"></span><span>Contractor access ends Friday · 18 people</span><span class="lnk">Review</span></div>
                  <div class="att"><span class="dot dot--grey"></span><span>3 admin roles have no owner</span><span class="lnk">Assign</span></div>
                </div></div>
                <div class="blk" style="--d:.8s"><div class="sk"></div><div class="c">
                  <div class="pn">Access changes · 7 days</div>
                  <div class="bars">{bars.map((h, i) => <i class="bar" style={`--h:${h}%;--i:${i}`}></i>)}</div>
                  <div class="bars__x"><span>Mon</span><span>Sun</span></div>
                </div></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      {view === 'cover' && (
        <div class="ph" aria-hidden="true"><div class="ph__scr">
          <div class="ph__status"><span>9:41</span><span class="ph__island"></span><span class="ph__sig"><i></i><i></i><i></i></span></div>
          <div class="ph__bar"><b class="logo">okta</b><span class="ph__menu"><i></i><i></i><i></i></span></div>
          <div class="ph__body">
            <div class="h">Dashboard</div>
            <div class="ph__stats">
              <div class="blk" style="--d:.2s"><div class="sk"></div><div class="c"><span class="k">People</span><b class="v">41,280</b></div></div>
              <div class="blk" style="--d:.35s"><div class="sk"></div><div class="c"><span class="k">Apps</span><b class="v">312</b></div></div>
            </div>
            <div class="blk" style="--d:.5s"><div class="sk"></div><div class="c"><span class="k">Access changes this week</span><b class="v">1,904</b></div></div>
            <div class="blk" style="--d:.7s"><div class="sk"></div><div class="c">
              <div class="pn">Needs attention</div>
              <div class="att"><span class="dot dot--amber"></span><span>61 in Finance haven’t used Salesforce in 90 days</span><span class="lnk">›</span></div>
              <div class="att"><span class="dot dot--blue"></span><span>Contractor access ends Friday</span><span class="lnk">›</span></div>
              <div class="att"><span class="dot dot--grey"></span><span>3 admin roles have no owner</span><span class="lnk">›</span></div>
            </div></div>
            <div class="blk" style="--d:.85s"><div class="sk"></div><div class="c">
              <div class="pn">Access changes · 7 days</div>
              <div class="bars bars--sm">{bars.map((h, i) => <i class="bar" style={`--h:${h}%;--i:${i}`}></i>)}</div>
            </div></div>
          </div>
          <div class="ph__home"></div>
        </div></div>
      )}
    </div>
  )}

  {view === 'scale' && (
    <div class="scale">
      <div class="scale__panel">
        <span class="u-label-mono scale__lbl">Before · one page per person</span>
        <div class="people" aria-hidden="true">{people.map((_, i) => <i class:list={[i === firstOn && 'on']}></i>)}</div>
        <span class="scale__big">1 of 240</span>
        <p class="scale__p">Open a person, remove the app, go back, repeat.</p>
      </div>
      <div class="scale__panel">
        <span class="u-label-mono scale__lbl">After · one change for a group</span>
        <div class="query"><span>Department is Finance</span>and<span>Has Salesforce</span></div>
        <div class="people people--group" aria-hidden="true">{people.map((on) => <i class:list={[on && 'on']}></i>)}</div>
        <span class="scale__big">240 at once</span>
        <p class="scale__p">Find them by what they share, and change them together.</p>
      </div>
    </div>
  )}

  {view === 'plan' && (
    <div class="plan" data-plan-root>
      <div class="seg" role="group" aria-label="Compare the two plans">
        <button type="button" aria-pressed="false" data-plan="cut">Migration day</button>
        <button type="button" aria-pressed="true" data-plan="place">In place</button>
      </div>
      <div class="plan__card">
        <div class="plan__grid" role="img" aria-label="Five areas over six quarters. In place: each area moves to the new console in its own quarter, with old and new kept alive side by side around it. Migration day: everything is rebuilt in parallel, then switches over at once in quarter five.">
          <span></span>
          {quarters.map((q) => <span class="u-label-mono plan__q">{q}</span>)}
          {areas.map((a, r) => (
            <>
              <span class="u-label-mono plan__area">{a}</span>
              {quarters.map((_, c) => (
                <span class="cell" data-r={r} data-c={c} style={`--i:${r * 6 + c}`} data-place={plans.place(r, c)} data-cut={plans.cut(r, c)}></span>
              ))}
            </>
          ))}
        </div>
        <div class="u-label-mono legend"><span><i></i>Old screens</span><span><i class="new"></i>New screens</span><span><i class="dual"></i>Two versions kept alive</span></div>
      </div>
      <div class="verdict">
        <div data-v="cut"><strong class="u-label-mono">Migration day</strong>Every button moves on one date. The old console lives on for months, getting its own fixes.</div>
        <div data-v="place" class="is-on"><strong class="u-label-mono">In place · my call</strong>One area at a time on the live product. It was slower, and our system designer spent two quarters keeping both versions working. Still the right call.</div>
      </div>
    </div>
  )}

  {view === 'model' && (
    <div class="model" data-model-root>
      <div class="stage">
        <div class="dia" role="img" aria-label="Diagram of one access change, in five steps: who, what changes, how many, who exactly, then review and record.">
          <div class="dia__step" data-part="1"><span class="u-label-mono dia__k">Who</span><span class="dia__v"><span class="tok">Department is Finance</span><span class="tok">Has Salesforce</span></span><span class="pin" aria-hidden="true">1</span></div>
          <div class="dia__step" data-part="2"><span class="u-label-mono dia__k">What changes</span><span class="dia__v">Remove <span class="tok">an app, role or entitlement</span></span><span class="pin" aria-hidden="true">2</span></div>
          <div class="dia__step" data-part="3"><span class="u-label-mono dia__k">How many</span><span class="dia__v"><b class="dia__n">n</b> people</span><span class="pin" aria-hidden="true">3</span></div>
          <div class="dia__step" data-part="4"><span class="u-label-mono dia__k">Who exactly</span><span class="dia__v dia__lines"><i></i><i></i><i></i></span><span class="pin" aria-hidden="true">4</span></div>
          <div class="dia__step" data-part="5"><span class="u-label-mono dia__k">Review, record</span><span class="dia__v"><span class="dia__btn">Review n changes</span><span>→ audit trail</span></span><span class="pin" aria-hidden="true">5</span></div>
        </div>
      </div>
      <ol class="parts">
        {steps.map(([t, d], i) => (
          <li><button type="button" data-p={i + 1}><span class="parts__n" aria-hidden="true">{i + 1}</span><span class="parts__t">{t}</span><span class="parts__d">{d}</span></button></li>
        ))}
      </ol>
    </div>
  )}

  {view === 'flow' && (
    <div class="stage stage--flat">
      <svg class="flow" viewBox="0 0 420 260" role="img" aria-label={labels.flow}>
        <g class="flow__lines">
          <path id="iam-fl1" d="M118 46 C 150 46, 150 130, 168 130" />
          <path id="iam-fl2" d="M118 130 L 168 130" />
          <path id="iam-fl3" d="M118 214 C 150 214, 150 130, 168 130" />
          <path id="iam-fl4" d="M282 130 L 318 130" />
        </g>
        <g class="flow__src">
          <rect x="10" y="26" width="108" height="40" rx="8" /><text x="64" y="50">Person page</text>
          <rect x="10" y="110" width="108" height="40" rx="8" /><text x="64" y="134">Group page</text>
          <rect x="10" y="194" width="108" height="40" rx="8" /><text x="64" y="218">App page</text>
        </g>
        <g class="flow__core">
          <rect x="168" y="78" width="114" height="104" rx="12" />
          <text x="225" y="104" class="t1">Change access</text>
          <text x="225" y="124">who · what</text>
          <text x="225" y="140">how many</text>
          <text x="225" y="156">review</text>
        </g>
        <g class="flow__out"><rect x="318" y="108" width="92" height="44" rx="8" /><text x="364" y="134">Audit trail</text></g>
        <g class="flow__dots">
          <circle r="4"><animateMotion dur="3s" repeatCount="indefinite" begin="0s"><mpath href="#iam-fl1" /></animateMotion></circle>
          <circle r="4"><animateMotion dur="3s" repeatCount="indefinite" begin="1s"><mpath href="#iam-fl2" /></animateMotion></circle>
          <circle r="4"><animateMotion dur="3s" repeatCount="indefinite" begin="2s"><mpath href="#iam-fl3" /></animateMotion></circle>
          <circle r="4"><animateMotion dur="1.5s" repeatCount="indefinite" begin=".5s"><mpath href="#iam-fl4" /></animateMotion></circle>
        </g>
      </svg>
    </div>
  )}

  {view === 'scroll' && (
    <div class="stage" role="img" aria-label={labels.scroll}>
      <div class="win win--tall" aria-hidden="true">
        <div class="win__top"><i></i><i></i><i></i><span class="win__url">acme-admin.okta.com/admin/app/salesforce/entitlements</span></div>
        <div class="win__app">
          <div class="win__nav"><b class="logo">okta</b>{nav.map((n, k) => <span class:list={[k === 2 && 'on']}>{n}</span>)}</div>
          <div class="win__main win__main--clip">
            <div class="scr">
              <div class="h">Salesforce · Entitlements</div>
              <div class="filters"><span class="on">Standard user</span><span class="on">Group by department</span><span>Last sign-in</span><span>+ Filter</span></div>
              {groups.map(([dept, n, list, off]) => (
                <>
                  <div class="grp"><span>{dept} · {n}</span><span class="lnk">Change access for {n}</span></div>
                  {list.map((p, i) => {
                    const old = (i + off) % 4 === 1;
                    return (
                      <div class="prow"><span class="av">{initials(p)}</span><span>{p}</span><span class="mut">{dept}</span><span class:list={[old ? 'old' : 'mut']}>{old ? '94 days ago' : `${((i + off) % 5) + 1} days ago`}</span></div>
                    );
                  })}
                </>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  )}

  {view === 'cards' && (
    <div class="pair">
      <div class="stage" role="img" aria-label={labels.cards}>
        <div class="card" aria-hidden="true">
          <div class="card__h"><span class="appic">SF</span><div><b>Salesforce · Standard user</b><span class="mut">Finance · 240 people</span></div><span class="pill pill--amber">61 unused</span></div>
          <div class="usage__bar"><i class="usage__used" style="--w:74.6%"></i><i class="usage__un" style="--w:25.4%"></i></div>
          <div class="usage__k"><span><i class="sw sw--used"></i>Signed in, last 90 days · 179</span><span><i class="sw sw--un"></i>Not signed in · 61</span></div>
          <div class="card__f"><span class="btn2">View people</span><span class="btn1">Remove from 61</span></div>
        </div>
      </div>
      <div class="stage" aria-hidden="true">
        <div class="card">
          <div class="card__h"><span class="appic appic--grey">↘</span><div><b>People with Salesforce · Finance</b><span class="mut">Last 12 weeks</span></div></div>
          <svg class="trend" viewBox="0 0 300 120">
            <path class="trend__grid" d="M0 30H300M0 60H300M0 90H300" />
            <path class="trend__line" pathLength="1" d="M0 70 L27 66 L54 60 L81 56 L108 50 L135 44 L162 40 L189 34 L216 30 L230 30 L236 82 L270 80 L300 79" />
            <circle class="trend__pt" cx="236" cy="82" r="4" />
            <text class="trend__lbl" x="296" y="104" text-anchor="end">Bulk change · −61</text>
          </svg>
          <div class="card__f"><span class="mut">Logged · 1 change, 61 people</span><span class="btn2">Audit trail</span></div>
        </div>
      </div>
    </div>
  )}

  {view === 'role' && (
    <div class="stage" role="img" aria-label={labels.role}>
      <div class="card card--wide" aria-hidden="true">
        <div class="card__h"><span class="appic appic--ink">HD</span><div><b>Role · Help desk admin</b><span class="mut">12 admins</span></div><span class="pill">Custom role</span></div>
        <div class="perm"><span>Reset passwords</span><i class="tg on"></i></div>
        <div class="perm"><span>Unlock accounts</span><i class="tg on"></i></div>
        <div class="perm perm--flip"><span>Manage app assignments</span><i class="tg"></i></div>
        <div class="perm"><span>Change admin roles</span><i class="tg"></i></div>
        <div class="card__f card__f--review"><span class="mut">1 change · reaches 12 admins</span><span class="btn1">Review</span></div>
      </div>
    </div>
  )}

  {view === 'review' && (
    <div class="stage" role="img" aria-label={labels.review}>
      <div class="win win--review" aria-hidden="true">
        <div class="win__top"><i></i><i></i><i></i><span class="win__url">acme-admin.okta.com/admin/people</span></div>
        <div class="win__app">
          <div class="win__nav"><b class="logo">okta</b>{nav.map((n, k) => <span class:list={[k === 1 && 'on']}>{n}</span>)}</div>
          <div class="win__main">
            <div class="h">People · Finance</div>
            <div class="rv__bg"><i></i><i></i><i></i><i></i><i></i></div>
            <div class="rv__scrim"></div>
            <div class="rv__modal">
              <b class="rv__t">Review 240 changes</b>
              <p class="rv__s">Remove <span class="tok">Salesforce · Standard user</span> from people in Finance.</p>
              <div class="rv__ck"><span class="ck ck1">✓</span>240 people match the filter</div>
              <div class="rv__ck"><span class="ck ck2">✓</span>No admins in this group</div>
              <div class="rv__ck"><span class="ck ck3">✓</span>Can be undone for 30 days</div>
              <div class="rv__ok"><span class="box">✓</span>I’ve checked who this reaches</div>
              <div class="rv__f"><span class="btn2">Back</span><span class="btn1 rv__go">Remove from 240</span></div>
            </div>
            <div class="rv__toast"><span>✓</span>240 changes applied · logged to the audit trail<b>Undo</b></div>
          </div>
        </div>
      </div>
    </div>
  )}

  {caption && <figcaption class="u-label-mono cap">{caption}</figcaption>}
</figure>

<script>
  import { cssMs } from '../scripts/css-time';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Plan: two buttons redraw the grid and swap the verdict.
  document.querySelectorAll<HTMLElement>('[data-plan-root]').forEach((root) => {
    const show = (plan: string) => {
      root.querySelectorAll<HTMLElement>('.cell').forEach((c) => {
        c.className = 'cell ' + (c.dataset[plan as 'place' | 'cut'] ?? '');
      });
      root.querySelectorAll<HTMLButtonElement>('[data-plan]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.plan === plan)));
      root.querySelectorAll<HTMLElement>('[data-v]').forEach((v) => v.classList.toggle('is-on', v.dataset.v === plan));
    };
    root.querySelectorAll<HTMLButtonElement>('[data-plan]').forEach((b) => b.addEventListener('click', () => show(b.dataset.plan!)));
    show('place');
  });

  // Model: pointing at or focusing a step lights it in the diagram.
  document.querySelectorAll<HTMLElement>('[data-model-root]').forEach((root) => {
    const parts = root.querySelectorAll<HTMLButtonElement>('[data-p]');
    const regions = root.querySelectorAll<HTMLElement>('[data-part]');
    const light = (p: string | null) => {
      regions.forEach((el) => el.classList.toggle('lit', el.dataset.part === p));
      parts.forEach((b) => b.classList.toggle('lit', b.dataset.p === p));
    };
    parts.forEach((b) => {
      b.addEventListener('mouseenter', () => light(b.dataset.p!));
      b.addEventListener('focus', () => light(b.dataset.p!));
      b.addEventListener('click', () => light(b.dataset.p!));
      b.addEventListener('blur', () => light(null));
    });
    root.querySelector('.parts')?.addEventListener('mouseleave', () => light(null));
  });

  // Motion: only on screen, only with motion allowed.
  const figs = document.querySelectorAll<HTMLElement>('.iam-anim');
  if (reduce) {
    document.querySelectorAll<SVGSVGElement>('.iam .flow').forEach((s) => s.pauseAnimations());
  } else if (figs.length) {
    const every = cssMs('--iam-replay', 7000);
    const timers = new Map<HTMLElement, number>();
    const restart = (f: HTMLElement) => { f.classList.remove('play'); void f.offsetWidth; f.classList.add('play'); };
    figs.forEach((f) => f.classList.add('go'));
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      const f = e.target as HTMLElement;
      const svg = f.querySelector<SVGSVGElement>('.flow');
      if (e.isIntersecting) {
        restart(f);
        if ('replay' in f.dataset) timers.set(f, window.setInterval(() => restart(f), every));
        svg?.unpauseAnimations();
      } else {
        f.classList.remove('play');
        window.clearInterval(timers.get(f));
        svg?.pauseAnimations();
      }
    }), { threshold: 0.3 });
    figs.forEach((f) => io.observe(f));
  }
</script>

<style>
