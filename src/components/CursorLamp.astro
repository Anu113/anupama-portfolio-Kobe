---
/* CursorLamp.astro — a soft pool of light under the pointer, dark mode
   only. After studio-nikita.com, which does the same with one full-page
   radial gradient whose centre follows the mouse.

   Why it's here: dark mode lights the hero as a late-night scene (NIGHT
   LIGHT in tokens.css); this carries that scene down the page — the
   visitor's pointer is the lamp. It sits alongside CursorTrail on
   request (the trail draws the path, this lights the room).

   How: one small round element the size of the pool, moved with a
   transform so the browser only re-composites it, never repaints the
   page (the first pass moved a full-screen gradient, which repainted the
   whole blended layer every move and stuttered). It glides after the
   pointer, closing --lamp-follow of the gap each frame, and stops its
   loop once it has caught up. It lives inside <main>, so the page's
   curved end clips it off the black footer, and is screen-blended over
   the content because <Section> bands paint their own ground, which
   would cover a layer placed behind them. Values live under CURSOR LAMP
   in tokens.css; strength is --hero-night, so it is zero in light mode
   and fades with the theme over --dur-night.

   Text casts shadows from it: headings, paragraphs and list items within
   the pool get a short black text-shadow pointing away from the lamp,
   stronger the closer they are (the CursorTrail line itself casts none,
   on request). Only text on screen is measured, tracked with an
   IntersectionObserver; shadows are cleared as text leaves the pool.
   Values under CURSOR LAMP (--lamp-cast-*); also scaled by --hero-night.

   It also announces where it is: every move dispatches a `cursor-lamp`
   event on window ({ x, y, on, radius }, viewport px), which
   HeroIllustration and AskBubble use to light her and Moss. The hero
   row sits above this layer (--z-lamp), so the lamp lights the ground
   behind her and the hero's text shadows fall on that light.

   Off, not just invisible: under prefers-reduced-motion, and on devices
   without hover (no pointer to follow). Takes no pointer events. */
---
<div class="lamp" id="cursor-lamp" aria-hidden="true"></div>

<style>
  .lamp {
    position: fixed; top: 0; left: 0;
    z-index: var(--z-lamp);
    width: calc(var(--lamp-size) * 2);
    height: calc(var(--lamp-size) * 2);
    margin: calc(var(--lamp-size) * -1) 0 0 calc(var(--lamp-size) * -1);
    pointer-events: none;
    mix-blend-mode: screen;
    /* Eased falloff: a plain two-stop fade drops off linearly and leaves
       a visible rim; these stops trace a smooth bell instead. */
    background: radial-gradient(
      closest-side,
      var(--lamp-colour),
      color-mix(in srgb, var(--lamp-colour) 70%, transparent) calc(var(--lamp-reach) * 0.25),
      color-mix(in srgb, var(--lamp-colour) 35%, transparent) calc(var(--lamp-reach) * 0.5),
      color-mix(in srgb, var(--lamp-colour) 12%, transparent) calc(var(--lamp-reach) * 0.75),
      transparent var(--lamp-reach)
    );
    transform: translate3d(-100vw, -100vh, 0);
    will-change: transform;
    opacity: 0;
    transition: opacity var(--dur-night) var(--ease-out);
  }
  .lamp.is-on { opacity: var(--hero-night); }
  /* The text shadows are inherited from the caster; a filled button
     inside it (the hero's Resume pill) would smudge, so buttons opt out. */
  :global(.btn) { text-shadow: none; }

  @media (prefers-reduced-motion: reduce) { .lamp { display: none; } }
  @media (hover: none) { .lamp { display: none; } }
</style>

<script>
  (() => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (matchMedia('(hover: none)').matches) return;

    const lamp = document.getElementById('cursor-lamp');
    if (!lamp) return;

    const follow = () =>
      Number(getComputedStyle(lamp).getPropertyValue('--lamp-follow')) || 0.22;
    let k = follow();

    // Text that can cast a shadow, and which of it is on screen now.
    const CASTERS = 'main :is(h1, h2, h3, h4, p, li, dt, dd, blockquote, figcaption)';
    const onScreen = new Set();
    const lit = new Set();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) onScreen.add(e.target);
        else { onScreen.delete(e.target); e.target.style.textShadow = ''; lit.delete(e.target); }
      }
    });
    document.querySelectorAll(CASTERS).forEach((el) => io.observe(el));

    let cast = { alpha: 0, length: 0, blur: 0 };
    const readCast = () => {
      const cs = getComputedStyle(document.documentElement);
      const n = (name) => Number(cs.getPropertyValue(name)) || 0;
      cast = {
        alpha: n('--lamp-cast-alpha') * n('--hero-night'),
        length: n('--lamp-cast-length'),
        blur: n('--lamp-cast-blur'),
      };
    };
    readCast();

    const clearCast = () => {
      for (const el of lit) el.style.textShadow = '';
      lit.clear();
    };

    // Each caster's shadow points from the lamp to the caster's centre;
    // strength falls off with the distance from the lamp to the nearest
    // edge of its box, reaching zero at the pool's edge.
    const castShadows = () => {
      if (!cast.alpha || !lamp.classList.contains('is-on')) { clearCast(); return; }
      const reach = lamp.offsetWidth / 2;
      for (const el of onScreen) {
        const r = el.getBoundingClientRect();
        const nx = Math.max(r.left, Math.min(pos.x, r.right));
        const ny = Math.max(r.top, Math.min(pos.y, r.bottom));
        const d = Math.hypot(nx - pos.x, ny - pos.y);
        if (d >= reach) {
          if (lit.has(el)) { el.style.textShadow = ''; lit.delete(el); }
          continue;
        }
        const f = (1 - d / reach) ** 2;
        const dx = (r.left + r.right) / 2 - pos.x;
        const dy = (r.top + r.bottom) / 2 - pos.y;
        const len = Math.hypot(dx, dy) || 1;
        const ox = (dx / len) * cast.length;
        const oy = (dy / len) * cast.length;
        el.style.textShadow =
          `${ox.toFixed(1)}px ${oy.toFixed(1)}px ${cast.blur}px rgb(0 0 0 / ${(cast.alpha * f).toFixed(3)})`;
        lit.add(el);
      }
    };

    const target = { x: 0, y: 0 };
    const pos = { x: 0, y: 0 };
    let seeded = false;
    let looping = false;

    const announce = (on) => {
      dispatchEvent(new CustomEvent('cursor-lamp', {
        detail: { x: pos.x, y: pos.y, on, radius: lamp.offsetWidth / 2 },
      }));
    };

    const place = () => {
      lamp.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0)`;
      announce(true);
    };

    const tick = () => {
      pos.x += (target.x - pos.x) * k;
      pos.y += (target.y - pos.y) * k;
      place();
      castShadows();
      if (Math.hypot(target.x - pos.x, target.y - pos.y) > 0.3) {
        requestAnimationFrame(tick);
      } else {
        looping = false;
      }
    };

    addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      target.x = e.clientX;
      target.y = e.clientY;
      if (!seeded) {
        // Start under the pointer rather than gliding in from the corner.
        pos.x = target.x; pos.y = target.y;
        place();
        seeded = true;
      }
      lamp.classList.add('is-on');
      if (!looping) { looping = true; requestAnimationFrame(tick); }
    }, { passive: true });

    addEventListener('resize', () => { k = follow(); });
    // The page moves under a still pointer, and the theme switches the
    // strength.
    addEventListener('scroll', castShadows, { passive: true });
    addEventListener('theme:changed', () => {
      // --hero-night is read after the tokens re-ink this frame.
      requestAnimationFrame(() => { readCast(); castShadows(); });
    });

    document.documentElement.addEventListener('mouseleave', () => {
      lamp.classList.remove('is-on');
      clearCast();
      announce(false);
    });
  })();
</script>
