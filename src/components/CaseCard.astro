---
/* A work tile for the drag rail or the work index. */
interface Props {
  title: string; href: string; image: string; alt?: string;
  scope?: string; metric?: string; w?: number; ratio?: string;
}
const { title, href, image, alt = '', scope, metric, w = 34, ratio = '4/3' } = Astro.props;
---
<a class="card" href={href} style={`--w:${w}vw; --ratio:${ratio};`}>
  <div class="card__media"><img src={image} alt={alt} loading="lazy" decoding="async" /></div>
  <div class="card__meta">
    {scope && <p class="u-label card__scope">{scope}</p>}
    <h3 class="card__title">{title}</h3>
    {metric && <p class="card__metric">{metric}</p>}
  </div>
</a>

<style>
  .card {
    display: block; width: var(--w); min-width: 260px;
    color: inherit; text-decoration: none;
  }
  .card__media {
    aspect-ratio: var(--ratio); overflow: hidden;
    border-radius: var(--radius); background: var(--rule);
  }
  .card__media img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: scale var(--dur-hover) var(--ease-out);
  }
  .card:hover .card__media img { scale: 1.03; }
  .card__meta { padding-top: 1rem; display: grid; gap: 0.35rem; }
  .card__scope { margin: 0; }
  .card__title { font-size: var(--step-h3); font-weight: 500; margin: 0; letter-spacing: var(--tracking-tight); }
  .card__metric { margin: 0; color: var(--fg-dim); font-size: 0.9rem; }
  @media (max-width: 700px) { .card { width: 78vw; } }
</style>
