---
/* CaseCard.astro — the one project-card component. Used by /work's grid;
   any future grid of projects (another index, a "more work" rail) should
   reach for this rather than inlining a card again.

   No cursor-following "View case study" pill: it was removed on request
   (2026-11-16) because it made the grid feel slow. The hover is the image
   easing up 4% and the normal pointer. HoverLabel.astro stays, unmounted.

   When the case has an entry in data/workPlay.ts the page passes it as
   `stage`, and the picture is WorkStage.astro instead (on request,
   2026-11-16): an iPhone whose flow plays while the card is hovered or
   focused, or Okta's laptop + phone. Those don't ease up — the flow is
   the hover.

   The media carries the company's project hue (data-hue, from hueFor()
   in data/work.ts) — the colour belongs to its thumbnail, while the meta
   text underneath stays in the page's own palette.

   Its shape and words are the home page's cards' (ProjectCard.astro),
   on request 2026-11-26: the picture is a stage with 20px corners at the
   home stage's height, and under it the company and labels as small grey
   chips, the title in the item role, one 12px line (the impact) and the
   round arrow that opens to "View" on hover (.card-chips and .card-go in
   global.css, shared with the home cards). What's on the stage stays
   /work's own: WorkStage's phones on their photo and colour grounds.

   A locked case (`locked`, from lockFor() in cases.ts) keeps the small
   lock by its title and, on hover or focus, frosts its picture with
   "Password protected" (LockFrost.astro, on request 2026-11-18); it
   still clicks through to the gate. Screen readers hear "password
   protected" after the title. */
import LockIcon from './LockIcon.astro';
import LockFrost from './LockFrost.astro';
import WorkStage from './WorkStage.astro';
import { hueFor } from '../data/work';
import type { Play, Desk } from '../data/workPlay';

interface Props {
  title: string; href: string; image: string; alt?: string;
  company?: string; role?: string; impact?: string;
  labels?: string[];
  theme?: string; ratio?: string;
  locked?: boolean;
  stage?: Play | Desk;
}
const {
  title, href, image, alt = '',
  company, impact,
  labels = [],
  theme, ratio = '4 / 3',
  locked = false,
  stage,
} = Astro.props;
---
<a class="card" href={href} data-card data-locked={locked || undefined}>
  <div class={`card__media${stage ? ' card__media--stage' : ''}`} data-theme={theme} data-hue={hueFor(company) ?? ''} style={`--ratio: ${ratio};`}>
    {stage ? <WorkStage stage={stage} /> : <img src={image} alt={alt} loading="lazy" decoding="async" />}
    {locked && <LockFrost />}
  </div>
  <div class="card__body">
    <ul class="card-chips" aria-label="Company, domain and discipline">
      {company && <li class="card__co">{locked && <LockIcon class="card__lock" size="1em" />}{company}</li>}
      {labels.map((t) => <li>{t}</li>)}
    </ul>
    <h2 class="card__title">
      {title}
      {locked && <span class="u-sr-only">, password protected</span>}
    </h2>
    {impact && <p class="card__impact">{impact}</p>}
    <span class="card-go" aria-hidden="true"><s></s><u></u><b>View</b><i><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 11.5l7-7M5.5 4.5h6v6"/></svg></i></span>
  </div>
</a>

<style>
  /* The home card's shape: no fill or line, the stage is the card's edge;
     room under the words before the next row (HOME CARDS in tokens.css). */
  .card {
    display: flex; flex-direction: column;
    height: 100%;
    padding: var(--home-card-pad);
    text-decoration: none; color: var(--fg); position: relative;
  }
  .card:focus-visible { outline: none; }
  .card:focus-visible .card__media { outline: 2px solid var(--focus); outline-offset: 4px; }
  .card__media {
    position: relative;
    background: var(--hue);   /* the company's project hue (tokens.css, PROJECT HUES) */
    height: var(--home-stage-h);
    overflow: hidden;
    border-radius: var(--radius-home-stage);
    /* Contained inside a margin of the hue, not cropped to cover it. */
    padding: clamp(1rem, 2.5vw, 1.75rem);
  }
  .card__media--stage { padding: 0; }
  /* Locked: the frost is the hover, so the picture holds still under it. */
  .card[data-locked]:is(:hover, :focus-visible) .card__media > img { transform: none; }
  .card__media > img {
    width: 100%; height: 100%;
    object-fit: contain; display: block;
    transition: transform var(--home-work-dur) var(--ease-out);
  }
  .card:hover .card__media > img,
  .card:focus-visible .card__media > img { transform: scale(var(--home-card-grow)); }

  /* The words, left under the work, as on the home cards. */
  .card__body {
    display: flex; flex-direction: column; align-items: flex-start;
    padding-top: var(--home-card-text-gap);
    flex: 1;
  }
  .card__co :global(.card__lock) { display: inline-block; margin-right: 0.4em; vertical-align: -0.1em; }
  .card__title {
    font-family: var(--font-sans);
    font-size: var(--step-item);
    line-height: var(--leading-item);
    letter-spacing: var(--tracking-item);
    font-weight: var(--weight-sans);
    margin: 0 0 0.375rem;
    text-wrap: balance;
  }
  .card__impact {
    font-size: var(--step-copy);
    line-height: var(--leading-copy);
    letter-spacing: var(--tracking-copy);
    color: var(--fg-dim);
    margin: 0;
    max-width: var(--home-tagline-max);
    text-wrap: pretty;
  }

  @media (max-width: 860px) {
    .card__media { height: var(--home-stage-h-narrow); }
  }

  @media (prefers-reduced-motion: reduce) {
    .card__media > img { transition: none; }
    .card:hover .card__media > img,
    .card:focus-visible .card__media > img { transform: none; }
  }
</style>
