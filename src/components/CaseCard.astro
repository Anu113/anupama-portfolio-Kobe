---
/* CaseCard.astro — the one project-card component. Used by /work's grid;
   any future grid of projects (another index, a "more work" rail) should
   reach for this rather than inlining a card again.

   The hover affordance is HoverLabel.astro, wired through the single
   `hoverState` prop — one of the five states in `data/hoverState.ts`. That
   is the whole contract: a new project sets one prop, and the label,
   positioning and reveal are already handled. `data-hover-trigger` is what
   HoverLabel listens for; see its own header comment for why that has to
   be a plain attribute rather than a scoped class.

   The media carries the company's project hue (data-hue, from hueFor()
   in data/work.ts) — the colour belongs to its thumbnail, the way
   /work's staggered grid already used it, while the meta text underneath
   stays in the page's own palette. HoverLabel itself renders as a sibling
   of the media, not nested inside it, so its pill can track the cursor
   across the *whole* card — including the meta text below the image —
   rather than stopping dead at the media's own edge; it still gets the
   project's own colour, just copied off the media element by its own
   script instead of inherited through the cascade, since it no longer sits
   inside that scope. See HoverLabel's header comment for why.

   Laid out after carlthomasiv.com/work: the picture, then the company in
   mono, the title, one short line (the impact) and the label chips last.
   No role line and no paragraph, on request — every card is the same
   four lines so the grid reads evenly. The page passes labelsFor(w). */
import HoverLabel from './HoverLabel.astro';
import LockIcon from './LockIcon.astro';
import { hueFor } from '../data/work';
import type { HoverState } from '../data/hoverState';

interface Props {
  title: string; href: string; image: string; alt?: string;
  company?: string; role?: string; impact?: string;
  labels?: string[];
  theme?: string; ratio?: string;
  locked?: boolean;
  hoverState?: HoverState;
}
const {
  title, href, image, alt = '',
  company, impact,
  labels = [],
  theme, ratio = '4 / 3',
  locked = false,
  hoverState = 'case-study',
} = Astro.props;
---
<a class="card" href={href} data-hover-trigger>
  <div class="card__media" data-theme={theme} data-hue={hueFor(company) ?? ''} style={`--ratio: ${ratio};`}>
    <img src={image} alt={alt} loading="lazy" decoding="async" />
  </div>
  <HoverLabel state={hoverState} />
  {company && <p class="card__co u-label-mono">{company}</p>}
  <h2 class="card__title">
    {title}
    {locked && <LockIcon class="card__lock" size="0.6em" />}
  </h2>
  {impact && <p class="card__impact">{impact}</p>}
  {labels.length > 0 && (
    <ul class="card__tags" aria-label="Domain and discipline">
      {labels.map((t) => <li class="u-label-mono">{t}</li>)}
    </ul>
  )}
</a>

<style>
  /* cursor: none — HoverLabel's pill is the cursor here (see its header
     comment); the browser's own hand/pointer icon underneath it would be
     a second, redundant cursor. */
  .card { display: block; text-decoration: none; color: var(--fg); position: relative; cursor: none; }
  .card__media {
    background: var(--hue);   /* the company's project hue (tokens.css, PROJECT HUES) */
    aspect-ratio: var(--ratio);
    overflow: hidden;
    /* Contained inside a margin of the hue, not cropped to cover it —
       same "wall, not a picture" treatment as ProjectCard's media. */
    padding: clamp(1rem, 2.5vw, 1.75rem);
    margin-bottom: 1rem;
  }
  .card__media img {
    width: 100%; height: 100%;
    object-fit: contain; display: block;
    transition: transform 600ms var(--ease-out);
  }
  .card:hover .card__media img,
  .card:focus-visible .card__media img { transform: scale(1.04); }

  .card__co { margin: 0 0 0.5rem; }
  /* 12px caps, as the reference's project titles (and the home cards). */
  .card__title {
    font-family: var(--font-sans);
    font-size: var(--step-label);
    line-height: var(--leading-label);
    letter-spacing: var(--tracking-label);
    font-weight: var(--weight-sans);
    text-transform: uppercase;
    margin: 0 0 0.5rem;
    text-wrap: balance;
  }
  .card__title :global(.card__lock) { display: inline-block; margin-left: 0.4em; color: var(--fg-dim); vertical-align: middle; }
  .card__impact {
    font-size: var(--step-copy);
    line-height: var(--leading-copy);
    letter-spacing: var(--tracking-copy);
    color: var(--fg-dim);
    margin: 0 0 1rem;
    text-wrap: pretty;
  }
  /* Same chip as ProjectCard's: hairline box, square, tracked caps. */
  .card__tags {
    display: flex; flex-wrap: wrap; gap: 0.4rem;
    list-style: none; margin: 0; padding: 0;
  }
  .card__tags li {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 0.2rem 0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .card__media img,
    .card:focus-visible .card__media img { transform: none; }
  }
</style>
