---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Reveal from '../components/Reveal.astro';

import HeroIllustration from '../components/HeroIllustration.astro';
import AskBubble from '../components/AskBubble.astro';
import LocalTime from '../components/LocalTime.astro';
import PixelBreak from '../components/PixelBreak.astro';
import ProjectCard from '../components/ProjectCard.astro';

import { site } from '../data/site';
import { work } from '../data/work';

// The category filter tabs that used to live on this page moved to
// /work — they were fighting the stacking-card effect below (hiding a
// card shifts every card after it, which the sticky/settle math never
// re-measured for), and /work's plain grid is a better home for
// filtering anyway.
const homeWork = work.filter((w) => w.showOnHome !== false);
---
<Base title={`${site.name} — ${site.seeking}`}>
  <!-- Hero. Type follows allierho.com's hero sentence: one serif display
       line that opens in italic and turns roman mid-sentence — the
       system's only emphasis. Background line and CTAs underneath in the
       sans. -->
  <Section theme="charcoal" class="hero">
    <div class="hero__row">
      <div class="hero__copy">
        <!-- No entrance animation on the hero text: it is the first thing
             read, so it is simply there on first paint. -->
        <!-- Where she is and whether she's around, before the pitch:
             status light, city, weather, ticking time (LocalTime.astro). -->
        <div class="hero__eyebrow"><LocalTime /></div>
        <h1 class="u-display hero__line">
          <em>Hi, I&rsquo;m Anupama,</em> a Staff Product Designer. I&nbsp;ship, I&nbsp;nudge, I&nbsp;craft, from systems and strategy to the last stubborn <PixelBreak>pixel</PixelBreak>.
        </h1>
        <p class="hero__more">
          10+ years in fintech, enterprise software and developer tools,
          most recently @&nbsp;<span class="hero__co">Okta</span>. Previously
          at <span class="hero__co">PayPal</span>, <span class="hero__co">Walmart Labs</span>,
          and <span class="hero__co">Deloitte</span>.
        </p>
        <p class="intro__links">
          <a class="btn btn--primary" href="/resume.pdf" target="_blank" rel="noopener">Resume</a>
          <a class="btn btn--secondary" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </p>
      </div>
      <Reveal delay={180} class="hero__portrait-cell">
        <div class="hero__portrait">
          <!-- .hero__stage: a positioned box exactly the portrait's size, so
               AskBubble can sit Moss on the books in the
               illustration. -->
          <div class="hero__stage">
            <HeroIllustration alt="Illustrated portrait of Anupama Mishra, working at her laptop" size={1700} />
            <AskBubble />
          </div>
        </div>
      </Reveal>
    </div>
    <!-- Scroll cue, after alejandromejias.com.au: tells a first-time
         visitor the work is below the fold, then fades on the first
         scroll because the hint is spent. Static (no bobbing arrow), and
         aria-hidden: a screen reader already knows there's more page. -->
    <p class="u-label hero__cue" aria-hidden="true" data-hero-cue>Scroll<svg class="hero__cue-arrow" viewBox="0 0 8 12" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 1v10M1.5 3.5 4 1l2.5 2.5M1.5 8.5 4 11l2.5-2.5"/></svg></p>
  </Section>

  <script>
    const cue = document.querySelector<HTMLElement>('[data-hero-cue]');
    if (cue) {
      const update = () => cue.classList.toggle('is-gone', scrollY > 24);
      update();
      addEventListener('scroll', update, { passive: true });
    }
  </script>

  <!-- Selected work. Section head in allierho.com's pattern: a centred
       serif line with its key phrase in italic, a label link under it. -->
<Section theme="bone" full id="work" class="workhead-section">
  <div class="u-shell workhead">
    <h2 class="u-heading">Selected <em>work</em></h2>
    <a class="btn--link" href="/work">View all work</a>
  </div>
</Section>
<Section theme="bone" class="worklist">
  <div class="worklist__grid" data-worklist>
    {homeWork.map((w, i) => (
      <div class="worklist__item" style={`--stack-i:${i}`}>
        <ProjectCard
          index={i + 1}
          company={w.company}
          title={w.title}
          tagline={w.tagline}
          href={w.href}
          theme={w.theme}
          hoverState={w.hoverState}
          tags={w.tags}
          image={'video' in w ? undefined : w.image}
          alt={w.alt}
        >
          {'video' in w && w.video && (
            <video
              slot="hero"
              poster={w.video.poster}
              aria-label={w.video.alt}
              muted
              loop
              playsinline
              autoplay
            >
              <source src={w.video.webm} type="video/webm" />
              <source src={w.video.mp4} type="video/mp4" />
            </video>
          )}
        </ProjectCard>
      </div>
    ))}
  </div>
</Section>

  <!-- The playground, pointed to — the same centred head as Selected
       work, standing on its own. Contact is the footer's job. -->
  <Section theme="bone" class="playline">
    <div class="workhead">
      <h2 class="u-heading">Smaller experiments live in the <em>playground.</em></h2>
      <a class="btn--link" href="/playground">Explore playground</a>
    </div>
  </Section>
</Base>

<style>
  /* :global — `class="hero"` is forwarded as a prop into <Section>, so it
     lands on an element in Section.astro's own scope, not this page's. An
     unscoped rule here silently never matches (CLAUDE.md's own documented
     gotcha); without :global() the hero never gets its centring. */
  /* Was min-height: 92svh with justify-content: center — the nav gap and
     the gap to the CTA row below were both just leftover space from
     centering a short headline in a near-full-viewport box, not decisions.
     Top-aligned now: the nav gap is set on purpose (clamp, so it holds
     proportionally on a short laptop screen and a tall monitor rather of
     a fixed rem doing something different on each), and it's deliberately
     bigger than the CTA gap below so the headline+CTAs read as one
     group (Gestalt proximity) separated from the nav above, not from
     each other. clamp(7rem, 26vh, 13rem) matches the raw proportion
     measured on hansonwu.com (nav→headline ≈26vh, ≈4x their headline's
     font-size, at 1440x900).

     min-height: 100svh, content still top-aligned: the first screen is
     the hero and only the hero, on every screen size. Sized to content
     alone, a tall monitor (2560x1440) showed "Selected work" and most of
     the first card under it — read as a landing page. Top-aligned, not
     centred, so the nav → headline distance above stays exactly as set
     by --hero-pad-top; any extra height goes below the CTAs, where the
     Scroll cue sits at the fold. (Before this it was 88svh plus a flex
     spacer, which left the work neither on the first screen nor near it.) */
  :global(.hero) {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: var(--hero-pad-top);
    /* Holds the Scroll cue (.hero__cue) clear of the CTAs and the
       portrait's feet; the rest of the gap to "Selected work" is #work's
       own top padding (--space-hero-work). */
    padding-bottom: clamp(3rem, 6vh, 4.5rem);
  }
  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: var(--hero-cue-offset);
    margin: 0;
    transform: translateX(-50%);
    color: var(--fg-dim);
    white-space: nowrap;
    transition: opacity var(--dur-hover) var(--ease-out);
  }
  .hero__cue.is-gone { opacity: 0; }
  /* SVG, not the ↕ glyph: neither Manrope nor Azeret Mono has it, so it
     fell back to whatever system font each visitor had. */
  .hero__cue {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }
  .hero__cue-arrow { width: 0.667em; height: 1em; }
  /* The hero sentence is .u-display (global.css): serif 300 at
     --step-display, italic lead-in via <em>. Background line under it in
     the sans at body size, dim. */
  /* 26ch, was 22ch: the headline ended ~70px short of its own column,
     and that width went to the gap before the illustration. */
  .hero__line { max-width: 26ch; text-wrap: pretty; }
  .hero__more { color: var(--fg-dim); max-width: 54ch; margin: 1.5rem 0 0; text-wrap: pretty; }
  .hero__co { color: var(--fg); }

  /* Hero copy + portrait side by side on desktop, portrait first and
     centred above the copy on narrow screens — the halftone photo is the
     thing a visitor's eye lands on first either way, then the headline.
     A full-bleed backdrop version of this (figure filling the whole
     band, copy on a bottom scrim) was tried by explicit instruction,
     matching a reference, and reverted ("too big") back to this
     side-by-side card layout — see git history if it comes back. */
  .hero__row {
    display: flex;
    /* flex-end, not flex-start — the illustration used to hang from the
       row's top edge, vertically centred against a copy column whose
       height changes with the headline's line count, so the gap above
       and below the figure drifted at different viewports and never
       read as composed. Bottom-aligning both columns means the
       illustration's feet always land on the same line as the
       Resume/LinkedIn row, whatever height the copy stack ends up at. */
    align-items: flex-end;
    /* Copy on the page's left edge, illustration centred in the space to
       its right (see .hero__portrait-cell), never closer than --hero-gap. The
       edges come from --gutter, which stops the content widening past
       --shell-max (tokens.css) — so on a very large screen the whole
       page, hero included, centres and the extra width goes to the outer
       margins, not into this gap. */
    justify-content: space-between;
    gap: var(--hero-gap);
  }
  /* The copy column gets a guaranteed width (--hero-copy-w) and the
     illustration takes whatever is left, scaling down with it. The other
     way round (image at a fixed share, copy getting the remainder) left
     the copy at ~200px on laptop-width screens once the left rail for the
     fixed menu (--gutter-start) came in. */
  .hero__copy { flex: 0 0 var(--hero-copy-w); min-width: 0; }
  /* The portrait's Reveal wrapper is the actual flex item; a class passed
     into a component doesn't carry this page's scope, hence :global. */
  /* Sized to the illustration, not flex: 1 — space-between hands the
     spare width to the gap, which the row's max-width caps. Still
     shrinks when space runs short. */
  /* flex: 1, with the figure placed --hero-art-bias of the way across
     the slack (tokens.css), so the gap to the text only gets a share of
     the spare width. Pinned to the right edge instead, every spare
     pixel went to that gap (1.1-1.4x the figure's width).
     Negative top margin lets the figure grow upward into the band's
     padding rather than pushing the bottom-aligned copy down. */
  :global(.hero__portrait-cell) { flex: 1 1 auto; min-width: 0; margin-top: calc(-1 * var(--hero-art-lift)); }
  .hero__portrait {
    display: flex;
    padding-inline-start: max(0px, calc((100% - var(--hero-art-h) * var(--hero-art-ratio)) * var(--hero-art-bias)));
  }
  /* Shrinks with the column (min-width: 0) so HeroIllustration's
     max-width: 100% still resolves against real space, and is the
     positioning box AskBubble pins itself to. */
  .hero__stage { position: relative; flex: 0 1 auto; min-width: 0; }
  @media (max-width: 860px) {
    .hero__copy, :global(.hero__portrait-cell) { flex: none; }
    /* Left-aligned on mobile now, not centred — the illustration, the
       headline, the bio, and the CTA row all sit on one shared left
       edge instead of each floating centred under a different width. */
    .hero__portrait { justify-content: flex-start; padding-inline-start: 0; }
    .hero__row { flex-direction: column-reverse; align-items: flex-start; text-align: left; gap: var(--hero-gap-stacked); }
    /* width: 100% is load-bearing, not decorative — flex-direction: column
       makes align-items the CROSS-axis (horizontal) sizing, and flex-start
       (like the old `center` it replaced) sizes a flex item to fit-content
       instead of stretching it to the row's full width. Without an
       explicit width, .hero__line's own `max-width: 100%` below resolves
       against that fit-content box, not the viewport, so at some
       in-between widths the headline stopped wrapping at all and ran off
       the right edge instead. */
    .hero__copy { display: flex; flex-direction: column; align-items: flex-start; width: 100%; }
    .hero__portrait { align-self: flex-start; }
    .hero__line { max-width: 100%; }
    /* padding-top's clamp is tuned for desktop, where 26vh is a modest
       gap under a short, wide nav row. On a tall/narrow phone the same
       26vh clamps to its 13rem ceiling — ~208px, most of a screen's worth
       of dead air before the portrait even starts, worse now that the
       portrait renders above the copy here (column-reverse). A flatter,
       lower clamp keeps a deliberate gap without the mobile-only bloat. */
    :global(.hero) { padding-top: clamp(4.5rem, 12vh, 6.5rem); }
    /* Stacked, the figure no longer has a copy column to match, and
       31rem would eat most of a phone screen before the headline starts.
       Read by HeroIllustration's own width calc, so overriding it here is
       enough. */
    .hero__stage { --hero-art-h: 13rem; }
    :global(.hero__portrait-cell) { margin-top: 0; }
    /* Stacked, the hero runs past the first screen and scrolling is the
       default on a phone; the cue would only sit under the CTAs. */
    .hero__cue { display: none; }
  }

  /* The location line sits above the headline, a label's distance
     from it — the first thing read is where and when she is. */
  .hero__eyebrow { margin: 0 0 1.4rem; }


  /* Started at 1.13rem, picked live against a mockup slider — but that
     mockup used a normal-leading serif font. The real .hero__line wears
     --leading-display: 0.85 (a deliberately tight box, 68px line-height
     on an 80px face), so the last line's descenders (the "p" in
     "products"/"shaping") paint several px below their own line box and
     visually eat most of a padding-top that small. 2.25rem compensates
     for that (a fixed pixel amount, not something that scales down with
     the smaller nav gap above) while still sitting closer than the
     2.75rem peak, back in proportion with the hansonwu.com-matched top
     gap. */
  .intro__links { display: flex; align-items: center; gap: 0.75rem; padding-top: 2.25rem; margin: 0; }
  /* Resume/LinkedIn now use the shared .btn system (global.css) —
     Primary/Secondary — instead of their own bespoke pill rules. */


  /* The default --space-section top padding, stacked on top of the
     approach band's own bottom padding right above it, pushed "What
     people say" almost two section-gaps down — a wall of plain clay
     before any quote appeared. Tightened to the seam value used
     elsewhere so the heading shows up right after the scroll into the
     band, not after it. */
  /* Home rhythm — see --space-band / --space-label in tokens.css. Every
     band below the hero gets the same space above and below its content;
     tops used to alternate between 56px and 176px with no reason tied to
     the content. #work (the "Selected work" label) and .worklist are one
     band split across two Sections: the label takes the band's top, the
     list its bottom, and only --space-label sits between them. */
  :global(#work),
  :global(.worklist),
  :global(.playline) { padding-block: var(--space-band); }
  :global(#work) { padding-block-start: var(--space-hero-work); padding-block-end: 0; }
  :global(#work + .worklist) { padding-block-start: 0; }

  /* Section head, allierho.com's pattern: centred serif line, label link
     a step under it. */
  .workhead {
    display: flex; flex-direction: column; align-items: center; gap: 1.5rem;
    text-align: center; padding-bottom: var(--space-head);
  }
  .workhead .u-heading { max-width: 20ch; }
  .playline .workhead { padding-bottom: 0; }

  /* The "Selected work" label owns the list right below it, so that pair
     closes up: no section padding underneath, and the list drops its own
     top padding to match. :global — both are rendered by Section.astro,
     so they don't carry this page's scope. */


  /* No max-width of its own any more: it was 74rem centred, which put
     the cards 13px (at 1440) to 140px inside the "Selected work" label's
     edge. The page-wide --shell-max (tokens.css) now does the containing,
     so cards, label and hero share one edge. */
  .worklist__grid {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Stacking cards: each row pins a little lower than the one before it
     (--stack-i, set per row from index.astro's map), so as you scroll a
     new card slides up over the last and the previous card's top edge
     keeps peeking out underneath rather than vanishing. z-index makes
     the paint order explicit instead of relying on DOM order. The
     padding-bottom (replacing the old flex `gap`) is what lets that peek
     show — a plain gap would just push the next card down without ever
     overlapping. */
  .worklist__item {
    position: sticky;
    top: calc(clamp(4.5rem, 6vw, 6rem) + var(--stack-i, 0) * 16px);
    z-index: calc(var(--stack-i, 0) + 1);
    /* This is what actually controls the delay before the next card
       starts covering this one — NOT the 16px --stack-i step above
       (that only sets how far each pinned card's top edge peeks out
       from behind the next). A sticky element stays pinned for exactly
       as much extra scroll distance as its own box has left below the
       pinned content — i.e. this padding. At the old ~2.5rem it barely
       stayed pinned before the next card's turn arrived, so cards felt
       like they overlapped mid-scroll instead of after a full look.
       40vh gives each card a real, comfortable window fully on screen
       first. */
    padding-bottom: 40vh;
  }
  /* Nothing follows the last card to cover it, so its pinned window was
     just ~40vh of empty band before the next section. */
  .worklist__item:last-child { padding-bottom: 0; }

  /* The settle effect (a card scales/dims slightly as the next one
     covers it) used to run on the browser's own scroll-driven
     animation-timeline. That worked at the old ~40px padding-bottom,
     but its 0–45% animation-range was tuned to that short pin duration
     — once the pin got much longer (see .worklist__item's own comment),
     the animation finished almost instantly and then sat static for
     the rest of the scroll, reading as a jump rather than a settle.
     animation-timeline also doesn't account for `position: sticky`
     freezing the element's own rect while pinned, which made the
     mismatch worse. Replaced with the same plain rAF-on-scroll
     rAF-on-scroll technique — see the script
     below — so the effect is always exactly proportional to how far
     through its own pinned window a card actually is, in every
     browser, transition-free (no lag behind the scroll position). */
  .worklist__item > :global(.pc) {
    transform-origin: center top;
    /* ProjectCard.astro's own .pc rule carries a transform transition
       meant for a hover effect that no longer uses it. Left alone here
       it would apply to our own rAF-driven scale updates below too —
       every scroll tick would ease in over --dur-hover (320ms) instead
       of landing immediately, so the card visibly lags behind the
       actual scroll position. Overriding to none keeps the settle
       effect locked exactly to scroll, which is what "smooth" means
       for a scroll-driven effect (transitions are for animating TO a
       new state on their own time; this state changes every frame). */
    transition: none;
  }
</style>

<script>
  // The stacking cards' settle effect — each card scales/dims slightly
  // in direct proportion to how far it's scrolled through its own
  // pinned window, computed straight from scroll position rather than
  // a CSS scroll-timeline (see the .worklist__item comment on why: a
  // timeline's animation-range can't stay correct across an arbitrary,
  // responsive padding-bottom, and doesn't account for position:sticky
  // freezing the element's own rect while pinned). Same plain
  // rAF-on-scroll shape.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const stackItems = [...document.querySelectorAll<HTMLElement>('.worklist__item')];
    if (stackItems.length) {
      type Rec = { item: HTMLElement; card: HTMLElement; startY: number; padBottom: number };
      let recs: Rec[] = [];

      // `item.offsetTop` looks like the right way to find where a sticky
      // element starts pinning, but once the browser has actually stuck
      // it, offsetTop stops reporting the original static-flow position
      // and instead tracks the current (stuck) rendered position — which
      // moves together with scrollY, so `offsetTop - stickyTop` collapses
      // to `scrollY` and progress reads as permanently 0 the moment a
      // card sticks. Toggling `position` to static for one synchronous
      // read (then straight back to sticky) forces the browser to report
      // the true, scroll-independent flow position instead.
      const measure = (): Rec[] =>
        stackItems.flatMap((item) => {
          const card = item.querySelector<HTMLElement>('.pc');
          if (!card) return [];
          const stickyTop = parseFloat(getComputedStyle(item).top) || 0;
          const padBottom = parseFloat(getComputedStyle(item).paddingBottom) || 1;
          const prevPosition = item.style.position;
          item.style.position = 'static';
          const staticTop = item.offsetTop;
          item.style.position = prevPosition;
          return [{ item, card, startY: staticTop - stickyTop, padBottom }];
        });

      // Two separate rAF handles, not one shared between scroll and
      // resize — sharing a single flag meant a resize firing while a
      // scroll-triggered tick() was already queued got silently dropped
      // (the `if (!raf)` guard saw it as busy), leaving `recs` stuck on
      // pre-resize measurements until some later, uncontested resize.
      let scrollRaf: number | null = null;
      let resizeRaf: number | null = null;
      const tick = () => {
        for (const { card, startY, padBottom } of recs) {
          const progress = Math.min(1, Math.max(0, (scrollY - startY) / padBottom));
          const scale = 1 - progress * 0.04;
          const brightness = 1 - progress * 0.08;
          card.style.transform = `scale(${scale})`;
          card.style.filter = `brightness(${brightness})`;
        }
        scrollRaf = null;
      };
      const remeasureAndTick = () => { recs = measure(); tick(); resizeRaf = null; };
      remeasureAndTick();
      addEventListener('scroll', () => { if (!scrollRaf) scrollRaf = requestAnimationFrame(tick); }, { passive: true });
      // Resize re-measures (a --stack-i offset, card height, or the
      // whole layout can change at a new width) rather than just
      // re-ticking with stale start positions.
      addEventListener('resize', () => { if (!resizeRaf) resizeRaf = requestAnimationFrame(remeasureAndTick); });
    }
  }
</script>
