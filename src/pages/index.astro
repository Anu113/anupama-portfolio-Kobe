---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Reveal from '../components/Reveal.astro';

import OneWord from '../components/OneWord.astro';
import Mosaic from '../components/Mosaic.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Marquee from '../components/Marquee.astro';
import Testimonials from '../components/Testimonials.astro';

import { site } from '../data/site';
import { work } from '../data/work';
import { testimonials } from '../data/home';
import { tiles } from '../data/play';

// The preview shows the first six playground tiles — enough to read as a set,
// short enough that the loop isn't a minute long. The card is a 4:3 crop, so
// the order in `play.ts` decides which pieces survive it: the squarer ones
// lead, the tall portraits sit further down where this slice won't reach.
const playCards = tiles.slice(0, 6).map((t) => ({ ...t, label: t.alt, href: '/playground' }));
---
<Base title={`${site.name} — ${site.seeking}`}>
  <!-- ACT 1 — the editorial opening. Its own palette, "iris": cream and
       navy by day, indigo and periwinkle at night — the pairing from
       meagandurlak.com's "dreaming of radical futures" opener. Exclusive
       to the hero; the work-head/mosaic bands right after it stay on ink,
       unchanged in either mode. -->
  <Section theme="iris" class="hero">
    <Reveal delay={120}>
      <h1 class="u-display hero__line">
        Staff Product Designer with 10+ years shaping digital products
        across fintech, consumer, and SaaS<span class="hero__dot">.</span>
      </h1>
    </Reveal>
  </Section>

  <!-- Intro paragraph removed: it duplicated the headline above once the
       headline itself became this sentence. If a second beat is wanted
       here again, it should say something the headline doesn't. -->
  <Section theme="iris" class="intro">
    <Reveal delay={100}>
      <p class="intro__links">
        <a class="intro__resume u-label" href="/resume.pdf" target="_blank" rel="noopener">Resume</a>
        <a class="intro__linkedin" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </p>
    </Reveal>
  </Section>

  <!-- ACT 2 — selected work, one ProjectCard per project, stacked full-width
       on a shared ink ground. Filtered to `showOnHome !== false` — /work
       carries the full seven, but a skeleton case (unconfirmed role, scope,
       metrics) doesn't get to represent the portfolio on the first thing a
       recruiter sees. -->
<Section theme="ink" full id="work" class="workhead-section">
  <div class="u-shell workhead">
    <h2 class="u-label">Selected work</h2>
  </div>
</Section>
<Section theme="ink" class="worklist">
  {work.filter((w) => w.showOnHome !== false).map((w) => (
    <ProjectCard
      company={w.company}
      title={w.title}
      tagline={w.tagline}
      href={w.href}
      theme={w.theme}
      hoverState={w.hoverState}
      image={'video' in w ? undefined : w.image}
      alt={w.alt}
      ratio={w.device === 'phone' ? '3 / 4' : '16 / 10'}
    >
      {'video' in w && w.video && (
        <video
          slot="hero"
          poster={w.video.poster}
          aria-label={w.video.alt}
          muted
          loop
          playsinline
          autoplay
        >
          <source src={w.video.webm} type="video/webm" />
          <source src={w.video.mp4} type="video/mp4" />
        </video>
      )}
    </ProjectCard>
  ))}
</Section>

  <!-- ACT 3 — palette flips, the interactive moment -->
  <Section theme="sand" id="approach">
    <OneWord
      before="The best enterprise software feels"
      after="."
      seed="obvious"
      prompt="Type one word"
      suggestions={['obvious', 'learnable', 'quiet', 'honest', 'fast']}
    />
    <Reveal delay={200}>
      <p class="u-measure sand__body">
        Ten years of it has taught me what holds up: a model the admin can
        predict, a system that's faster than the workaround, and critique that's
        kind and specific. <a href="/about#approach">How I work →</a>
      </p>
    </Reveal>
  </Section>

  <!-- Testimonials. Placed after the work and the approach, where a hiring
       manager already knows what she did and is looking for corroboration.
       Clay is shared with the fourth work band — far enough up the page that
       the two don't read as a pair. -->
  <Section theme="clay" class="saidabout">
    <Reveal>
      <h2 class="u-label">What people say</h2>
    </Reveal>
    <Reveal delay={120}>
      <Testimonials items={testimonials} />
    </Reveal>
  </Section>

  <!-- ACT 4 — full-bleed mosaic, back to dark -->
  <Section theme="ink" full>
    <Mosaic items={[
      { src: '/images/placeholder-1.svg', alt: 'Placeholder — replace with work imagery', edge: 'left', w: 44 },
      { src: '/images/placeholder-2.svg', alt: 'Placeholder — replace with work imagery', edge: 'right', w: 38, y: -4 },
      { src: '/images/placeholder-3.svg', alt: 'Placeholder — replace with work imagery', edge: 'center', w: 56, y: 4 },
    ]} />
  </Section>

  <!-- The playground, previewed. Last light note before the contact band;
       the whole row is a way into /playground. -->
  <Section theme="sand" full class="playpeek">
    <div class="u-shell playpeek__head">
      <h2 class="u-label">From the playground</h2>
      <a class="playpeek__link" href="/playground">See all &rarr;</a>
    </div>
    <Marquee items={playCards} kind="card" seconds={26} label="From the playground" />
  </Section>

  <!-- ACT 5 — contact -->
  <Section theme="bone" id="contact">
    <Reveal>
      <h2 class="u-display">Open to work.</h2>
    </Reveal>
    <Reveal delay={140}>
      <p class="u-measure">
        Looking for a {site.ask}. The hard, systemic parts of enterprise
        software, hands on the work.
      </p>
      <p class="contact__links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.linkedin}>LinkedIn</a>
      </p>
    </Reveal>
  </Section>
</Base>

<style>
  /* :global — `class="hero"` is forwarded as a prop into <Section>, so it
     lands on an element in Section.astro's own scope, not this page's. An
     unscoped rule here silently never matches (CLAUDE.md's own documented
     gotcha); without :global() the hero never gets its centring. */
  :global(.hero) { min-height: 92svh; display: flex; flex-direction: column; justify-content: center; gap: 1.5rem; }
  /* The headline is now a full sentence, not four hand-broken words, so
     it can't wear --step-display (a poster-scale size meant for a
     handful of words) or the old 20ch measure — together they forced
     this sentence into an 8-line tower taller than the viewport. Sized
     down to --step-h1 and widened so it wraps into a few natural lines
     instead. */
  .hero__line { font-size: var(--step-h1); max-width: 32ch; }

  /* The bio paragraph after the hero. Tighter than the section default —
     it's a second beat of the opening act, not a new one, so it shouldn't
     push the logo strip a full --space-section further down the page. */
  :global(.intro) { padding-block: 0 clamp(2.5rem, 6vw, 4.5rem); }
  .intro__body { color: var(--fg-dim); font-size: var(--step-body); }

  .intro__links { display: flex; align-items: center; gap: 1.5rem; padding-top: 1.5rem; margin: 0; }
  /* The pill — same border-not-fill treatment as .lede__cta on the case
     study pages, so a control on this page reads as the same control
     everywhere else on the site. */
  .intro__resume {
    display: inline-block;
    color: var(--fg);
    text-decoration: none;
    border: 1px solid var(--fg-dim);
    border-radius: 999px;
    padding: 0.65rem 1.15rem;
    transition: background var(--dur-hover) var(--ease-out),
                border-color var(--dur-hover) var(--ease-out);
  }
  .intro__resume:hover { background: var(--screen); border-color: var(--fg-dim); }
  .intro__linkedin {
    color: var(--fg);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  /* The full stop blinks like a terminal caret — steps(), not a fade, so it
     snaps rather than pulses. It stays inside the sentence rather than being
     aria-hidden, so the line still ends in a full stop when read aloud. */
  .hero__dot { animation: hero-blink 1.15s steps(1, end) infinite; }
  @keyframes hero-blink {
    0%, 60%   { opacity: 1; }
    61%, 100% { opacity: 0; }
  }
  /* The global reduced-motion block only collapses the duration, which on an
     infinite animation leaves the dot resting in an arbitrary state. Park it
     visible instead. */
  @media (prefers-reduced-motion: reduce) {
    .hero__dot { animation: none; opacity: 1; }
  }

  .railhead { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 2.5rem; }
  .railhead__hint { margin: 0; }

  .sand__body { color: var(--fg-dim); font-size: var(--step-h3); }
  .sand__body a { color: var(--fg); text-decoration: none; border-bottom: 1px solid currentColor; }

  .contact__links { display: flex; gap: 1.5rem; padding-top: 1rem; }
  .contact__links a { color: var(--fg); }

  .playpeek__head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: clamp(1rem, 2vw, 1.5rem); }
  .playpeek__link {
    font-family: var(--font-display);
    font-size: var(--step-label); letter-spacing: var(--tracking-label);
    text-transform: uppercase; font-weight: 600;
    color: var(--accent-text); text-decoration: none;
  }

  .workhead { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: clamp(1rem, 2vw, 1.5rem); }
  .workhead__count { font-family: var(--font-accent); font-style: italic; font-size: var(--step-h3); color: var(--fg-dim); margin: 0; }

  /* The "Selected work" label owns the list right below it, so that pair
     closes up: no section padding underneath, and the list drops its own
     top padding to match. :global — both are rendered by Section.astro,
     so they don't carry this page's scope. */
  :global(.workhead-section) { padding-bottom: 0; }
  :global(.workhead-section + .worklist) { padding-top: var(--space-band-tight); }

  .worklist {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 5rem);
  }
</style>
