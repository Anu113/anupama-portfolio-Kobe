---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Reveal from '../components/Reveal.astro';

import OneWord from '../components/OneWord.astro';
import HeroRotatingWord from '../components/HeroRotatingWord.astro';
import HeroIllustration from '../components/HeroIllustration.astro';
import Mosaic from '../components/Mosaic.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Marquee from '../components/Marquee.astro';
import Testimonials from '../components/Testimonials.astro';

import { site } from '../data/site';
import { work } from '../data/work';
import { testimonials } from '../data/home';
import { tiles } from '../data/play';

// The preview shows the first six playground tiles — enough to read as a set,
// short enough that the loop isn't a minute long. The card is a 4:3 crop, so
// the order in `play.ts` decides which pieces survive it: the squarer ones
// lead, the tall portraits sit further down where this slice won't reach.
const playCards = tiles.slice(0, 6).map((t) => ({ ...t, label: t.alt, href: '/playground' }));

// The category filter tabs that used to live on this page moved to
// /work — they were fighting the stacking-card effect below (hiding a
// card shifts every card after it, which the sticky/settle math never
// re-measured for), and /work's plain grid is a better home for
// filtering anyway.
const homeWork = work.filter((w) => w.showOnHome !== false);
---
<Base title={`${site.name} — ${site.seeking}`}>
  <!-- ACT 1 — the editorial opening. Its own palette, "charcoal": pale
       grey by day, near-black at night — neutral on purpose, no hue to
       compete with the opening line. Exclusive to the hero; the
       work-head/mosaic bands right after it stay on ink, unchanged in
       either mode. -->
  <!-- ACT 1 + intro merged into one band, min-height: 80svh — the hero
       always claims 80% of the first screen and "Selected work" always
       peeks in the remaining 20%, on any monitor or phone, instead of a
       fixed rem of bottom padding that read short on a big monitor and
       overshot on a small laptop. Safe to merge: both wore the same
       "charcoal" theme already, so there's no palette seam being lost. -->
  <Section theme="charcoal" class="hero">
    <div class="hero__row">
      <div class="hero__copy">
        <!-- Hidden, not deleted — kept visually hidden rather than removed so
             it's trivial to bring back later. -->
        <Reveal delay={80}>
          <p class="hero__eyebrow u-sr-only">
            <span class="hero__statusdot" aria-hidden="true"></span>
            Open to ambitious problems &amp; good people.
          </p>
        </Reveal>
        <Reveal delay={120}>
          <h1 class="u-display hero__line">Hi, I&rsquo;m Anupama.</h1>
        </Reveal>
        <Reveal delay={130}>
          <p class="hero__greet">
            <span class="reflect-wrap"><span class="reflect" tabindex="0">Staff Product Designer</span><span class="reflect__aside" aria-hidden="true">— 10+ yrs</span></span>{' '}@ Okta.
          </p>
        </Reveal>
        <Reveal delay={150}>
          <p class="hero__bio">
            I <HeroRotatingWord words={['ship', 'nudge', 'craft']} flexible />{' '}
            — from systems and strategy to the last stubborn pixel. I bring
            curiosity, craft, and a little fun to whatever I&rsquo;m building.
          </p>
        </Reveal>
        <Reveal delay={170}>
          <p class="hero__bio hero__bio--secondary">
            I&rsquo;ve worked across a wonderfully eclectic mix of domains —{' '}
            <span class="reflect-wrap"><span class="reflect" tabindex="0">data &amp; privacy</span><span class="reflect__aside" aria-hidden="true">— Deloitte</span></span>,{' '}
            <span class="reflect-wrap"><span class="reflect" tabindex="0">digital identity</span><span class="reflect__aside" aria-hidden="true">— Okta</span></span>,{' '}
            <span class="reflect-wrap"><span class="reflect" tabindex="0">fintech</span><span class="reflect__aside" aria-hidden="true">— PayPal</span></span>, and{' '}
            <span class="reflect-wrap"><span class="reflect" tabindex="0">e-commerce</span><span class="reflect__aside" aria-hidden="true">— Walmart Labs</span></span>.{' '}
            Previously @ PayPal, Walmart Labs, and Deloitte.
          </p>
        </Reveal>
        <Reveal delay={190}>
          <p class="hero__find">
            Find me at{' '}
            <a class="link-ext" href={site.linkedin} target="_blank" rel="noopener">
              LinkedIn<span class="link-ext__mark" aria-hidden="true">↗</span>
            </a>{' '}
            or{' '}
            <a class="link-ext" href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
        </Reveal>
        <Reveal delay={100}>
          <p class="intro__links">
            <a class="btn btn--primary" href="/resume.pdf" target="_blank" rel="noopener">Resume</a>
            <a class="btn btn--secondary" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          </p>
        </Reveal>
      </div>
      <Reveal delay={180}>
        <div class="hero__portrait">
          <HeroIllustration alt="Illustrated portrait of Anupama Mishra, working at her laptop" size={1150} />
        </div>
      </Reveal>
    </div>
    <!-- Flexible, not fixed — absorbs whatever's left of the 80svh after
         the nav gap, headline and CTA row above have taken their fixed
         amount, so the leftover room scales with the viewport instead of
         being a flat rem number. min-height, not height, on .hero itself:
         a floor, so a 4-line headline wrap on a narrow phone still just
         pushes the band taller rather than clipping. */ -->
    <div class="hero__spacer" aria-hidden="true"></div>
  </Section>

  <!-- ACT 2 — selected work, one ProjectCard per project, stacked full-width
       on a shared bone ground. Was ink (near-black in both day and night —
       that palette doesn't lighten in day mode, it just shifts shade), which
       read as an unexpectedly dark band while the rest of the page was in
       day mode. bone is also /work.astro's own grid background, so the two
       pages now share a ground for the same content. The one cost: Chase
       Pay's card used to wear bone too and would've had no edge against a
       bone section — it now wears `ink` instead (see the comment on that
       entry in work.ts), which also happens to fix the identical problem
       that card already had on /work. Filtered to `showOnHome !== false` —
       /work carries the full seven, but a skeleton case (unconfirmed role,
       scope, metrics) doesn't get to represent the portfolio on the first
       thing a recruiter sees. -->
<Section theme="bone" full id="work" class="workhead-section">
  <div class="u-shell workhead">
    <h2 class="u-label">Selected work</h2>
    <a class="workhead__all" href="/work">See all work →</a>
  </div>
</Section>
<Section theme="bone" class="worklist">
  <div class="worklist__grid" data-worklist>
    {homeWork.map((w, i) => (
      <div class="worklist__item" style={`--stack-i:${i}`}>
        <ProjectCard
          index={i + 1}
          company={w.company}
          title={w.title}
          tagline={w.tagline}
          href={w.href}
          theme={w.theme}
          hoverState={w.hoverState}
          tags={w.tags}
          image={'video' in w ? undefined : w.image}
          alt={w.alt}
        >
          {'video' in w && w.video && (
            <video
              slot="hero"
              poster={w.video.poster}
              aria-label={w.video.alt}
              muted
              loop
              playsinline
              autoplay
            >
              <source src={w.video.webm} type="video/webm" />
              <source src={w.video.mp4} type="video/mp4" />
            </video>
          )}
        </ProjectCard>
      </div>
    ))}
  </div>
</Section>

  <!-- ACT 3 — palette flips, the interactive moment -->
  <Section theme="sand" id="approach">
    <OneWord
      before="The best enterprise software feels"
      after="."
      seed="obvious"
      prompt="Type one word"
      suggestions={['obvious', 'learnable', 'quiet', 'honest', 'fast']}
    />
    <Reveal delay={200}>
      <p class="u-measure sand__body">
        Ten years of it has taught me what holds up: a model the admin can
        predict, a system that's faster than the workaround, and critique that's
        kind and specific. <a class="link-ext" href="/about#approach">How I work<span class="link-ext__mark" aria-hidden="true">→</span></a>
      </p>
    </Reveal>
  </Section>

  <!-- Testimonials. Placed after the work and the approach, where a hiring
       manager already knows what she did and is looking for corroboration.
       Clay is shared with the fourth work band — far enough up the page that
       the two don't read as a pair. -->
  <Section theme="clay" class="saidabout">
    <Reveal>
      <h2 class="u-label">What people say</h2>
    </Reveal>
    <Reveal delay={120}>
      <Testimonials items={testimonials} />
    </Reveal>
  </Section>

  <!-- ACT 4 — full-bleed mosaic, back to dark. Tighter than the original
       spread (was 44/38/56vw with up to 7rem gaps and a full --space-section
       of padding top and bottom): three placeholder shapes at that scale
       read as a broken, mostly-empty band rather than an airy one. Smaller
       widths, a smaller gap (Mosaic.astro) and .mosaic-band's own reduced
       padding keep the same left/right/center composition without the
       dead space either side of it. -->
  <Section theme="ink" full class="mosaic-band">
    <Mosaic items={[
      { src: '/images/placeholder-1.svg', alt: 'Placeholder — replace with work imagery', edge: 'left', w: 36 },
      { src: '/images/placeholder-2.svg', alt: 'Placeholder — replace with work imagery', edge: 'right', w: 30, y: -3 },
      { src: '/images/placeholder-3.svg', alt: 'Placeholder — replace with work imagery', edge: 'center', w: 44, y: 3 },
    ]} />
  </Section>

  <!-- The playground, previewed. Last light note before the contact band;
       the whole row is a way into /playground. -->
  <Section theme="sand" full class="playpeek">
    <div class="u-shell playpeek__head">
      <h2 class="u-label">From the playground</h2>
      <a class="playpeek__link" href="/playground">See all &rarr;</a>
    </div>
    <Marquee items={playCards} kind="card" seconds={26} label="From the playground" />
  </Section>

  <!-- ACT 5 — contact -->
  <Section theme="bone" id="contact">
    <Reveal>
      <h2 class="u-display">Open to work.</h2>
    </Reveal>
    <Reveal delay={140}>
      <p class="u-measure">
        Looking for a {site.ask}. The hard, systemic parts of enterprise
        software, hands on the work.
      </p>
      <p class="contact__links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.linkedin}>LinkedIn</a>
      </p>
    </Reveal>
  </Section>
</Base>

<style>
  /* :global — `class="hero"` is forwarded as a prop into <Section>, so it
     lands on an element in Section.astro's own scope, not this page's. An
     unscoped rule here silently never matches (CLAUDE.md's own documented
     gotcha); without :global() the hero never gets its centring. */
  /* Was min-height: 92svh with justify-content: center — the nav gap and
     the gap to the CTA row below were both just leftover space from
     centering a short headline in a near-full-viewport box, not decisions.
     Top-aligned now: the nav gap is set on purpose (clamp, so it holds
     proportionally on a short laptop screen and a tall monitor rather of
     a fixed rem doing something different on each), and it's deliberately
     bigger than the CTA gap below so the headline+CTAs read as one
     group (Gestalt proximity) separated from the nav above, not from
     each other. clamp(7rem, 26vh, 13rem) matches the raw proportion
     measured on hansonwu.com (nav→headline ≈26vh, ≈4x their headline's
     font-size, at 1440x900).

     min-height: 80svh (not a fixed bottom padding) makes the whole band —
     nav gap, headline, CTA row, and the leftover room below them — always
     read as 80% of the first screen, "Selected work" always peeking in
     the remaining 20%, on any monitor or phone. svh, not vh: vh on
     mobile Safari/Chrome includes the address bar's collapsed state and
     jumps on scroll; svh locks to the smallest possible viewport. It's a
     floor, not a cap — min-height, so a headline that wraps to a 4th line
     on a narrow phone just pushes the band taller instead of clipping,
     same as every clamp() gap here already behaves. Bottom padding
     zeroed — Section.astro's base `.u-section` rule applies
     --space-section (clamp(5rem,12vw,11rem)) to both edges, and left
     alone that was fighting the flex spacer below for the same space. */
  :global(.hero) {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 88svh;
    padding-top: clamp(7rem, 26vh, 13rem);
    /* No longer zeroed. That relied on .hero__spacer alone to hold the
       CTA row away from the section's bottom edge — true only while the
       headline+bio+CTA stack stayed under 80svh. The current headline
       wraps to more lines at its tightened max-width (see .hero__line),
       so the stack now routinely exceeds 80svh: the spacer collapses to
       0 and the Resume/LinkedIn buttons landed flush against the band's
       bottom edge with no gap at all, reading as broken rather than
       "the section grew to fit its content." A real bottom padding
       means the CTA row always has breathing room, whether the spacer
       has anything left to give or not. */
    padding-bottom: clamp(3rem, 6vh, 4.5rem);
  }
  /* Absorbs whatever's left of the 80svh after the nav gap, headline and
     CTA row above have taken their fixed amount — the actual mechanism
     that makes "80% on every screen" true, rather than a computed number.
     On a short viewport where the content already exceeds 80svh this
     just collapses to 0, which is correct: min-height already lets the
     band grow past it. */
  .hero__spacer { flex: 1 1 auto; }
  /* Still --step-h1, not --step-display — a poster-scale size meant for
     a handful of words forced this same sentence into an 8-line tower
     taller than the viewport the last time this wore it. Hand-broken
     into three lines again (the industry now lives in
     HeroRotatingWord, one word at a time, so it never has to be the
     line that decides where the break falls); measure widened enough
     to hold "10+ years shaping digital products" as a single line at
     this size without extra wrapping. */
  /* var(--step-h1) tops out at 6rem/96px once the viewport crosses ~1371px
     — and at that size "10+ years shaping digital products" needs ~1507px
     while the shell only gives it ~1325px, so it wraps mid-sentence and
     strands "products" alone on the line after it. Capped at 5rem/80px
     here instead (measured: fits the shell down to the hero's own min
     width), so all three authored lines land exactly where the <br/>s put
     them at every desktop width. */
  /* max-width tightened from 44ch, then 32ch, then 26ch — none of those
     actually narrowed the rendered lines: greedy word-wrap only fills a
     line until the next word doesn't fit, and every wrapped line here
     was already narrower than all three of those box widths (measured:
     the widest line topped out near 1060px against a 1241px/26ch box),
     so the text kept wrapping at the exact same points regardless of how
     much invisible box remained past it. The box has to be narrower than
     the content's own natural wrap width to change anything — 18ch does
     that (measured ~845px at the font-size cap, tighter than every line
     the old boxes produced). */
  /* line-height overridden up from .u-display's own --leading-display
     (0.85) — that value is tuned for the short, 1-3-line headlines it
     wears elsewhere on the site (Contact's "Open to work.", etc.), where
     there's no line directly below a line ending in a descender. This
     headline is five lines of running prose, so at 0.85 a descender
     ending one line (the "y" in "reality") sits low enough to collide
     with the ascenders/caps starting the next ("beyond..."). 1.08 gives
     enough room for that without loosening the shorter headlines that
     still rely on the tight default. */
  /* Conversational, not a marketing headline — this line used to carry
     a rotating-word H1 at display size; now it's just "Hi, I'm
     Anupama.", sized down to --step-h2 so it reads as a greeting, not
     a claim. */
  .hero__line { font-size: var(--step-h2); max-width: 18ch; line-height: 1.15; }

  /* Hero copy + portrait side by side on desktop, portrait first and
     centred above the copy on narrow screens — the halftone photo is the
     thing a visitor's eye lands on first either way, then the headline.
     A full-bleed backdrop version of this (figure filling the whole
     band, copy on a bottom scrim) was tried by explicit instruction,
     matching a reference, and reverted ("too big") back to this
     side-by-side card layout — see git history if it comes back. */
  .hero__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .hero__copy { flex: 1 1 auto; min-width: 0; }
  .hero__portrait { flex: none; }
  @media (max-width: 860px) {
    .hero__row { flex-direction: column-reverse; align-items: center; text-align: center; }
    .hero__copy { display: flex; flex-direction: column; align-items: center; }
    .hero__portrait { align-self: center; }
    .hero__line { max-width: 100%; }
    .intro__links { justify-content: center; }
  }

  /* The status line ("Open to a Staff Product Designer role, remote") —
     modelled on carlthomasiv.com's mono-caps eyebrow ("CURRENTLY DESIGNING
     AT ONA"), same monospace treatment, but the wording reads from
     site.ask (data/site.ts) rather than being retyped here, so it can't
     drift the way CLAUDE.md warns the ask has before. Sits above the
     headline, not below it — a recruiter's first signal is availability,
     the headline is the pitch.

     Colour is --fg-dim, not --accent-text, to track the hero's own
     --fg-dim value rather than sit pinned to a separate token. (This
     is also currently hidden via .u-sr-only — see the Reveal wrapping
     it below.) */
  .hero__eyebrow {
    display: flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-mono); font-size: var(--step-label); font-weight: 400;
    letter-spacing: var(--tracking-label); text-transform: uppercase;
    color: var(--fg-dim); margin: 0 0 1.4rem;
  }
  /* Live-availability dot, not the old terminal-caret full stop — a small
     pulse (not a hard blink) reads as "currently true" rather than a
     cursor waiting for input. */
  .hero__statusdot {
    width: 7px; height: 7px; border-radius: 50%;
    background: currentColor; flex: none;
    animation: hero-pulse 2s ease-in-out infinite;
  }
  @keyframes hero-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__statusdot { animation: none; opacity: 1; }
  }

  /* Widened from 40ch and the copy itself cut (dropped "leading a team of
     six on Identity & Access Management" — that's already the case
     studies' job, not the hero's) so the sentence actually holds to two
     lines instead of wrapping to four or five. Measured live, not
     guessed: text-wrap:pretty avoids a lonely last word stranded alone
     on the second line. */
  /* font-family overridden to --font-display (sans) — the body default,
     --font-body (Crimson Pro), is a serif, and this line reads as part
     of the hero's sans-serif statement rather than a paragraph of body
     copy. */
  .hero__bio { font-family: var(--font-display); color: var(--fg-dim); font-size: var(--step-body); max-width: 64ch; margin: 1.4rem 0 0; text-wrap: pretty; }
  .hero__bio--secondary { margin-top: 0.9rem; }

  /* Plain sans greeting line, same colour as the headline (not --fg-dim) —
     it's the one beat before the bio proper and reads as part of the
     "statement," not body copy. */
  .hero__greet { font-family: var(--font-display); color: var(--fg); font-size: var(--step-h3); font-weight: 500; margin: 1.4rem 0 0; }

  /* "Reflected" phrases — the cali.so-style device of drawing a second
     look to specific words in a running bio sentence, adapted to this
     site's own hover system rather than cali's inline emoji. The hero
     wears "charcoal", a deliberately hue-less theme (see tokens.css — "no
     hue to compete with the headline"), so this can't lean on a colour
     the way the mockup did; --font-accent (the italic) plus an underline
     that draws in with the sitewide --ease-out/--dur-hover on hover/focus
     is the whole effect, in currentColor. The aside is a short, true
     attribution (a company or a duration already stated elsewhere on the
     site) that slides open next to the phrase — progressive disclosure,
     not new information gating: the plain sentence around it already
     carries the fact for anyone who never hovers. Hover-only by design;
     no touch fallback, because nothing here is required reading. */
  .reflect-wrap { display: inline; }
  .reflect {
    font-family: var(--font-accent);
    font-style: italic;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-hover) var(--ease-out);
  }
  .reflect:hover, .reflect:focus-visible {
    text-decoration-color: currentColor;
  }
  .reflect__aside {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: var(--step-caption);
    color: var(--fg-dim);
    vertical-align: middle;
    transition: max-width var(--dur-hover) var(--ease-out),
      opacity var(--dur-hover) var(--ease-out),
      margin-left var(--dur-hover) var(--ease-out);
  }
  .reflect-wrap:hover .reflect__aside,
  .reflect-wrap:focus-within .reflect__aside {
    max-width: 12ch;
    opacity: 1;
    margin-left: 0.5em;
  }

  /* "Find me at LinkedIn ↗ or hi@anupama.design" — the hero's own line of
     inline links, styled with the sitewide .link-ext hover (global.css)
     rather than a button, so it reads as a sentence handing off to a link
     the way the rest of the hero copy reads as a paragraph. */
  .hero__find { font-family: var(--font-display); color: var(--fg-dim); font-size: var(--step-body); margin: 0.9rem 0 0; }
  .hero__find .link-ext { color: var(--fg); font-weight: 500; }

  .intro__body { color: var(--fg-dim); font-size: var(--step-body); }

  /* Started at 1.13rem, picked live against a mockup slider — but that
     mockup used a normal-leading serif font. The real .hero__line wears
     --leading-display: 0.85 (a deliberately tight box, 68px line-height
     on an 80px face), so the last line's descenders (the "p" in
     "products"/"shaping") paint several px below their own line box and
     visually eat most of a padding-top that small. 2.25rem compensates
     for that (a fixed pixel amount, not something that scales down with
     the smaller nav gap above) while still sitting closer than the
     2.75rem peak, back in proportion with the hansonwu.com-matched top
     gap. */
  .intro__links { display: flex; align-items: center; gap: 1.5rem; padding-top: 2.25rem; margin: 0; }
  /* Resume/LinkedIn now use the shared .btn system (global.css) —
     Primary/Secondary — instead of their own bespoke pill rules. */

  .railhead { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 2.5rem; }
  .railhead__hint { margin: 0; }

  /* The default --space-section top padding, stacked on top of the
     approach band's own bottom padding right above it, pushed "What
     people say" almost two section-gaps down — a wall of plain clay
     before any quote appeared. Tightened to the seam value used
     elsewhere so the heading shows up right after the scroll into the
     band, not after it. */
  :global(.saidabout) { padding-block-start: var(--space-band-tight); }

  .sand__body { color: var(--fg-dim); font-size: var(--step-h3); }
  .sand__body a { color: var(--fg); text-decoration: none; border-bottom: 1px solid currentColor; }

  .contact__links { display: flex; gap: 1.5rem; padding-top: 1rem; }
  .contact__links a { color: var(--fg); }

  .playpeek__head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: clamp(1rem, 2vw, 1.5rem); }
  .playpeek__link {
    font-family: var(--font-display);
    font-size: var(--step-label); letter-spacing: var(--tracking-label);
    text-transform: uppercase; font-weight: 600;
    color: var(--accent-text); text-decoration: none;
  }

  .workhead { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: clamp(1rem, 2vw, 1.5rem); }
  .workhead__count { font-family: var(--font-accent); font-style: italic; font-size: var(--step-h3); color: var(--fg-dim); margin: 0; }
  .workhead__all {
    font-family: var(--font-display); font-size: var(--step-label); font-weight: 600;
    letter-spacing: var(--tracking-label); text-transform: uppercase;
    color: var(--accent-text); text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-hover) var(--ease-out);
  }
  .workhead__all:hover { border-color: currentColor; }

  /* The "Selected work" label owns the list right below it, so that pair
     closes up: no section padding underneath, and the list drops its own
     top padding to match. :global — both are rendered by Section.astro,
     so they don't carry this page's scope. */
  :global(.workhead-section) { padding-block: var(--space-band-tight) 0; }

  /* See ACT 4's own comment — this band was reading as three near-empty
     screens of black against tiny placeholder shapes. --space-band-tight
     instead of the default --space-section keeps it a compact interlude
     between the approach/testimonials bands and the playground band,
     proportionate to the placeholder content's own smaller footprint. */
  :global(.mosaic-band) { padding-block: var(--space-band-tight); }
  :global(.workhead-section + .worklist) { padding-top: var(--space-band-tight); }

  /* Contained, not full-bleed — the redesign's whole point was to stop
     the cards spanning almost the entire viewport. Section.astro's own
     .u-shell already centres this band, but at a width tuned for body
     copy; this is deliberately narrower again, just for the grid. */
  .worklist__grid { max-width: 74rem; margin-inline: auto; }

  .worklist__grid {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Stacking cards: each row pins a little lower than the one before it
     (--stack-i, set per row from index.astro's map), so as you scroll a
     new card slides up over the last and the previous card's top edge
     keeps peeking out underneath rather than vanishing. z-index makes
     the paint order explicit instead of relying on DOM order. The
     padding-bottom (replacing the old flex `gap`) is what lets that peek
     show — a plain gap would just push the next card down without ever
     overlapping. */
  .worklist__item {
    position: sticky;
    top: calc(clamp(4.5rem, 6vw, 6rem) + var(--stack-i, 0) * 16px);
    z-index: calc(var(--stack-i, 0) + 1);
    /* This is what actually controls the delay before the next card
       starts covering this one — NOT the 16px --stack-i step above
       (that only sets how far each pinned card's top edge peeks out
       from behind the next). A sticky element stays pinned for exactly
       as much extra scroll distance as its own box has left below the
       pinned content — i.e. this padding. At the old ~2.5rem it barely
       stayed pinned before the next card's turn arrived, so cards felt
       like they overlapped mid-scroll instead of after a full look.
       40vh gives each card a real, comfortable window fully on screen
       first. */
    padding-bottom: 40vh;
  }

  /* The settle effect (a card scales/dims slightly as the next one
     covers it) used to run on the browser's own scroll-driven
     animation-timeline. That worked at the old ~40px padding-bottom,
     but its 0–45% animation-range was tuned to that short pin duration
     — once the pin got much longer (see .worklist__item's own comment),
     the animation finished almost instantly and then sat static for
     the rest of the scroll, reading as a jump rather than a settle.
     animation-timeline also doesn't account for `position: sticky`
     freezing the element's own rect while pinned, which made the
     mismatch worse. Replaced with the same plain rAF-on-scroll
     technique Mosaic.astro's parallax already uses — see the <script>
     below — so the effect is always exactly proportional to how far
     through its own pinned window a card actually is, in every
     browser, transition-free (no lag behind the scroll position). */
  .worklist__item > :global(.pc) {
    transform-origin: center top;
    /* ProjectCard.astro's own .pc rule carries a transform transition
       meant for a hover effect that no longer uses it. Left alone here
       it would apply to our own rAF-driven scale updates below too —
       every scroll tick would ease in over --dur-hover (320ms) instead
       of landing immediately, so the card visibly lags behind the
       actual scroll position. Overriding to none keeps the settle
       effect locked exactly to scroll, which is what "smooth" means
       for a scroll-driven effect (transitions are for animating TO a
       new state on their own time; this state changes every frame). */
    transition: none;
  }
</style>

<script>
  // The stacking cards' settle effect — each card scales/dims slightly
  // in direct proportion to how far it's scrolled through its own
  // pinned window, computed straight from scroll position rather than
  // a CSS scroll-timeline (see the .worklist__item comment on why: a
  // timeline's animation-range can't stay correct across an arbitrary,
  // responsive padding-bottom, and doesn't account for position:sticky
  // freezing the element's own rect while pinned). Same plain
  // rAF-on-scroll shape as Mosaic.astro's own parallax.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const stackItems = [...document.querySelectorAll<HTMLElement>('.worklist__item')];
    if (stackItems.length) {
      type Rec = { item: HTMLElement; card: HTMLElement; startY: number; padBottom: number };
      let recs: Rec[] = [];

      // `item.offsetTop` looks like the right way to find where a sticky
      // element starts pinning, but once the browser has actually stuck
      // it, offsetTop stops reporting the original static-flow position
      // and instead tracks the current (stuck) rendered position — which
      // moves together with scrollY, so `offsetTop - stickyTop` collapses
      // to `scrollY` and progress reads as permanently 0 the moment a
      // card sticks. Toggling `position` to static for one synchronous
      // read (then straight back to sticky) forces the browser to report
      // the true, scroll-independent flow position instead.
      const measure = (): Rec[] =>
        stackItems.flatMap((item) => {
          const card = item.querySelector<HTMLElement>('.pc');
          if (!card) return [];
          const stickyTop = parseFloat(getComputedStyle(item).top) || 0;
          const padBottom = parseFloat(getComputedStyle(item).paddingBottom) || 1;
          const prevPosition = item.style.position;
          item.style.position = 'static';
          const staticTop = item.offsetTop;
          item.style.position = prevPosition;
          return [{ item, card, startY: staticTop - stickyTop, padBottom }];
        });

      // Two separate rAF handles, not one shared between scroll and
      // resize — sharing a single flag meant a resize firing while a
      // scroll-triggered tick() was already queued got silently dropped
      // (the `if (!raf)` guard saw it as busy), leaving `recs` stuck on
      // pre-resize measurements until some later, uncontested resize.
      let scrollRaf: number | null = null;
      let resizeRaf: number | null = null;
      const tick = () => {
        for (const { card, startY, padBottom } of recs) {
          const progress = Math.min(1, Math.max(0, (scrollY - startY) / padBottom));
          const scale = 1 - progress * 0.04;
          const brightness = 1 - progress * 0.08;
          card.style.transform = `scale(${scale})`;
          card.style.filter = `brightness(${brightness})`;
        }
        scrollRaf = null;
      };
      const remeasureAndTick = () => { recs = measure(); tick(); resizeRaf = null; };
      remeasureAndTick();
      addEventListener('scroll', () => { if (!scrollRaf) scrollRaf = requestAnimationFrame(tick); }, { passive: true });
      // Resize re-measures (a --stack-i offset, card height, or the
      // whole layout can change at a new width) rather than just
      // re-ticking with stale start positions.
      addEventListener('resize', () => { if (!resizeRaf) resizeRaf = requestAnimationFrame(remeasureAndTick); });
    }
  }
</script>
