---
/* /playground — one screen: PlayBall, a copy of andreas.vision/play (on
   request, 2026-10-19). The earlier endless stream (InfiniteStream.astro,
   data/play.ts) is parked, not deleted; /playground/canvas still uses its
   own PanCanvas. */
import Base from '../layouts/Base.astro';
import PlayBall from '../components/PlayBall.astro';
---
<!-- No cursor trail or lamp here: the ball wears the grab/grabbing hand,
     and a line trailing off a hand you're dragging with reads as two
     cursors. See the note on Base's `trail` prop. -->
<Base
  title="Playground — Anupama Mishra"
  description="Sketches, interfaces, art and photos by Anupama Mishra, on one ball you can spin or sort."
  trail={false}
>
  <PlayBall />
</Base>
