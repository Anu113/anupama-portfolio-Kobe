---
/* /playground — her work hung as a gallery wall (PlayDepth.astro), on
   request (2026-11-13; built 2026-11-11 from
   experiments/playground-stream/wall.html, first at /playground/stream).
   The page opens on the heading, the work rises from below it, and after
   ~4 screens of work the page goes on to the footer. PlayBall (the ball of
   cards, data/playground.ts) and the earlier stream (InfiniteStream.astro,
   data/play.ts) are parked, not deleted; /playground/canvas still uses its
   own PanCanvas. */
import Base from '../layouts/Base.astro';
import PlayDepth from '../components/PlayDepth.astro';
---
<!-- No cursor trail or lamp: the wall wears the grab/grabbing hand, and a
     line trailing off a hand you're dragging with reads as two cursors. -->
<Base
  title="Playground — Anupama Mishra"
  description="Paintings and photos by Anupama Mishra, hung as a wall you can scroll and pan."
  trail={false}
>
  <PlayDepth />
</Base>
