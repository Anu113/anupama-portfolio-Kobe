</style>

<script>
  // Which stage is "current" comes from IntersectionObserver, the same
  // question and the same rootMargin CaseRail.astro's own section-spy
  // already asks — see the header comment for why this isn't a
  // scroll-position probe.
  const wrap = document.querySelector<HTMLElement>('[data-aboutstory]');

  if (wrap) {
    const mask = wrap.querySelector<HTMLElement>('[data-mask]')!;
    const stack = wrap.querySelector<HTMLElement>('[data-stack]')!;
    const titles = [...stack.children] as HTMLElement[];
    const stages = [...wrap.querySelectorAll<HTMLElement>('[data-stage]')];
    const visible = new Set<string>();

    const sizeMask = () => {
      mask.style.height = `${titles[0].getBoundingClientRect().height}px`;
    };

    const roll = () => {
      const currentId = stages.find((s) => visible.has(s.id))?.id;
      const idx = Math.max(0, stages.findIndex((s) => s.id === currentId));
      stack.style.transform = `translateY(-${idx * titles[0].getBoundingClientRect().height}px)`;
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        roll();
      },
      { rootMargin: '-25% 0px -60% 0px', threshold: 0 }
    );

    sizeMask();
    stages.forEach((s) => io.observe(s));
    addEventListener('resize', () => { sizeMask(); roll(); });
    // The mask is sized against the fallback system font at parse time;
    // General Sans swapping in afterward can change that measurement,
    // which is what let the next title peek in under the current one with
    // no scroll at all. Re-measure once the real font is ready.
    document.fonts?.ready.then(() => { sizeMask(); roll(); });
  }
</script>

<script>
  // Custom dropdown — button + popup listbox standing in for the old
  // native <select> (see the template comment above the form for why).
  // ARIA "select-only combobox": the button opens the popup, the popup
  // itself takes DOM focus and owns arrow/Home/End/Enter/Escape, and a
  // hidden input carries the chosen value into the form's FormData.
  function initDSelect(root: HTMLElement) {
    const trigger = root.querySelector<HTMLButtonElement>('[data-dselect-trigger]');
    const valueEl = root.querySelector<HTMLElement>('[data-dselect-value]');
    const list = root.querySelector<HTMLUListElement>('[data-dselect-list]');
    const input = root.querySelector<HTMLInputElement>('[data-dselect-input]');
    if (!trigger || !valueEl || !list || !input) return;
    const options = [...list.querySelectorAll<HTMLLIElement>('[role="option"]')];
    let activeIndex = 0;

    const setActive = (i: number) => {
      activeIndex = Math.max(0, Math.min(i, options.length - 1));
      options.forEach((o, idx) => o.classList.toggle('is-active', idx === activeIndex));
      list.setAttribute('aria-activedescendant', options[activeIndex].id);
      options[activeIndex].scrollIntoView({ block: 'nearest' });
    };

    const close = () => {
      list.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
    };

    const open = () => {
      const selected = options.findIndex((o) => o.getAttribute('aria-selected') === 'true');
      list.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      setActive(selected >= 0 ? selected : 0);
      list.focus();
    };

    const choose = (i: number) => {
      options.forEach((o) => o.setAttribute('aria-selected', 'false'));
      options[i].setAttribute('aria-selected', 'true');
      valueEl.textContent = options[i].dataset.value ?? '';
      input.value = options[i].dataset.value ?? '';
      trigger.setAttribute('aria-invalid', 'false');
      close();
      trigger.focus();
    };

    trigger.addEventListener('click', () => (list.hidden ? open() : close()));

    list.addEventListener('keydown', (e) => {
      switch (e.key) {
        case 'ArrowDown': e.preventDefault(); setActive(activeIndex + 1); break;
        case 'ArrowUp': e.preventDefault(); setActive(activeIndex - 1); break;
        case 'Home': e.preventDefault(); setActive(0); break;
        case 'End': e.preventDefault(); setActive(options.length - 1); break;
        case 'Enter':
        case ' ': e.preventDefault(); choose(activeIndex); break;
        case 'Escape': e.preventDefault(); close(); trigger.focus(); break;
        case 'Tab': close(); break;
      }
    });

    options.forEach((o, i) => {
      o.addEventListener('click', () => choose(i));
      o.addEventListener('mouseenter', () => setActive(i));
    });

    document.addEventListener('click', (e) => {
      if (!list.hidden && !root.contains(e.target as Node)) close();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-dselect]').forEach(initDSelect);
</script>

<script>
  // The mad-lib form has nowhere to submit to — static site, no server —
  // so "Submit" builds a mailto: from the three fields instead, same move
  // LockedGate.astro's own contact link already makes.
  const connectForm = document.querySelector<HTMLFormElement>('[data-connect-form]');

  connectForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(connectForm);
    const name = String(data.get('name') ?? '').trim();
    const orgType = String(data.get('orgType') ?? '');
    const need = String(data.get('need') ?? '');
    const email = String(data.get('email') ?? '').trim();
    const to = connectForm.dataset.to ?? '';

    // orgType/need live in hidden inputs behind the custom dropdown, which
    // the browser's own "required" can't validate (a hidden input is
    // barred from constraint validation) — so check them by hand and hold
    // the mailto redirect until both are set.
    let firstInvalid: HTMLButtonElement | null = null;
    for (const [value, field] of [[orgType, 'orgType'], [need, 'need']] as const) {
      const dselect = connectForm.querySelector<HTMLElement>(`[data-dselect][data-field="${field}"]`);
      const trigger = dselect?.querySelector<HTMLButtonElement>('[data-dselect-trigger]');
      trigger?.setAttribute('aria-invalid', String(!value));
      if (!value && !firstInvalid) firstInvalid = trigger ?? null;
    }
    if (firstInvalid) { firstInvalid.focus(); return; }

    const subject = `Hello from ${name || 'a visitor'}`;
    const body = [
      `${name || 'Someone'} here, from a/an ${orgType || '[org type]'}.`,
      `Need help with: ${need || '[what they need]'}.`,
      '',
      `Reach me at ${email || '[email]'}.`,
    ].join('\n');

    window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
