---
/* About. Layout chosen on request (2026-11-11) from the mocks in
   experiments/about-grid/ ("Half and half", "Fan out"); content in
   data/about.ts, values under ABOUT in tokens.css. Our fonts and role
   colours.

   HEAD. Her portrait on the left (4:5, her porch painting as a stamp),
   held in place while her words and the tabs scroll beside it; it lets
   go before the tiles. Right: "About me", then "Updated on …"
   (`updated` in data/about.ts) in mono, her bio in her words, how to
   reach her, three icon buttons (LinkedIn, copy email, email); then,
   after andreas.vision/about, tabs (Experience / Case studies / Books)
   over a short list that scrolls on its own, slowly, and loops (the
   rows are rendered twice; the copy is hidden from screen readers and
   the keyboard). It stops while the pointer or focus is on it, can be
   dragged or scrolled by hand, and is still under reduced motion.
   Under it, Moss's field (AskMoss.astro, small size). The words rise
   in, 50ms apart. Under 1024px it's one column: portrait, words, the
   tiles, then the tabs and Moss's field last.

   TILES. Six, three across (two under 1024px, one on phones): Talks
   and people, Making, Travel, Food, Books, and a record player
   (RecordPlayer.astro, its own header says how it plays). The first
   five: Each a stack of up to
   five photos; on hover or keyboard focus the stack spreads to show
   every photo, stopping at the tile's edge, and the photo under the
   pointer lifts. Every photo is a button: it opens large in a
   lightbox (a native <dialog>: arrows step through the tile's photos,
   Escape closes, focus goes back to the photo). On touch the stacks
   rest spread. No motion under reduced motion.

   UX reason: her face and her words read together on the first screen;
   the tiles show who she is outside the work, and nothing in a stack is
   out of reach. Tabs are an ARIA tablist (arrow keys move between them). */
import Base from '../layouts/Base.astro';
import AskMoss from '../components/AskMoss.astro';
import RecordPlayer from '../components/RecordPlayer.astro';
import { site } from '../data/site';
import { tabs, portrait, tiles, updated } from '../data/about';

const gmail = `https://mail.google.com/mail/?view=cm&fs=1&to=${site.email}`;
const updatedLabel = new Date(`${updated}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

---
<Base
  title="About me — Anupama Mishra"
  description={`Staff product designer, ten years across fintech, enterprise software and developer tools. Led a team of six at Okta. Looking for a ${site.ask}.`}
>
  <div class="about u-shell">
    <div class="head">
      <div class="photo rise" style="--i:0">
        <img src={portrait.src} alt={portrait.alt} width={portrait.width} height={portrait.height} loading="eager" decoding="async" />
        <span class="stamp" aria-hidden="true"><img src={portrait.stamp} alt="" loading="lazy" decoding="async" /></span>
      </div>

      <div class="side">
      <section class="intro" aria-labelledby="about-h">
        <div class="words">
          <h1 class="rise" id="about-h" style="--i:0">About <em>me</em></h1>
          <p class="updated u-label-mono rise" style="--i:0">Updated on <time datetime={updated}>{updatedLabel}</time></p>
          <div class="body">
            {/* Her bio, in her words (2026-11-11). */}
            <p class="rise" style="--i:1">
              I’m a product designer based in {site.location},
              working fluidly across product, design, and engineering. I think
              of design as a problem-solving framework with higher-leverage
              applications than screens and, at my best, deliver solutions in
              one fluid motion.
            </p>
            <p class="rise" style="--i:2">
              I’ve been designing consumer applications for the last 11 years
              and playing with code since I was 12. I’m currently a Staff
              Product Designer at Okta.
            </p>
            <p class="rise" style="--i:3">
              Beyond my day job, I partner with founders to design the systems
              that create great products and honor their relationships with
              their customers. I enjoy working closely with people who are
              building something meaningful and helping bring their ideas to
              life.
            </p>
            <p class="rise" style="--i:4">
              Open to {site.seeking} roles.
            </p>
            <p class="rise" style="--i:5">
              Outside of my design work, I’m a mother, wife, elder sister, and
              daughter. I’m a maker at heart, deeply curious about the world
              around me. I love exploring ideas, making things, and finding
              inspiration in unexpected places. I still find time for the
              occasional session of writing poetry and spending time with my
              little creative club.
            </p>
            <p class="rise" style="--i:6">
              I can always find time on my calendar for a kindred creative
              spirit. Please do say hi, on
              {' '}<a href={site.linkedin} target="_blank" rel="me noopener">LinkedIn</a>{' '}
              or by <a href={gmail} target="_blank" rel="noopener">email</a>.
            </p>
          </div>
        </div>

        <div class="links rise" style="--i:7">
          <a class="icon" href={site.linkedin} target="_blank" rel="me noopener" aria-label="LinkedIn (opens in a new tab)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <span class="tipped" data-copy-wrap>
            <button class="icon" type="button" data-copy={site.email} aria-label="Copy email address">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            </button>
            <span class="tip" aria-hidden="true" data-tip>Copy email</span>
          </span>
          <a class="icon" href={gmail} target="_blank" rel="noopener" aria-label="Email Anupama (opens Gmail in a new tab)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
          </a>
          <span class="u-sr-only" role="status" data-copy-status></span>
        </div>
      </section>

      <div class="picks rise" style="--i:2" data-ask-scope>
        <div class="tabs" role="tablist" aria-label="About Anupama">
          {tabs.map((t, i) => (
            <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`}
              aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
          ))}
        </div>
        {tabs.map((t, i) => (
          <div class="box" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`}
            tabindex="0" hidden={i !== 0} data-box>
            <div class="reel">
              {[0, 1].map((copy) => (
                <ul class={copy ? 'echo' : undefined} aria-hidden={copy ? 'true' : undefined} inert={copy ? true : undefined}>
                  {t.rows.map((r) => {
                    const Tag = r.href ? 'a' : 'div';
                    return (
                      <li>
                        <Tag class="row" href={r.href}>
                          {r.tile.src
                            ? <img class="tile" src={r.tile.src} alt="" width="44" height="44" loading="lazy" decoding="async" draggable="false" />
                            : <span class="tile tile--letter" aria-hidden="true">{r.tile.letter}</span>}
                          <span class="text">
                            <span class="rhead">
                              <span class="name">{r.name}{r.tag && <span class="tag"> / {r.tag}</span>}</span>
                              {r.year && <span class="year">{r.year}</span>}
                            </span>
                            <span class="line">{r.line}{r.site && <> <a class="site" href={r.site.href} target="_blank" rel="noopener">{r.site.label}</a></>}</span>
                          </span>
                        </Tag>
                      </li>
                    );
                  })}
                </ul>
              ))}
            </div>
          </div>
        ))}
        <AskMoss size="small" start />
      </div>
      </div>
    </div>

    <ul class="tiles">
      {tiles.map((t) => (
        <li class="ptile" data-tile>
          <div class="deck">
            {t.shots.map((sh, i) => (
              <button class="shot" type="button" data-shot={i} aria-label={`${sh.alt} (open larger)`}>
                <img src={sh.src} alt="" loading="lazy" decoding="async" draggable="false" />
              </button>
            ))}
          </div>
          <p class="caption">{t.caption}</p>
        </li>
      ))}
      <li class="ptile ptile--player"><RecordPlayer /></li>
    </ul>

    <dialog class="lb" aria-label="Photo" data-lb>
      <button class="lb__btn lb__x" type="button" aria-label="Close" data-lb-close>×</button>
      <button class="lb__btn lb__prev" type="button" aria-label="Previous photo" data-lb-step="-1">‹</button>
      <figure class="lb__fig">
        <img alt="" data-lb-img />
        <figcaption><span data-lb-cap></span><span class="lb__count" data-lb-count></span></figcaption>
      </figure>
      <button class="lb__btn lb__next" type="button" aria-label="Next photo" data-lb-step="1">›</button>
    </dialog>
  </div>
</Base>

<style>
  .about {
    display: flex; flex-direction: column; gap: var(--about-top-gap);
    padding-block: calc(var(--nav-h) + var(--space-band-tight)) var(--space-band);
  }

  /* ---- head: portrait | words and tabs ---- */
  .head {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--about-head-gap); align-items: start;
  }
  .photo {
    position: sticky; top: var(--about-sticky-top);
    aspect-ratio: var(--about-photo-ratio); border-radius: var(--radius-about-card);
    background: var(--about-card);
  }
  .photo > img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%;
    border-radius: inherit;
  }
  .stamp {
    position: absolute; top: -3%; right: 5%; width: 18%; aspect-ratio: 0.87;
    padding: 2.2%; background: var(--about-stamp-paper); transform: rotate(7deg);
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.15));
    /* perforated edge: dots punched out of the margin only */
    mask:
      linear-gradient(#000 0 0) content-box,
      radial-gradient(circle, #0000 2.4px, #000 2.7px) -4px -4px / 8px 8px round;
  }
  .stamp img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .side { display: grid; gap: var(--about-top-gap); max-width: var(--about-intro-max); }
  .intro { display: grid; gap: 1.5rem; }
  .words { display: grid; gap: 0.875rem; }
  .updated { margin: 0; }
  .words h1 {
    margin: 0; font-family: var(--font-serif); font-weight: 300;
    font-size: var(--step-about-h); line-height: 1.2; letter-spacing: 0; color: var(--fg);
  }
  .words h1 em { font-style: italic; }
  .body { display: grid; gap: 0.75rem; color: var(--fg-dim); font-size: var(--step-body); line-height: var(--leading-body); }
  .body p { margin: 0; }
  .body a { color: var(--fg); text-decoration: underline var(--link-thick) var(--link-line); text-underline-offset: var(--link-offset); }
  .body a:hover { text-decoration-color: var(--link-line-hover); text-decoration-thickness: var(--link-thick-hover); }

  .links { display: flex; gap: 0.5rem; }
  .icon {
    position: relative; display: grid; place-items: center; width: 2.25rem; height: 2.25rem;
    padding: 0; border: 0; border-radius: var(--radius-about-icon);
    background: var(--about-icon); color: var(--about-soft); cursor: pointer;
    transition: color var(--dur-micro) ease-out, background-color var(--dur-micro) ease-out;
  }
  .icon svg { width: 1rem; height: 1rem; }
  .icon:hover { color: var(--fg); background: var(--about-tab); }
  .icon:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .tipped { position: relative; display: flex; }
  .tip {
    position: absolute; bottom: calc(100% + 6px); left: 50%;
    padding: 3px 8px; border-radius: 6px; background: var(--fg); color: var(--bg);
    font-size: var(--step-label); line-height: 1.4; white-space: nowrap;
    opacity: 0; transform: translate(-50%, 4px); pointer-events: none;
    transition: opacity 100ms ease-out, transform 100ms ease-out;
  }
  .tipped:hover .tip, .tipped:focus-within .tip, .tipped[data-copied] .tip { opacity: 1; transform: translate(-50%, 0); }

  .rise { animation: about-rise var(--dur-about-rise) ease-out both; animation-delay: calc(var(--i, 0) * 50ms); }
  @keyframes about-rise { from { opacity: 0; transform: translateY(10px); } }

  /* ---- tabs + the list that scrolls itself ---- */
  .picks { display: grid; gap: 1.5rem; }
  .tabs { display: flex; gap: 0.25rem; }
  .tabs button {
    padding: 0.25rem 0.75rem; border: 0; border-radius: var(--radius-about-tab);
    background: transparent; color: var(--about-quiet);
    font: inherit; font-size: var(--step-about-tab); line-height: 1.6; white-space: nowrap; cursor: pointer;
    transition: background-color var(--dur-micro) ease-out, color var(--dur-micro) ease-out;
  }
  .tabs button:hover { color: var(--about-soft); }
  .tabs button[aria-selected='true'] { background: var(--about-tab); color: var(--about-soft); }
  .tabs button:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

  .box {
    height: var(--about-reel-h); overflow-y: auto; scrollbar-width: none; outline: none; cursor: grab;
    mask-image: linear-gradient(transparent, #000 12px, #000 calc(100% - 32px), transparent);
  }
  .box[hidden] { display: none; }
  .box::-webkit-scrollbar { display: none; }
  .box.is-dragging { cursor: grabbing; user-select: none; }
  .box:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: var(--radius-about-row); }
  .reel, .reel ul { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .row {
    display: flex; align-items: flex-start; gap: 1rem; padding: 0.5rem;
    border-radius: var(--radius-about-row); background: var(--about-row); color: inherit; text-decoration: none;
    transition: background-color var(--dur-micro) ease-out;
  }
  .row:hover { background: var(--about-row-hover); }
  a.row:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
  .tile {
    flex: none; width: var(--about-tile); height: var(--about-tile); border-radius: var(--radius-about-row);
    object-fit: cover; background: var(--about-card);
  }
  .tile--letter { display: grid; place-items: center; color: var(--about-soft); font-size: 0.9375rem; }
  .text { flex: 1; min-width: 0; display: grid; gap: 2px; font-size: var(--step-copy); line-height: 1.3; }
  .rhead { display: flex; justify-content: space-between; gap: 0.5rem; }
  .name { color: var(--fg); }
  .tag { color: var(--fg-dim); }
  .year { flex: none; color: var(--fg-dim); font-family: var(--font-mono); font-size: var(--step-fine); }
  .line { color: var(--fg-dim); text-wrap: pretty; }
  .site { color: var(--fg); text-decoration: underline var(--link-thick) var(--link-line); text-underline-offset: var(--link-offset); }
  .site:hover { text-decoration-color: var(--link-line-hover); text-decoration-thickness: var(--link-thick-hover); }
  .site:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

  /* ---- the three tiles ---- */
  .tiles {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--about-grid-gap);
    margin: var(--about-top-gap) 0 0; padding: 0; list-style: none;
  }
  /* Square tiles, sized from their width only (container-type:
     inline-size, cqw units). A size container plus aspect-ratio broke
     in Firefox (tiles collapsed to their padding) and squeezed the
     stacks elsewhere; and cq units in a tile's own padding resolve
     against the page, not the tile, so the padding is a percentage. */
  .ptile {
    position: relative; isolation: isolate; aspect-ratio: 1; container-type: inline-size;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 6%; border-radius: var(--radius-about-card);
  }
  .ptile::before {
    content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit;
    background: var(--about-card);
    transition: scale var(--dur-talk-grow) var(--ease-talk-grow);
  }
  .ptile:hover, .ptile:focus-within { z-index: 2; }
  @media (hover: hover) and (pointer: fine) { .ptile:hover::before { scale: 1.03; } }
  .caption {
    margin: 4cqw 0 0; width: min(100%, 34ch); color: var(--fg-dim);
    font-size: var(--step-copy); line-height: 1.35; text-align: center; text-wrap: balance;
  }

  /* a stack of up to five; each photo moves by its own --x/--y/--r/--s */
  /* both sides set explicitly (the photos inside are all absolutely
     placed, so the stack has no content size to fall back on) */
  .deck { position: relative; flex: none; width: 30cqw; height: 50cqw; }
  .shot {
    --x: 0%; --y: 0%; --r: 0deg; --s: 1; --lift: 0%;
    position: absolute; inset: 0; padding: 0; border: 0; overflow: hidden; cursor: zoom-in;
    border-radius: var(--radius-about-shot); background: var(--about-card); box-shadow: var(--about-shadow);
    transform: translate(var(--x), calc(var(--y) - var(--lift))) rotate(var(--r)) scale(var(--s));
    transition: transform 200ms ease-out, box-shadow 200ms ease-out;
  }
  .shot img { display: block; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .shot:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .shot:nth-child(1) { z-index: 5; }
  .shot:nth-child(2) { z-index: 4; --x: -30%; --y: 3%; --r: -6deg; --s: 0.82; }
  .shot:nth-child(3) { z-index: 3; --x: 30%; --y: 3%; --r: 6deg; --s: 0.82; }
  .shot:nth-child(4) { z-index: 2; --x: -56%; --y: 6%; --r: -11deg; --s: 0.68; }
  .shot:nth-child(5) { z-index: 1; --x: 56%; --y: 6%; --r: 11deg; --s: 0.68; }
  /* spread: every photo in view, the outer ones stopping at the tile's edge */
  .ptile:is(:hover, :focus-within) .shot { transition: transform var(--dur-about-fan) var(--ease-about-fan), box-shadow 200ms ease-out; }
  .ptile:is(:hover, :focus-within) .shot:nth-child(1) { --y: -5%; --s: 0.86; }
  .ptile:is(:hover, :focus-within) .shot:nth-child(2) { --x: -42%; --y: 1%; --r: -5deg; --s: 0.76; }
  .ptile:is(:hover, :focus-within) .shot:nth-child(3) { --x: 42%; --y: 1%; --r: 5deg; --s: 0.76; }
  .ptile:is(:hover, :focus-within) .shot:nth-child(4) { --x: -74%; --y: 5%; --r: -9deg; --s: 0.66; }
  .ptile:is(:hover, :focus-within) .shot:nth-child(5) { --x: 74%; --y: 5%; --r: 9deg; --s: 0.66; }
  .ptile .shot:is(:hover, :focus-visible) { --lift: 8%; z-index: 9; box-shadow: var(--about-shadow-lift); }
  /* touch: rest spread, since there's no hover to spread them */
  @media (hover: none) {
    .shot:nth-child(1) { --y: -5%; --s: 0.86; }
    .shot:nth-child(2) { --x: -42%; --y: 1%; --r: -5deg; --s: 0.76; }
    .shot:nth-child(3) { --x: 42%; --y: 1%; --r: 5deg; --s: 0.76; }
    .shot:nth-child(4) { --x: -74%; --y: 5%; --r: -9deg; --s: 0.66; }
    .shot:nth-child(5) { --x: 74%; --y: 5%; --r: 9deg; --s: 0.66; }
  }

  /* ---- the lightbox ---- */
  .lb {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: var(--about-lb-scrim); color: var(--about-lb-ink);
  }
  .lb[open] { display: grid; place-items: center; animation: lb-in 180ms ease-out; }
  .lb::backdrop { background: transparent; }
  @keyframes lb-in { from { opacity: 0; } }
  .lb__fig { margin: 0; display: grid; gap: 0.75rem; justify-items: center; }
  .lb__fig img {
    max-width: var(--about-lb-max-w); max-height: var(--about-lb-max-h);
    border-radius: var(--radius-about-shot); box-shadow: var(--about-shadow-lift);
  }
  .lb__fig figcaption { font-size: var(--step-small); text-align: center; max-width: var(--about-lb-max-w); }
  .lb__count { margin-left: 0.5rem; color: var(--about-lb-dim); font-family: var(--font-mono); font-size: var(--step-fine); }
  .lb__btn {
    position: absolute; width: 2.75rem; height: 2.75rem; border: 0; border-radius: var(--radius-pill);
    background: var(--about-lb-btn); color: var(--about-lb-ink); font: inherit; font-size: 1.25rem; line-height: 1; cursor: pointer;
    transition: background-color var(--dur-micro) ease-out;
  }
  .lb__btn:hover { background: var(--about-lb-btn-hover); }
  .lb__btn:focus-visible { outline: 2px solid var(--about-lb-ink); outline-offset: 2px; }
  .lb__x { top: 1.5rem; right: 1.5rem; }
  .lb__prev { left: 1.5rem; top: 50%; translate: 0 -50%; }
  .lb__next { right: 1.5rem; top: 50%; translate: 0 -50%; }

  /* ---- smaller screens ---- */
  /* one column: the head and the right column dissolve into the page's
     own stack, so the order can be photo, words, tiles, then the tabs
     and Moss's field last, on request */
  @media (max-width: 63.99rem) {
    .head, .side { display: contents; }
    .photo { order: 1; position: relative; top: auto; width: 100%; max-width: var(--about-photo-max); }
    .intro { order: 2; }
    .tiles { order: 3; margin-top: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .picks { order: 4; }
  }
  @media (max-width: 40rem) {
    .tiles { grid-template-columns: minmax(0, 1fr); }
    .lb__prev, .lb__next { top: auto; bottom: 1.5rem; translate: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise { animation: none; }
    .ptile::before, .shot, .ptile:is(:hover, :focus-within) .shot { transition: none; }
    .lb[open] { animation: none; }
  }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  // ---- copy email ----
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const wrap = document.querySelector<HTMLElement>('[data-copy-wrap]');
  const tip = document.querySelector<HTMLElement>('[data-tip]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  copyBtn?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(copyBtn.dataset.copy!); } catch { return; }
    tip!.textContent = 'Copied';
    status!.textContent = 'Email address copied';
    wrap!.setAttribute('data-copied', '');
    setTimeout(() => {
      wrap!.removeAttribute('data-copied');
      tip!.textContent = 'Copy email';
      status!.textContent = '';
    }, 1400);
  });

  // ---- tabs (ARIA tablist: arrows, Home, End) ----
  const tabList = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  function select(tab: HTMLButtonElement, focus = false) {
    tabList.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls')!)!;
      panel.hidden = !on;
      if (on) panel.scrollTop = 0;
    });
    if (focus) tab.focus();
  }
  tabList.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const n = tabList.length;
      const to = e.key === 'ArrowRight' ? (i + 1) % n : e.key === 'ArrowLeft' ? (i - 1 + n) % n
        : e.key === 'Home' ? 0 : e.key === 'End' ? n - 1 : -1;
      if (to < 0) return;
      e.preventDefault();
      select(tabList[to], true);
    });
  });

  // ---- the list that scrolls itself, and loops ----
  const speed = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--about-reel-speed')) || 18;
  document.querySelectorAll<HTMLElement>('[data-box]').forEach((box) => {
    const first = box.querySelector<HTMLElement>('.reel > ul')!;
    const loop = () => first.offsetHeight + 2;   // one copy plus the gap
    let held = false, seen = false, pos = 0, last = 0;
    const wrapPos = () => {
      const h = loop();
      if (box.scrollTop >= h) box.scrollTop -= h;
      else if (box.scrollTop <= 0 && held) box.scrollTop += h;
    };
    box.addEventListener('scroll', () => { wrapPos(); if (held) pos = box.scrollTop; });
    const hold = (on: boolean) => { held = on; pos = box.scrollTop; };
    box.addEventListener('pointerenter', () => hold(true));
    box.addEventListener('pointerleave', () => hold(box.contains(document.activeElement)));
    box.addEventListener('focusin', () => hold(true));
    box.addEventListener('focusout', () => hold(box.matches(':hover')));

    // drag to scroll (mouse; touch scrolls natively)
    let dragY = -1, dragTop = 0;
    box.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragY = e.clientY; dragTop = box.scrollTop;
    });
    window.addEventListener('pointermove', (e) => {
      if (dragY < 0) return;
      const dy = e.clientY - dragY;
      if (Math.abs(dy) > 3) box.classList.add('is-dragging');
      box.scrollTop = dragTop - dy;
    });
    window.addEventListener('pointerup', () => {
      if (dragY < 0) return;
      dragY = -1;
      setTimeout(() => box.classList.remove('is-dragging'), 0);
    });
    // a drag that ends on a row link isn't a click
    box.addEventListener('click', (e) => { if (box.classList.contains('is-dragging')) e.preventDefault(); }, true);

    new IntersectionObserver(([e]) => { seen = e.isIntersecting; }).observe(box);
    const tick = (t: number) => {
      const dt = last ? Math.min(0.1, (t - last) / 1000) : 0;
      last = t;
      if (!held && seen && !box.hidden && dragY < 0 && !still.matches) {
        pos += speed * dt;
        const h = loop();
        if (pos >= h) pos -= h;
        box.scrollTop = pos;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });

  // ---- the lightbox: a photo opens large; arrows step through its tile ----
  const lb = document.querySelector<HTMLDialogElement>('[data-lb]')!;
  const lbImg = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const lbCap = lb.querySelector<HTMLElement>('[data-lb-cap]')!;
  const lbCount = lb.querySelector<HTMLElement>('[data-lb-count]')!;
  let shots: HTMLButtonElement[] = [], at = 0, back: HTMLElement | null = null;
  const altOf = (b: HTMLButtonElement) => (b.getAttribute('aria-label') ?? '').replace(/ \(open larger\)$/, '');
  function show() {
    const b = shots[at];
    lbImg.src = b.querySelector('img')!.src;
    lbImg.alt = altOf(b);
    lbCap.textContent = altOf(b);
    lbCount.textContent = `${at + 1} / ${shots.length}`;
  }
  const step = (d: number) => { at = (at + d + shots.length) % shots.length; show(); };
  document.querySelectorAll<HTMLElement>('[data-tile]').forEach((tile) => {
    const own = [...tile.querySelectorAll<HTMLButtonElement>('[data-shot]')];
    own.forEach((b, i) => b.addEventListener('click', () => {
      shots = own; at = i; back = b;
      show();
      lb.showModal();
    }));
  });
  lb.querySelectorAll<HTMLButtonElement>('[data-lb-step]').forEach((b) =>
    b.addEventListener('click', () => step(Number(b.dataset.lbStep))));
  lb.querySelector('[data-lb-close]')!.addEventListener('click', () => lb.close());
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
  });
  lb.addEventListener('close', () => back?.focus());
</script>
