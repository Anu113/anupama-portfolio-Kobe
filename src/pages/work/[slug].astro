---
/* /work/[slug] — the case study layout.
   Structure follows rachelchen.tech/projects/openai: a hero with eyebrow,
   display title, full-width image and a meta row; then a two-column body —
   sticky section rail on the left, content on the right; then a closing
   band with the next project.

   Content and order come from data/cases.ts, and the order is the point.
   CLAUDE.md rule 3: situation → my scope → the hard call → how the team
   worked → the craft → impact → what I'd do differently. Do not reorder
   these to put screens first — the leadership evidence is what the page
   is for, and a portfolio that opens on wireframes argues for an IC role.

   Two things are deliberately duplicated for the 60-second skim: team
   scope sits in the hero meta row (not only in the scope section), and the
   headline metric sits in the closing band. A recruiter who reads the hero
   and nothing else should still come away with team size and outcome. */
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Reveal from '../../components/Reveal.astro';
import CaseRail from '../../components/CaseRail.astro';
import CaseBlocks from '../../components/CaseBlocks.astro';
import { cases, caseBySlug } from '../../data/cases';
import { site } from '../../data/site';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.slug }, props: { study: c } }));
}

const { study } = Astro.props;
const next = caseBySlug(study.next);
---
<Base title={`${study.title} — ${study.company} — Anupama Mishra`} description={study.description}>
  <!-- HERO ----------------------------------------------------------
       Bone, not the project's palette. A full-bleed saturated ground
       behind display type reads as a poster, and it fights the reading
       page underneath it. The project's hue is still on its /work tile
       and on the closing "next case study" band — it doesn't need to be
       the first thing in the room. -->
  <Section theme="bone" class="casehero">
    <div class="hero">
      <Reveal>
        <p class="u-label hero__eyebrow">{study.eyebrow}</p>
      </Reveal>
      <Reveal delay={100}>
        <h1 class="hero__title">{study.title}</h1>
      </Reveal>
      <Reveal delay={180}>
        <div class="hero__frame">
          <img src={study.hero.src} alt={study.hero.alt} decoding="async" />
        </div>
      </Reveal>
      <Reveal delay={260}>
        <dl class="meta">
          {study.meta.map((m) => (
            <div class="meta__cell">
              <dt class="u-label meta__label">{m.label}</dt>
              <dd class="meta__value">{m.value}</dd>
            </div>
          ))}
        </dl>
      </Reveal>
    </div>
  </Section>

  <!-- BODY ---------------------------------------------------------- -->
  <Section theme="bone" class="casebody">
    <div class="body">
      <CaseRail sections={study.sections.map((s) => ({ id: s.id, nav: s.nav }))} />

      <div class="body__col">
        {study.sections.map((s) => (
          <section class="cs" id={s.id} aria-labelledby={`${s.id}-h`}>
            <Reveal>
              <p class="u-label cs__label">{s.label}</p>
              <h2 class="cs__head" id={`${s.id}-h`}>{s.heading}</h2>
            </Reveal>
            <div class="cs__blocks">
              <CaseBlocks blocks={s.blocks} />
            </div>
          </section>
        ))}
      </div>
    </div>
  </Section>

  <!-- NEXT ---------------------------------------------------------- -->
  {next && (
    <Section theme={next.theme} class="casenext">
      <Reveal>
        <p class="u-label">Next case study</p>
        <a class="next" href={`/work/${next.slug}`}>
          <span class="next__co">{next.company}</span>
          <span class="next__title">{next.title}</span>
        </a>
      </Reveal>
    </Section>
  )}

  <Section theme="ink" class="casefoot">
    <Reveal>
      <h2 class="foot__title">Want the parts I can't publish?</h2>
      <p class="u-measure foot__body">
        Some of this work sits behind an NDA. I'll walk through it live — the
        screens, the decisions behind them, and what I'd do differently.
      </p>
      <p class="foot__links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.linkedin}>LinkedIn</a>
        <a href="/work">All work</a>
      </p>
    </Reveal>
  </Section>
</Base>

<style>
  /* :global — these bands are rendered by Section.astro, so the class
     passed through `class` doesn't carry this page's scope hash. */
  :global(.casehero) {
    padding-block-start: calc(var(--nav-h) + var(--space-band-tight));
    /* Banner and body are the same palette now, so there is no colour edge
       between them — two full --space-section paddings back to back would
       just be a dead screen of cream. The body band still opens with its
       own, which is the gap that reads. */
    padding-block-end: var(--space-band-tight);
  }

  .hero { max-width: 82rem; margin-inline: auto; }
  .hero__eyebrow { margin: 0 0 1.25rem; color: var(--fg-dim); }
  .hero__title {
    font-family: var(--font-display);
    font-size: var(--step-h1);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    font-weight: 500;
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
  }
  .hero__frame {
    background: var(--screen);
    /* Panoramic on purpose. The banner carries no body copy, so the frame
       is what sets its height — 16/7 keeps the whole hero (title, image,
       meta row) inside the first screen on a laptop. */
    aspect-ratio: 16 / 7;
    overflow: hidden;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .hero__frame img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* The meta row. Sits under the hero image, same as the reference. */
  .meta {
    margin: 2.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.75rem var(--gutter);
    border-top: 1px solid var(--rule);
    padding-top: 1.75rem;
  }
  .meta__cell { min-width: 0; }
  .meta__label { margin: 0 0 0.5rem; }
  .meta__value { margin: 0; font-weight: 500; text-wrap: pretty; }

  /* --- Body: rail + content ------------------------------------------ */
  .body {
    max-width: 82rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: var(--rail-width) minmax(0, 1fr);
    column-gap: var(--gutter);
    align-items: start;
  }
  .body__col { min-width: 0; }

  .cs {
    /* Clears the fixed nav when the rail's anchors jump here. */
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }
  .cs + .cs { margin-block-start: var(--space-case); }
  .cs__label { margin: 0 0 0.85rem; }
  .cs__head {
    font-family: var(--font-display);
    font-size: var(--step-h2);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
    font-weight: 500;
    margin: 0;
    max-width: 26ch;
    text-wrap: balance;
  }
  /* One rhythm for every block in a section, set here rather than in
     CaseBlocks so a section's internal spacing is one number. */
  .cs__blocks {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 3.5vw, 3rem);
    margin-block-start: clamp(1.75rem, 3vw, 2.5rem);
  }

  /* --- Next / footer -------------------------------------------------- */
  .next {
    display: block;
    text-decoration: none;
    color: var(--fg);
    margin-top: 1rem;
    max-width: 24ch;
  }
  .next__co {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-h1);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: 0.95;
  }
  .next__title {
    display: block;
    font-family: var(--font-accent);
    font-style: italic;
    font-size: var(--step-h3);
    color: var(--fg-dim);
    margin-top: 0.75rem;
  }
  .next:hover .next__co { text-decoration: underline; text-underline-offset: 8px; }

  .foot__title {
    font-family: var(--font-display);
    font-size: var(--step-h2);
    letter-spacing: var(--tracking-display);
    font-weight: 500;
    margin: 0 0 1rem;
  }
  .foot__body { color: var(--fg-dim); }
  .foot__links { display: flex; flex-wrap: wrap; gap: 1.5rem; padding-top: 1rem; }

  @media (max-width: 1080px) {
    .body { grid-template-columns: 1fr; row-gap: clamp(2rem, 5vw, 3rem); }
    /* The horizontal rail is pinned under the nav, so anchored sections
       need to clear both. */
    .cs { scroll-margin-top: calc(var(--nav-h) + 5rem); }
  }
  @media (max-width: 820px) {
    .meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* A 16/7 letterbox is too thin to read on a phone. */
    .hero__frame { aspect-ratio: 16 / 10; }
  }
</style>
