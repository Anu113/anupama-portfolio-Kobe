---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Reveal from '../components/Reveal.astro';
import PageHeader from '../components/PageHeader.astro';
import ArchiveList from '../components/ArchiveList.astro';
import CaseCard from '../components/CaseCard.astro';
import { work, archive, labelsFor } from '../data/work';
import { cases } from '../data/cases';

/* Cross-referenced by href rather than duplicating a `locked` flag in
   work.ts — cases.ts is the one place a case's gate state is declared, so
   there's nothing to keep in sync by hand. */
const lockedSlugs = new Set(cases.filter((c) => c.locked).map((c) => c.slug));
const isLocked = (href: string) => lockedSlugs.has(href.replace('/work/', ''));

/* One even grid after carlthomasiv.com/work: two columns, every tile the
   same 3:2 picture, no stagger. The earlier staggered field (mixed spans,
   drops and ratios) read as uneven, and its full-width tiles ran taller
   than the window. */
const RATIO = '3 / 2';
---
<Base
  title="Work — Anupama Mishra"
  description="Selected work: Okta IAM and the Integration Platform, PayPal ID verification, the PayPal Debit Card, PayPal privacy and ad consent, Walmart Scan & Go and Chase Pay. Scope, the hard calls and outcomes for each."
>
  <Section theme="bone" class="workindex">
    <div class="workindex__head">
      <PageHeader label="Work">
        Curated <em>case studies</em>
        <Fragment slot="intro">
          <p>Fintech, identity, developer tools and retail. Work spanning hands-on design, design systems, team leadership and 0-to-1 products.</p>
        </Fragment>
      </PageHeader>
    </div>

    <div class="grid" data-worklist>
      {work.map((w, i) => {
        return (
          <div class="cell">
          <Reveal delay={(i % 2) * 90}>
            <CaseCard
              title={w.title} href={w.href} image={w.image} alt={w.alt}
              company={w.company} impact={w.impact}
              labels={labelsFor(w)}
              theme={w.theme} ratio={RATIO}
              locked={isLocked(w.href)}
              hoverState={w.hoverState}
            />
          </Reveal>
          </div>
        );
      })}
    </div>
  </Section>

  <Section theme="clay">
    <Reveal>
      <h2 class="arch__head u-label">Archive</h2>
    </Reveal>
    <Reveal delay={120}>
      <ArchiveList items={archive} />
    </Reveal>
  </Section>

</Base>

<style>
  /* The header and the grid share one bone band. They used to be two
     adjacent <Section>s, but once the header went light they wore the same
     ground — and two Sections in one palette stack their padding into a
     ~280px dead gap at a seam nobody can see. One band, one gap.
     :global because the band is rendered by Section.astro, so it doesn't
     carry this page's scope hash. Named .workindex rather than .workhead:
     index.astro already owns that class for its "Selected work" label row. */
  :global(.workindex) { padding-top: 0; }

  /* A compact header on the content edge, after carlthomasiv.com/work —
     label, one line, then straight into the grid. Left-aligned here
     rather than PageHeader's centred default. */
  .workindex__head {
    padding-top: calc(var(--space-band-tight) * 2);
  }
  .workindex__head :global(.phead) { align-items: flex-start; text-align: left; }
  .workindex__head :global(.phead__title) { max-width: none; }
  .grid { margin-top: var(--space-band-tight); }

  /* --- The grid ------------------------------------------------------
     Two equal columns, rows aligned to the top. */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 2.5vw, 2rem);
    row-gap: clamp(3rem, 4.5vw, 3.5rem);
    align-items: start;
  }

  /* --- Archive -------------------------------------------------------
     The rows themselves are ArchiveList.astro; only the heading is here. */
  .arch__head { margin: 0 0 2rem; color: var(--fg-dim); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); row-gap: clamp(3.5rem, 10vw, 5rem); }
    .arch__row { grid-template-columns: minmax(0, 1fr) 5rem; }
    .arch__tag { grid-column: 1; }
    .arch__year { grid-column: 2; grid-row: 1; }
  }
</style>
