---
/* /playground/stream — the playground as a gallery wall of her work
   (PlayDepth.astro), built on request (2026-11-11) from
   experiments/playground-stream/wall.html. Not linked from anywhere;
   /playground itself is PlayBall. The page opens on the heading, the work
   rises from below it, and after ~4 screens of work the page goes on to the
   footer. The earlier stream (InfiniteStream.astro, data/play.ts) is
   parked, not deleted. */
import Base from '../../layouts/Base.astro';
import PlayDepth from '../../components/PlayDepth.astro';
---
<!-- No cursor trail or lamp: the field wears the grab/grabbing hand, and a
     line trailing off a hand you're dragging with reads as two cursors. -->
<Base
  title="Playground — Anupama Mishra"
  description="Paintings and photos by Anupama Mishra, hung as a wall you can scroll and pan."
  trail={false}
>
  <PlayDepth />
</Base>
